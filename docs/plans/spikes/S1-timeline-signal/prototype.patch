diff --git a/src/styles/transport.css b/src/styles/transport.css
index 3d279f9..9ddce1f 100644
--- a/src/styles/transport.css
+++ b/src/styles/transport.css
@@ -991,3 +991,55 @@ legend.tp-label {
     outline: 1px solid CanvasText;
   }
 }
+
+/* ───────────────────────────── spike S1: pace signal candidates (prototype, not for release) ───────────────────────────── */
+/* T1: a 44 px button in the strip's 4th column; faint outline when behind, amber ring when waiting. */
+.tl-pace {
+  grid-column: 4;
+  grid-row: 1;
+  align-self: center;
+  justify-self: center;
+  width: var(--tap);
+  height: var(--tap);
+  border-radius: 50%;
+  color: var(--text);
+  box-shadow: inset 0 0 0 1px var(--outline);
+}
+.tl-pace[hidden] {
+  display: none;
+}
+.scrubber[data-pace='waiting'] .tl-pace {
+  color: var(--watch-ink);
+  box-shadow: inset 0 0 0 3px var(--watch);
+}
+/* The amber line under the rail: a fixed 44 px run that ends at the thumb (the stretch between thumb and head is empty while waiting). */
+.tl-pace-line {
+  position: absolute;
+  left: max(0px, calc(var(--view, 0%) - 44px));
+  width: min(44px, var(--view, 0%));
+  top: calc(var(--tl-cy) + 4px);
+  height: 3px;
+  border-radius: 2px;
+  background: var(--watch);
+  pointer-events: none;
+}
+.tl-pace-line[hidden] {
+  display: none;
+}
+/* T3: an amber ring on the thumb. */
+.scrubber[data-pace-variant='t3'][data-pace='behind'] .tl-thumb {
+  box-shadow: 0 0 0 2px var(--surface), 0 0 0 3px var(--outline);
+}
+.scrubber[data-pace-variant='t3'][data-pace='waiting'] .tl-thumb {
+  box-shadow: 0 0 0 2px var(--surface), 0 0 0 5px var(--watch);
+}
+/* T2: a badge in the clock's state slot. */
+.tb-chip-pace {
+  background: var(--watch);
+  color: #1b1500;
+  gap: 4px;
+}
+.tp-pace h3 {
+  margin: var(--sp-3) 0 var(--sp-1);
+  font-size: var(--fs-md);
+}
