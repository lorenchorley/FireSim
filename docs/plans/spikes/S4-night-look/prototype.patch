diff --git a/src/render/mapLighting.test.ts b/src/render/mapLighting.test.ts
new file mode 100644
index 0000000..0d8476b
--- /dev/null
+++ b/src/render/mapLighting.test.ts
@@ -0,0 +1,130 @@
+// SPIKE S4 prototype tests for the map lighting (Night lighting). Throwaway: the lane writes the reviewed version.
+import { describe, expect, it } from 'vitest';
+import { sunDirectionWorld, type Vec3 } from './coords';
+import { MAP_LOOK, mapLighting, NIGHT_LOOKS, skyLighting, type NightLook } from './sky';
+
+const ELEVATIONS = [-30, -18, -12, -8, -6, -3, -2, -1, 0, 0.5, 2, 4, 6, 8, 8.5, 12, 30, 60, 90];
+const realDir = (el: number, az = 240): Vec3 => sunDirectionWorld(az, Math.max(el, -2));
+const lum = (c: readonly number[]): number => 0.2126 * c[0]! + 0.7152 * c[1]! + 0.0722 * c[2]!;
+
+describe('mapLighting', () => {
+  it('Realistic is bit-identical to today for every elevation, cloud and smoke value', () => {
+    for (const el of ELEVATIONS)
+      for (const cloudCover of [0, 40, 100])
+        for (const smoke of [0, 0.3, 1]) {
+          const real = skyLighting(el, { cloudCover, smoke });
+          const dir = realDir(el);
+          const m = mapLighting(real, 'realistic', dir);
+          expect(m.weight).toBe(0);
+          expect(m.sunDir).toBe(dir); // the very same numbers
+          expect(m.sunColour).toBe(real.sunColour);
+          expect(m.sunIntensity).toBe(real.sunIntensity);
+          expect(m.skyAmbient).toBe(real.skyAmbient);
+          expect(m.groundAmbient).toBe(real.groundAmbient);
+          expect(m.ambientIntensity).toBe(real.ambientIntensity);
+          expect(m.exposure).toBe(real.exposure);
+          expect(m.mapNight).toBe(real.night);
+        }
+  });
+
+  it('every look is identical to Realistic with the sun at or above fadeHigh (8 deg)', () => {
+    for (const el of [8, 8.5, 12, 30, 60, 90])
+      for (const look of NIGHT_LOOKS) {
+        const real = skyLighting(el, { cloudCover: 30 });
+        const m = mapLighting(real, look as NightLook, realDir(el));
+        expect(m.weight).toBe(0);
+        expect(m.sunIntensity).toBe(real.sunIntensity);
+        expect(m.ambientIntensity).toBe(real.ambientIntensity);
+        expect(m.exposure).toBe(real.exposure);
+        expect(m.sunColour).toEqual(real.sunColour);
+      }
+  });
+
+  it('Daylight at night equals the target lighting from the fixed sun', () => {
+    const target = skyLighting(MAP_LOOK.sunElevation);
+    const tdir = sunDirectionWorld(MAP_LOOK.sunAzimuth, MAP_LOOK.sunElevation);
+    for (const el of [-2, -6, -12, -30]) {
+      const real = skyLighting(el, { cloudCover: 80, smoke: 0.5 });
+      const m = mapLighting(real, 'daylight', realDir(el));
+      expect(m.weight).toBe(1);
+      expect(m.sunIntensity).toBeCloseTo(target.sunIntensity, 12);
+      expect(m.ambientIntensity).toBeCloseTo(target.ambientIntensity, 12);
+      expect(m.exposure).toBeCloseTo(target.exposure, 12);
+      for (let i = 0; i < 3; i++) {
+        expect(m.sunColour[i]).toBeCloseTo(target.sunColour[i]!, 12);
+        expect(m.skyAmbient[i]).toBeCloseTo(target.skyAmbient[i]!, 12);
+        expect(m.groundAmbient[i]).toBeCloseTo(target.groundAmbient[i]!, 12);
+        expect(m.sunDir[i]).toBeCloseTo(tdir[i]!, 12);
+      }
+      expect(m.mapNight).toBe(0);
+    }
+  });
+
+  it('the direction is a unit vector; weight and sun intensity are monotone and continuous through dusk', () => {
+    for (const look of ['brighter', 'daylight'] as NightLook[]) {
+      let prev = -1;
+      let prevI = NaN;
+      for (let el = 10; el >= -14; el -= 0.1) {
+        const real = skyLighting(el);
+        const m = mapLighting(real, look, realDir(el));
+        expect(Math.hypot(...m.sunDir)).toBeCloseTo(1, 12);
+        expect(m.weight).toBeGreaterThanOrEqual(prev - 1e-12);
+        expect(m.weight).toBeLessThanOrEqual(MAP_LOOK.mix[look] + 1e-12);
+        prev = m.weight;
+        if (Number.isFinite(prevI)) expect(Math.abs(m.sunIntensity - prevI)).toBeLessThan(0.1); // per 0.1 deg
+        prevI = m.sunIntensity;
+      }
+    }
+  });
+
+  it('mapNight is the real night times (1 - weight): 0 in Daylight, between in Brighter, the real value in Realistic', () => {
+    const real = skyLighting(-20);
+    expect(real.night).toBe(1);
+    expect(mapLighting(real, 'realistic', realDir(-20)).mapNight).toBe(1);
+    expect(mapLighting(real, 'brighter', realDir(-20)).mapNight).toBeCloseTo(1 - MAP_LOOK.mix.brighter, 12);
+    expect(mapLighting(real, 'daylight', realDir(-20)).mapNight).toBe(0);
+    expect(mapLighting(skyLighting(40), 'daylight', realDir(40)).mapNight).toBe(0); // by day it is the real night (0)
+  });
+
+  // The two defects of the plan's blend that the spike found (see the README).
+  it('at night every look is lit from the fixed sun, whatever the real sun azimuth does (a plain vector blend swings with it)', () => {
+    const tdir = sunDirectionWorld(MAP_LOOK.sunAzimuth, MAP_LOOK.sunElevation);
+    for (const az of [0, 60, 120, 180, 240, 300])
+      for (const look of ['brighter', 'daylight'] as NightLook[]) {
+        const m = mapLighting(skyLighting(-30), look, realDir(-30, az));
+        for (let i = 0; i < 3; i++) expect(m.sunDir[i]).toBeCloseTo(tdir[i]!, 12);
+      }
+    // the same with the plan's vector blend: Brighter's direction depends on the real azimuth (up to tens of degrees)
+    MAP_LOOK.dirBlend = 'vector';
+    try {
+      const a = mapLighting(skyLighting(-30), 'brighter', realDir(-30, 60)).sunDir;
+      const b = mapLighting(skyLighting(-30), 'brighter', realDir(-30, 240)).sunDir;
+      expect(Math.acos(Math.min(1, a[0] * b[0] + a[1] * b[1] + a[2] * b[2])) * (180 / Math.PI)).toBeGreaterThan(30);
+    } finally {
+      MAP_LOOK.dirBlend = 'light';
+    }
+  });
+
+  it('the sun light (colour times intensity) at night is the weight times the target sun light, not the weight squared', () => {
+    const target = skyLighting(MAP_LOOK.sunElevation);
+    const full = lum(target.sunColour) * target.sunIntensity;
+    const b = mapLighting(skyLighting(-30), 'brighter', realDir(-30));
+    expect(lum(b.sunColour) * b.sunIntensity).toBeCloseTo(MAP_LOOK.mix.brighter * full, 10);
+    MAP_LOOK.lightBlend = 'separate';
+    try {
+      const s = mapLighting(skyLighting(-30), 'brighter', realDir(-30));
+      expect(lum(s.sunColour) * s.sunIntensity).toBeCloseTo(MAP_LOOK.mix.brighter ** 2 * full, 10); // the plan's blend
+    } finally {
+      MAP_LOOK.lightBlend = 'product';
+    }
+  });
+
+  it('a smoke weight of 0 gives the real lighting back untouched', () => {
+    const real = skyLighting(-30);
+    const dir = realDir(-30);
+    const m = mapLighting(real, 'daylight', dir, 0);
+    expect(m.sunIntensity).toBe(real.sunIntensity);
+    expect(m.exposure).toBe(real.exposure);
+    expect(m.sunDir).toBe(dir);
+  });
+});
