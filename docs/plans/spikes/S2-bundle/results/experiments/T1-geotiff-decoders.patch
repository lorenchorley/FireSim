 import { defineConfig } from 'vitest/config';
 import { fileURLToPath } from 'node:url';
+import type { Plugin } from 'vite';
+
+/**
+ * Leaves out the GeoTIFF decoders the app never needs. src/data/canopy.ts reads only the Meta / WRI canopy-height COGs,
+ * which are Deflate (docs/research/08-data-sources-apis.md, 3.8). geotiff loads each decoder with import(), so every one is a chunk
+ * (LERC and ZSTD are 68 kB gzip together, mostly base64 WebAssembly text).
+ */
+function stubUnusedTiffDecoders(): Plugin {
+  const STUB = '\0firesim-unsupported-tiff-decoder';
+  return {
+    name: 'firesim-stub-unused-tiff-decoders',
+    enforce: 'pre',
+    resolveId(source, importer) {
+      if (importer && /geotiff[\\/]dist-module[\\/]compression[\\/]index\.js$/.test(importer) && /^\.\/(lerc|zstd|jpeg|webimage)\.js$/.test(source)) return STUB;
+      return null;
+    },
+    load(id) {
+      if (id !== STUB) return null;
+      return "export const zstd = { init: async () => { throw new Error('This build has no decoder for this TIFF compression'); } };\nexport default class UnsupportedTiffDecoder { constructor() { throw new Error('This build has no decoder for this TIFF compression'); } }\n";
+    },
+  };
+}
 
