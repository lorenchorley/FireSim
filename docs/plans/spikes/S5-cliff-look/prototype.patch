index 0000000..2b157d2
--- /dev/null
+++ b/src/render/cliffSharpen.test.ts
@@ -0,0 +1,91 @@
+import { describe, expect, it } from 'vitest';
+import type { GridSpec } from '../core/grid';
+import { cliffSharpen, countSpikes } from './cliffSharpen';
+import { hornGradient, slopeFromGradient } from './fields';
+
+const origin = { lat: -33.7, lon: 150.3 };
+const mk = (nx: number, ny: number, h = 10): GridSpec => ({ nx, ny, cellSize: h, x0: 0, y0: 0, origin });
+const maxSlope = (g: GridSpec, z: Float32Array): number => {
+  const { dzdx, dzdy } = hornGradient(g, z);
+  let m = 0;
+  for (let k = 0; k < z.length; k++) m = Math.max(m, slopeFromGradient(dzdx[k]!, dzdy[k]!));
+  return m;
+};
+
+describe('cliffSharpen (S5 prototype)', () => {
+  it('makes a 70 degree ramp with rounded shoulders steeper and keeps its end heights', () => {
+    const g = mk(60, 40);
+    const z = new Float32Array(g.nx * g.ny);
+    const run = 100 / Math.tan((70 * Math.PI) / 180);
+    for (let j = 0; j < g.ny; j++)
+      for (let i = 0; i < g.nx; i++) {
+        const t = Math.min(1, Math.max(0, (i * 10 - 200) / run));
+        z[j * g.nx + i] = 0.45 * 100 * (1 - t) + 0.55 * 100 * (1 - t * t * (3 - 2 * t));
+      }
+    const r = cliffSharpen(g, z);
+    expect(maxSlope(g, r.elevation)).toBeGreaterThan(maxSlope(g, z) + 2);
+    expect(r.elevation[20 * g.nx + 5]).toBe(z[20 * g.nx + 5]);
+    expect(r.elevation[20 * g.nx + 54]).toBe(z[20 * g.nx + 54]);
+  });
+
+  it('leaves a straight steep ramp (away from the edge) and all ground under 48 degrees untouched, bit for bit', () => {
+    const g = mk(80, 80);
+    const plane = new Float32Array(g.nx * g.ny);
+    const gentle = new Float32Array(g.nx * g.ny);
+    for (let j = 0; j < g.ny; j++)
+      for (let i = 0; i < g.nx; i++) {
+        plane[j * g.nx + i] = 500 - 25 * i + 7 * j;
+        gentle[j * g.nx + i] = 300 + 18 * Math.sin(i / 9) + 12 * Math.cos(j / 7) - 3 * i;
+      }
+    const rp = cliffSharpen(g, plane).elevation;
+    for (let j = 5; j < g.ny - 5; j++) for (let i = 5; i < g.nx - 5; i++) expect(rp[j * g.nx + i]).toBe(plane[j * g.nx + i]);
+    expect(maxSlope(g, gentle)).toBeLessThan(48);
+    expect(cliffSharpen(g, gentle).elevation.every((v, k) => v === gentle[k])).toBe(true);
+  });
+
+  it('leaves no tower or pit of 10 m or more, is deterministic, bounded, and never touches the edge or makes a NaN', () => {
+    const g = mk(100, 100);
+    const z = new Float32Array(g.nx * g.ny);
+    let s = 12345;
+    const rnd = (): number => {
+      s = (Math.imul(s, 1664525) + 1013904223) >>> 0;
+      return s / 4294967296;
+    };
+    for (let j = 0; j < g.ny; j++) for (let i = 0; i < g.nx; i++) z[j * g.nx + i] = 400 + 90 * Math.sin(i / 9) * Math.cos(j / 11) + (rnd() < 0.02 ? (rnd() - 0.5) * 120 : 0) + 2 * rnd();
+    const a = cliffSharpen(g, z);
+    const b = cliffSharpen(g, z);
+    expect(a.elevation.every((v, k) => v === b.elevation[k])).toBe(true);
+    expect(countSpikes(g, a.elevation, 10)).toEqual({ towers: 0, pits: 0 });
+    for (let i = 0; i < g.nx; i++) {
+      expect(a.elevation[i]).toBe(z[i]);
+      expect(a.elevation[(g.ny - 1) * g.nx + i]).toBe(z[(g.ny - 1) * g.nx + i]);
+    }
+    for (let j = 3; j < g.ny - 3; j++)
+      for (let i = 3; i < g.nx - 3; i++) {
+        let lo = Infinity;
+        let hi = -Infinity;
+        for (let dj = -3; dj <= 3; dj++) for (let di = -3; di <= 3; di++) {
+          const v = z[(j + dj) * g.nx + i + di]!;
+          lo = Math.min(lo, v);
+          hi = Math.max(hi, v);
+        }
+        expect(a.elevation[j * g.nx + i]).toBeGreaterThanOrEqual(lo - 2 - 1e-3);
+        expect(a.elevation[j * g.nx + i]).toBeLessThanOrEqual(hi + 2 + 1e-3);
+      }
+    const zn = Float32Array.from(z);
+    zn[50 * g.nx + 50] = NaN;
+    const rn = cliffSharpen(g, zn).elevation;
+    let fresh = 0;
+    for (let k = 0; k < rn.length; k++) if (Number.isNaN(rn[k]!) && !Number.isNaN(zn[k]!)) fresh++;
+    expect(fresh).toBe(0);
+  });
+
+  it('keeps the floor of a gully with 60 degree walls unchanged', () => {
+    const g = mk(80, 80);
+    const z = new Float32Array(g.nx * g.ny);
+    for (let j = 0; j < g.ny; j++)
+      for (let i = 0; i < g.nx; i++) z[j * g.nx + i] = 200 + 1.8 * j + Math.min(Math.abs(i - 40) * 10 * Math.tan((60 * Math.PI) / 180), 120);
+    const r = cliffSharpen(g, z).elevation;
+    for (let j = 4; j < g.ny - 4; j++) expect(Math.abs(r[j * g.nx + 40]! - z[j * g.nx + 40]!)).toBeLessThan(1e-3);
+  });
+});
