index 0000000..9e69f3e
--- /dev/null
+++ b/src/sim/validation/convergence.test.ts
@@ -0,0 +1,142 @@
+/**
+ * Convergence under refinement (plan 15d idea 4 and 17; contract 0.10.0, 4.3 item 1, last relation): the same fire with a smaller solver
+ * step and with finer cells, against stated bands (passMarks.json, written before these checks). Convergence is not validity: finer
+ * cells are a different model setting until the validity work says which is closer to a real fire, and the bands only ask that the
+ * numerics do not by themselves use up the whole of the literature's adequacy interval. Embers are off (their random draws change with
+ * the cell and the step, so differences would mix numerics and chance); one realisation per row.
+ *   P-stepConvergence   solver step 10 s (automatic) against 5 s and 2 s: burnt area at 1 h within 10 percent;
+ *   P-gridConvergence   cells of 30 and 20 m against 10 m: burnt area at 1 h within 35 percent of the 10 m run, and the 20 m run not
+ *                       farther from it than the 30 m run.
+ * On seeded random synthetic terrains and, under SLOW=1, on the bundled sites Katoomba and the Warrumbungles (6 km, the V20 preset and
+ * ignition of the desktop study). The 10 m runs on the bundled sites need the builder's high-detail cell set to 10 m: the mock below does
+ * that in this test only, as the desktop study's launcher does (studies/desktop-simulation/01-cost-vs-detail/scripts/launch.mjs).
+ */
+import { describe, expect, it, vi } from 'vitest';
+import { log, runSim, SLOW } from './harness';
+import marksFile from './passMarks.json';
+import { fire, HOUR, record, seeds } from './propertyKit';
+import { drawCase, elevationOf } from './randomCases';
+import { demoScenario, pointIgnition, withIgnitions } from '../testing/scenarios';
+
+const hold = vi.hoisted(() => ({ cell: 20 }));
+vi.mock('../../scenario/params', async (importOriginal) => {
+  const m = await importOriginal<typeof import('../../scenario/params')>();
+  const P = { ...m.SCENARIO_PARAMS };
+  Object.defineProperty(P, 'highDetailCellM', { get: () => hold.cell, enumerable: true });
+  return {
+    ...m,
+    SCENARIO_PARAMS: P,
+    builtFireCell: (extentM: number, requested?: number, tier?: string) => {
+      const wantsHigh = (requested !== undefined && requested <= hold.cell) || tier === 'high';
+      if (!wantsHigh) return { cellM: P.fireCellM, coarsened: false };
+      return extentM <= P.highDetailMaxExtentM ? { cellM: hold.cell, coarsened: false } : { cellM: P.fireCellM, coarsened: true };
+    },
+  };
+});
+
+const STEP = marksFile.marks.stepConvergence.bandFraction;
+const GRID = marksFile.marks.gridConvergence.bandFraction;
+const CELLS = [30, 20, 10];
+
+/** The verdict on one set of rows: step runs against the automatic one, cells against the finest. */
+function stepFailures(label: string, auto: number, steps: Record<number, number>): string[] {
+  return Object.entries(steps)
+    .filter(([, a]) => Math.abs(a / auto - 1) > STEP)
+    .map(([s, a]) => `${label}: step ${s} s gives ${a.toFixed(1)} ha against ${auto.toFixed(1)} ha (${(100 * (a / auto - 1)).toFixed(1)} percent)`);
+}
+function gridFailures(label: string, byCell: Record<number, number>): string[] {
+  const fine = byCell[10]!;
+  const out: string[] = [];
+  for (const c of [30, 20]) if (Math.abs(byCell[c]! / fine - 1) > GRID) out.push(`${label}: ${c} m gives ${byCell[c]!.toFixed(1)} ha against ${fine.toFixed(1)} ha at 10 m (${(100 * (byCell[c]! / fine - 1)).toFixed(1)} percent)`);
+  if (Math.abs(byCell[20]! - fine) > Math.abs(byCell[30]! - fine)) out.push(`${label}: the 20 m run (${byCell[20]!.toFixed(1)} ha) is farther from the 10 m run (${fine.toFixed(1)} ha) than the 30 m run (${byCell[30]!.toFixed(1)} ha)`);
+  return out;
+}
+
+describe('convergence on seeded random synthetic terrains (2.4 km; the quick run: seed 601, 30 m against 20 m, step 5 s)', () => {
+  const run = (seed: number, cellSize: number, maxStepS?: number): number => {
+    const c = drawCase(seed, { extent: 2400, windKmh: [15, 35] });
+    const f = fire({ elevation: elevationOf(c.terrain), ignition: c.ignition, windKmh: c.windKmh, windFromDeg: c.windFromDeg, cellSize, ...(maxStepS ? { maxStepS } : {}) });
+    return f.burntAreaHa;
+  };
+  const stepRows = (seed: number, steps: number[]): { auto: number; byStep: Record<number, number> } => {
+    const auto = run(seed, 30);
+    const byStep: Record<number, number> = {};
+    for (const s of steps) byStep[s] = run(seed, 30, s);
+    log(`P-stepConvergence synthetic seed ${seed}: burnt area at 1 h ${auto.toFixed(1)} ha (automatic), ${Object.entries(byStep).map(([s, a]) => `${a.toFixed(1)} ha (${s} s)`).join(', ')}`);
+    record('P-stepConvergence-synthetic', { seed, autoHa: auto, byStepHa: byStep });
+    return { auto, byStep };
+  };
+
+  it('P-stepConvergence: a solver step of 5 s gives the area of the automatic step at 1 h within the band (every seed)', () => {
+    const failures: string[] = [];
+    for (const seed of seeds(601, 4, 1)) {
+      const r = stepRows(seed, [5]);
+      failures.push(...stepFailures(`seed ${seed}`, r.auto, r.byStep));
+    }
+    expect(failures, `step refinement outside the band (a finding, not to be fixed in the solver): ${failures.join('; ')}`).toEqual([]);
+  }, 900000);
+
+  it.skipIf(!SLOW)('P-stepConvergence: a solver step of 2 s gives the area of the automatic step at 1 h within the band (seeds 602 to 604) [SLOW]', () => {
+    const failures: string[] = [];
+    for (const seed of [602, 603, 604]) {
+      const r = stepRows(seed, [2]);
+      failures.push(...stepFailures(`seed ${seed}`, r.auto, r.byStep));
+    }
+    expect(failures, `step refinement outside the band (a finding, not to be fixed in the solver): ${failures.join('; ')}`).toEqual([]);
+  }, 900000);
+
+  // Finding F2 (reported, not fixed here): on the one terrain of seed 601 a 2 s step gives 130.3 ha at 1 h against 118.1 ha for the automatic step, 10.4 percent,
+  // just outside the pre-registered 10 percent (the 5 s step is within 3.2 percent; the other three seeds and both bundled sites are within 7.3 percent at 2 s). Pinned
+  // like the Katoomba forecast fixture of V21: it passes while the finding stands and fails the day the numbers move, so claims.json is updated in that commit.
+  it.skipIf(!SLOW).fails('P-stepConvergence: seed 601, a solver step of 2 s gives the area of the automatic step within 10 percent [known finding F2, SLOW]', () => {
+    const r = stepRows(601, [2]);
+    expect(stepFailures('seed 601', r.auto, r.byStep)).toEqual([]);
+  }, 900000);
+
+  it('P-gridConvergence: cells of 30 m and 20 m (and 10 m under SLOW) give the area of the finest run at 1 h within the band', () => {
+    const failures: string[] = [];
+    for (const seed of seeds(601, 4, 1)) {
+      const byCell: Record<number, number> = {};
+      for (const c of SLOW ? CELLS : [30, 20]) byCell[c] = run(seed, c);
+      log(`P-gridConvergence synthetic seed ${seed}: burnt area at 1 h ${Object.entries(byCell).map(([c, a]) => `${a.toFixed(1)} ha (${c} m)`).join(', ')}`);
+      record('P-gridConvergence-synthetic', { seed, byCellHa: byCell });
+      if (SLOW) failures.push(...gridFailures(`seed ${seed}`, byCell));
+    }
+    expect(failures, `grid refinement outside the band (a finding, not to be fixed in the solver): ${failures.join('; ')}`).toEqual([]);
+  }, 900000);
+});
+
+const SITES = [
+  { site: 'katoomba', x: -2170, y: 900 },
+  { site: 'warrumbungles', x: -1500, y: 1000 },
+] as const;
+
+describe.skipIf(!SLOW)('convergence on the bundled sites (6 km, the V20 preset, embers off, 1 h) [SLOW]', () => {
+  const area = async (site: (typeof SITES)[number], cell: number, maxStepS?: number): Promise<number> => {
+    hold.cell = cell;
+    const base = await demoScenario({ site: site.site, preset: 'hot-nw-sw-change', startCivil: [2025, 12, 20, 14], duration: 4 * 3600, extent: 6000, tier: 'fast', options: { fireCellSize: cell, embers: false, seed: 1, ...(maxStepS ? { maxStepS } : {}) } });
+    const s = withIgnitions(base, [pointIgnition('a', site.x, site.y, 0, 60)], { embers: false });
+    expect(s.terrain.grid.cellSize, 'the builder gave the cell asked for').toBe(cell);
+    return runSim(s, { tier: 'fast', until: HOUR, every: 600, keepSnaps: false }).sim.stats().burntAreaHa;
+  };
+
+  for (const site of SITES) {
+    it(`P-stepConvergence: ${site.site}: a solver step of 5 s and of 2 s gives the area of the automatic step at 1 h within the band`, async () => {
+      const auto = await area(site, 30);
+      const steps: Record<number, number> = { 5: await area(site, 30, 5), 2: await area(site, 30, 2) };
+      log(`P-stepConvergence ${site.site}: burnt area at 1 h ${auto.toFixed(1)} ha (automatic), ${Object.entries(steps).map(([s, a]) => `${a.toFixed(1)} ha (${s} s)`).join(', ')}`);
+      record(`P-stepConvergence-${site.site}`, { autoHa: auto, byStepHa: steps, d5: steps[5]! / auto - 1, d2: steps[2]! / auto - 1 });
+      const failures = stepFailures(site.site, auto, steps);
+      expect(failures, `step refinement outside the band (a finding, not to be fixed in the solver): ${failures.join('; ')}`).toEqual([]);
+    }, 900000);
+
+    it(`P-gridConvergence: ${site.site}: cells of 30 m and 20 m give the area of the 10 m run at 1 h within the band`, async () => {
+      const byCell: Record<number, number> = {};
+      for (const c of CELLS) byCell[c] = await area(site, c);
+      log(`P-gridConvergence ${site.site}: burnt area at 1 h ${Object.entries(byCell).map(([c, a]) => `${a.toFixed(1)} ha (${c} m)`).join(', ')}`);
+      record(`P-gridConvergence-${site.site}`, { byCellHa: byCell, d30: byCell[30]! / byCell[10]! - 1, d20: byCell[20]! / byCell[10]! - 1 });
+      const failures = gridFailures(site.site, byCell);
+      expect(failures, `grid refinement outside the band (a finding, not to be fixed in the solver): ${failures.join('; ')}`).toEqual([]);
+    }, 900000);
+  }
+});
diff --git a/src/sim/validation/fuzz.test.ts b/src/sim/validation/fuzz.test.ts
