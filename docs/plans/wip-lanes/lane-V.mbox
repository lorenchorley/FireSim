+#!/usr/bin/env node
+/**
+ * Makes the validity card's data (src/sim/validation/card.json) and the claims page (docs/validity/claims.md) from the claims register
+ * (claims.json) and what was measured, so that no figure of either is typed by hand (plan 15d ideas 2 and 23).
+ *
+ *   node scripts/validity-card.mjs                         remake card.json and claims.md from the files as they are
+ *   node scripts/validity-card.mjs --merge RUN.jsonl REPORT.json
+ *       first write src/sim/validation/results/validity-run.json from a full run:
+ *         FIRESIM_VALIDITY_OUT=RUN.jsonl SLOW=1 npx vitest run <the validity test files> --reporter=json --outputFile=REPORT.json
+ *       (RUN.jsonl is what the checks measured, REPORT.json is vitest's own pass or fail per test), then remake both.
+ *
+ * Inputs: claims.json, golden/*.json, results/validity-run.json, results/cross-engine.json (written by e2e/validity-engines.spec.ts),
+ * studies/simulation-validity/tiers/summary.json and studies/desktop-simulation/01-cost-vs-detail/data/convergence-diff.json.
+ * claims.test.ts fails when either output is out of date with them. Loads the TypeScript kit through the repository's own Vite.
+ */
+import { createServer } from 'vite';
+import { readFileSync, writeFileSync, mkdirSync } from 'node:fs';
+import { dirname, relative, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');
+const args = process.argv.slice(2);
+
+if (args[0] === '--merge') {
+  const [, jsonl, report] = args;
+  if (!jsonl || !report) throw new Error('usage: validity-card.mjs --merge RUN.jsonl REPORT.json');
+  const measures = {};
+  for (const line of readFileSync(jsonl, 'utf8').split('\n').filter(Boolean)) {
+    const { id, ...rest } = JSON.parse(line);
+    if (measures[id] === undefined) measures[id] = rest;
+    else if (Array.isArray(measures[id])) measures[id].push(rest);
+    else measures[id] = [measures[id], rest];
+  }
+  const rep = JSON.parse(readFileSync(report, 'utf8'));
+  const tests = [];
+  for (const f of rep.testResults) {
+    const file = relative(root, f.name).split('\\').join('/');
+    for (const a of f.assertionResults) tests.push({ file, title: a.title, fullName: a.fullName, status: a.status === 'passed' ? 'passed' : a.status === 'failed' ? 'failed' : 'skipped' });
+  }
+  const out = {
+    ranAt: new Date().toISOString(),
+    node: process.version,
+    platform: `${process.platform} ${process.arch}`,
+    command: 'FIRESIM_VALIDITY_OUT=run.jsonl SLOW=1 npx vitest run src/sim/validation/properties.test.ts src/sim/validation/convergence.test.ts src/sim/validation/fuzz.test.ts src/sim/validation/golden/golden.test.ts --reporter=json',
+    tests,
+    measures,
+  };
+  mkdirSync(resolve(root, 'src/sim/validation/results'), { recursive: true });
+  writeFileSync(resolve(root, 'src/sim/validation/results/validity-run.json'), `${JSON.stringify(out, null, 2)}\n`);
+  console.log(`wrote src/sim/validation/results/validity-run.json: ${tests.length} tests, ${Object.keys(measures).length} measures`);
+}
+
+const server = await createServer({
+  root,
+  configFile: false,
+  logLevel: 'error',
+  appType: 'custom',
+  server: { middlewareMode: true, hmr: false, watch: null },
+  optimizeDeps: { noDiscovery: true, include: [] },
+});
+try {
+  const kit = await server.ssrLoadModule('/src/sim/validation/claimsKit.ts');
+  const claims = kit.loadClaims();
+  const src = kit.loadSources();
+  const ids = kit.goldenFiles();
+  const golden = ids.map((id) => JSON.parse(readFileSync(resolve(root, `src/sim/validation/golden/${id}.json`), 'utf8')));
+  const card = kit.buildCard(claims, src, ids, golden);
+  writeFileSync(resolve(root, 'src/sim/validation/card.json'), `${JSON.stringify(card, null, 2)}\n`);
+  mkdirSync(resolve(root, 'docs/validity'), { recursive: true });
+  writeFileSync(resolve(root, 'docs/validity/claims.md'), kit.claimsMarkdown(claims, src));
+  console.log(`wrote src/sim/validation/card.json (${card.properties.hold} of ${card.properties.total} properties hold, ${card.properties.findings} known finding(s); ${card.goldens.hold} of ${card.goldens.total} goldens) and docs/validity/claims.md (${claims.claims.length} claims)`);
+} finally {
+  await server.close();
+}
+process.exit(0);
