+/**
+ * Small runner shared by the property and convergence checks (properties.test.ts, convergence.test.ts): one headless fast-tier run on a
+ * seeded synthetic terrain, returning copies of what the checks compare. Not imported by application code.
+ */
+import { appendFileSync } from 'node:fs';
+import type { FuelType } from '../../core/types';
+import { burntCount, extentAlong, point, runSim, SLOW, synth, type RunResult } from './harness';
+import type { DrawnCase } from './randomCases';
+
+export const EXTENT = 2400;
+export const CELL = 30;
+export const HOUR = 3600;
+
+/** Seeds of a set: all under SLOW=1, else the first `quick`. */
+export const seeds = (first: number, count: number, quick: number): number[] => Array.from({ length: SLOW ? count : Math.min(count, quick) }, (_, i) => first + i);
+
+export interface Fire {
+  /** Arrival time (s) of every cell, a copy (Infinity = unburnt). */
+  arrival: Float32Array;
+  /** Burnt cells at each 600 s mark. */
+  burnt: number[];
+  headRos: number;
+  burntAreaHa: number;
+  g: RunResult['scenario']['terrain']['grid'];
+  wallS: number;
+}
+
+export interface FireOptions {
+  elevation: (x: number, y: number) => number;
+  ignition: [number, number];
+  windKmh: number;
+  windFromDeg: number;
+  /** Constant dead fuel moisture (percent) with surface heating off, as in the V1 to V5 scenarios (the test hooks); absent = the model's own. */
+  hooks?: { moisture: number };
+  fuelOverride?: (x: number, y: number, k: number) => FuelType | null;
+  until?: number;
+  extent?: number;
+  cellSize?: number;
+  /** Solver step limit (s); absent = automatic. */
+  maxStepS?: number;
+}
+
+/** One headless fast-tier run on a square domain (default 2.4 km, 30 m cells), embers off. */
+export function fire(o: FireOptions): Fire {
+  const until = o.until ?? HOUR;
+  const s = synth({
+    extent: o.extent ?? EXTENT,
+    cellSize: o.cellSize ?? CELL,
+    elevation: o.elevation,
+    windKmh: o.windKmh,
+    windFromDeg: o.windFromDeg,
+    duration: until,
+    ignitions: [point(o.ignition[0], o.ignition[1], 0, 30)],
+    ...(o.fuelOverride ? { fuelOverride: o.fuelOverride } : {}),
+    ...(o.maxStepS ? { options: { maxStepS: o.maxStepS } } : {}),
+  });
+  const burnt: number[] = [];
+  const r = runSim(s, {
+    until,
+    every: 600,
+    keepSnaps: false,
+    ...(o.hooks ? { moisturePct: o.hooks.moisture, heating: false } : {}),
+    onTick: (sim) => burnt.push(burntCount(sim.stateView().fire.arrivalTime, sim.time)),
+  });
+  const st = r.sim.stats();
+  return { arrival: r.sim.stateView().fire.arrivalTime.slice(), burnt, headRos: st.headRos, burntAreaHa: st.burntAreaHa, g: s.terrain.grid, wallS: r.wallS };
+}
+
+export const downwind = (c: DrawnCase): number => (c.windFromDeg + 180) % 360;
+
+/** The farthest burnt cell along the wind-to direction from the ignition at time T (m). */
+export const farthest = (f: Fire, c: DrawnCase, T = HOUR): number => extentAlong(f.g, f.arrival, T, c.ignition[0], c.ignition[1], downwind(c));
+
+/**
+ * Append one measured result (a property's numbers, a golden's summary, a fuzz case) to the JSON-lines file named by
+ * FIRESIM_VALIDITY_OUT, when it is set: the card generator (scripts/validity-card.mjs) reads it. Nothing happens without it.
+ */
+export function record(id: string, data: Record<string, unknown>): void {
+  const out = process.env['FIRESIM_VALIDITY_OUT'];
+  if (out) appendFileSync(out, `${JSON.stringify({ id, ...data })}\n`);
+}
