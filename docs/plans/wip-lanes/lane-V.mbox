+++ b/src/ui/validityCard.test.ts
@@ -0,0 +1,139 @@
+/**
+ * The per-release validation card in "How sure are we?" (0.10.0; src/ui/validityCard.ts, data in src/sim/validation/card.json): every figure on it is
+ * a figure of the data, the words say what the checks compare with and never that the simulation is validated, plural and singular read right, a
+ * known finding and a difference between engines are said, and the card is part of the model card and of its "Copy as text".
+ */
+import { describe, expect, it } from 'vitest';
+import type { CardData } from '../sim/validation/cardData';
+import realCard from '../sim/validation/card.json';
+import { pointIgnition, syntheticScenario } from '../sim/testing/scenarios';
+import { cardToText, describeModel, type CardBlock } from './modelInfo';
+import { DEFAULT_SETTINGS } from './settings';
+import { validityBlocks } from './validityCard';
+
+const base: CardData = {
+  release: '0.10.0',
+  run: { ranAt: '2026-11-08T09:30:00.000Z', node: 'v22.22.0', platform: 'linux x64' },
+  claims: { total: 56, checked: 14, partly: 28, unchecked: 2, knownGap: 12 },
+  properties: { total: 14, hold: 13, findings: 1 },
+  goldens: { total: 6, hold: 6, tiers: ['fast', 'standard'] },
+  fuzz: { cases: 44, findings: 3 },
+  engines: { same: true, scenariosIdentical: 6, scenarios: 6, marks: 19, browser: 'Chromium 143.0', maxRelativePct: 0 },
+  convergence: [
+    { site: 'Katoomba', embers: true, cellsM: [30, 10], hours: 4, areaPct: 10, blocksPct: 82 },
+    { site: 'Katoomba', embers: false, cellsM: [30, 10], hours: 4, areaPct: 52, blocksPct: 67 },
+    { site: 'Warrumbungles', embers: true, cellsM: [30, 10], hours: 2, areaPct: 2, blocksPct: 97 },
+  ],
+  tiers: { headline: 'A sentence about the tiers.' },
+  knownGaps: ['Not validated against recorded fires.', 'Another gap.'],
+};
+
+const strings = (v: unknown, out: string[] = []): string[] => {
+  if (typeof v === 'string') out.push(v);
+  else if (Array.isArray(v)) v.forEach((x) => strings(x, out));
+  else if (v && typeof v === 'object') Object.values(v).forEach((x) => strings(x, out));
+  return out;
+};
+const facts = (b: CardBlock[]): Record<string, { value: string; note?: string }> =>
+  Object.fromEntries(b.flatMap((x) => (x.type === 'facts' ? x.facts.map((f) => [f.id, { value: f.value, ...(f.note ? { note: f.note } : {}) }]) : [])));
+
+describe('validityBlocks: the figures are the data\'s', () => {
+  const blocks = validityBlocks(base);
+  const f = facts(blocks);
+
+  it('says how many properties hold, how many goldens are unchanged, how many stress cases ran, whether the engines agree and how many claims there are', () => {
+    expect(f['val-properties']!.value).toBe('13 of 14 hold');
+    expect(f['val-golden']!.value).toBe('6 of 6 unchanged');
+    expect(f['val-stress']!.value).toBe('44 run');
+    expect(f['val-engines']!.value).toBe('Identical');
+    expect(f['val-claims']!.value).toBe('56');
+    expect(f['val-claims']!.note).toContain('14 checked, 28 partly, 2 not checked, 12 known gaps');
+    expect(f['val-engines']!.note).toContain('all 19 marks');
+    expect(f['val-engines']!.note).toContain('Chromium 143.0');
+    expect(f['val-golden']!.note).toContain('Fast and Standard tiers');
+  });
+
+  it('names the run it comes from by its date', () => {
+    const title = blocks.find((b) => b.type === 'facts')!;
+    expect(title.type === 'facts' && title.title).toBe('Checked for each release (the run of 2026-11-08)');
+  });
+
+  it('gives each grid study line its own figures: which cells, how much more or less area, how many blocks in both', () => {
+    const grid = blocks.find((b) => b.type === 'bullets' && b.title === 'How far a finer grid changes the answer');
+    expect(grid && grid.type === 'bullets' && grid.bullets.map((x) => x.text.replace(/[ ]/g, ' '))).toEqual([
+      'Katoomba, 4 hours, with embers: 10 m cells burn 10 % more area than 30 m cells, and 82 % of the 60 m blocks that either run burnt are burnt in both.',
+      'Katoomba, 4 hours, without embers: 10 m cells burn 52 % more area than 30 m cells, and 67 % of the 60 m blocks that either run burnt are burnt in both.',
+      'Warrumbungles, 2 hours, with embers: 10 m cells burn 2 % more area than 30 m cells, and 97 % of the 60 m blocks that either run burnt are burnt in both.',
+      'Finer cells are a different setting of the same model, not a more accurate one: nothing shows which is closer to a real fire.',
+    ]);
+  });
+
+  it('puts the tier sentence and every known gap on the card, and the warning that nothing was compared with a recorded fire', () => {
+    expect(blocks.some((b) => b.type === 'text' && b.text === 'A sentence about the tiers.')).toBe(true);
+    const gaps = blocks.find((b) => b.type === 'bullets' && b.title === 'Not known');
+    expect(gaps && gaps.type === 'bullets' && gaps.bullets.map((x) => x.text)).toEqual(base.knownGaps);
+    const warn = blocks.find((b) => b.type === 'text' && b.tone === 'warn');
+    expect(warn && warn.type === 'text' && warn.text).toMatch(/None of it compares it with a recorded fire\.$/);
+  });
+
+  it('a negative area difference reads "less", and plural and singular are right', () => {
+    const one = validityBlocks({ ...base, properties: { total: 1, hold: 0, findings: 1 }, goldens: { total: 1, hold: 1, tiers: ['fast'] }, fuzz: { cases: 1, findings: 1 }, convergence: [{ site: 'Somewhere', embers: false, cellsM: [30, 20], hours: 1, areaPct: -7, blocksPct: 90 }] });
+    const g = facts(one);
+    expect(g['val-properties']!.note).toContain('1 case came out just outside the band set beforehand and is kept as a known finding');
+    expect(g['val-golden']!.note).toContain('1 scenario (flat');
+    expect(g['val-golden']!.note).toContain('in the Fast tier');
+    expect(g['val-stress']!.note).toContain('in 1 case (below)');
+    expect(strings(one).join(' ').replace(/ /g, ' ')).toContain('Somewhere, 1 hours, without embers: 20 m cells burn 7 % less area than 30 m cells');
+  });
+
+  it('says so when the engines differ, and when nothing is a finding says nothing of one', () => {
+    const diff = facts(validityBlocks({ ...base, engines: { ...base.engines, same: false, scenariosIdentical: 4, maxRelativePct: 0.12 } }));
+    expect(diff['val-engines']!.value).toBe('4 of 6 identical');
+    expect(diff['val-engines']!.note?.replace(/\u00a0/g, ' ')).toContain('4 gave the same result at every mark, the others differ in the last bits (burnt area, head rate and arrival times agree within 0.12 %)');
+    const clean = facts(validityBlocks({ ...base, properties: { total: 14, hold: 14, findings: 0 }, fuzz: { cases: 44, findings: 0 } }));
+    expect(clean['val-properties']!.note).not.toMatch(/finding/);
+    expect(clean['val-stress']!.note).not.toMatch(/below/);
+  });
+
+  it('never calls the simulation validated, uses no em dash and prints no undefined or NaN', () => {
+    for (const s of strings(blocks)) {
+      expect(s, s).not.toMatch(/undefined|NaN|\[object|—/);
+      expect(s, s).not.toMatch(/(?<!not )\bvalidated\b/i);
+      expect(s.trim().length, s).toBeGreaterThan(0);
+    }
+  });
+});
+
+describe('the validation card is part of "How sure are we?" and of its text', () => {
+  const sc = syntheticScenario({ ignitions: [pointIgnition('a', -300, 0, 0, 60)] });
+  const card = describeModel({ scenario: sc, settings: DEFAULT_SETTINGS });
+  const sure = card.sections.find((s) => s.id === 'sure')!;
+
+  it('comes after the validation summary in the section, with the five facts', () => {
+    const types = sure.blocks.map((b) => b.type);
+    const summary = sure.blocks.findIndex((b) => b.type === 'text' && b.text.startsWith('The validation scenarios of the specification'));
+    expect(summary).toBeGreaterThan(0);
+    const validity = sure.blocks.slice(summary + 1);
+    expect(validity.length).toBeGreaterThanOrEqual(4);
+    expect(types.slice(summary + 1)).toContain('facts');
+    expect(Object.keys(facts(sure.blocks)).filter((k) => k.startsWith('val-')).sort()).toEqual(['val-claims', 'val-engines', 'val-golden', 'val-properties', 'val-stress']);
+  });
+
+  it('is in the Copy as text export with its figures', () => {
+    const text = cardToText(card);
+    expect(text).toContain('Properties that must hold:');
+    expect(text).toContain('How far a finer grid changes the answer');
+    expect(text).toContain('Not known');
+    expect(text).toMatch(/None of it compares it with a recorded fire\./);
+  });
+
+  it('shows the figures of the stored card data (src/sim/validation/card.json), none of them typed in the card\'s words', () => {
+    const real = realCard as unknown as CardData;
+    const f = facts(sure.blocks);
+    expect(f['val-properties']!.value).toBe(`${real.properties.hold} of ${real.properties.total} hold`);
+    expect(f['val-golden']!.value).toBe(`${real.goldens.hold} of ${real.goldens.total} unchanged`);
+    expect(f['val-claims']!.value).toBe(String(real.claims.total));
+    expect(real.claims.checked + real.claims.partly + real.claims.unchecked + real.claims.knownGap).toBe(real.claims.total);
+    expect(real.properties.hold + real.properties.findings).toBeLessThanOrEqual(real.properties.total);
+  });
+});
