index 0000000..346db89
--- /dev/null
+++ b/src/sim/validation/golden/run.ts
@@ -0,0 +1,138 @@
+/**
+ * Runs a golden scenario (specs.ts) headless and summarises it: burnt area and head rate of spread at the marks, arrival-time and ember
+ * landing percentiles, and the snapshot hash at each mark. Used by golden.test.ts, by `npm run golden:update` (scripts/golden-update.mjs,
+ * through Vite) and, for the scenario and the hash only, by the cross-engine e2e (e2e/validity-engines.spec.ts). Not imported by application code.
+ */
+import type { SimSnapshot } from '../../../core/types';
+import { Simulation } from '../../simulation';
+import { snapshotHash } from '../../testing/hash';
+import { quantile } from '../harness';
+import type { GoldenSpec } from './specs';
+
+/**
+ * What the hash leaves out: the wall-clock field, the insights since the last picture and the ember landing layer (they describe the display
+ * window, not the physics: a coalesced or a run-end snapshot differs there), and, always, the engine info (snapshotHash).
+ */
+export const GOLDEN_HASH_SKIP: readonly string[] = ['stats.msPerSimMinute', 'insights', 'layers.landing'];
+
+export interface GoldenRecord {
+  id: string;
+  title: string;
+  tier: string;
+  recordedWith: { node: string; v8: string; platform: string; arch: string };
+  until: number;
+  marks: number[];
+  /** Burnt area (ha) at each mark. */
+  burntAreaHa: number[];
+  /** The "Head fire" figure (SimStats.headRos, km/h) at each mark, and its largest value over the run. */
+  headRosKmh: number[];
+  headRosKmhMax: number;
+  /** Arrival time (s from the start) of the burnt cells at the end: the cell count and the percentiles. */
+  arrival: { cells: number; p10: number; p25: number; p50: number; p75: number; p90: number };
+  /** Weighted travel distance (m) of the ember landings in the domain: the count, the total weight and the percentiles (null when there were none). */
+  emberLanding: { count: number; weight: number; p50: number | null; p90: number | null; p99: number | null };
+  /** snapshotHash (leaving out GOLDEN_HASH_SKIP) at each mark. */
+  hashes: number[];
+  hash: number;
+  /** Relative tolerance on every summary number. 0 = identical (same machine and Node); the cross-engine figure is filled from e2e/validity-engines.spec.ts. */
+  tolerance: { sameEngine: number; crossEngine: number | null };
+}
+
+const weighted = (ev: { d: number; w: number }[], q: number): number | null => {
+  if (!ev.length) return null;
+  const s = [...ev].sort((a, b) => a.d - b.d);
+  const total = s.reduce((a, b) => a + b.w, 0);
+  let c = 0;
+  for (const x of s) {
+    c += x.w;
+    if (c >= q * total) return x.d;
+  }
+  return s[s.length - 1]!.d;
+};
+
+export async function runGolden(spec: GoldenSpec, tolerance: GoldenRecord['tolerance'] = { sameEngine: 0, crossEngine: null }): Promise<GoldenRecord> {
+  const scenario = await spec.build();
+  const marks = new Set(spec.marks);
+  const at = new Map<number, { area: number; head: number; hash: number }>();
+  let headMax = 0;
+  const landings: { d: number; w: number }[] = [];
+  const sim = new Simulation(scenario, {
+    tier: spec.tier,
+    hooks: {
+      snapshot: (s: SimSnapshot) => {
+        headMax = Math.max(headMax, s.stats.headRos * 3.6);
+        if (marks.has(s.time)) at.set(s.time, { area: s.stats.burntAreaHa, head: s.stats.headRos * 3.6, hash: snapshotHash(s, [...GOLDEN_HASH_SKIP]) });
+      },
+    },
+    testHooks: { emberLanding: (ev) => landings.push({ d: ev.travel, w: ev.weight }) },
+  });
+  sim.spinUp();
+  sim.advance(spec.until);
+  const arr: number[] = [];
+  for (const t of sim.stateView().fire.arrivalTime) if (t <= spec.until) arr.push(t);
+  const rows = spec.marks.map((m) => {
+    const r = at.get(m);
+    if (!r) throw new Error(`${spec.id}: no snapshot at the mark ${m} s`);
+    return r;
+  });
+  return {
+    id: spec.id,
+    title: spec.title,
+    tier: spec.tier,
+    recordedWith: { node: process.version, v8: process.versions.v8, platform: process.platform, arch: process.arch },
+    until: spec.until,
+    marks: [...spec.marks],
+    burntAreaHa: rows.map((r) => r.area),
+    headRosKmh: rows.map((r) => r.head),
+    headRosKmhMax: headMax,
+    arrival: { cells: arr.length, p10: quantile(arr, 0.1), p25: quantile(arr, 0.25), p50: quantile(arr, 0.5), p75: quantile(arr, 0.75), p90: quantile(arr, 0.9) },
+    emberLanding: { count: landings.length, weight: landings.reduce((a, b) => a + b.w, 0), p50: weighted(landings, 0.5), p90: weighted(landings, 0.9), p99: weighted(landings, 0.99) },
+    hashes: rows.map((r) => r.hash),
+    hash: rows[rows.length - 1]!.hash,
+    tolerance,
+  };
+}
+
+/** The summary numbers of a record as a flat list (name, value), for comparison and for the diff the update script prints. */
+export function summaryOf(r: GoldenRecord): [string, number | null][] {
+  return [
+    ...r.marks.map((m, i): [string, number] => [`burntAreaHa@${m}s`, r.burntAreaHa[i]!]),
+    ...r.marks.map((m, i): [string, number] => [`headRosKmh@${m}s`, r.headRosKmh[i]!]),
+    ['headRosKmhMax', r.headRosKmhMax],
+    ['arrival.cells', r.arrival.cells],
+    ['arrival.p10', r.arrival.p10],
+    ['arrival.p25', r.arrival.p25],
+    ['arrival.p50', r.arrival.p50],
+    ['arrival.p75', r.arrival.p75],
+    ['arrival.p90', r.arrival.p90],
+    ['emberLanding.count', r.emberLanding.count],
+    ['emberLanding.weight', r.emberLanding.weight],
+    ['emberLanding.p50', r.emberLanding.p50],
+    ['emberLanding.p90', r.emberLanding.p90],
+    ['emberLanding.p99', r.emberLanding.p99],
+  ];
+}
+
+/** Whether a stored record was written by this Node on this kind of machine (the hash is then expected to be identical, not just close). */
+export const sameEngineAs = (r: GoldenRecord): boolean => r.recordedWith.platform === process.platform && r.recordedWith.arch === process.arch && r.recordedWith.node.split('.')[0] === process.version.split('.')[0];
+
+/** What differs between a stored and a fresh record: the hashes (exact, on the same engine) and every summary number beyond `tolerance` (relative). */
+export function differences(stored: GoldenRecord, fresh: GoldenRecord, tolerance = stored.tolerance.sameEngine): string[] {
+  const out: string[] = [];
+  const a = summaryOf(stored);
+  const b = summaryOf(fresh);
+  if (a.length !== b.length) out.push(`the summary has ${b.length} entries, the stored one ${a.length}`);
+  for (let i = 0; i < Math.min(a.length, b.length); i++) {
+    const [name, x] = a[i]!;
+    const y = b[i]![1];
+    if (x === y) continue;
+    if (x === null || y === null) {
+      out.push(`${name}: ${x} stored, ${y} now`);
+      continue;
+    }
+    const rel = Math.abs(y - x) / Math.max(Math.abs(x), 1e-12);
+    if (rel > tolerance) out.push(`${name}: ${x} stored, ${y} now (${(100 * (y - x) / (x || 1)).toFixed(4)} percent, tolerance ${100 * tolerance} percent)`);
+  }
+  if (sameEngineAs(stored)) stored.hashes.forEach((h, i) => h !== fresh.hashes[i] && out.push(`snapshot hash at ${stored.marks[i]} s: ${h} stored, ${fresh.hashes[i]} now`));
+  return out;
+}
diff --git a/src/sim/validation/golden/specs.ts b/src/sim/validation/golden/specs.ts
