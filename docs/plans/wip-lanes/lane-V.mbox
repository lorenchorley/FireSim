+/**
+ * The claims register (claims.json; plan 15d idea 2): a claim may only say what its checks allow. Every check it names is a real test
+ * (a file that exists with a describe, it or test of that title), its status does not claim more than its checks allow, the register
+ * covers every row of the model card, every open issue of the specification that the card quotes and every kind of insight card, every
+ * pass mark of passMarks.json is used, and the two things made from it (docs/validity/claims.md and the card's data, card.json) are what
+ * the register and the measured results produce today. Regenerate them with `node scripts/validity-card.mjs`.
+ */
+import { readFileSync } from 'node:fs';
+import { describe, expect, it } from 'vitest';
+import { describeModel, SPEC_OPEN_ISSUES } from '../../ui/modelInfo';
+import { DEFAULT_SETTINGS } from '../../ui/settings';
+import { pointIgnition, syntheticScenario } from '../testing/scenarios';
+import { buildCard, checkProblem, claimProblems, claimsMarkdown, goldenFiles, loadClaims, loadSources, rel, STATUSES } from './claimsKit';
+import marksFile from './passMarks.json';
+
+const claims = loadClaims();
+
+describe('claims register: the entries are sound', () => {
+  it('every claim has its fields, a known status, checks that exist, and no status that says more than the checks allow', () => {
+    expect(claimProblems(claims, Object.keys(marksFile.marks))).toEqual([]);
+  });
+
+  it('a check that does not exist is found (the test of the test)', () => {
+    expect(checkProblem({ file: 'src/sim/validation/properties.test.ts', title: 'P-rotation' })).toBeNull();
+    expect(checkProblem({ file: 'src/sim/validation/properties.test.ts', title: 'a test nobody wrote' })).toMatch(/no describe, it or test/);
+    expect(checkProblem({ file: 'src/sim/validation/nothing.test.ts', title: 'x' })).toMatch(/does not exist/);
+    const bad = { ...claims, claims: [{ ...claims.claims[0]!, checks: [{ file: 'src/sim/validation/slope.test.ts', title: 'no such title' }] }] };
+    expect(claimProblems(bad, Object.keys(marksFile.marks)).join(' ')).toMatch(/no describe, it or test/);
+    const over = { ...claims, claims: [{ ...claims.claims[0]!, status: 'checked' as const, checks: [], measurements: [] }] };
+    expect(claimProblems(over, Object.keys(marksFile.marks)).join(' ')).toMatch(/needs at least one test/);
+  });
+
+  it('the statuses are the four named and each is described', () => {
+    expect(Object.keys(claims.statuses).sort()).toEqual([...STATUSES].sort());
+    for (const c of claims.claims) expect(STATUSES).toContain(c.status);
+  });
+
+  it('a known gap that the card words has its plain-words line, and no claim is checked without a pass mark', () => {
+    for (const c of claims.claims) {
+      if (c.status === 'checked') expect(c.passMark.trim().length, c.id).toBeGreaterThan(0);
+      if (c.cardLine) {
+        expect(c.status, c.id).toBe('known gap');
+        expect(c.cardLine, c.id).not.toMatch(/—|\{\{/);
+      }
+    }
+  });
+
+  it('every pass mark of passMarks.json is used by a claim (none is written and then forgotten)', () => {
+    const used = new Set(claims.claims.flatMap((c) => c.passMarkId?.split('+') ?? []));
+    for (const id of Object.keys(marksFile.marks)) expect(used.has(id), `passMarks.json ${id} is used by no claim`).toBe(true);
+  });
+});
+
+describe('claims register: it covers what the app shows', () => {
+  const sc = syntheticScenario({ ignitions: [pointIgnition('a', -300, 0, 0, 60)] });
+  const card = describeModel({ scenario: sc, settings: DEFAULT_SETTINGS });
+
+  it('every row of the model card (At a glance) is the subject of a claim', () => {
+    const rows = card.sections.find((s) => s.id === 'glance')!.blocks.flatMap((b) => (b.type === 'rows' ? b.rows.map((r) => r.id) : []));
+    expect(rows.length).toBeGreaterThanOrEqual(12);
+    for (const id of rows) expect(claims.claims.some((c) => new RegExp(`row ${id}\\b`).test(c.shownIn)), `no claim shown in row ${id}`).toBe(true);
+  });
+
+  it('every open issue the card quotes (spec section 16) is in a claim', () => {
+    const items = new Set(claims.claims.flatMap((c) => c.specItems ?? []));
+    for (const i of SPEC_OPEN_ISSUES) expect(items.has(i.item), `section 16 item ${i.item}`).toBe(true);
+  });
+
+  it('every kind of insight card is in a claim', () => {
+    const src = readFileSync(rel('src/core/types.ts'), 'utf8');
+    const union = /export type InsightKind =([\s\S]*?);/.exec(src)![1]!;
+    const kinds = [...union.matchAll(/'([a-z-]+)'/g)].map((m) => m[1]!);
+    expect(kinds.length).toBeGreaterThanOrEqual(30);
+    const covered = new Set(claims.claims.flatMap((c) => c.insightKinds ?? []));
+    for (const k of kinds) expect(covered.has(k), `insight kind ${k}`).toBe(true);
+    for (const k of covered) expect(kinds, `${k} is not an insight kind`).toContain(k);
+  });
+
+  it('the register says plainly what no check compares with a recorded fire', () => {
+    const gaps = claims.claims.filter((c) => c.status === 'known gap' && /recorded fires/.test(c.cardLine ?? ''));
+    expect(gaps.length).toBeGreaterThanOrEqual(1);
+    expect(claims.claims.some((c) => /recorded fire/i.test(c.knownError))).toBe(true);
+  });
+});
+
+describe('claims register: what is made from it is current', () => {
+  it('docs/validity/claims.md is the page claims.json makes (node scripts/validity-card.mjs)', () => {
+    expect(readFileSync(rel('docs/validity/claims.md'), 'utf8')).toBe(claimsMarkdown(claims, loadSources()));
+  });
+
+  it('card.json is the card the register and the measured results make (node scripts/validity-card.mjs)', () => {
+    const src = loadSources();
+    const ids = goldenFiles();
+    const golden = ids.map((id) => JSON.parse(readFileSync(rel(`src/sim/validation/golden/${id}.json`), 'utf8')) as { tier: string });
+    expect(JSON.parse(readFileSync(rel('src/sim/validation/card.json'), 'utf8'))).toEqual(JSON.parse(JSON.stringify(buildCard(claims, src, ids, golden))));
+  });
+
+  it('the run behind the figures names the tests the card counts, and every golden scenario', () => {
+    const src = loadSources();
+    const titles = src.run.tests.map((t) => t.title);
+    for (const id of goldenFiles()) expect(src.run.tests.some((t) => t.fullName.includes('a run gives the stored summary and snapshot hash') && t.title.startsWith(`${id}:`)), `no golden test of ${id} in the run`).toBe(true);
+      expect(src.run.tests.some((t) => t.fullName.includes('message loop') && t.title.startsWith(`${id}:`)), `no host-path control of ${id} in the run`).toBe(true);
+    expect(src.run.tests.filter((t) => t.title.startsWith('P-')).length).toBeGreaterThanOrEqual(10);
+    // The run is a full SLOW run: nothing the card counts was skipped.
+    for (const t of src.run.tests.filter((x) => /golden\.test\.ts$|properties\.test\.ts$|convergence\.test\.ts$/.test(x.file) && x.title.startsWith('P-'))) expect(t.status, t.title).not.toBe('skipped');
+  });
+});
diff --git a/src/sim/validation/claimsKit.ts b/src/sim/validation/claimsKit.ts
new file mode 100644
index 0000000..e43b76e
--- /dev/null
+++ b/src/sim/validation/claimsKit.ts
@@ -0,0 +1,264 @@
+/**
+ * The claims register as data (claims.json) and what is made from it: the page docs/validity/claims.md, the figures filled into known errors,
+ * the per-release card (card.json) and the checks that a register entry says something true about its checks. Pure functions over plain
+ * data, shared by claims.test.ts and scripts/validity-card.mjs. Not imported by application code.
+ */
+import { existsSync, readFileSync, readdirSync } from 'node:fs';
+import { dirname, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import type { CardData } from './cardData';
+
+export const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '../../..');
+export const rel = (...p: string[]): string => resolve(ROOT, ...p);
+
+export type ClaimStatus = 'checked' | 'partly' | 'unchecked' | 'known gap';
+export const STATUSES: readonly ClaimStatus[] = ['checked', 'partly', 'unchecked', 'known gap'];
+
+export interface Check {
+  file: string;
+  /** A fragment of the title of a describe, it or test in the file. */
+  title: string;
+}
+
+export interface Claim {
+  id: string;
+  area: string;
+  claim: string;
+  shownIn: string;
+  source: string;
+  comparedWith: string;
+  checks: Check[];
+  /** A measurement stored in a file (not a test that re-runs). */
+  measurements: { file: string; what: string }[];
+  passMark: string;
+  passMarkSet: 'with the existing check' | 'before the check ran' | 'after measuring' | 'none';
+  /** The pass mark(s) of passMarks.json this claim's check was held to; several joined with '+'. */
+  passMarkId?: string;
+  knownError: string;
+  status: ClaimStatus;
+  note: string;
+  /** The plain words the card shows for a known gap. */
+  cardLine?: string;
+  insightKinds?: string[];
+  specItems?: number[];
+}
+
+export interface ClaimsFile {
+  about: string;
+  scope: string;
+  statuses: Record<ClaimStatus, string>;
+  claims: Claim[];
+}
+
+const readJson = <T>(...p: string[]): T => JSON.parse(readFileSync(rel(...p), 'utf8')) as T;
+
+export const loadClaims = (): ClaimsFile => readJson<ClaimsFile>('src/sim/validation/claims.json');
+
+// ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────
+// The data files a known error or the card reads
+// ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────
+
+export interface RunFile {
+  ranAt: string;
+  node: string;
+  platform: string;
+  command: string;
+  /** The tests of the run (from the vitest JSON report). */
+  tests: { file: string; title: string; fullName: string; status: 'passed' | 'failed' | 'skipped' }[];
+  /** What the checks measured (FIRESIM_VALIDITY_OUT): by record id; an id recorded more than once is a list. */
+  measures: Record<string, Record<string, unknown> | Record<string, unknown>[]>;
+}
+
+export interface TiersFile {
+  headline: string;
+  [k: string]: unknown;
+}
+
+export interface CrossEngineFile {
+  summary: string;
+  [k: string]: unknown;
+}
+
+export interface Sources {
+  run: RunFile;
+  conv: Record<string, { pairs: { a: string; b: string; areaRatioAtEnd: number; jaccard: number; arrivalErrorMinAbs: { p50: number; p90: number } }[] }>;
+  tiers: TiersFile;
+  engines: CrossEngineFile;
+  sweep: { fast: SweepPart; standard: SweepPart };
+}
+
+export interface SweepPart {
+  from: number;
+  cases: number;
+  snapshots: number;
+  casesWithProblems: number;
+  f1Count: number;
+  f1Seeds: number[];
+}
+
+export function loadSources(): Sources {
+  return {
+    run: readJson<RunFile>('src/sim/validation/results/validity-run.json'),
+    conv: readJson<Sources['conv']>('studies/desktop-simulation/01-cost-vs-detail/data/convergence-diff.json'),
+    tiers: readJson<TiersFile>('studies/simulation-validity/tiers/summary.json'),
+    engines: readJson<CrossEngineFile>('src/sim/validation/results/cross-engine.json'),
+    sweep: readJson<Sources['sweep']>('src/sim/validation/results/fuzz-sweep.json'),
+  };
+}
+
+const pick = (obj: unknown, path: string[]): unknown => path.reduce<unknown>((o, k) => (o && typeof o === 'object' ? (o as Record<string, unknown>)[k] : undefined), obj);
+
+/** One placeholder's value: `run:ID.field`, `conv:set.A-B.areaPct|jaccardPct`, `tiers:path`, `engines:path`, `sweep:path`; a format after `|` (`pct`, `d2`). */
+export function figure(ref: string, src: Sources): string {
+  const [spec, fmt] = ref.split('|');
+  const [kind, path] = [spec!.slice(0, spec!.indexOf(':')), spec!.slice(spec!.indexOf(':') + 1)];
+  let v: unknown;
+  if (kind === 'run') {
+    const dot = path.indexOf('.');
+    const rec = src.run.measures[path.slice(0, dot)];
+    v = Array.isArray(rec) ? rec.map((r) => pick(r, path.slice(dot + 1).split('.'))) : pick(rec, path.slice(dot + 1).split('.'));
+  } else if (kind === 'conv') {
+    const [set, pair, what] = path.split('.');
+    const [a, b] = pair!.split('-');
+    const p = src.conv[set!]?.pairs.find((x) => x.a === a && x.b === b);
+    if (!p) throw new Error(`no pair ${pair} in ${set}`);
+    v = what === 'areaPct' ? Math.round((p.areaRatioAtEnd - 1) * 100) : what === 'jaccardPct' ? Math.round(p.jaccard * 100) : undefined;
+  } else if (kind === 'tiers') v = pick(src.tiers, path.split('.'));
+  else if (kind === 'engines') v = pick(src.engines, path.split('.'));
+  else if (kind === 'sweep') v = pick(src.sweep, path.split('.'));
+  if (v === undefined || v === null) throw new Error(`no figure for {{${ref}}}`);
+  if (typeof v === 'number') {
+    if (fmt === 'pct') return `${v >= 0 ? '+' : ''}${(v * 100).toFixed(1)} percent`;
+    if (fmt?.startsWith('d')) return v.toFixed(Number(fmt.slice(1)));
+    return String(v);
+  }
+  return String(v);
+}
+
+/** Fills `{{ref}}` placeholders. */
+export const fill = (text: string, src: Sources): string => text.replace(/\{\{([^}]+)\}\}/g, (_, ref: string) => figure(ref, src));
+
+// ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────
+// Does what a claim says about its checks hold?
+// ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────
+
+/** Whether a check names a real test: the file exists and a describe, it or test call in it has the title fragment. */
+export function checkProblem(c: Check): string | null {
+  const path = rel(c.file);
+  if (!existsSync(path)) return `${c.file} does not exist`;
+  if (!c.title) return `${c.file}: no title`;
+  const lines = readFileSync(path, 'utf8').split('\n');
+  const found = lines.some((l) => /\b(describe|it|test)\b/.test(l) && l.includes(c.title));
+  return found ? null : `${c.file}: no describe, it or test with the title fragment "${c.title}"`;
+}
+
+export function claimProblems(f: ClaimsFile, passMarkIds: string[]): string[] {
+  const out: string[] = [];
+  const ids = new Set<string>();
+  for (const c of f.claims) {
+    const at = (m: string): void => void out.push(`${c.id}: ${m}`);
+    if (ids.has(c.id)) at('duplicate id');
+    ids.add(c.id);
+    for (const k of ['area', 'claim', 'shownIn', 'source', 'comparedWith', 'passMark', 'knownError'] as const) if (!c[k]?.trim()) at(`empty ${k}`);
+    if (!STATUSES.includes(c.status)) at(`unknown status ${c.status}`);
+    for (const k of c.checks) {
+      const p = checkProblem(k);
+      if (p) at(p);
+    }
+    for (const m of c.measurements) if (!existsSync(rel(m.file))) at(`measurement ${m.file} does not exist`);
+    const evidence = c.checks.length + c.measurements.length;
+    if (c.status === 'checked' && c.checks.length === 0) at('status checked needs at least one test');
+    if (c.status === 'partly' && evidence === 0) at('status partly needs a test or a measurement');
+    if (c.status === 'unchecked' && evidence > 0) at('status unchecked but it names checks');
+    if (c.checks.length === 0 && c.passMarkSet !== 'none' && c.measurements.length === 0) at('no check, so no pass mark can have been set');
+    for (const id of c.passMarkId?.split('+') ?? []) if (!passMarkIds.includes(id)) at(`pass mark ${id} is not in passMarks.json`);
+    if (c.passMarkSet === 'before the check ran' && !c.passMarkId) at('a pre-registered pass mark must name its id in passMarks.json');
+    if (c.status === 'known gap' && !c.note.trim() && !c.knownError.trim()) at('a known gap says what is not known');
+  }
+  return out;
+}
+
+// ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────
+// The page docs/validity/claims.md
+// ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────
+
+const cell = (s: string): string => s.replace(/\|/g, '\\|').replace(/\n/g, ' ');
+
+export function claimsMarkdown(f: ClaimsFile, src: Sources): string {
+  const count = (s: ClaimStatus): number => f.claims.filter((c) => c.status === s).length;
+  const lines: string[] = [
+    '# Claims register',
+    '',
+    '<!-- Generated by scripts/validity-card.mjs from src/sim/validation/claims.json. Do not edit by hand: edit the JSON and run the script. -->',
+    '',
+    fill(f.about, src),
+    '',
+    `**Scope.** ${f.scope}`,
+    '',
+    `**${f.claims.length} claims:** ${count('checked')} checked, ${count('partly')} partly, ${count('unchecked')} unchecked, ${count('known gap')} known gaps. **Nothing in this register has been compared with a recorded fire.** Every "checked" is a check against a formula, a published rule of thumb or a property; \`comparedWith\` says which.`,
+    '',
+    '## What the statuses mean',
+    '',
+    ...STATUSES.map((s) => `- **${s}**: ${f.statuses[s]}`),
+    '',
+    '## The register',
+    '',
+    '| Id | Status | Claim | Shown in | Source | Compared with | Check (a test: file, title) | Pass mark (when set) | Known error |',
+    '|---|---|---|---|---|---|---|---|---|',
+  ];
+  for (const c of f.claims) {
+    const checks = [...c.checks.map((k) => `\`${k.file}\`: ${k.title || '(the file)'}`), ...c.measurements.map((m) => `measurement \`${m.file}\`: ${m.what}`)];
+    lines.push(
+      `| ${c.id} | ${c.status} | ${cell(c.claim)} | ${cell(c.shownIn)} | ${cell(c.source)} | ${cell(c.comparedWith)} | ${checks.length ? cell(checks.join('<br>')) : '**none**'} | ${cell(c.passMark)} (${c.passMarkSet}${c.passMarkId ? `: passMarks.json ${c.passMarkId}` : ''}) | ${cell(fill(c.knownError, src))}${c.note ? ` ${cell(fill(c.note, src))}` : ''} |`,
+    );
+  }
+  const kinds = f.claims.flatMap((c) => c.insightKinds ?? []);
+  lines.push('', '## Insight card kinds covered', '', kinds.length ? kinds.map((k) => `\`${k}\``).join(', ') : 'none', '', '## Open issues of the specification covered (section 16)', '', f.claims.flatMap((c) => c.specItems ?? []).join(', '), '');
+  return `${lines.join('\n')}\n`;
+}
+
+// ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────
+// The per-release card (card.json): the words are code (src/ui/validityCard.ts), the figures are here
+// ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────
+
+export type { CardData };
+
+const PROPERTY_FILES = ['src/sim/validation/properties.test.ts', 'src/sim/validation/convergence.test.ts'];
+const FINDING = '[known finding';
+
+export function buildCard(f: ClaimsFile, src: Sources, goldenIds: string[], golden: { tier: string }[]): CardData {
+  const t = src.run.tests;
+  const props = t.filter((x) => PROPERTY_FILES.includes(x.file) && x.title.startsWith('P-') && x.status !== 'skipped');
+  const findings = props.filter((x) => x.title.includes(FINDING)).length;
+  const gt = t.filter((x) => x.file.endsWith('golden/golden.test.ts') && x.fullName.includes('a run gives the stored summary and snapshot hash') && goldenIds.some((id) => x.title.startsWith(`${id}:`)) && x.status !== 'skipped');
+  const count = (s: ClaimStatus): number => f.claims.filter((c) => c.status === s).length;
+  const fz = [src.run.measures['F-fuzz-fast'], src.run.measures['F-fuzz-standard']].flatMap((r) => (r && !Array.isArray(r) ? [r] : []));
+  // The SLOW run's fast cases (1001 to 1040) and the long sweep's (3001 to 3500) are different seeds; the sweep's standard seeds (2001 to 2020) include the run's four.
+  const runFast = fz.find((r) => r['from'] === 1001);
+  const cases = Number(runFast?.['cases'] ?? 0) + src.sweep.fast.cases + src.sweep.standard.cases;
+  const f1 = ((runFast?.['knownFindingF1Seeds'] as number[] | undefined)?.length ?? 0) + src.sweep.fast.f1Count + src.sweep.standard.f1Count;
+  const ce = src.engines as unknown as { same: boolean; scenariosIdentical: number; scenarios: number; marks: number; browser: string; maxRelative: number };
+  const pair = (set: string, a: string, b: string): { areaPct: number; blocksPct: number } => {
+    const p = src.conv[set]?.pairs.find((x) => x.a === a && x.b === b);
+    if (!p) throw new Error(`no pair ${a}-${b} in ${set}`);
+    return { areaPct: Math.round((p.areaRatioAtEnd - 1) * 100), blocksPct: Math.round(p.jaccard * 100) };
+  };
+  return {
+    release: '0.10.0',
+    run: { ranAt: src.run.ranAt, node: src.run.node, platform: src.run.platform },
+    claims: { total: f.claims.length, checked: count('checked'), partly: count('partly'), unchecked: count('unchecked'), knownGap: count('known gap') },
+    properties: { total: props.length, hold: props.filter((x) => x.status === 'passed' && !x.title.includes(FINDING)).length, findings },
+    goldens: { total: gt.length, hold: gt.filter((x) => x.status === 'passed').length, tiers: [...new Set(golden.map((g) => g.tier))] },
+    fuzz: { cases, findings: f1 },
+    engines: { same: !!ce.same, scenariosIdentical: Number(ce.scenariosIdentical), scenarios: Number(ce.scenarios), marks: Number(ce.marks), browser: String(ce.browser), maxRelativePct: Math.round(Number(ce.maxRelative) * 1e4) / 100 },
+    convergence: [
+      { site: 'Katoomba', embers: true, cellsM: [30, 10], hours: 4, ...pair('kat6', 'L30', 'L10') },
+      { site: 'Katoomba', embers: false, cellsM: [30, 10], hours: 4, ...pair('kat6NoEmbers', 'LN30', 'LN10') },
+      { site: 'Warrumbungles', embers: true, cellsM: [30, 10], hours: 2, ...pair('war6', 'W30', 'W10') },
+    ],
+    tiers: { headline: src.tiers.headline },
+    knownGaps: f.claims.filter((c) => c.status === 'known gap' && c.cardLine).map((c) => fill(c.cardLine!, src)),
+  };
+}
+
+export const goldenFiles = (): string[] => readdirSync(rel('src/sim/validation/golden')).filter((n) => n.endsWith('.json')).map((n) => n.replace(/\.json$/, ''));
