+/**
+ * The cross-engine check's two helpers (engines.ts): a scenario survives the trip to a browser page as bytes (every typed array and number as it
+ * was, down to NaN and -0), and the page's fingerprint code, which is source text, gives exactly the numbers of src/sim/testing/hash.ts.
+ */
+import { describe, expect, it } from 'vitest';
+import type { ScenarioData, SimSnapshot } from '../../../core/types';
+import { Simulation } from '../../simulation';
+import { snapshotHash, snapshotPartHashes } from '../../testing/hash';
+import { difference } from '../../testing/compare';
+import { GOLDEN_HASH_SKIP } from './run';
+import { REVIVE_SOURCE, pageHasher, serializeScenario } from './engines';
+import { point, synth } from '../harness';
+
+const revive = (0, eval)(REVIVE_SOURCE) as (v: unknown, buf: ArrayBuffer) => unknown;
+
+describe('serializeScenario and the page reviver', () => {
+  it('a scenario comes back as it was: typed arrays bit for bit, NaN, Infinity and -0 kept, nothing lost', () => {
+    const sc = synth({ extent: 900, windKmh: 15, ignitions: [point(0, 0, 0, 30)], edits: [{ kind: 'windDirection', id: 'w', dir: 180, time: 600 }] });
+    const { json, blob } = serializeScenario(sc);
+    const back = revive(JSON.parse(JSON.stringify(json)), blob.buffer.slice(blob.byteOffset, blob.byteOffset + blob.byteLength) as ArrayBuffer) as ScenarioData;
+    expect(difference(sc, back)).toBeNull();
+    const odd = serializeScenario({ a: [NaN, Infinity, -Infinity, -0, 1.5], b: new Float64Array([NaN, -0]), c: undefined, d: 'x' });
+    const o = revive(JSON.parse(JSON.stringify(odd.json)), odd.blob.buffer.slice(0) as ArrayBuffer) as { a: number[]; b: Float64Array; d: string };
+    expect(Object.is(o.a[0], NaN) && o.a[1] === Infinity && o.a[2] === -Infinity && Object.is(o.a[3], -0) && o.a[4] === 1.5).toBe(true);
+    expect(Object.is(o.b[0], NaN) && Object.is(o.b[1], -0)).toBe(true);
+    expect(o.d).toBe('x');
+  });
+
+  it('refuses what an engine input must not contain', () => {
+    expect(() => serializeScenario({ f: () => 1 })).toThrow(/function/);
+    expect(() => serializeScenario({ m: new Map() })).toThrow(/Map/);
+  });
+});
+
+describe('the page fingerprint is snapshotHash', () => {
+  it('hash and part hashes equal src/sim/testing/hash.ts on snapshots of a short fire (same skip list)', () => {
+    const snaps: SimSnapshot[] = [];
+    const sim = new Simulation(synth({ extent: 1500, windKmh: 25, duration: 1200, ignitions: [point(-200, 0, 0, 40)], options: { embers: true, maxEmbers: 500, seed: 7 } }), { tier: 'fast', hooks: { snapshot: (s) => snaps.push(s) } });
+    sim.spinUp();
+    sim.advance(900);
+    expect(snaps.length).toBeGreaterThan(5);
+    const h = pageHasher();
+    for (const s of snaps.filter((_, i) => i % 4 === 0)) {
+      expect(h.hash(s, GOLDEN_HASH_SKIP)).toBe(snapshotHash(s, [...GOLDEN_HASH_SKIP]));
+      expect(h.hash(s, ['stats.msPerSimMinute'])).toBe(snapshotHash(s));
+      expect(h.parts(s, ['stats.msPerSimMinute'])).toEqual(snapshotPartHashes(s));
+    }
+    // It tells a different snapshot from this one.
+    expect(h.hash(snaps[2]!, GOLDEN_HASH_SKIP)).not.toBe(h.hash(snaps[3]!, GOLDEN_HASH_SKIP));
+  });
+});
