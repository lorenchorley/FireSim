index 0000000..1e136e9
--- /dev/null
+++ b/src/sim/validation/golden/specs.ts
@@ -0,0 +1,112 @@
+/**
+ * The golden scenarios (plan 15d idea 3; contract 0.10.0, 4.3 item 2): a small fixed set whose summaries are stored in `golden/*.json` and
+ * compared at every release, so that a change in results (decision D23) is measured and explained, not discovered. Determinism (V18)
+ * makes this cheap. A scenario here is a name and a recipe; what a run is summarised into is `run.ts`. Change a recipe, or the
+ * solver's results, and the test fails until `npm run golden:update` has rewritten the file and the commit says why.
+ *
+ *   flat-uniform           flat ground, uniform dry forest, a 20 km/h westerly, one point ignition
+ *   uniform-slope-15       the same on a 15 degree slope rising to the east (wind and slope aligned)
+ *   ridge                  a symmetric 25 degree ridge of 300 m across a 20 km/h westerly, a fire line at its windward base
+ *   wind-change            flat, a 36 km/h westerly, the wind turns to come from the south at 20 minutes (the Wind direction edit)
+ *   katoomba-v20-fast      the V20 preset (hot north-westerly, change two hours in) at Katoomba, 6 km, from the escarpment, 1 h, Fast tier
+ *   katoomba-v20-standard  the same in the Standard tier (the 3-D air)
+ * Embers are on in all of them (seed 7 on the synthetic ones, 1 on Katoomba) so that the landing percentiles say something.
+ */
+import type { QualityTier, ScenarioData } from '../../../core/types';
+import { demoScenario, pointIgnition, withIgnitions } from '../../testing/scenarios';
+import { DEG, line, point, synth } from '../harness';
+
+export interface GoldenSpec {
+  id: string;
+  title: string;
+  tier: QualityTier;
+  /** Simulated seconds run; the last mark. */
+  until: number;
+  /** Times (s) at which the summaries and the snapshot hash are taken; multiples of the 60 s display step. */
+  marks: number[];
+  /** Slow to build or run: under SLOW=1 only. */
+  slow: boolean;
+  build(): Promise<ScenarioData> | ScenarioData;
+}
+
+const emberOptions = { embers: true, maxEmbers: 1500, seed: 7 } as const;
+
+export const GOLDEN_SPECS: readonly GoldenSpec[] = [
+  {
+    id: 'flat-uniform',
+    title: 'Flat ground, uniform dry forest, 20 km/h westerly, one point ignition, 1 h, Fast tier',
+    tier: 'fast',
+    until: 3600,
+    marks: [600, 1800, 3600],
+    slow: false,
+    build: () => synth({ extent: 3000, windKmh: 20, windFromDeg: 270, duration: 3600, ignitions: [point(-600, 0, 0, 45)], options: emberOptions }),
+  },
+  {
+    id: 'uniform-slope-15',
+    title: 'A 15 degree slope rising to the east, 20 km/h westerly (wind and slope aligned), one point ignition, 1 h, Fast tier',
+    tier: 'fast',
+    until: 3600,
+    marks: [600, 1800, 3600],
+    slow: false,
+    build: () => synth({ extent: 3000, elevation: (x) => 500 + Math.tan(15 * DEG) * x, windKmh: 20, windFromDeg: 270, duration: 3600, ignitions: [point(-600, 0, 0, 45)], options: emberOptions }),
+  },
+  {
+    id: 'ridge',
+    title: 'A symmetric 25 degree ridge of 300 m across a 20 km/h westerly, a fire line at its windward base, 2 h, Fast tier',
+    tier: 'fast',
+    until: 7200,
+    marks: [1800, 3600, 7200],
+    slow: false,
+    build: () =>
+      synth({
+        extent: 4000,
+        elevation: (x) => 500 + Math.max(0, 300 - Math.tan(25 * DEG) * Math.abs(x)),
+        windKmh: 20,
+        windFromDeg: 270,
+        duration: 7200,
+        ignitions: [line([[-750, -600], [-750, 600]])],
+        options: emberOptions,
+      }),
+  },
+  {
+    id: 'wind-change',
+    title: 'Flat, 36 km/h westerly turning to come from the south at 20 minutes (a Wind direction change), one point ignition, 1 h, Fast tier',
+    tier: 'fast',
+    until: 3600,
+    marks: [600, 1200, 1800, 3600],
+    slow: false,
+    build: () =>
+      synth({
+        extent: 3000,
+        windKmh: 36,
+        windFromDeg: 270,
+        duration: 3600,
+        ignitions: [point(-600, 0, 0, 60)],
+        edits: [{ kind: 'windDirection', id: 'south', dir: 180, time: 1200 }],
+        options: emberOptions,
+      }),
+  },
+  {
+    id: 'katoomba-v20-fast',
+    title: 'Katoomba, the V20 preset (hot north-westerly, the change two hours in), 6 km, from the escarpment, 1 h, Fast tier',
+    tier: 'fast',
+    until: 3600,
+    marks: [600, 1800, 3600],
+    slow: false,
+    build: () => katoomba('fast'),
+  },
+  {
+    id: 'katoomba-v20-standard',
+    title: 'Katoomba, the V20 preset, 6 km, from the escarpment, 1 h, Standard tier (3-D air)',
+    tier: 'standard',
+    until: 3600,
+    marks: [600, 1800, 3600],
+    slow: true,
+    build: () => katoomba('standard'),
+  },
+];
+
+async function katoomba(tier: QualityTier): Promise<ScenarioData> {
+  const base = await demoScenario({ site: 'katoomba', preset: 'hot-nw-sw-change', startCivil: [2025, 12, 20, 14], duration: 4 * 3600, extent: 6000, tier, options: { seed: 1 } });
+  return withIgnitions(base, [pointIgnition('escarpment', -2170, 900, 0, 60)]);
+}
