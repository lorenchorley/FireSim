+/**
+ * The shape of card.json, the per-release validation card's data (made by scripts/validity-card.mjs from the claims register, the golden
+ * files, the measured run and the studies; read by src/ui/validityCard.ts). Types only: the app's lazy chunk imports this file, so it
+ * must not import node modules.
+ */
+export interface CardData {
+  release: string;
+  /** When the run behind the figures was made, and where. */
+  run: { ranAt: string; node: string; platform: string };
+  claims: { total: number; checked: number; partly: number; unchecked: number; knownGap: number };
+  /** Properties that must hold: how many were run, how many hold, how many are a pinned known finding. */
+  properties: { total: number; hold: number; findings: number };
+  goldens: { total: number; hold: number; tiers: string[] };
+  /** Random stress cases run, and how many show the one known finding (F1). */
+  fuzz: { cases: number; findings: number };
+  /** The same golden scenarios in Node and in a browser worker: how many gave the same snapshot hash at every mark, and how far the rest differ (percent). */
+  engines: { same: boolean; scenariosIdentical: number; scenarios: number; marks: number; browser: string; maxRelativePct: number };
+  /** Cells of the first size against the second on a bundled site (the 4 h study of the desktop work), area and block overlap in percent. */
+  convergence: { site: string; embers: boolean; cellsM: [number, number]; hours: number; areaPct: number; blocksPct: number }[];
+  tiers: { headline: string };
+  /** The known gaps in plain words (from the register's cardLine). */
+  knownGaps: string[];
+}
