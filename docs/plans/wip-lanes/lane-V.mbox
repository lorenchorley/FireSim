+/**
+ * Seeded random cases for the validity checks of 0.10.0 (properties.test.ts, fuzz.test.ts): analytic random terrains (a plane and
+ * Gaussian hills, so a terrain can be turned by a quarter turn exactly), wind, ignition and weather draws. Every draw comes from the
+ * repository's own `Rng` (integer arithmetic), so a seed names the case: the tests print the seed, and the same seed gives the same
+ * case on any machine. Not imported by application code.
+ */
+import { Rng } from '../../core/rng';
+import { FuelType } from '../../core/types';
+import { DEG } from './harness';
+
+export interface Hill {
+  x: number;
+  y: number;
+  sx: number;
+  sy: number;
+  /** Height (m); negative for a pit. */
+  h: number;
+}
+
+/** z(x, y) = base + gx x + gy y + the sum of the hills (local metres, x east, y north). */
+export interface TerrainSpec {
+  baseM: number;
+  gx: number;
+  gy: number;
+  hills: Hill[];
+}
+
+export type Elevation = (x: number, y: number) => number;
+
+export function elevationOf(t: TerrainSpec): Elevation {
+  return (x, y) => {
+    let z = t.baseM + t.gx * x + t.gy * y;
+    for (const k of t.hills) z += k.h * Math.exp(-0.5 * (((x - k.x) / k.sx) ** 2 + ((y - k.y) / k.sy) ** 2));
+    return z;
+  };
+}
+
+export interface RandomTerrainOptions {
+  /** Side of the square domain (m). */
+  extent: number;
+  /** Steepest plane (degrees); default 12. */
+  planeDeg?: number;
+  /** Number of hills (default 2 to 5). */
+  hills?: number;
+  /** Tallest hill (m); default 150. */
+  hillM?: number;
+  /** Narrowest hill (m); default 150. */
+  minWidthM?: number;
+}
+
+/** A seeded terrain: a gentle plane and a few hills of 150 to 500 m width, so slopes reach about 30 degrees. */
+export function randomTerrain(seed: number, o: RandomTerrainOptions): TerrainSpec {
+  const r = new Rng(seed * 2654435761 + 17);
+  const tilt = Math.tan((o.planeDeg ?? 12) * DEG) * r.next();
+  const dir = r.range(0, 2 * Math.PI);
+  const n = o.hills ?? 2 + r.int(4);
+  const hills: Hill[] = [];
+  for (let i = 0; i < n; i++) {
+    const w = o.minWidthM ?? 150;
+    hills.push({
+      x: r.range(-0.4, 0.4) * o.extent,
+      y: r.range(-0.4, 0.4) * o.extent,
+      sx: r.range(w, w + 350),
+      sy: r.range(w, w + 350),
+      h: r.range(-0.6, 1) * (o.hillM ?? 150),
+    });
+  }
+  return { baseM: 500, gx: tilt * Math.cos(dir), gy: tilt * Math.sin(dir), hills };
+}
+
+/** The terrain turned anticlockwise (seen from above) by `quarters` quarter turns about the origin: z'(p) = z(R^-1 p). */
+export function turnedElevation(z: Elevation, quarters: number): Elevation {
+  const q = ((quarters % 4) + 4) % 4;
+  return (x, y) => {
+    let px = x;
+    let py = y;
+    for (let i = 0; i < q; i++) [px, py] = [py, -px];
+    return z(px, py);
+  };
+}
+
+/** A point turned anticlockwise by `quarters` quarter turns about the origin: (x, y) to (-y, x). */
+export function turnedPoint(p: readonly [number, number], quarters: number): [number, number] {
+  let [x, y] = p;
+  for (let i = 0; i < ((quarters % 4) + 4) % 4; i++) [x, y] = [-y, x];
+  return [x, y];
+}
+
+/** A compass direction (degrees clockwise from north) turned anticlockwise by `quarters` quarter turns. */
+export const turnedCompass = (deg: number, quarters: number): number => (((deg - 90 * quarters) % 360) + 360) % 360;
+
+export interface DrawnCase {
+  seed: number;
+  terrain: TerrainSpec;
+  windKmh: number;
+  windFromDeg: number;
+  /** The ignition point (m). */
+  ignition: [number, number];
+}
+
+/** A seeded case of a terrain, a wind and an ignition near the centre. */
+export function drawCase(seed: number, o: RandomTerrainOptions & { windKmh?: [number, number]; ignitionRadiusM?: number }): DrawnCase {
+  const terrain = randomTerrain(seed, o);
+  const r = new Rng(seed * 40503 + 99);
+  const [lo, hi] = o.windKmh ?? [10, 40];
+  const rad = o.ignitionRadiusM ?? 300;
+  return { seed, terrain, windKmh: Math.round(r.range(lo, hi)), windFromDeg: Math.round(r.range(0, 360)), ignition: [Math.round(r.range(-rad, rad)), Math.round(r.range(-rad, rad))] };
+}
+
+/** The fuel types the fuzz draws from (the burnable ones the spread models cover). */
+export const FUZZ_FUELS: readonly FuelType[] = [
+  FuelType.Grassland,
+  FuelType.GrassyWoodland,
+  FuelType.DryForestShrubby,
+  FuelType.DryForestGrassy,
+  FuelType.WetForest,
+  FuelType.Heath,
+  FuelType.PinePlantation,
+];

