+/**
+ * Golden scenarios (plan 15d idea 3; contract 0.10.0, 4.3 item 2): each scenario of specs.ts is run and compared with its stored summary
+ * (burnt area at set times, head rate of spread, arrival-time and ember landing percentiles, the snapshot hash). On the machine kind and Node
+ * major that wrote the file the hash and every number are identical (tolerance 0, passMarks.json `golden`); on another engine the numbers
+ * are compared within the stored cross-engine tolerance and the hash is left to e2e/validity-engines.spec.ts. A failure here is a change in
+ * results (decision D23): read the diff `npm run golden:update` prints, and the commit that rewrites a golden file says why.
+ * The Standard-tier scenario runs under SLOW=1.
+ */
+import { existsSync, readFileSync, readdirSync } from 'node:fs';
+import { dirname, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { describe, expect, it } from 'vitest';
+import { SLOW, log } from '../harness';
+import { GOLDEN_SPECS } from './specs';
+import { differences, runGolden, sameEngineAs, type GoldenRecord } from './run';
+
+const dir = dirname(fileURLToPath(import.meta.url));
+const load = (id: string): GoldenRecord => JSON.parse(readFileSync(resolve(dir, `${id}.json`), 'utf8')) as GoldenRecord;
+
+describe('golden scenarios: the stored files and the recipes agree', () => {
+  it('every scenario has a stored file and every stored file has a scenario', () => {
+    const files = readdirSync(dir).filter((f) => f.endsWith('.json')).map((f) => f.replace(/\.json$/, '')).sort();
+    expect(files).toEqual(GOLDEN_SPECS.map((s) => s.id).sort());
+  });
+
+  it('a stored file names its marks, the tier and a tolerance, and its hashes are one per mark', () => {
+    for (const spec of GOLDEN_SPECS) {
+      const g = load(spec.id);
+      expect(g.id).toBe(spec.id);
+      expect(g.tier).toBe(spec.tier);
+      expect(g.marks, spec.id).toEqual(spec.marks);
+      expect(g.until).toBe(spec.until);
+      expect(g.hashes.length).toBe(g.marks.length);
+      expect(g.burntAreaHa.length).toBe(g.marks.length);
+      expect(g.headRosKmh.length).toBe(g.marks.length);
+      expect(g.hash).toBe(g.hashes[g.hashes.length - 1]);
+      expect(g.tolerance.sameEngine, spec.id).toBeGreaterThanOrEqual(0);
+      expect(g.recordedWith.node, spec.id).toMatch(/^v\d+\./);
+      expect(g.burntAreaHa[g.burntAreaHa.length - 1]!, `${spec.id} burnt something, so the hash says something`).toBeGreaterThan(0);
+    }
+  });
+});
+
+describe('golden scenarios: the comparison notices a change (the test of the test)', () => {
+  const stored = load('flat-uniform');
+  it('a summary number moved by a millionth, a different hash, or a missing ember percentile is a difference; inside a stated tolerance it is not', () => {
+    expect(differences(stored, stored)).toEqual([]);
+    const moved = { ...stored, burntAreaHa: stored.burntAreaHa.map((a, i) => (i === 1 ? a * (1 + 1e-6) : a)) };
+    expect(differences(stored, moved).join(' ')).toMatch(/burntAreaHa@1800s/);
+    expect(differences(stored, moved, 1e-5)).toEqual([]);
+    const rehash = { ...stored, hashes: stored.hashes.map((h, i) => (i === 0 ? h + 1 : h)) };
+    expect(differences(stored, rehash).join(' ')).toMatch(/snapshot hash at 600 s/);
+    const lost = { ...stored, emberLanding: { ...stored.emberLanding, p99: null } };
+    expect(differences(stored, lost).join(' ')).toMatch(/emberLanding\.p99/);
+  });
+
+  it('a hash is only demanded of the engine that wrote it (another Node major or machine kind compares the numbers)', () => {
+    expect(sameEngineAs(stored)).toBe(true);
+    const other = { ...stored, recordedWith: { ...stored.recordedWith, node: 'v18.0.0' } };
+    expect(sameEngineAs(other)).toBe(false);
+    const rehash = { ...other, hashes: stored.hashes.map((h) => h + 1) };
+    expect(differences(rehash, stored)).toEqual([]);
+  });
+});
+
+describe('golden scenarios: a run gives the stored summary and snapshot hash', () => {
+  for (const spec of GOLDEN_SPECS) {
+    it.skipIf(spec.slow && !SLOW)(`${spec.id}: ${spec.title}`, async () => {
+      expect(existsSync(resolve(dir, `${spec.id}.json`)), `run npm run golden:update to create ${spec.id}.json`).toBe(true);
+      const stored = load(spec.id);
+      const fresh = await runGolden(spec, stored.tolerance);
+      const same = sameEngineAs(stored);
+      const diff = differences(stored, fresh, same ? stored.tolerance.sameEngine : (stored.tolerance.crossEngine ?? stored.tolerance.sameEngine));
+      log(`golden ${spec.id}: ${same ? 'same engine as the file (Node ' + stored.recordedWith.node + ')' : `another engine (file: Node ${stored.recordedWith.node} ${stored.recordedWith.platform} ${stored.recordedWith.arch})`}; burnt ${fresh.burntAreaHa.map((a) => a.toFixed(1)).join(' / ')} ha at ${fresh.marks.join(' / ')} s; hash ${fresh.hash}; ${diff.length ? `${diff.length} differences` : 'identical'}`);
+      expect(diff, `${spec.id}: a change in results (decision D23). Run npm run golden:update, read the diff, and say in the commit why it changed:\n${diff.join('\n')}`).toEqual([]);
+    }, 900000);
+  }
+});
