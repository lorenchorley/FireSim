+++ b/src/sim/validation/properties.test.ts
@@ -0,0 +1,261 @@
+/**
+ * Properties that must hold (plan 15d, ideas 1 and 17; contract 0.10.0, 4.3 item 1): metamorphic relations of the coupled model, run over
+ * seeded random synthetic terrains, with no reference answer: what the result must do when the input changes, not what it must equal.
+ *   P-rotation        turning the terrain, the wind and the ignition by a quarter turn turns the result;
+ *   P-moreWind        more wind never slows the head;
+ *   P-moreMoisture    more moisture never speeds it;
+ *   P-firebreak       a firebreak never raises the burnt area;
+ *   P-laterChange     a change made at time t leaves every earlier result unchanged (known from the start, and made in the past:
+ *                     the engine rewinds and replays).
+ * Grid and step refinement (stated bands, synthetic terrain and the bundled sites) are in convergence.test.ts. The pass marks are in
+ * passMarks.json, committed before these checks were written. Every case prints its seed (`drawCase(seed, ...)` in randomCases.ts
+ * rebuilds it). A property that fails is a finding to report, not something to fix in the solver: the failing seeds and numbers are in
+ * the message. The quick run takes the first seeds of each set; SLOW=1 takes them all.
+ */
+import { describe, expect, it } from 'vitest';
+import { Rng } from '../../core/rng';
+import { FuelType, type Ignition, type ScenarioEdit } from '../../core/types';
+import { azimuthToUnit } from '../../core/units';
+import { Simulation } from '../simulation';
+import { snapshotHash } from '../testing/hash';
+import { log, point, synth } from './harness';
+import marksFile from './passMarks.json';
+import { CELL, EXTENT, HOUR, downwind, farthest, fire, record, seeds } from './propertyKit';
+import { drawCase, elevationOf, turnedCompass, turnedElevation, turnedPoint } from './randomCases';
+
+const M = marksFile.marks;
+const hooks = { moisture: 8 };
+
+describe('P-rotation: turning the terrain, the wind and the ignition by a quarter turn turns the result', () => {
+  const tol = M.rotation.toleranceMeasuredS;
+  it(`P-rotation: the turned arrival-time raster is the first run's turned, to ${tol} s (measured; bit for bit was the pre-registered mark), and the burnt area at every mark is equal`, () => {
+    const failures: string[] = [];
+    let worst = 0;
+    let bitwise = 0;
+    let pairs = 0;
+    for (const seed of seeds(101, 8, 2)) {
+      const c = drawCase(seed, { extent: EXTENT });
+      const z = elevationOf(c.terrain);
+      const base = fire({ elevation: z, ignition: c.ignition, windKmh: c.windKmh, windFromDeg: c.windFromDeg, hooks });
+      const n = base.g.nx;
+      for (const q of [1, 2, 3]) {
+        const turned = fire({ elevation: turnedElevation(z, q), ignition: turnedPoint(c.ignition, q), windKmh: c.windKmh, windFromDeg: turnedCompass(c.windFromDeg, q), hooks });
+        // Cell (i, j) of the first run is cell (n-1-j, i) after one quarter turn (the grid is symmetric about the origin).
+        let diff = 0;
+        for (let j = 0; j < n; j++)
+          for (let i = 0; i < n; i++) {
+            let ti = i;
+            let tj = j;
+            for (let t = 0; t < q; t++) [ti, tj] = [n - 1 - tj, ti];
+            const a = base.arrival[j * n + i]!;
+            const b = turned.arrival[tj * n + ti]!;
+            if (!Object.is(a, b)) diff = Math.max(diff, Number.isFinite(a) && Number.isFinite(b) ? Math.abs(a - b) : Infinity);
+          }
+        const sameArea = base.burnt.every((v, k) => v === turned.burnt[k]);
+        pairs++;
+        if (diff === 0) bitwise++;
+        worst = Math.max(worst, diff);
+        log(`P-rotation seed ${seed} turn ${q * 90}: wind ${c.windKmh} km/h from ${c.windFromDeg} deg, ${base.burnt[base.burnt.length - 1]} cells burnt, largest arrival difference ${diff} s, burnt cells at the marks ${sameArea ? 'equal' : 'DIFFER'}`);
+        if (diff > tol || !sameArea) failures.push(`seed ${seed}, ${q * 90} degrees: largest arrival difference ${diff} s${sameArea ? '' : ', burnt area differs'}`);
+      }
+    }
+    log(`P-rotation: ${pairs} turned runs, ${bitwise} bit for bit, largest arrival difference ${worst} s`);
+    record('P-rotation', { pairs, bitForBit: bitwise, largestDifferenceS: worst, toleranceS: tol, preRegisteredToleranceS: M.rotation.toleranceS, failures: failures.length });
+    expect(failures, `rotation failures (a finding, not to be fixed in the solver): ${failures.join('; ')}`).toEqual([]);
+  }, 600000);
+});
+
+describe('P-moreWind: more wind never slows the head', () => {
+  const slack = M.moreWind.slackM;
+  const speeds = [10, 20, 30];
+  const sweep = (label: string, first: number, count: number, quick: number, withHooks: boolean): void => {
+    it(`P-moreWind: ${label}: the farthest burnt cell downwind at 1 h is not nearer with a stronger wind (${slack} m of slack)`, () => {
+      const failures: string[] = [];
+      let worstDrop = 0;
+      for (const seed of seeds(first, count, quick)) {
+        const c = drawCase(seed, { extent: EXTENT });
+        const reach = speeds.map((u) => farthest(fire({ elevation: elevationOf(c.terrain), ignition: c.ignition, windKmh: u, windFromDeg: c.windFromDeg, ...(withHooks ? { hooks } : {}) }), c));
+        log(`P-moreWind ${label} seed ${seed}: wind from ${c.windFromDeg} deg, farthest downwind at 1 h ${reach.map((v, i) => `${speeds[i]} km/h ${v.toFixed(0)} m`).join(', ')}`);
+        for (let i = 1; i < speeds.length; i++) {
+          worstDrop = Math.max(worstDrop, reach[i - 1]! - reach[i]!);
+          if (reach[i]! < reach[i - 1]! - slack) failures.push(`seed ${seed}: ${speeds[i]} km/h reaches ${reach[i]!.toFixed(0)} m, ${speeds[i - 1]} km/h reaches ${reach[i - 1]!.toFixed(0)} m`);
+        }
+      }
+      record(`P-moreWind-${withHooks ? 'hooks' : 'free'}`, { cases: seeds(first, count, quick).length, largestDropM: Math.max(0, worstDrop), slackM: slack, failures: failures.length });
+      expect(failures, `more wind slowed the head (a finding, not to be fixed in the solver): ${failures.join('; ')}`).toEqual([]);
+    }, 600000);
+  };
+  sweep('random terrains, constant moisture and no surface heating', 201, 8, 2, true);
+  sweep("random terrains, the model's own moisture and heating", 211, 4, 1, false);
+
+  it('P-moreWind: flat ground, uniform fuel: SimStats.headRos at 1 h is not lower with a stronger wind', () => {
+    const flat = (): number => 500;
+    const winds = [5, 10, 20, 30, 40];
+    const ros = winds.map((u) => fire({ elevation: flat, ignition: [0, 0], windKmh: u, windFromDeg: 270, hooks }).headRos);
+    log(`P-moreWind flat: head rate of spread ${winds.map((u, i) => `${u} km/h ${(ros[i]! * 3.6).toFixed(2)} km/h`).join(', ')}`);
+    record('P-moreWind-flat', { winds, headRosKmh: ros.map((v) => v * 3.6) });
+    for (let i = 1; i < winds.length; i++) expect(ros[i]!, `${winds[i]} km/h against ${winds[i - 1]} km/h`).toBeGreaterThanOrEqual(ros[i - 1]!);
+  }, 120000);
+});
+
+describe('P-moreMoisture: more moisture never speeds it', () => {
+  const slack = M.moreMoisture.slackS;
+  const levels = [6, 10, 14];
+  it(`P-moreMoisture: no cell burns in the wetter run that does not burn in the drier one, and none arrives sooner (${slack} s of rounding)`, () => {
+    const failures: string[] = [];
+    let burntOnlyWet = 0;
+    let earliestBy = 0;
+    for (const seed of seeds(301, 8, 2)) {
+      const c = drawCase(seed, { extent: EXTENT, windKmh: [20, 40] });
+      const runs = levels.map((m) => fire({ elevation: elevationOf(c.terrain), ignition: c.ignition, windKmh: c.windKmh, windFromDeg: c.windFromDeg, hooks: { moisture: m } }));
+      log(`P-moreMoisture seed ${seed}: wind ${c.windKmh} km/h, cells burnt at 1 h ${runs.map((r, i) => `M ${levels[i]} % ${r.burnt[r.burnt.length - 1]}`).join(', ')}`);
+      for (let i = 1; i < levels.length; i++) {
+        const dry = runs[i - 1]!;
+        const wet = runs[i]!;
+        let only = 0;
+        let sooner = 0;
+        for (let k = 0; k < dry.arrival.length; k++) {
+          const a = dry.arrival[k]!;
+          const b = wet.arrival[k]!;
+          if (b <= HOUR && !(a <= HOUR)) only++;
+          else if (b <= HOUR && a <= HOUR) sooner = Math.max(sooner, a - b);
+        }
+        burntOnlyWet += only;
+        earliestBy = Math.max(earliestBy, sooner);
+        if (only > 0 || sooner > slack) failures.push(`seed ${seed}: M ${levels[i]} % against ${levels[i - 1]} %: ${only} cells burnt only in the wetter run, a cell arrives up to ${sooner.toFixed(3)} s sooner`);
+      }
+    }
+    record('P-moreMoisture', { cases: seeds(301, 8, 2).length, cellsBurntOnlyWet: burntOnlyWet, largestEarlierS: earliestBy, slackS: slack, failures: failures.length });
+    expect(failures, `more moisture sped the fire (a finding, not to be fixed in the solver): ${failures.join('; ')}`).toEqual([]);
+  }, 600000);
+});
+
+describe('P-firebreak: a firebreak never raises the burnt area', () => {
+  const slackCells = Math.round((M.firebreak.slackHa * 1e4) / (CELL * CELL));
+  it(`P-firebreak: the burnt area with a two-cell strip of non-burnable ground across the wind is not larger than without it at any mark (${slackCells} cell of slack)`, () => {
+    const failures: string[] = [];
+    let reached = 0;
+    let largestRise = 0;
+    const cases = seeds(401, 8, 2);
+    for (const seed of cases) {
+      const c = drawCase(seed, { extent: EXTENT, windKmh: [15, 40], ignitionRadiusM: 200 });
+      const r = new Rng(seed + 4001);
+      const d0 = 300 + 50 * r.int(5);
+      const [ux, uy] = azimuthToUnit(downwind(c));
+      const strip = (x: number, y: number): FuelType | null => (Math.abs((x - c.ignition[0]) * ux + (y - c.ignition[1]) * uy - d0) <= CELL ? FuelType.NonFuel : null);
+      const base = { elevation: elevationOf(c.terrain), ignition: c.ignition, windKmh: c.windKmh, windFromDeg: c.windFromDeg };
+      const open = fire(base);
+      const broken = fire({ ...base, fuelOverride: strip });
+      const hit = farthest(open, c) >= d0 + CELL;
+      if (hit) reached++;
+      const rises = open.burnt.map((v, k) => broken.burnt[k]! - v);
+      largestRise = Math.max(largestRise, ...rises);
+      log(`P-firebreak seed ${seed}: wind ${c.windKmh} km/h, strip ${d0} m ahead, ${hit ? 'reached' : 'not reached'}, cells burnt at the marks without ${open.burnt.join(' ')} with ${broken.burnt.join(' ')}`);
+      rises.forEach((d, k) => {
+        if (d > slackCells) failures.push(`seed ${seed}: at ${(k + 1) * 600} s the strip run has ${d} more burnt cells`);
+      });
+    }
+    record('P-firebreak', { cases: cases.length, stripReached: reached, largestRiseCells: Math.max(0, largestRise), slackCells, failures: failures.length });
+    expect(failures, `a firebreak raised the burnt area (a finding, not to be fixed in the solver): ${failures.join('; ')}`).toEqual([]);
+    expect(reached, 'the fire reached the strip in at least half of the cases, so the property was exercised').toBeGreaterThanOrEqual(cases.length / 2);
+  }, 600000);
+});
+
+describe('P-laterChange: a change made at time t leaves every earlier result unchanged', () => {
+  const SKIP = [...M.laterChange.skipped];
+  const scenario = (c: ReturnType<typeof drawCase>): ReturnType<typeof synth> =>
+    synth({
+      extent: EXTENT,
+      cellSize: CELL,
+      elevation: elevationOf(c.terrain),
+      windKmh: c.windKmh,
+      windFromDeg: c.windFromDeg,
+      duration: HOUR,
+      ignitions: [point(c.ignition[0], c.ignition[1], 0, 30)],
+      options: { embers: true, maxEmbers: 1500, seed: 7 },
+    });
+
+  function started(sc: ReturnType<typeof synth>, setup?: (sim: Simulation) => void): { sim: Simulation; hashes: Map<number, number> } {
+    const hashes = new Map<number, number>();
+    const sim = new Simulation(sc, { tier: 'fast', hooks: { snapshot: (s) => hashes.set(s.time, snapshotHash(s, SKIP)) } });
+    setup?.(sim);
+    return { sim, hashes };
+  }
+  const finished = (sc: ReturnType<typeof synth>, setup?: (sim: Simulation) => void): { sim: Simulation; hashes: Map<number, number> } => {
+    const r = started(sc, setup);
+    r.sim.spinUp();
+    r.sim.advance(HOUR);
+    return r;
+  };
+
+  type Change = (sim: Simulation) => void;
+  const changes: { kind: string; make(c: ReturnType<typeof drawCase>, tE: number, r: Rng): Change }[] = [
+    {
+      kind: 'a second ignition',
+      make: (_c, tE, r) => {
+        const ign: Ignition = { id: 'late', kind: 'point', points: [[Math.round(r.range(-600, 600)), Math.round(r.range(-600, 600))]], time: tE, radius: 30, origin: 'observed' };
+        return (sim) => sim.ignite(ign);
+      },
+    },
+    {
+      kind: 'a Wind direction change',
+      make: (c, tE) => {
+        const e: ScenarioEdit = { kind: 'windDirection', id: 'wd', dir: (c.windFromDeg + 90) % 360, time: tE };
+        return (sim) => sim.edit(e, tE);
+      },
+    },
+    {
+      kind: 'a fuel edit (a disc of non-burnable ground ahead of the fire)',
+      make: (c, tE) => {
+        const [ux, uy] = azimuthToUnit(downwind(c));
+        const e: ScenarioEdit = { kind: 'fuel', id: 'fe', shape: { kind: 'circle', x: c.ignition[0] + 350 * ux, y: c.ignition[1] + 350 * uy, radius: 250 }, setType: FuelType.NonFuel };
+        return (sim) => sim.edit(e, tE);
+      },
+    },
+  ];
+
+  it('P-laterChange: every snapshot at or before t is the same with the change as without it, whether it was known from the start or made in the past (rewind and replay), and the change did something', () => {
+    const failures: string[] = [];
+    let compared = 0;
+    let effective = 0;
+    let total = 0;
+    for (const seed of seeds(501, 4, 1)) {
+      const c = drawCase(seed, { extent: EXTENT, windKmh: [15, 35] });
+      const rng = new Rng(seed + 5001);
+      const tE = 1200 + 60 * rng.int(21);
+      const base = finished(scenario(c));
+      const before = new Map(base.hashes);
+      for (const ch of changes) {
+        const apply = ch.make(c, tE, new Rng(seed + 5002));
+        total++;
+        // (a) known from the start: every cadence snapshot up to t.
+        const fromStart = finished(scenario(c), apply);
+        let same = true;
+        for (const [t, h] of before) {
+          if (t > tE) continue;
+          compared++;
+          if (fromStart.hashes.get(t) !== h) {
+            same = false;
+            failures.push(`seed ${seed}, ${ch.kind} at ${tE} s, known from the start: the snapshot at ${t} s differs`);
+            break;
+          }
+        }
+        // (b) made in the past: the engine restores a checkpoint and replays to t; the state there is the original's.
+        const mid = finished(scenario(c));
+        apply(mid.sim);
+        mid.sim.advance(tE);
+        compared++;
+        const atT = snapshotHash(mid.sim.snapshot(), SKIP);
+        if (atT !== before.get(tE)) failures.push(`seed ${seed}, ${ch.kind} at ${tE} s, made in the past: the state replayed to ${tE} s differs`);
+        mid.sim.advance(HOUR);
+        // The change must have done something, or the property says nothing.
+        const did = fromStart.hashes.get(HOUR) !== before.get(HOUR);
+        if (did) effective++;
+        log(`P-laterChange seed ${seed}: ${ch.kind} at ${tE} s: earlier snapshots ${same ? 'identical' : 'DIFFER'}, replayed state at t ${atT === before.get(tE) ? 'identical' : 'DIFFERS'}, final snapshot ${did ? 'changed' : 'unchanged (the change did not matter in this case)'}; replayed run's final snapshot ${snapshotHash(mid.sim.snapshot(), SKIP) === fromStart.hashes.get(HOUR) ? 'equals' : 'differs from'} the run that knew from the start`);
+      }
+    }
+    record('P-laterChange', { cases: total, snapshotsCompared: compared, changeChangedTheEnd: effective, failures: failures.length });
+    expect(failures, `a later change moved an earlier result (a finding, not to be fixed in the solver): ${failures.join('; ')}`).toEqual([]);
+    expect(effective, 'the change altered the final snapshot in at least half of the cases, so the property was exercised').toBeGreaterThanOrEqual(total / 2);
+  }, 900000);
+});
