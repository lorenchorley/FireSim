+#!/usr/bin/env node
+/**
+ * Regenerates the golden scenario summaries (src/sim/validation/golden/*.json; plan 15d idea 3) and prints what changed.
+ *
+ *   npm run golden:update [-- --only <id>] [-- --dry]
+ *
+ * A change in a golden value is a change in results (decision D23): the commit that changes one says why. So this script
+ *   - refuses to run in CI mode (the environment variable CI is set and not "0" or "false"): a build must never rewrite its own reference;
+ *   - runs every scenario of src/sim/validation/golden/specs.ts (or the one named by --only) with the real `Simulation` through the
+ *     repository's own Vite (no new dependency), compares with the stored file and PRINTS THE DIFF (every summary number and snapshot hash
+ *     that changed, old and new);
+ *   - writes the files unless --dry is given. Without any difference it writes nothing and says so.
+ * The cross-engine tolerance stored in a file (tolerance.crossEngine) is kept, never overwritten: it comes from e2e/validity-engines.spec.ts.
+ * Heavy (about a minute of one core; the Standard tier is the slow one): run it under the shared lock on the build machine.
+ */
+import { createServer } from 'vite';
+import { existsSync, readFileSync, readdirSync, writeFileSync } from 'node:fs';
+import { dirname, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');
+const dir = resolve(root, 'src/sim/validation/golden');
+const args = process.argv.slice(2);
+const flag = (n) => args.includes(`--${n}`);
+const only = args.includes('--only') ? args[args.indexOf('--only') + 1] : null;
+
+const ci = (process.env.CI ?? '').trim().toLowerCase();
+if (ci && ci !== '0' && ci !== 'false') {
+  console.error('golden:update refuses to run in CI mode (CI is set). The golden files are the reference of a release: a build must not rewrite them.');
+  console.error('Run it on a development machine, read the diff, and say in the commit why the results changed (decision D23).');
+  process.exit(2);
+}
+
+const server = await createServer({
+  root,
+  configFile: false,
+  logLevel: 'error',
+  appType: 'custom',
+  server: { middlewareMode: true, hmr: false, watch: null },
+  optimizeDeps: { noDiscovery: true, include: [] },
+  resolve: { alias: { '@': resolve(root, 'src') } },
+});
+let changed = 0;
+try {
+  const { GOLDEN_SPECS } = await server.ssrLoadModule('/src/sim/validation/golden/specs.ts');
+  const { runGolden, differences } = await server.ssrLoadModule('/src/sim/validation/golden/run.ts');
+  const specs = GOLDEN_SPECS.filter((s) => !only || s.id === only);
+  if (only && !specs.length) throw new Error(`no golden scenario "${only}" (have ${GOLDEN_SPECS.map((s) => s.id).join(', ')})`);
+  for (const spec of specs) {
+    const file = resolve(dir, `${spec.id}.json`);
+    const stored = existsSync(file) ? JSON.parse(readFileSync(file, 'utf8')) : null;
+    process.stdout.write(`${spec.id} ... `);
+    const c0 = Date.now();
+    const fresh = await runGolden(spec, stored ? stored.tolerance : undefined);
+    process.stdout.write(`${((Date.now() - c0) / 1000).toFixed(1)} s\n`);
+    if (!stored) {
+      console.log('  NEW (no stored file)');
+      changed++;
+    } else {
+      const diff = differences({ ...stored, tolerance: { ...stored.tolerance, sameEngine: 0 } }, fresh, 0);
+      // The hash line is only produced for the same engine; show the hashes for a different machine too.
+      stored.hashes.forEach((h, i) => h !== fresh.hashes[i] && !diff.some((d) => d.startsWith(`snapshot hash at ${stored.marks[i]} s`)) && diff.push(`snapshot hash at ${stored.marks[i]} s: ${h} stored, ${fresh.hashes[i]} now`));
+      if (!diff.length) {
+        console.log('  unchanged');
+        continue;
+      }
+      changed++;
+      console.log(`  CHANGED (${diff.length}):`);
+      for (const d of diff) console.log(`    ${d}`);
+    }
+    if (flag('dry')) continue;
+    writeFileSync(file, `${JSON.stringify(fresh, null, 2)}\n`);
+    console.log(`  wrote ${file.replace(`${root}/`, '')}`);
+  }
+  const ids = new Set(GOLDEN_SPECS.map((s) => s.id));
+  for (const f of readdirSync(dir).filter((n) => n.endsWith('.json'))) if (!ids.has(f.replace(/\.json$/, ''))) console.log(`note: ${f} has no scenario in specs.ts any more (delete it)`);
+} finally {
+  await server.close();
+}
+console.log(changed ? `${changed} golden file(s) ${flag('dry') ? 'would change (--dry: nothing written)' : 'written'}. A change in a golden value is a change in results: say why in the commit.` : 'No golden value changed.');
+process.exit(0);
