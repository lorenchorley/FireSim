@@ -0,0 +1,97 @@
+/**
+ * What the cross-engine check needs (plan 15d idea 19; e2e/validity-engines.spec.ts): a golden scenario as bytes a browser page can rebuild,
+ * and the snapshot fingerprint as SOURCE TEXT, so that the page and Node compute it with the very same code (engines.test.ts holds that text
+ * to `snapshotHash`). Not imported by application code.
+ */
+import { GOLDEN_HASH_SKIP } from './run';
+
+/**
+ * A scenario as JSON plus one binary blob: typed arrays become `{ __ta, off, len }` into the blob, numbers JSON cannot hold (NaN,
+ * Infinity, -0) become `{ __num }`. Throws on anything the engine's input should not contain (a function, a Map, a Set, a Date).
+ */
+export function serializeScenario(sc: unknown): { json: unknown; blob: Uint8Array } {
+  const chunks: Uint8Array[] = [];
+  let size = 0;
+  const walk = (v: unknown, path: string): unknown => {
+    if (v === undefined) return undefined;
+    if (typeof v === 'function') throw new Error(`a function at ${path}`);
+    if (typeof v === 'number') return Number.isFinite(v) && !Object.is(v, -0) ? v : { __num: Object.is(v, -0) ? '-0' : String(v) };
+    if (v === null || typeof v !== 'object') return v;
+    if (ArrayBuffer.isView(v)) {
+      const bytes = new Uint8Array(v.buffer, v.byteOffset, v.byteLength);
+      const pad = (8 - (size % 8)) % 8;
+      if (pad) {
+        chunks.push(new Uint8Array(pad));
+        size += pad;
+      }
+      const off = size;
+      chunks.push(bytes);
+      size += bytes.byteLength;
+      return { __ta: v.constructor.name, off, len: (v as unknown as { length: number }).length };
+    }
+    if (Array.isArray(v)) return v.map((x, i) => walk(x, `${path}[${i}]`));
+    if (v instanceof Map || v instanceof Set || v instanceof Date) throw new Error(`a ${v.constructor.name} at ${path}`);
+    const out: Record<string, unknown> = {};
+    for (const [k, x] of Object.entries(v)) {
+      const w = walk(x, `${path}.${k}`);
+      if (w !== undefined) out[k] = w;
+    }
+    return out;
+  };
+  const json = walk(sc, 'scenario');
+  const blob = new Uint8Array(size);
+  let at = 0;
+  for (const c of chunks) {
+    blob.set(c, at);
+    at += c.byteLength;
+  }
+  return { json, blob };
+}
+
+/** The page's side of `serializeScenario`: `revive(json, ArrayBuffer)` gives the scenario back. */
+export const REVIVE_SOURCE = `(() => {
+  const T = { Float32Array, Float64Array, Int8Array, Uint8Array, Int16Array, Uint16Array, Int32Array, Uint32Array, Uint8ClampedArray };
+  return function revive(v, buf) {
+    if (v === null || typeof v !== 'object') return v;
+    if (Array.isArray(v)) return v.map((x) => revive(x, buf));
+    if (v.__num !== undefined) return v.__num === '-0' ? -0 : Number(v.__num);
+    if (v.__ta !== undefined) { const C = T[v.__ta]; return new C(buf.slice(v.off, v.off + v.len * C.BYTES_PER_ELEMENT)); }
+    const o = {};
+    for (const k of Object.keys(v)) o[k] = revive(v[k], buf);
+    return o;
+  };
+})()`;
+
+/**
+ * `snapshotHash` and its per-part hashes as source text (FNV-1a over the bytes of every typed array and the JSON of the rest, keys sorted,
+ * the skipped paths left out; `engine` is always skipped). `(0, eval)(PAGE_HASH_SOURCE)` gives `{ hash(snapshot, skip), parts(snapshot, skip) }`.
+ * engines.test.ts holds it to src/sim/testing/hash.ts, so the page and Node cannot drift apart.
+ */
+export const PAGE_HASH_SOURCE = `(() => {
+  function fnv(h, bytes) { for (let i = 0; i < bytes.length; i++) { h ^= bytes[i]; h = Math.imul(h, 16777619) >>> 0; } return h; }
+  function hv(h, v, skip, path) {
+    if (ArrayBuffer.isView(v)) return fnv(h, new Uint8Array(v.buffer, v.byteOffset, v.byteLength));
+    if (v === null || typeof v !== 'object') return fnv(h, new TextEncoder().encode(path + '=' + (typeof v === 'number' ? (Object.is(v, -0) ? '-0' : String(v)) : JSON.stringify(v)) + ';'));
+    if (Array.isArray(v)) { v.forEach((x, i) => (h = hv(h, x, skip, path + '[' + i + ']'))); return h; }
+    for (const k of Object.keys(v).sort()) { const p = path ? path + '.' + k : k; if (skip.has(p)) continue; h = hv(h, v[k], skip, p); }
+    return h;
+  }
+  const S = (skip) => new Set([...skip, 'engine']);
+  return {
+    hash: (s, skip) => hv(0x811c9dc5, s, S(skip), ''),
+    parts: (s, skip) => {
+      const sk = S(skip);
+      const out = {};
+      for (const k of Object.keys(s)) if (k !== 'engine') out[k] = hv(0x811c9dc5, s[k], sk, k);
+      for (const group of ['fire', 'layers']) if (s[group]) for (const k of Object.keys(s[group])) out[group + '.' + k] = hv(0x811c9dc5, s[group][k], sk, k);
+      return out;
+    },
+  };
+})()`;
+
+/** The page's hash and part hashes, built here in Node from the same text. */
+export function pageHasher(): { hash(s: unknown, skip: readonly string[]): number; parts(s: unknown, skip: readonly string[]): Record<string, number> } {
+  return (0, eval)(PAGE_HASH_SOURCE) as ReturnType<typeof pageHasher>;
+}
+
+export { GOLDEN_HASH_SKIP };
