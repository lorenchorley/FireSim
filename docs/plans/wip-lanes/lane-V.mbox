+// Writes specs.json: the rows of the tier comparison (plan 15d idea 21; contract 0.10.0 item 6). Rows are run by the harness of
+// studies/desktop-simulation/01-cost-vs-detail/scripts (run-batch.mjs, launch.mjs, row.ts), unchanged.
+//   node make-specs.mjs > specs.json
+//
+// Scenario: the one of the desktop study (study 01): the V20 preset 'hot-nw-sw-change' from 14:00 on 2025-12-20, one point ignition of 60 m
+// radius, seed 1, 6 km square. Katoomba (ignition at (-2170, 900) m, 3 h, so the south-west change two hours in is inside the window) and the
+// Warrumbungles (ignition (-1500, 1000) m, 2 h, as in the study: the fire fills the square soon after).
+// Five rows per site and per ember setting, one realisation each:
+//   F30  Fast tier, 30 m fire cells (the reference of the comparison: the forecast wind fitted to the terrain)
+//   S30  Standard tier, 30 m cells (3-D air of 200 m)
+//   H30  High air at 30 m cells (the finer 3-D air of the High tier on the same 30 m fire grid, so the air is the only change)
+//   F20  Fast tier at 20 m cells (separates the effect of the finer fire cell)
+//   H20  the High tier as the app builds it: 20 m fire cells with the finer 3-D air
+// Embers on (the tier's default cap) and off (the rows then differ only in the air and the cell, not in random draws).
+const H = 3600;
+const SITES = [
+  { key: 'katoomba', site: 'katoomba', ignition: { x: -2170, y: 900, radius: 60 }, windowS: 3 * H },
+  { key: 'warrumbungles', site: 'warrumbungles', ignition: { x: -1500, y: 1000, radius: 60 }, windowS: 2 * H },
+];
+const TIERS = [
+  { key: 'F30', tier: 'fast', cell: 30 },
+  { key: 'S30', tier: 'standard', cell: 30 },
+  { key: 'H30', tier: 'high', cell: 30 },
+  { key: 'F20', tier: 'fast', cell: 20 },
+  { key: 'H20', tier: 'high', cell: 20, buildTier: 'high' },
+];
+const rows = [];
+for (const s of SITES) {
+  for (const embers of [false, true]) {
+    for (const t of TIERS) {
+      rows.push({
+        id: `${s.key}-${t.key}-${embers ? 'embers' : 'noembers'}`,
+        site: s.site,
+        ignition: s.ignition,
+        extent: 6000,
+        embers,
+        tier: t.tier,
+        cell: t.cell,
+        ...(t.buildTier ? { buildTier: t.buildTier } : {}),
+        windowS: s.windowS,
+        chunkS: 300,
+        hook: 'last',
+        summary: true,
+        maxWallS: 1500,
+        seed: 1,
+      });
+    }
+  }
+}
