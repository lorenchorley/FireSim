index 0000000..1ddacf3
--- /dev/null
+++ b/src/sim/validation/fuzz.test.ts
@@ -0,0 +1,99 @@
+/**
+ * Stress and fuzz (plan 15d idea 20; contract 0.10.0, 4.3 item 3): seeded random terrains, weather and ignitions, extremes included
+ * (calm and gale, bone dry and saturated, 0 to 100 percent moisture, a 600 m and a 3 km domain, ignitions at the edge and the corner,
+ * some starting later), run headless; every snapshot is held against the invariants of passMarks.json (`fuzz`): no NaN, no negative or
+ * impossible area, no runaway growth, a burnt cell never un-burns, time never goes back. The cases come from `drawFuzz(seed)`
+ * (fuzzCases.ts), so a failing seed printed here is the reproduction. The quick run takes 8 seeds from 1001, SLOW=1 takes 40 and four
+ * standard-tier cases; for a long sweep set FUZZ_FROM and FUZZ_N (for example FUZZ_FROM=2001 FUZZ_N=300). A failure is a finding to
+ * report, not something to fix in the solver.
+ */
+import { describe, expect, it } from 'vitest';
+import { Simulation } from '../simulation';
+import { FuzzStream, drawFuzz, type FuzzCase } from './fuzzCases';
+import { log, SLOW } from './harness';
+import { record } from './propertyKit';
+
+const FROM = Number(process.env['FUZZ_FROM'] ?? 1001);
+const N = Number(process.env['FUZZ_N'] ?? (SLOW ? 40 : 8));
+
+interface Outcome {
+  seed: number;
+  label: string;
+  problems: string[];
+  /** Known findings seen in the case (fuzzCases.ts, `FuzzStream.findings`). */
+  findings: string[];
+  snapshots: number;
+  wallS: number;
+}
+
+/** One case, run to its end; a throw is a problem too (a crash on a legal scenario). */
+function runCase(c: FuzzCase): Outcome {
+  const stream = new FuzzStream(c);
+  const c0 = performance.now();
+  const hookM = c.moistureHookPct;
+  const sim = new Simulation(c.scenario, {
+    tier: c.tier,
+    hooks: { snapshot: (s) => stream.push(s) },
+    ...(hookM !== null ? { testHooks: { moisture: (m: Float32Array) => void m.fill(hookM) } } : {}),
+  });
+  try {
+    sim.spinUp();
+    sim.advance(c.durationS);
+  } catch (e) {
+    stream.problems.push(`crashed: ${(e as Error).message}`);
+  }
+  const problems = stream.finish();
+  if (stream.snapshots === 0 && problems.length === 0) problems.push('no snapshot was produced');
+  return { seed: c.seed, label: c.label, problems, findings: stream.findings, snapshots: stream.snapshots, wallS: (performance.now() - c0) / 1000 };
+}
+
+function sweep(from: number, count: number, tier: 'fast' | 'standard'): { failing: Outcome[]; known: number[]; snapshots: number; slowest: number } {
+  const failing: Outcome[] = [];
+  const known: number[] = [];
+  let snapshots = 0;
+  let slowest = 0;
+  for (let seed = from; seed < from + count; seed++) {
+    const o = runCase(drawFuzz(seed, tier));
+    snapshots += o.snapshots;
+    slowest = Math.max(slowest, o.wallS);
+    log(`F-fuzz ${o.label}: ${o.snapshots} snapshots, ${o.wallS.toFixed(1)} s${o.problems.length ? `; PROBLEMS ${o.problems.join(' | ')}` : ''}${o.findings.length ? `; KNOWN FINDING ${o.findings[0]}` : ''}`);
+    if (o.problems.length) failing.push(o);
+    if (o.findings.length) known.push(o.seed);
+  }
+  return { failing, known, snapshots, slowest };
+}
+
+const message = (failing: Outcome[]): string => failing.map((o) => `[${o.label}] ${o.problems.join(' | ')}`).join('\n');
+
+describe('F-fuzz: random terrains, weather and ignitions never break the invariants', () => {
+  it(`F-fuzz: ${N} seeded fast-tier cases from seed ${FROM}: no NaN, no impossible area, no runaway growth, no burnt cell that un-burns`, () => {
+    const r = sweep(FROM, N, 'fast');
+    record('F-fuzz-fast', { from: FROM, cases: N, snapshots: r.snapshots, failingSeeds: r.failing.map((o) => o.seed), knownFindingF1Seeds: r.known, slowestS: r.slowest });
+    expect(r.failing.map((o) => o.seed), `fuzz invariants broke (a finding to report with these seeds, not to fix in the solver):\n${message(r.failing)}`).toEqual([]);
+  }, 3600000);
+
+  it.skipIf(!SLOW)('F-fuzz: four seeded standard-tier cases on a small domain (the 3-D air) [SLOW]', () => {
+    const r = sweep(2001, 4, 'standard');
+    record('F-fuzz-standard', { from: 2001, cases: 4, snapshots: r.snapshots, failingSeeds: r.failing.map((o) => o.seed), knownFindingF1Seeds: r.known, slowestS: r.slowest });
+    expect(r.failing.map((o) => o.seed), `fuzz invariants broke in the standard tier (a finding to report with these seeds):\n${message(r.failing)}`).toEqual([]);
+  }, 3600000);
+});
+
+/**
+ * Finding F1 (known gap, reported and not fixed here): `SimStats.headRos`, which the "Head fire" tile shows, is read from the stored rate of the
+ * freshest front cell, and an ignition cell keeps the model's own rate, which is not held to the level-set cap (SPREAD_PARAMS.levelSet.rosMaxMs, 6 m/s,
+ * 21.6 km/h, the cap the model card quotes). So a line ignition on steep ground shows a head rate far above the cap for the first minutes (seed 1027:
+ * 28.2 m/s, about 101 km/h; the front itself never outruns the cap: the sweep's arrival-time bound holds), and the last value is held after the front has
+ * died (seed 1030: 7.49 m/s with no cell burning). The same with embers off. This test pins it: it passes while the finding stands, and it fails the day the
+ * solver is fixed, so that the known gap in claims.json is closed in the same commit.
+ */
+describe('F-fuzz: known gap F1, the Head fire figure above the cap (pinned)', () => {
+  it('F-fuzz-F1: seeds 1027, 1030 and 1037 still show SimStats.headRos above the level-set cap (delete this test and close the known gap when it is fixed)', () => {
+    const seen = [1027, 1030, 1037].map((seed) => runCase(drawFuzz(seed)));
+    for (const o of seen) log(`F-fuzz-F1 ${o.label}: ${o.findings[0] ?? 'no longer above the cap'}`);
+    record('F-fuzz-F1', { seeds: seen.map((o) => o.seed), stillAboveCap: seen.map((o) => o.findings.length > 0), summary: seen.map((o) => `seed ${o.seed} (${o.label.split(': ')[1]!.split(',').slice(0, 7).join(',')}): ${(o.findings[0] ?? '').replace(/^F1: /, '')}`).join('; ') });
+    for (const o of seen) expect(o.findings.length, `seed ${o.seed}: F1 no longer shows, so the gap is fixed: close it in claims.json`).toBeGreaterThan(0);
+    // Everything else holds on these three seeds.
+    for (const o of seen) expect(o.problems, `seed ${o.seed}`).toEqual([]);
+  }, 600000);
+});
