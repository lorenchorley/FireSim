+++ b/src/ui/validityCard.ts
@@ -0,0 +1,87 @@
+/**
+ * The per-release validation card in "How sure are we?" (0.10.0; plan 15d idea 23), pure (no DOM). The words are here; every figure comes
+ * from card.json (src/sim/validation/card.json), which scripts/validity-card.mjs makes from the claims register, the golden files and the
+ * measured run, so nothing on the card is typed by hand. It says what was checked, what the checks compare with, how far finer cells
+ * change the answer, and what is not known, in the words of the register. It never says the simulation is validated: nothing here
+ * compares it with a recorded fire.
+ */
+import type { CardData } from '../sim/validation/cardData';
+import type { CardBlock, CardBullet, CardFact } from './modelInfo';
+
+const NB = ' ';
+const day = (iso: string): string => iso.slice(0, 10);
+const n = (v: number, one: string, many: string): string => `${v} ${v === 1 ? one : many}`;
+
+/** "10 % more" or "52 % less": how much more area the finer cells burn. */
+function moreOrLess(pct: number): string {
+  return pct === 0 ? 'the same area' : `${Math.abs(pct)}${NB}% ${pct > 0 ? 'more' : 'less'} area`;
+}
+
+/** The blocks of the card for "How sure are we?": what the checks did, the grid study, the tiers, the known gaps. */
+export function validityBlocks(c: CardData): CardBlock[] {
+  const p = c.properties;
+  const g = c.goldens;
+  const facts: CardFact[] = [
+    {
+      id: 'val-properties',
+      key: 'Properties that must hold',
+      value: `${p.hold} of ${p.total} hold`,
+      note:
+        'Turn the map, add wind, add moisture, put in a firebreak, change something later, refine the grid or the step: the result must change the way it should. ' +
+        `Run on random made-up terrains${p.findings > 0 ? `; ${n(p.findings, 'case', 'cases')} came out just outside the band set beforehand and ${p.findings === 1 ? 'is' : 'are'} kept as a known finding` : ''}.`,
+    },
+    {
+      id: 'val-golden',
+      key: 'Fixed scenarios',
+      value: `${g.hold} of ${g.total} unchanged`,
+      note: `${n(g.total, 'scenario', 'scenarios')} (flat, slope, ridge, wind change, Katoomba in the ${g.tiers.length > 1 ? 'Fast and Standard tiers' : 'Fast tier'}) are run at each release and compared with the stored results, so a change in results is noticed and explained.`,
+    },
+    {
+      id: 'val-stress',
+      key: 'Random stress cases',
+      value: `${c.fuzz.cases} run`,
+      note: `Gale and calm, bone dry and saturated, steep and flat, ignitions at an edge or a corner. No number went wrong, no area was impossible, no burnt cell un-burnt${c.fuzz.findings > 0 ? `; one displayed figure did go wrong in ${n(c.fuzz.findings, 'case', 'cases')} (below)` : ''}.`,
+    },
+    {
+      id: 'val-engines',
+      key: 'Same result in a browser',
+      value: c.engines.same ? 'Identical' : `${c.engines.scenariosIdentical} of ${c.engines.scenarios} identical`,
+      note: c.engines.same
+        ? `${n(c.engines.scenarios, 'scenario', 'scenarios')} run in Node and in a browser worker (${c.engines.browser}) gave the same result at all ${c.engines.marks} marks. No phone was tried.`
+        : `${n(c.engines.scenarios, 'scenario', 'scenarios')} run in Node and in a browser worker (${c.engines.browser}); ${c.engines.scenariosIdentical} gave the same result at every mark, the others differ in the last bits (burnt area, head rate and arrival times agree within ${c.engines.maxRelativePct}${NB}%). No phone was tried.`,
+    },
+    {
+      id: 'val-claims',
+      key: 'Claims in the register',
+      value: `${c.claims.total}`,
+      note: `Every number and behaviour this app shows, with its source and the check on it: ${c.claims.checked} checked, ${c.claims.partly} partly, ${c.claims.unchecked} not checked, ${c.claims.knownGap} known gaps.`,
+    },
+  ];
+  const grid: CardBullet[] = c.convergence.map((x) => ({
+    kind: 'note',
+    text: `${x.site}, ${x.hours} hours, ${x.embers ? 'with' : 'without'} embers: ${x.cellsM[1]}${NB}m cells burn ${moreOrLess(x.areaPct)} than ${x.cellsM[0]}${NB}m cells, and ${x.blocksPct}${NB}% of the 60${NB}m blocks that either run burnt are burnt in both.`,
+  }));
+  const gaps: CardBullet[] = c.knownGaps.map((text) => ({ kind: 'issue', text }));
+  return [
+    {
+      type: 'facts',
+      title: `Checked for each release (the run of ${day(c.run.ranAt)})`,
+      facts,
+    },
+    {
+      type: 'bullets',
+      title: 'How far a finer grid changes the answer',
+      bullets: [
+        ...grid,
+        { kind: 'note', text: 'Finer cells are a different setting of the same model, not a more accurate one: nothing shows which is closer to a real fire.' },
+      ],
+    },
+    { type: 'text', text: c.tiers.headline },
+    { type: 'bullets', title: 'Not known', bullets: gaps },
+    {
+      type: 'text',
+      tone: 'warn',
+      text: 'All of this compares the simulation with its own formulas, with published rules of thumb, with a finer run of itself or with itself turned or changed. None of it compares it with a recorded fire.',
+    },
+  ];
+}
