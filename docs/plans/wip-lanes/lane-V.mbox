diff --git a/e2e/validity-engines.spec.ts b/e2e/validity-engines.spec.ts
new file mode 100644
index 0000000..74fd539
--- /dev/null
+++ b/e2e/validity-engines.spec.ts
@@ -0,0 +1,166 @@
+/**
+ * Reproducibility across engines (plan 15d idea 19; contract 0.10.0, 4.3 item 7): the golden scenarios (src/sim/validation/golden/specs.ts) are built
+ * in Node and run there with the real `Simulation`; the same scenarios, as bytes, are handed to the production build's own SimClient, which runs the engine
+ * in a Web Worker of Chromium. The snapshot fingerprint (the golden hash: every typed array and value of the snapshot but the wall-clock field, the insights since
+ * the last picture and the ember landing layer) is taken at every golden mark in both places, with the very same code (the source text of engines.ts).
+ * The test fails if any differ, and says by how much: which marks, which parts of the snapshot, the burnt area and the largest difference of the arrival-time
+ * raster in seconds. If they differ it is a finding, and the goldens need a stated cross-engine tolerance (passMarks.json `crossEngine`).
+ * With FIRESIM_WRITE_CROSS_ENGINE=1 the outcome is written to src/sim/validation/results/cross-engine.json (the card and the register read it).
+ * One Node, one Chromium, one machine; no phone engine.
+ */
+import { execFileSync } from 'node:child_process';
+import { mkdirSync, readFileSync, writeFileSync } from 'node:fs';
+import { dirname, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import type { Page } from '@playwright/test';
+import { GOLDEN_HASH_SKIP } from '../src/sim/validation/golden/run';
+import { PAGE_HASH_SOURCE, REVIVE_SOURCE } from '../src/sim/validation/golden/engines';
+import { expect, test } from './fixtures';
+import { acceptNotice } from './helpers';
+
+const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');
+
+interface NodeRow {
+  hash: number;
+  parts: Record<string, number>;
+  burntAreaHa: number;
+}
+interface IndexEntry {
+  id: string;
+  tier: string;
+  until: number;
+  marks: number[];
+  node: { at: Record<string, NodeRow>; arrivalB64: string };
+}
+interface BrowserOut {
+  at: Record<string, NodeRow>;
+  arrivalB64: string;
+  workerKind: string;
+}
+
+/** Build any scenario through the UI so that the page holds the debug handle (the app's real services, the real worker). */
+async function openWithHandle(page: Page): Promise<void> {
+  await page.goto('/?debug=1');
+  await page.getByTestId('setup').waitFor();
+  await page.waitForTimeout(1200);
+  if (await page.getByTestId('notice').count()) await acceptNotice(page);
+  await page.getByTestId('site-katoomba').click();
+  await page.getByTestId('weather-source').getByRole('radio', { name: 'Preset' }).check();
+  await page.getByTestId('preset-hot-nw-sw-change').click();
+  const online = page.getByTestId('online').getByRole('switch');
+  if (await online.isChecked()) await page.getByTestId('online').click();
+  await page.getByTestId('detail').getByRole('radio', { name: /Fast/ }).check({ force: true });
+  await page.getByTestId('duration').getByRole('radio', { name: /^1 h/ }).check({ force: true });
+  await page.getByTestId('build').click();
+  await expect(page.getByTestId('sim')).toBeVisible({ timeout: 180_000 });
+}
+
+const decode = (b64: string): Float32Array => {
+  const b = Buffer.from(b64, 'base64');
+  return new Float32Array(b.buffer.slice(b.byteOffset, b.byteOffset + b.byteLength));
+};
+
+test('the golden scenarios give the same snapshot hashes in Node and in a browser worker', async ({ page }, testInfo) => {
+  test.setTimeout(1_800_000);
+  const dir = testInfo.outputPath('validity');
+  mkdirSync(dir, { recursive: true });
+  // Node: build, serialise and run every golden scenario (about a minute).
+  execFileSync('node', ['scripts/validity-engines-export.mjs', dir], { cwd: root, stdio: 'inherit', timeout: 900_000 });
+  const index = JSON.parse(readFileSync(resolve(dir, 'index.json'), 'utf8')) as { skip: string[]; scenarios: IndexEntry[] };
+  expect(index.skip).toEqual([...GOLDEN_HASH_SKIP]);
+  await page.route('**/__validity/*', async (route) => {
+    const name = route.request().url().split('/__validity/')[1]!.split('?')[0]!;
+    const body = readFileSync(resolve(dir, name));
+    await route.fulfill({ body, contentType: name.endsWith('.json') ? 'application/json' : 'application/octet-stream' });
+  });
+  await openWithHandle(page);
+  const browser = `Chromium ${page.context().browser()?.version() ?? '?'}`;
+
+  const differences: string[] = [];
+  const perScenario: Record<string, unknown>[] = [];
+  let marksCompared = 0;
+  for (const sc of index.scenarios) {
+    const out = (await page.evaluate(
+      async ({ id, marks, hashSrc, reviveSrc, skip }) => {
+        const fs = (window as unknown as { __firesim: { services: { createLocalController(): { init(s: unknown): Promise<unknown>; run(t: number): void; on(e: string, cb: (s: any) => void): () => void; dispose(): void } } } }).__firesim;
+        const hasher = (0, eval)(hashSrc) as { hash(s: unknown, k: string[]): number; parts(s: unknown, k: string[]): Record<string, number> };
+        const revive = (0, eval)(reviveSrc) as (v: unknown, buf: ArrayBuffer) => unknown;
+        const json = await (await fetch(`__validity/${id}.json`)).json();
+        const buf = await (await fetch(`__validity/${id}.bin`)).arrayBuffer();
+        const scenario = revive(json, buf);
+        const c = fs.services.createLocalController();
+        const res: { at: Record<string, { hash: number; parts: Record<string, number>; burntAreaHa: number }>; arrivalB64: string; workerKind: string } = { at: {}, arrivalB64: '', workerKind: typeof Worker === 'function' ? 'Web Worker' : 'in-thread' };
+        const last = marks[marks.length - 1]!;
+        c.on('snapshot', (s: any) => {
+          if (!marks.includes(s.time) || String(s.time) in res.at) return;
+          res.at[String(s.time)] = { hash: hasher.hash(s, skip), parts: hasher.parts(s, skip), burntAreaHa: s.stats.burntAreaHa };
+          if (s.time === last) {
+            const a = new Uint8Array(s.fire.arrivalTime.buffer, s.fire.arrivalTime.byteOffset, s.fire.arrivalTime.byteLength);
+            let bin = '';
+            for (let i = 0; i < a.length; i += 8192) bin += String.fromCharCode(...a.subarray(i, i + 8192));
+            res.arrivalB64 = btoa(bin);
+          }
+        });
+        await c.init(scenario);
+        for (const m of marks) {
+          await new Promise<void>((done) => {
+            const off = c.on('snapshot', (s: any) => {
+              if (s.time >= m - 1e-6) {
+                off();
+                done();
+              }
+            });
+            c.run(m);
+          });
+        }
+        c.dispose();
+        return res;
+      },
+      { id: sc.id, marks: sc.marks, hashSrc: PAGE_HASH_SOURCE, reviveSrc: REVIVE_SOURCE, skip: index.skip },
+    )) as BrowserOut;
+    expect(out.workerKind, 'the engine ran in a Web Worker').toBe('Web Worker');
+    const diffs: string[] = [];
+    for (const m of sc.marks) {
+      marksCompared++;
+      const n = sc.node.at[String(m)]!;
+      const b = out.at[String(m)];
+      if (!b) {
+        diffs.push(`no snapshot at ${m} s in the browser`);
+        continue;
+      }
+      if (n.hash === b.hash) continue;
+      const parts = Object.keys(n.parts).filter((k) => n.parts[k] !== b.parts[k]);
+      diffs.push(`at ${m} s the hashes differ (Node ${n.hash}, browser ${b.hash}); parts that differ: ${parts.join(', ') || 'none found'}; burnt area ${n.burntAreaHa} ha in Node, ${b.burntAreaHa} ha in the browser`);
+    }
+    let maxArrival = 0;
+    let finiteMismatch = 0;
+    let cells = 0;
+    if (out.arrivalB64) {
+      const a = decode(sc.node.arrivalB64);
+      const b = decode(out.arrivalB64);
+      for (let k = 0; k < a.length; k++) {
+        const fa = Number.isFinite(a[k]!);
+        const fb = Number.isFinite(b[k]!);
+        if (fa !== fb) finiteMismatch++;
+        else if (fa) {
+          cells++;
+          maxArrival = Math.max(maxArrival, Math.abs(a[k]! - b[k]!));
+        }
+      }
+    }
+    if (diffs.length) diffs.push(`final arrival-time raster: largest difference ${maxArrival} s over ${cells} burnt cells, ${finiteMismatch} cells burnt in one and not the other`);
+    perScenario.push({ id: sc.id, tier: sc.tier, marks: sc.marks, identical: diffs.length === 0, arrivalMaxDifferenceS: maxArrival, cellsBurnt: cells });
+    differences.push(...diffs.map((d) => `${sc.id}: ${d}`));
+    console.log(`[validity-engines] ${sc.id}: ${diffs.length ? diffs.join(' | ') : `identical at all ${sc.marks.length} marks`}`);
+  }
+  const same = differences.length === 0;
+  const summary = same
+    ? `The ${index.scenarios.length} golden scenarios gave the same snapshot hash at all ${marksCompared} marks in Node (${process.version}) and in a Web Worker of ${browser}.`
+    : `The golden scenarios gave different snapshots in Node (${process.version}) and in a Web Worker of ${browser}: ${differences.join('; ')}`;
+  const result = { same, marks: marksCompared, scenarios: index.scenarios.length, browser, node: process.version, ranAt: new Date().toISOString(), summary, perScenario, differences };
+  if (process.env['FIRESIM_WRITE_CROSS_ENGINE']) {
+    mkdirSync(resolve(root, 'src/sim/validation/results'), { recursive: true });
+    writeFileSync(resolve(root, 'src/sim/validation/results/cross-engine.json'), `${JSON.stringify(result, null, 2)}\n`);
+  }
+  expect(differences, `Node and the browser worker disagree (a finding: the goldens need a cross-engine tolerance):\n${differences.join('\n')}`).toEqual([]);
+});
diff --git a/scripts/validity-engines-export.mjs b/scripts/validity-engines-export.mjs
new file mode 100644
index 0000000..4b111fe
--- /dev/null
+++ b/scripts/validity-engines-export.mjs
@@ -0,0 +1,71 @@
+#!/usr/bin/env node
+/**
+ * Prepares the cross-engine check (plan 15d idea 19; e2e/validity-engines.spec.ts): for each golden scenario (src/sim/validation/golden/specs.ts)
+ * builds the scenario in Node, writes it as JSON plus one binary blob (a browser page rebuilds it from them), and runs it here with the real
+ * `Simulation` to record what Node gives at each golden mark: the snapshot hash (the same code the page runs), the part hashes, the burnt area and
+ * the final arrival-time raster.
+ *
+ *   node scripts/validity-engines-export.mjs <outdir> [golden id]
+ *
+ * Writes <outdir>/<id>.json, <outdir>/<id>.bin and <outdir>/index.json. Takes about a minute (the Standard tier is the slow one).
+ */
+import { createServer } from 'vite';
+import { mkdirSync, writeFileSync } from 'node:fs';
+import { dirname, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');
+const outDir = process.argv[2];
+const only = process.argv[3] ?? null; // a golden id: export just that one (a quick try)
+if (!outDir) throw new Error('usage: validity-engines-export.mjs <outdir>');
+mkdirSync(outDir, { recursive: true });
+
+const server = await createServer({
+  root,
+  configFile: false,
+  logLevel: 'error',
+  appType: 'custom',
+  server: { middlewareMode: true, hmr: false, watch: null },
+  optimizeDeps: { noDiscovery: true, include: [] },
+  resolve: { alias: { '@': resolve(root, 'src') } },
+});
+const index = [];
+try {
+  const { GOLDEN_SPECS } = await server.ssrLoadModule('/src/sim/validation/golden/specs.ts');
+  const { GOLDEN_HASH_SKIP } = await server.ssrLoadModule('/src/sim/validation/golden/run.ts');
+  const { serializeScenario, pageHasher } = await server.ssrLoadModule('/src/sim/validation/golden/engines.ts');
+  const { Simulation } = await server.ssrLoadModule('/src/sim/simulation.ts');
+  const hasher = pageHasher();
+  for (const spec of GOLDEN_SPECS.filter((x) => !only || x.id === only)) {
+    const c0 = Date.now();
+    const scenario = await spec.build();
+    const { json, blob } = serializeScenario(scenario);
+    writeFileSync(resolve(outDir, `${spec.id}.json`), JSON.stringify(json));
+    writeFileSync(resolve(outDir, `${spec.id}.bin`), blob);
+    const marks = new Set(spec.marks);
+    const at = {};
+    const sim = new Simulation(scenario, {
+      tier: spec.tier,
+      hooks: {
+        snapshot: (s) => {
+          if (marks.has(s.time)) at[s.time] = { hash: hasher.hash(s, GOLDEN_HASH_SKIP), parts: hasher.parts(s, GOLDEN_HASH_SKIP), burntAreaHa: s.stats.burntAreaHa };
+        },
+      },
+    });
+    sim.spinUp();
+    sim.advance(spec.until);
+    const arrival = sim.stateView().fire.arrivalTime;
+    index.push({
+      id: spec.id,
+      tier: spec.tier,
+      until: spec.until,
+      marks: spec.marks,
+      node: { at, arrivalB64: Buffer.from(arrival.buffer, arrival.byteOffset, arrival.byteLength).toString('base64') },
+    });
+    console.log(`${spec.id}: ${(blob.byteLength / 1e6).toFixed(1)} MB scenario, ${((Date.now() - c0) / 1000).toFixed(1)} s`);
+  }
+  writeFileSync(resolve(outDir, 'index.json'), JSON.stringify({ skip: GOLDEN_HASH_SKIP, scenarios: index }));
+} finally {
+  await server.close();
+}
+process.exit(0);

