@@ -0,0 +1,228 @@
+/**
+ * The fuzz cases of 0.10.0 (fuzz.test.ts): a seed names a random terrain, weather and ignitions, extremes included, and a stream checker
+ * that holds the invariants of passMarks.json (`fuzz`) against every snapshot of a run. Pure and seeded: `drawFuzz(1017)` is the same
+ * case on any machine, so a failing seed in a report is a reproduction. Not imported by application code.
+ */
+import { Rng } from '../../core/rng';
+import { BurnState, FuelType, SpreadDriver, type Ignition, type QualityTier, type ScenarioData, type SimSnapshot } from '../../core/types';
+import { SPREAD_PARAMS } from '../../fire/spread';
+import { FUZZ_FUELS, elevationOf, randomTerrain } from './randomCases';
+import { synth } from './harness';
+
+export interface FuzzCase {
+  seed: number;
+  tier: QualityTier;
+  extentM: number;
+  cellM: number;
+  durationS: number;
+  windKmh: number;
+  windFromDeg: number;
+  temperatureC: number;
+  rhPct: number;
+  cloudPct: number;
+  droughtFactor: number;
+  fuel: FuelType;
+  embers: boolean;
+  coupling: number;
+  mountainPhenomena: boolean;
+  /** A constant dead fuel moisture (percent) forced through the test hook, or null for the model's own. */
+  moistureHookPct: number | null;
+  ignitions: Ignition[];
+  /** A one-line description (printed with the seed). */
+  label: string;
+  scenario: ScenarioData;
+}
+
+const pick = <T>(r: Rng, xs: readonly T[]): T => xs[r.int(xs.length)]!;
+
+/** A seeded fuzz case. `tier` 'standard' draws a smaller domain (the 3-D air costs more). */
+export function drawFuzz(seed: number, tier: QualityTier = 'fast'): FuzzCase {
+  const r = new Rng(seed * 7919 + 3);
+  const small = tier !== 'fast';
+  const extentM = small ? pick(r, [900, 1200, 1500]) : pick(r, [600, 900, 1500, 2100, 3000]);
+  const cellM = pick(r, [20, 30, 40]);
+  const durationS = small ? 60 * (15 + r.int(16)) : 60 * (20 + r.int(41));
+  // Extremes are drawn on purpose: calm, gale, bone dry, saturated.
+  const windKmh = r.next() < 0.1 ? 0 : r.next() < 0.1 ? 120 : Math.round(r.range(0, 120));
+  const rhPct = r.next() < 0.1 ? 2 : r.next() < 0.1 ? 100 : Math.round(r.range(2, 100));
+  const temperatureC = Math.round(r.range(-5, 48));
+  const cloudPct = Math.round(r.range(0, 100));
+  const droughtFactor = r.next() < 0.15 ? 0 : r.next() < 0.15 ? 10 : Math.round(r.range(0, 10));
+  const fuel = pick(r, FUZZ_FUELS);
+  const embers = r.next() < 0.5;
+  const coupling = r.next() < 0.2 ? 0 : 1;
+  const mountainPhenomena = r.next() < 0.8;
+  const moistureHookPct = r.next() < 0.25 ? pick(r, [0, 1, 3, 6, 12, 25, 60, 100]) : null;
+  const windFromDeg = Math.round(r.range(0, 360));
+
+  const terrain = randomTerrain(seed, { extent: extentM, planeDeg: r.range(0, 55), hills: 1 + r.int(6), hillM: r.range(15, 420), minWidthM: r.range(60, 400) });
+  const half = (extentM / cellM - 1) * cellM * 0.5;
+  const edge = (): number => (r.next() < 0.5 ? -1 : 1) * Math.floor(half * 0.97);
+  const spot = (): [number, number] => {
+    const q = r.next();
+    if (q < 0.15) return [edge(), edge()]; // a corner
+    if (q < 0.3) return r.next() < 0.5 ? [edge(), Math.round(r.range(-half, half))] : [Math.round(r.range(-half, half)), edge()]; // an edge
+    return [Math.round(r.range(-half * 0.9, half * 0.9)), Math.round(r.range(-half * 0.9, half * 0.9))];
+  };
+  const ignitions: Ignition[] = [];
+  for (let i = 0, n = 1 + r.int(3); i < n; i++) {
+    const time = r.next() < 0.6 ? 0 : 60 * r.int(Math.max(1, Math.floor(durationS / 120)));
+    if (r.next() < 0.65) ignitions.push({ id: `p${i}`, kind: 'point', points: [spot()], time, radius: Math.round(r.range(15, 60)), origin: 'observed' });
+    else ignitions.push({ id: `l${i}`, kind: 'line', points: [spot(), spot(), ...(r.next() < 0.5 ? [spot()] : [])], time, origin: 'observed' });
+  }
+
+  // Patches of another fuel type (and of ground that cannot burn) so that the map is not one uniform type.
+  const patches = Array.from({ length: r.int(4) }, () => ({ x: r.range(-half, half), y: r.range(-half, half), rad: r.range(60, 500), type: r.next() < 0.4 ? FuelType.NonFuel : pick(r, FUZZ_FUELS) }));
+  const scenario = synth({
+    extent: extentM,
+    cellSize: cellM,
+    elevation: elevationOf(terrain),
+    fuelType: fuel,
+    fuelOverride: (x, y) => patches.find((p) => Math.hypot(x - p.x, y - p.y) < p.rad)?.type ?? null,
+    windKmh,
+    windFromDeg,
+    temperature: temperatureC,
+    rh: rhPct,
+    cloud: cloudPct,
+    droughtFactor,
+    duration: durationS,
+    ignitions,
+    options: { embers, coupling, mountainPhenomena, seed: 1 + r.int(1000), maxEmbers: 1500 },
+  });
+  const label =
+    `seed ${seed} ${tier}: ${extentM} m domain, ${cellM} m cells, ${durationS / 60} min, wind ${windKmh} km/h from ${windFromDeg}, ${temperatureC} C, RH ${rhPct} %, cloud ${cloudPct} %, DF ${droughtFactor}, ` +
+    `fuel ${FuelType[fuel]}, embers ${embers ? 'on' : 'off'}, coupling ${coupling}, mountain ${mountainPhenomena ? 'on' : 'off'}, moisture ${moistureHookPct === null ? 'model' : `${moistureHookPct} %`}, ` +
+    `${ignitions.map((i) => `${i.kind}@${i.time}s`).join(' + ')}`;
+  return { seed, tier, extentM, cellM, durationS, windKmh, windFromDeg, temperatureC, rhPct, cloudPct, droughtFactor, fuel, embers, coupling, mountainPhenomena, moistureHookPct, ignitions, label, scenario };
+}
+
+/** Distance (m) from a point to a polyline (or a single point) in local metres. */
+function distanceTo(points: readonly [number, number][], px: number, py: number): number {
+  if (points.length === 1) return Math.hypot(px - points[0]![0], py - points[0]![1]);
+  let best = Infinity;
+  for (let i = 0; i + 1 < points.length; i++) {
+    const [ax, ay] = points[i]!;
+    const [bx, by] = points[i + 1]!;
+    const dx = bx - ax;
+    const dy = by - ay;
+    const t = dx === 0 && dy === 0 ? 0 : Math.max(0, Math.min(1, ((px - ax) * dx + (py - ay) * dy) / (dx * dx + dy * dy)));
+    best = Math.min(best, Math.hypot(px - (ax + t * dx), py - (ay + t * dy)));
+  }
+  return best;
+}
+
+/** Checks the fuzz invariants against a stream of snapshots; `problems` collects what broke (the first few of each kind). */
+export class FuzzStream {
+  readonly problems: string[] = [];
+  snapshots = 0;
+  private prevTime = -Infinity;
+  private prevArea = 0;
+  private prevArrival: Float32Array | null = null;
+  private lastArrival: Float32Array | null = null;
+  private readonly counts = new Map<string, number>();
+  readonly cap = SPREAD_PARAMS.levelSet.rosMaxMs;
+
+  constructor(private readonly c: FuzzCase) {}
+
+  /** Known findings (reported, not fixed here): the first few of each. */
+  readonly findings: string[] = [];
+
+  private finding(id: string, detail: string): void {
+    const n = (this.counts.get(id) ?? 0) + 1;
+    this.counts.set(id, n);
+    if (n <= 3) this.findings.push(`${id}: ${detail}`);
+  }
+
+  private bad(kind: string, detail: string): void {
+    const n = (this.counts.get(kind) ?? 0) + 1;
+    this.counts.set(kind, n);
+    if (n <= 3) this.problems.push(`${kind}: ${detail}`);
+  }
+
+  private nan(name: string, a: ArrayLike<number>, t: number): void {
+    for (let k = 0; k < a.length; k++)
+      if (Number.isNaN(a[k]!)) {
+        this.bad(`NaN in ${name}`, `cell ${k} at ${t} s`);
+        return;
+      }
+  }
+
+  push(s: SimSnapshot): void {
+    this.snapshots++;
+    const t = s.time;
+    const n = s.fire.arrivalTime.length;
+    if (!(t >= this.prevTime)) this.bad('time went back', `${this.prevTime} s then ${t} s`);
+    this.prevTime = t;
+    const f = s.fire;
+    // The arrival time of an unburnt cell is Infinity (allowed); NaN is not. `spreadDir` is the direction of the spread: NaN where no
+    // front has been (a sentinel the other checks rely on), so it is checked where the cell has burnt.
+    this.nan('arrivalTime', f.arrivalTime, t);
+    for (const [name, a] of [['ros', f.ros], ['intensity', f.intensity], ['flameHeight', f.flameHeight], ['moisture', s.moisture]] as const) this.nan(name, a, t);
+    for (let k = 0; k < n; k++) {
+      if (Number.isFinite(f.arrivalTime[k]!) && Number.isNaN(f.spreadDir[k]!) && f.driver[k] !== SpreadDriver.None) {
+        this.bad('NaN in spreadDir of a burnt cell', `cell ${k} at ${t} s, driver ${SpreadDriver[f.driver[k]!]}`);
+        break;
+      }
+    }
+    if (s.fireWind) this.nan('fireWind', s.fireWind.u, t);
+    const e = s.embers;
+    for (let i = 0; i < e.count * 4 && i < e.data.length; i++)
+      if (Number.isNaN(e.data[i]!)) {
+        this.bad('NaN in embers', `value ${i} at ${t} s`);
+        break;
+      }
+    // `deadFuelMoistureMean` is the mean over the unburnt burnable cells and is NaN by design when none is left (src/sim/stats.ts moistureMean;
+    // the UI shows a dash): allowed then, a finding anywhere else (passMarks.json, revisions).
+    let unburntBurnable = 0;
+    for (let k = 0; k < n && unburntBurnable === 0; k++) if (f.burnState[k] !== BurnState.NonFlammable && f.arrivalTime[k] === Infinity) unburntBurnable++;
+    for (const [k, v] of Object.entries(s.stats)) {
+      if (typeof v !== 'number' || Number.isFinite(v) || k === 'msPerSimMinute') continue;
+      if (k === 'deadFuelMoistureMean' && unburntBurnable === 0) continue;
+      this.bad(`non-finite stat ${k}`, `${v} at ${t} s`);
+    }
+    const area = s.stats.burntAreaHa;
+    const domainHa = (n * this.c.cellM * this.c.cellM) / 1e4;
+    if (!(area >= 0)) this.bad('negative burnt area', `${area} ha at ${t} s`);
+    if (area > domainHa + 1e-6) this.bad('burnt area above the domain', `${area} ha of ${domainHa} ha at ${t} s`);
+    if (area < this.prevArea - 1e-9) this.bad('burnt area decreased', `${this.prevArea} to ${area} ha at ${t} s`);
+    this.prevArea = Math.max(this.prevArea, area);
+    // Finding F1 (known gap, pinned by fuzz.test.ts): SimStats.headRos is read from the stored rate of an ignition cell, which is not held to
+    // the cap, and it is also held after the front has died. Kept apart so that the sweep still catches every other way past the cap.
+    if (s.stats.headRos > this.cap * (1 + 1e-6)) this.finding('F1', `head rate of spread above the cap: ${s.stats.headRos} m/s at ${t} s (cap ${this.cap}), ${s.stats.burningCells} cells burning`);
+    if (s.stats.maxRos > this.cap * (1 + 1e-6)) this.bad('rate of spread above the cap', `${s.stats.maxRos} m/s at ${t} s (cap ${this.cap})`);
+    if (this.prevArrival) {
+      for (let k = 0; k < n; k++) {
+        const before = this.prevArrival[k]!;
+        if (Number.isFinite(before) && f.arrivalTime[k] !== before) {
+          this.bad('a burnt cell changed its arrival time (or un-burnt)', `cell ${k}: ${before} then ${f.arrivalTime[k]} at ${t} s`);
+          break;
+        }
+      }
+    }
+    this.prevArrival = f.arrivalTime.slice();
+    this.lastArrival = this.prevArrival;
+  }
+
+  /** After the run: with embers off no cell is reached sooner than its distance from the nearest ignition over the cap, to within two cells. */
+  finish(): string[] {
+    const a = this.lastArrival;
+    if (a && !this.c.embers) {
+      const g = this.c.scenario.terrain.grid;
+      const slack = 2 * this.c.cellM;
+      for (let j = 0; j < g.ny; j++)
+        for (let i = 0; i < g.nx; i++) {
+          const ta = a[j * g.nx + i]!;
+          if (!Number.isFinite(ta)) continue;
+          const x = g.x0 + i * g.cellSize;
+          const y = g.y0 + j * g.cellSize;
+          let bound = Infinity;
+          for (const ig of this.c.ignitions) bound = Math.min(bound, ig.time + Math.max(0, distanceTo(ig.points, x, y) - (ig.radius ?? 0) - slack) / this.cap);
+          if (ta < bound - 1e-3) {
+            this.bad('runaway growth: a cell reached faster than the cap allows', `cell (${i}, ${j}) at ${ta.toFixed(1)} s, not before ${bound.toFixed(1)} s`);
+            break;
+          }
+        }
+    }
+    return this.problems;
+  }
+}
