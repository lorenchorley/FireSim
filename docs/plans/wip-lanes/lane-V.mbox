--- /dev/null
+++ b/studies/simulation-validity/tiers/summarize.mjs
@@ -0,0 +1,142 @@
+// Turns the row files of the tier comparison (run by studies/desktop-simulation/01-cost-vs-detail/scripts/run-batch.mjs from specs.json)
+// into summary.json: per row the burnt area and perimeter at each hour, and per pair of rows the area ratio at each hour, the overlap of the
+// 60 m blocks burnt at the end and the arrival-time difference between blocks burnt in both (the same measures as the desktop study's
+// convergence-diff.json). The pass mark of the comparison is the one written before the run (src/sim/validation/passMarks.json, `tiers`).
+//   node summarize.mjs <rundir> <outfile> <commit>
+import { readdirSync, readFileSync, writeFileSync } from 'node:fs';
+import { resolve, dirname } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const here = dirname(fileURLToPath(import.meta.url));
+const marks = JSON.parse(readFileSync(resolve(here, '../../../src/sim/validation/passMarks.json'), 'utf8')).marks.tiers;
+const [runDir, outFile, commit] = process.argv.slice(2);
+if (!runDir || !outFile) throw new Error('usage: summarize.mjs <rundir> <outfile> <commit>');
+
+const rows = {};
+for (const n of readdirSync(runDir)) {
+  if (!n.endsWith('.json') || n.endsWith('.spec.json')) continue;
+  const r = JSON.parse(readFileSync(resolve(runDir, n), 'utf8'));
+  rows[r.spec.id] = r;
+}
+const q = (v, p) => {
+  if (!v.length) return null;
+  const s = [...v].sort((a, b) => a - b);
+  return s[Math.min(s.length - 1, Math.max(0, Math.round(p * (s.length - 1))))];
+};
+const round = (x, d = 1) => (typeof x === 'number' ? Math.round(x * 10 ** d) / 10 ** d : x);
+
+const SITES = { katoomba: { hours: 3, label: 'Katoomba' }, warrumbungles: { hours: 2, label: 'the Warrumbungles' } };
+const PAIRS = [
+  ['F30', 'S30', 'Standard against Fast (both 30 m cells)'],
+  ['F30', 'H30', 'High air against Fast (both 30 m cells)'],
+  ['F30', 'H20', 'High as the app builds it (20 m cells) against Fast'],
+  ['F30', 'F20', 'Fast at 20 m cells against Fast at 30 m (the cell alone)'],
+  ['F20', 'H20', 'High against Fast, both 20 m cells (the air alone)'],
+  ['S30', 'H30', 'High air against Standard (both 30 m cells)'],
+];
+const out = {
+  about:
+    'How far the Fast, Standard and High tiers differ on real terrain with a fire (plan 15d idea 21). Node runs of the real Simulation on the bundled sites with the V20 preset and the ignitions of the desktop study (studies/desktop-simulation/01-cost-vs-detail), seed 1, 6 km, ONE REALISATION PER ROW, one 4 vCPU shared machine, no phone, no browser. Embers on and off: with embers the random draws change with every setting, so differences mix the air, the cell and chance; without embers they are the air and the cell only. A difference between tiers is a difference between model settings: nothing here says which is closer to a real fire.',
+  passMark: marks,
+  commit: commit ?? null,
+  sites: {},
+};
+const verdicts = [];
+for (const [site, meta] of Object.entries(SITES)) {
+  out.sites[site] = { label: meta.label, hours: meta.hours };
+  for (const embers of ['noembers', 'embers']) {
+    const id = (t) => `${site}-${t}-${embers}`;
+    const have = ['F30', 'S30', 'H30', 'F20', 'H20'].filter((t) => rows[id(t)] && !rows[id(t)].error && rows[id(t)].summaryData);
+    const set = { rows: {}, pairs: [] };
+    for (const t of have) {
+      const r = rows[id(t)];
+      const d = r.summaryData;
+      const at = (h) => d.timesS.indexOf(h * 3600);
+      set.rows[t] = {
+        tier: r.spec.tier,
+        cellM: r.spec.cell,
+        simulatedH: r.simTimeS / 3600,
+        truncatedAtS: r.truncatedAtS ?? null,
+        areaHaAtHours: Object.fromEntries(Array.from({ length: meta.hours }, (_, i) => [i + 1, round(d.areaHa[at(i + 1)], 1)])),
+        perimeterKmAtEnd: round(d.perimeterM[d.perimeterM.length - 1] / 1000, 1),
+        wallPerSimHourS: round(r.wallPerSimHourS, 1),
+        peakRssMB: r.peak?.maxRssProcessMB ?? null,
+      };
+    }
+    for (const [a, b, label] of PAIRS) {
+      if (!have.includes(a) || !have.includes(b)) continue;
+      const A = rows[id(a)].summaryData;
+      const B = rows[id(b)].summaryData;
+      const ca = A.coarse;
+      const cb = B.coarse;
+      let both = 0;
+      let onlyA = 0;
+      let onlyB = 0;
+      const dt = [];
+      for (let k = 0; k < ca.n * ca.n; k++) {
+        const x = ca.burntFrac[k] >= 128;
+        const y = cb.burntFrac[k] >= 128;
+        if (x && y) {
+          both++;
+          if (ca.meanArrivalS[k] >= 0 && cb.meanArrivalS[k] >= 0) dt.push(Math.abs((cb.meanArrivalS[k] - ca.meanArrivalS[k]) / 60));
+        } else if (x) onlyA++;
+        else if (y) onlyB++;
+      }
+      const ratioAt = (h) => {
+        const i = A.timesS.indexOf(h * 3600);
+        return A.areaHa[i] > 0 ? B.areaHa[i] / A.areaHa[i] : null;
+      };
+      const end = meta.hours;
+      const pair = {
+        a,
+        b,
+        label,
+        areaRatioBoverA: Object.fromEntries(Array.from({ length: end }, (_, i) => [i + 1, round(ratioAt(i + 1), 3)])),
+        blocksBurntInBoth: both,
+        blocksOnlyA: onlyA,
+        blocksOnlyB: onlyB,
+        jaccardAtEnd: round(both / (both + onlyA + onlyB), 3),
+        arrivalErrorMinAbs: { p50: round(q(dt, 0.5), 1), p90: round(q(dt, 0.9), 1) },
+      };
+      // The pass mark written before the run: a 3-D tier against Fast, at every hour within the band, and the block overlap at the end.
+      if (a === 'F30' && ['S30', 'H30', 'H20'].includes(b)) {
+        const within = Object.values(pair.areaRatioBoverA).every((v) => v !== null && Math.abs(v - 1) <= marks.bandFraction);
+        const overlap = pair.jaccardAtEnd >= marks.jaccardMin;
+        pair.meetsMark = { areaWithinBandAtEveryHour: within, blockOverlapAtLeastMin: overlap, both: within && overlap };
+        verdicts.push({ site, embers, tier: b, ...pair.meetsMark, finalRatio: pair.areaRatioBoverA[end], jaccard: pair.jaccardAtEnd });
+      }
+      set.pairs.push(pair);
+    }
+    out.sites[site][embers] = set;
+  }
+}
+// The sentence the card and the register quote: every figure in it is computed here from the pairs above.
+const pairOf = (site, embers, a, b) => out.sites[site][embers]?.pairs.find((p) => p.a === a && p.b === b);
+const endRatio = (site, p) => p.areaRatioBoverA[SITES[site].hours];
+const pctOf = (r) => Math.round(Math.abs(r - 1) * 100);
+const range = (xs) => [Math.min(...xs), Math.max(...xs)];
+const span = (xs) => {
+  const [lo, hi] = range(xs);
+  return lo === hi ? `${lo}` : `${lo} to ${hi}`;
+};
+const gather = (embers, a, b) => Object.keys(SITES).map((site) => [site, pairOf(site, embers, a, b)]).filter(([, p]) => p);
+/** The size of the difference at the end (percent) and the block overlap (percent) of a comparison on every site that has it. */
+const effect = (embers, pairs) => {
+  const ps = pairs.flatMap(([a, b]) => gather(embers, a, b));
+  return { diff: ps.map(([site, p]) => pctOf(endRatio(site, p))), overlap: ps.map(([, p]) => Math.round(p.jaccardAtEnd * 100)) };
+};
+const airOff = effect('noembers', [['F30', 'S30'], ['F30', 'H30']]);
+const cellOff = effect('noembers', [['F30', 'F20']]);
+const builtOff = effect('noembers', [['F30', 'H20']]);
+const airOn = effect('embers', [['F30', 'S30'], ['F30', 'H30']]);
+const builtOn = effect('embers', [['F30', 'H20']]);
+const met = verdicts.filter((v) => v.both).length;
+out.verdicts = verdicts;
+out.headline =
+  `Without embers, the Standard air and the High air on the same 30 m cells changed the burnt area at the end of the run by ${span(airOff.diff)} percent against the Fast tier, with ${span(airOff.overlap)} percent of the 60 m blocks burnt in both, ` +
+  `on Katoomba and the Warrumbungles; the finer 20 m cell alone changed it by ${span(cellOff.diff)} percent, and the High tier as the app builds it (20 m cells) by ${span(builtOff.diff)} percent. ` +
+  `With embers the random draws change with every setting and the differences grow: the 3-D tiers at 30 m by ${span(airOn.diff)} percent and the High tier as built by ${span(builtOn.diff)} percent. ` +
+  `${met} of ${verdicts.length} comparisons with the Fast tier met the pass mark written beforehand (burnt area within ${Math.round(marks.bandFraction * 100)} percent at every hour and at least ${Math.round(marks.jaccardMin * 100)} percent of the blocks burnt in both). ` +
+  'One realisation per row; these are differences between settings of the same model, and none is shown to be closer to a real fire.';
+writeFileSync(outFile, `${JSON.stringify(out, null, 2)}\n`);
+console.log(`wrote ${outFile}: ${Object.keys(rows).length} rows, ${verdicts.length} pass-mark verdicts\n${out.headline}`);
