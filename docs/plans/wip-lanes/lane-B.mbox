diff --git a/src/scenario/cliffs.rule10.test.ts b/src/scenario/cliffs.rule10.test.ts
new file mode 100644
index 0000000..f493cad
--- /dev/null
+++ b/src/scenario/cliffs.rule10.test.ts
@@ -0,0 +1,227 @@
+/**
+ * Plan section 4, rule 10 for the hand-mapped cliffs (contract 0.10.0 section 4.5; H-sim stays blocked): a map of the cliffs changes the
+ * drawing and the Data sets Terrain card, and NOTHING the simulation reads or a person is shown as a number. Three proofs:
+ *   1. the same Katoomba scenario built with and without a cliffs file is the same scenario, array for array (terrain, slopes, fuel,
+ *      weather, the 10 m ground), and the same run, snapshot hash for snapshot hash, while the drawing built from it differs;
+ *   2. what the drawing is built from is never modified, before or after the map is applied;
+ *   3. no module the simulation, the atmosphere, the fire model, the fuel map, the terrain analysis, the explanations, the desktop host or the
+ *      shared types imports can reach the modules that hold a map: the repository is held to it by reading its import lines.
+ * The cliffs are synthetic (tests/fixtures/cliffs): no cliff has been mapped and nothing is in public/demo.
+ */
+import { readdirSync, readFileSync } from 'node:fs';
+import { readFile } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import { afterAll, afterEach, beforeAll, describe, expect, it } from 'vitest';
+import type { ScenarioData } from '../core/types';
+import { CLIFFS_FILE, clearBundleManifestCache, loadBundleManifest, setAssetLoader, type BundleManifest } from '../data';
+import { buildCliffDrawing } from '../render/cliffDrawing';
+import { hornSlopeDeg } from '../render/cliffSharpen';
+import { Simulation } from '../sim/simulation';
+import { snapshotHash } from '../sim/testing/hash';
+import { pointIgnition, withIgnitions } from '../sim/testing/scenarios';
+import { civilToUtc } from './time';
+import { buildScenario } from './build';
+import { clearCliffsMemo } from './cliffs';
+import { siteCliffs } from './cliffsSite';
+import { handMappedNote, TERRAIN_DRAWING_NOTE } from './datasetRecords';
+import { withFakeNetwork } from './testing';
+import type { DatasetRecord } from '../core/datasets';
+
+const ROOT = fileURLToPath(new URL('../../', import.meta.url));
+const PUBLIC = `${ROOT}public/`;
+const FIXTURE = readFileSync(`${ROOT}tests/fixtures/cliffs/synthetic-katoomba.geojson`, 'utf8');
+const KAT = { lat: -33.715, lon: 150.285 };
+
+/** The bundled files as the node loader serves them, with the manifest listing the synthetic cliffs file and the file itself, or neither. */
+function serve(withCliffs: boolean): void {
+  setAssetLoader(async (path) => {
+    if (withCliffs && path === 'demo/provenance.json') {
+      const m = JSON.parse(await readFile(`${PUBLIC}${path}`, 'utf8')) as BundleManifest;
+      m.sites['katoomba']!.files[CLIFFS_FILE] = { bytes: FIXTURE.length, capturedOn: '2026-11-08', features: 4, source: 'Synthetic test fixture', licence: 'None: test data', credit: 'FireSim tests (synthetic)' };
+      return new TextEncoder().encode(JSON.stringify(m));
+    }
+    if (withCliffs && path === `demo/katoomba/${CLIFFS_FILE}`) return new TextEncoder().encode(FIXTURE);
+    try {
+      return new Uint8Array(await readFile(`${PUBLIC}${path}`));
+    } catch {
+      return null;
+    }
+  });
+  clearBundleManifestCache();
+  clearCliffsMemo();
+}
+
+const net = withFakeNetwork([]); // nothing may reach the network
+afterEach(() => {
+  setAssetLoader(null);
+  clearBundleManifestCache();
+  clearCliffsMemo();
+});
+afterAll(() => net.restore());
+
+const build = (): Promise<ScenarioData> =>
+  buildScenario({ centre: KAT, extent: 6000, demoSiteId: 'katoomba', weather: { kind: 'preset', presetId: 'hot-nw-sw-change', start: civilToUtc(2025, 12, 20, 11) }, duration: 2 * 3600, online: false });
+
+/** A fingerprint of the bytes of every typed array in a value (and its plain data), so two 800 k-cell scenarios compare quickly. */
+function fingerprint(v: unknown): string {
+  let h = 0x811c9dc5;
+  const mix = (b: Uint8Array): void => {
+    for (let i = 0; i < b.length; i++) h = Math.imul(h ^ b[i]!, 16777619) >>> 0;
+  };
+  const walk = (x: unknown, seen: Set<object>): void => {
+    if (ArrayBuffer.isView(x)) return mix(new Uint8Array(x.buffer, x.byteOffset, x.byteLength));
+    if (x === null || typeof x !== 'object') return mix(new TextEncoder().encode(typeof x === 'number' ? (Object.is(x, -0) ? '-0' : String(x)) : JSON.stringify(x) ?? 'undefined'));
+    if (seen.has(x)) return;
+    seen.add(x);
+    for (const k of Object.keys(x).sort()) {
+      mix(new TextEncoder().encode(k));
+      walk((x as Record<string, unknown>)[k], seen);
+    }
+  };
+  walk(v, new Set());
+  return h.toString(16);
+}
+
+/** What a run of the scenario gives: the snapshot hash at the start and after each stretch (fast tier, one ignition near the face). */
+function runHashes(sc: ScenarioData): number[] {
+  const s = withIgnitions(sc, [pointIgnition('a', 2300, -1800, 0, 60)], { snapshotInterval: 300 });
+  const sim = new Simulation(s, { tier: 'fast' });
+  const out = [snapshotHash(sim.snapshot())];
+  sim.spinUp();
+  for (const t of [600, 1200]) {
+    sim.advance(t);
+    out.push(snapshotHash(sim.snapshot()));
+  }
+  return out;
+}
+
+describe('a map of the cliffs changes the drawing and the card, and nothing the simulation reads', () => {
+  let plain: ScenarioData;
+  let mapped: ScenarioData;
+  let plainFingerprint = '';
+  let hiBefore: string;
+  let slopeHiBefore: Float32Array;
+
+  beforeAll(async () => {
+    serve(false);
+    plain = await build();
+    serve(true);
+    mapped = await build();
+    plainFingerprint = fingerprint({ ...plain, datasets: undefined, datasetSummary: undefined });
+    hiBefore = fingerprint(mapped.terrainHiRes);
+    slopeHiBefore = hornSlopeDeg(mapped.terrainHiRes!.grid, mapped.terrainHiRes!.elevation);
+  }, 300000);
+
+  it('the two scenarios are the same scenario: terrain, slopes, fuel, weather, 10 m ground, options and every other field, byte for byte', () => {
+    expect(fingerprint({ ...mapped, datasets: undefined, datasetSummary: undefined })).toBe(plainFingerprint);
+    expect(fingerprint(mapped.terrain.slopeDeg)).toBe(fingerprint(plain.terrain.slopeDeg));
+    expect(fingerprint(mapped.terrain.slopeP90Deg)).toBe(fingerprint(plain.terrain.slopeP90Deg));
+    expect(fingerprint(mapped.terrain.cliffFraction)).toBe(fingerprint(plain.terrain.cliffFraction));
+    expect(fingerprint(mapped.terrainHiRes)).toBe(fingerprint(plain.terrainHiRes));
+    expect(fingerprint(mapped.fuel)).toBe(fingerprint(plain.fuel));
+    expect(mapped.weather.warnings).toEqual(plain.weather.warnings); // a good file adds no warning
+    // the map is not a field of the scenario the engine is given, however deep one looks
+    const keys = JSON.stringify(mapped, (_k, v) => (ArrayBuffer.isView(v) ? undefined : v)).match(/"(cliffs|rockShare|rockStyle|handMapped\w*)"/g);
+    expect(keys).toBeNull();
+    expect(Object.keys(mapped).sort()).toEqual(Object.keys(plain).sort());
+  });
+
+  it('the Terrain card says so: hand-mapped for 2 cliffs on this ground, the credit, and that the numbers use the data as received', () => {
+    const rec = (s: ScenarioData): DatasetRecord => s.datasets!.find((r) => r.id === 'terrain')!;
+    const note = rec(mapped).model!.note!;
+    expect(note.startsWith(rec(plain).model!.note!)).toBe(true); // the card's own words are all still there
+    expect(note).toContain(TERRAIN_DRAWING_NOTE);
+    // 6 km shows the tall face (A) and the line (B); patch C is past the edge of this ground and square D is off the site
+    expect(note).toContain('Hand-mapped for 2 cliffs (FireSim tests (synthetic); Second synthetic credit; licence None: test data, never shipped with the app; mapped 2026-11-08).');
+    expect(note).toContain('2 more in the file lie outside this ground.');
+    expect(note).toContain('not the fire, wind or slope numbers: they use the data as received.');
+    expect(rec(plain).model!.note).not.toContain('Hand-mapped');
+    expect(rec(mapped).stats.find((x) => x.label === 'Hand-mapped cliffs')?.value).toBe('2 (drawing only)');
+    expect(rec(plain).stats.some((x) => x.label === 'Hand-mapped cliffs')).toBe(false);
+    expect(rec(mapped).attribution).toContain('Cliff mapping: FireSim tests (synthetic); Second synthetic credit');
+    expect(rec(mapped).limitations.some((l) => /reading of photographs, not measured geometry/.test(l))).toBe(true);
+    expect(rec(mapped).parts?.some((p) => p.label.startsWith(CLIFFS_FILE))).toBe(true);
+    // the bundled-data card lists the file with its own source and licence, not the services' licence
+    const bundle = mapped.datasets!.find((r) => r.role === 'bundle')!;
