+import type { GridSpec } from '../core/grid';
+import { loadBundleManifest } from '../data';
+import type { CliffRasters } from '../render/cliffStyle';
+import { siteCliffs } from '../scenario/cliffsSite';
+
+/** The site's cliffs as rasters on `grid`, or null (no file, or one the build already warned about). Only a cancelled request throws. */
+export async function loadScenarioCliffs(grid: GridSpec | undefined, demoSiteId: string | undefined, signal?: AbortSignal): Promise<CliffRasters | null> {
+  if (!grid || !demoSiteId) return null;
+  const bundle = await loadBundleManifest(signal).catch(() => null);
+  const r = await siteCliffs(demoSiteId, bundle, grid, signal);
+  return r.kind === 'ok' ? r.rasters : null;
+}
