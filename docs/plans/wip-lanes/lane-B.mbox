+/** Mean luma inside the face's box. */
+function boxLuma(f: Frame): number {
+  const { x0, y0, x1, y1 } = f.box;
+  let sum = 0;
+  let n = 0;
+  for (let y = y0; y < y1; y++)
+    for (let x = x0; x < x1; x++) {
+      sum += luma(f, x, y);
+      n++;
+    }
+  return n ? sum / n : 0;
+}
+
+/** Pixels of two frames of the same view that differ, inside the face's box and outside it (a margin of `pad` px round the box counts as inside). */
+function changed(a: Frame, b: Frame, pad: number): { inside: number; outside: number } {
+  const { x0, y0, x1, y1 } = a.box;
+  let inside = 0;
+  let outside = 0;
+  for (let y = 0; y < a.h; y++)
+    for (let x = 0; x < a.w; x++) {
+      const i = (y * a.w + x) * a.ch;
+      if (a.data[i] === b.data[i] && a.data[i + 1] === b.data[i + 1] && a.data[i + 2] === b.data[i + 2]) continue;
+      if (x >= x0 - pad && x < x1 + pad && y >= y0 - pad && y < y1 + pad) inside++;
+      else outside++;
+    }
+  return { inside, outside };
