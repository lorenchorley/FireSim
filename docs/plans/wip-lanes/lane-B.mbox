+/**
+ * The bundled hand-mapped cliffs file and its place in public/demo/provenance.json (plan 15b, contract 0.10.0 section 4.5). No site has such a
+ * file: no cliff has been mapped and there is no data, so nothing is in public/demo. What is tested is the way a first file would arrive: the
+ * generator (scripts/build-demo-provenance.mjs, run here on a throwaway tree with the synthetic fixture) lists it with the source, licence and
+ * credit the file states and refuses one that does not say; any file that is ever added to public/demo must be one the app accepts; and a
+ * site without one is never asked for it.
+ */
+import { execFileSync } from 'node:child_process';
+import { copyFileSync, existsSync, mkdirSync, mkdtempSync, readFileSync, readdirSync, rmSync, statSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { afterEach, describe, expect, it } from 'vitest';
+import { makeGridSpec } from '../core/grid';
+import { parseCliffsText } from '../scenario/cliffs';
+import { siteCliffs } from '../scenario/cliffsSite';
+import { bundleFile, CLIFFS_FILE, clearBundleManifestCache, loadBundleManifest, setAssetLoader } from './index';
+import { DEMO_SITES } from './demoSites';
+
+const ROOT = fileURLToPath(new URL('../../', import.meta.url));
+const FIXTURES = `${ROOT}tests/fixtures/cliffs/`;
+const SCRIPT = `${ROOT}scripts/build-demo-provenance.mjs`;
+
+let tmp = '';
+afterEach(() => {
+  if (tmp) rmSync(tmp, { recursive: true, force: true });
+  tmp = '';
+  setAssetLoader(null);
+  clearBundleManifestCache();
+});
+
+/** A throwaway repository shape (scripts/ and public/demo/site1/) with the generator and one cliffs file, and the generator run on it. */
+function generate(fixture: string): { manifest: any; stderr: string; ok: boolean } { // eslint-disable-line @typescript-eslint/no-explicit-any
+  tmp = mkdtempSync(join(tmpdir(), 'firesim-cliffs-prov-'));
+  mkdirSync(join(tmp, 'scripts'));
+  mkdirSync(join(tmp, 'public', 'demo', 'site1'), { recursive: true });
+  copyFileSync(SCRIPT, join(tmp, 'scripts', 'build-demo-provenance.mjs'));
+  copyFileSync(`${FIXTURES}${fixture}`, join(tmp, 'public', 'demo', 'site1', CLIFFS_FILE));
+  try {
+    execFileSync(process.execPath, [join(tmp, 'scripts', 'build-demo-provenance.mjs')], { cwd: tmp, encoding: 'utf8', stdio: 'pipe' });
+  } catch (e) {
+    return { manifest: null, stderr: String((e as { stderr?: string }).stderr ?? e), ok: false };
+  }
+  return { manifest: JSON.parse(readFileSync(join(tmp, 'public', 'demo', 'provenance.json'), 'utf8')), stderr: '', ok: true };
+}
+
+describe('provenance.json takes the cliffs file’s source and licence', () => {
+  it('lists a file that says where it came from, with its bytes, day, count, source, licence and credit, and adds it to the site’s total', () => {
+    const r = generate('synthetic-katoomba.geojson');
+    expect(r.ok, r.stderr).toBe(true);
+    const f = r.manifest.sites.site1.files[CLIFFS_FILE];
+    expect(f).toEqual({
+      bytes: statSync(`${FIXTURES}synthetic-katoomba.geojson`).size,
+      capturedOn: '2026-11-08',
+      features: 4,
+      source: "Synthetic test fixture: invented shapes placed on Katoomba's coordinates for the unit tests. Not a real cliff and not mapped from any photograph.",
+      licence: 'None: test data, never shipped with the app',
+      credit: 'FireSim tests (synthetic)',
+    });
+    expect(r.manifest.sites.site1.totalBytes).toBe(f.bytes);
+    expect(r.manifest.totalBytes).toBe(f.bytes);
+  });
+
+  it('refuses a file that does not say its licence: it is not listed until it does', () => {
+    const r = generate('refused-no-licence.geojson');
+    expect(r.ok).toBe(false);
+    expect(r.stderr).toContain("site1/cliffs.geojson has no 'licence'");
+    expect(existsSync(join(tmp, 'public', 'demo', 'provenance.json'))).toBe(false);
+  });
+});
+
+describe('the bundled demo sites', () => {
+  const sites = readdirSync(`${ROOT}public/demo`, { withFileTypes: true }).filter((d) => d.isDirectory()).map((d) => d.name);
+
+  it('any cliffs file that is ever added is one the app accepts and the manifest lists with its own source and licence', async () => {
+    const m = (await loadBundleManifest())!;
+    for (const id of sites) {
+      const file = `${ROOT}public/demo/${id}/${CLIFFS_FILE}`;
+      const listed = bundleFile(m, id, CLIFFS_FILE);
+      if (!existsSync(file)) {
+        expect(listed, `${id} lists a cliffs file that is not there`).toBeUndefined();
+        continue;
+      }
+      const parsed = parseCliffsText(readFileSync(file, 'utf8'));
+      expect(parsed.ok, `${id}/cliffs.geojson: ${parsed.ok ? '' : parsed.problems.join(' ')}`).toBe(true);
+      if (!parsed.ok) continue;
+      expect(listed).toMatchObject({ bytes: statSync(file).size, capturedOn: parsed.file.capturedOn, features: parsed.file.features.length, source: parsed.file.source, licence: parsed.file.licence, credit: parsed.file.credit });
+      expect(parsed.file.licence).not.toMatch(/^None/); // the synthetic fixtures live under tests, never here
+    }
+  });
+
+  it('a site that has no cliffs file is never asked for one (so no request fails and no code is loaded)', async () => {
+    const asked: string[] = [];
+    const real = (await loadBundleManifest())!;
+    setAssetLoader(async (path) => {
+      asked.push(path);
+      try {
+        return new Uint8Array(readFileSync(`${ROOT}public/${path}`));
+      } catch {
+        return null;
+      }
+    });
+    clearBundleManifestCache();
+    const m = (await loadBundleManifest())!;
+    expect(m.totalBytes).toBe(real.totalBytes);
+    for (const s of DEMO_SITES) {
+      if (bundleFile(m, s.id, CLIFFS_FILE)) continue;
+      expect(await siteCliffs(s.id, m, makeGridSpec(s.centre, 9000, 10)), s.id).toEqual({ kind: 'none' });
+    }
+    expect(asked.filter((p) => p.endsWith(CLIFFS_FILE))).toEqual([]);
+  });
+});
