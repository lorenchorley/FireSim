+import { CLIFF_PROFILES, ROCK_STYLES } from '../render/cliffStyle';
+import { CLIFF_LINE_WIDTH_M, CLIFFS_MAX_CHARS, CLIFFS_MAX_FEATURES, CLIFFS_MAX_VERTICES, parseCliffs, parseCliffsText } from './cliffs';
+
+const GUIDE = readFileSync(fileURLToPath(new URL('../../docs/cliffs-data.md', import.meta.url)), 'utf8');
+const section = (title: string): string => {
+  const from = GUIDE.indexOf(`### ${title}`);
+  const to = GUIDE.indexOf('\n#', from + 4);
+  return GUIDE.slice(from, to < 0 ? undefined : to);
+};
+/** The rows of the first table of a section, less its header, as [first cell without its backticks, the whole row]. */
+const rows = (s: string): [string, string][] => s.split('\n').filter((l) => /^\| `/.test(l)).slice(1).map((l) => [/^\| `([^`]+)`/.exec(l)![1]!, l]);
+
+describe('docs/cliffs-data.md', () => {
+  it('has an example file the checker accepts, so a person who copies it starts from something that works', () => {
+    const block = /```json\n([\s\S]*?)\n```/.exec(GUIDE)![1]!;
+    const r = parseCliffsText(block);
+    expect(r.ok, r.ok ? '' : r.problems.join(' ')).toBe(true);
+    if (r.ok) expect(r.file.features.map((f) => f.name)).toEqual(['Example face', 'Example line']);
+  });
+
+  it('lists the styles and the profiles the code has, in the code’s words', () => {
+    const styles = rows(section('Styles'));
