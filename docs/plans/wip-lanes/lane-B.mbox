+/**
+ * What a hand-mapped cliff may change in the DRAWING (plan 15b, contract 0.10.0 section 4.5; pure, no Three.js, no DOM).
+ *
+ * A person who has looked at a cliff can say three things the terrain cannot: how much of it is bare rock (the rock mask's R), what
+ * the rock looks like (a style) and what its profile is (vertical, stepped or undercut). They arrive here as three rasters on the
+ * 10 m terrain's grid ({@link CliffRasters}, made by scenario/cliffs.ts) and change only the picture: the rock mask (rockMask.ts),
+ * how steeply the ground is sharpened to be drawn (cliffSharpen.ts) and the strength of the rock detail in the terrain shader
+ * (terrainLayer.ts). Nothing the simulation reads, and no slope, elevation or card a person is shown, ever sees them (plan section 4,
+ * rule 10; H-sim stays blocked): no module of the simulation imports this file, and a test holds the repository to that.
+ *
+ * The numbers below are drawing strengths I chose and tuned by eye on software rendering only. They are not measurements of any rock.
+ */
+import type { GridSpec } from '../core/grid';
+
+/** One rock style: how strongly the face's detail is drawn, relative to the generic sandstone (all 1). */
+export interface RockStyle {
+  id: string;
+  /** What a person sees, for the guide (docs/cliffs-data.md): the look a photo has to show for this style to fit. */
+  looks: string;
+  /** Strength of the ledges (shelves that catch the light). */
+  ledges: number;
+  /** Strength of the vertical joints (thin dark cracks). */
+  joints: number;
+  /** Strength of the water stains (dark and ochre streaks). */
+  stains: number;
+  /** Brightness of the rock's own colour. */
+  tone: number;
+}
+
+/**
+ * The rock styles, in the order of their codes. Code 0, `sandstone`, is what the drawing uses everywhere: naming it says the face was
+ * looked at and the generic look fits, and it is the one thing a style can say that changes nothing. Every strength is between 0.3 and 2
+ * and the brightness between 0.7 and 1.25 (a test holds them there).
+ */
+export const ROCK_STYLES: readonly RockStyle[] = Object.freeze([
+  { id: 'sandstone', looks: 'the look the app draws everywhere: ledges, a few cracks and stains', ledges: 1, joints: 1, stains: 1, tone: 1 },
+  { id: 'banded', looks: 'many regular horizontal ledges and bands, few vertical cracks', ledges: 1.6, joints: 0.7, stains: 1, tone: 1 },
+  { id: 'jointed', looks: 'long vertical cracks and blocks, few ledges', ledges: 0.7, joints: 1.8, stains: 1, tone: 1 },
+  { id: 'stained', looks: 'dark and ochre water streaks down most of the face', ledges: 1, joints: 1, stains: 1.8, tone: 1 },
+  { id: 'smooth', looks: 'a smooth, weathered face with few ledges, cracks or streaks', ledges: 0.3, joints: 0.3, stains: 0.6, tone: 1 },
+  { id: 'pale', looks: 'pale, bleached or weathered rock', ledges: 1, joints: 1, stains: 0.6, tone: 1.2 },
+  { id: 'dark', looks: 'dark rock, wet or covered with lichen', ledges: 1, joints: 1, stains: 1.2, tone: 0.75 },
+]);
+
+/** How a hand-mapped cliff's profile changes the drawing. Code 0 (no hint) is the generic rule. */
+export interface CliffProfile {
+  id: string;
+  /** What a side-on photo has to show for this profile to fit (for the guide). */
+  looks: string;
+  /** Multiplier on how far the ground is sharpened towards a wall (1 is the rule; the rest of it is capped at a full step). */
+  sharpen: number;
+  /** Strength of the ledges, on top of the style's. */
+  ledges: number;
+  /** Strength of the dark band under each ledge, which is how the picture shows an overhang (a height field cannot hold one). */
+  overhang: number;
+}
+
+/** The profile hints, in the order of their codes minus one (code 0 is "no hint"). */
+export const CLIFF_PROFILES: readonly CliffProfile[] = Object.freeze([
+  { id: 'vertical', looks: 'a sheer face with no ledges worth drawing', sharpen: 1.5, ledges: 0.8, overhang: 1 },
+  { id: 'stepped', looks: 'faces broken by wide ledges or benches', sharpen: 1, ledges: 1.5, overhang: 1 },
+  { id: 'undercut', looks: 'a face that leans out over its foot, with overhangs', sharpen: 1.5, ledges: 1.2, overhang: 1.8 },
+]);
+
+export const ROCK_STYLE_IDS: readonly string[] = ROCK_STYLES.map((s) => s.id);
+export const CLIFF_PROFILE_IDS: readonly string[] = CLIFF_PROFILES.map((p) => p.id);
+
+/** The code of a style id (0 to {@link ROCK_STYLES}.length - 1), or -1 when there is no such style. */
+export const styleCode = (id: string): number => ROCK_STYLES.findIndex((s) => s.id === id);
+/** The code of a profile id (1 to 3), or 0 when there is no such profile. */
+export const profileCode = (id: string): number => CLIFF_PROFILES.findIndex((p) => p.id === id) + 1;
+
+/** Styles that fit the three bits of a look code, profiles the two above them. */
+export const MAX_STYLES = 8;
+export const MAX_PROFILES = 4;
+
+/**
+ * The alpha byte of a rock-mask cell: 255 with no style and no profile (what it has always been), then one less per step of
+ * `profile x 8 + style`. The shader reads it back with `texelFetch`, so a style is never blended with its neighbour's.
+ */
+export const lookByte = (style: number, profile: number): number => 255 - (profile * MAX_STYLES + style);
+/** The style code and profile code of an alpha byte. */
+export const lookOf = (byte: number): { style: number; profile: number } => {
+  const v = 255 - byte;
+  return { style: v % MAX_STYLES, profile: Math.floor(v / MAX_STYLES) };
+};
+
+/**
+ * What the file says about every cell of the 10 m terrain's grid (scenario/cliffs.ts makes it). It is display data only: it travels from
+ * the loader to `SceneView.setScenario` and never into the scenario the engine is given.
+ */
+export interface CliffRasters {
+  /** The grid of the 10 m terrain it was made for (the cliff drawing refuses another). */
+  grid: GridSpec;
+  /** Bare-rock share as the rock mask's R byte (0 to 255), or -1 where the file says nothing. */
+  rock: Int16Array;
+  /** Style code per cell ({@link ROCK_STYLES}); 0 where there is none, or where the style is the generic sandstone. */
+  style: Uint8Array;
+  /** Profile code per cell: 0 none, then {@link CLIFF_PROFILES} in order. */
+  profile: Uint8Array;
+}
+
+/** True when the rasters were made for this grid (same size, spacing and position). */
+export const cliffsFit = (r: CliffRasters, g: GridSpec): boolean => r.grid.nx === g.nx && r.grid.ny === g.ny && r.grid.cellSize === g.cellSize && r.grid.x0 === g.x0 && r.grid.y0 === g.y0;
+
+/** The alpha bytes of a mask's cells from the rasters: 255 where the file says no style and no profile. */
+export function lookBytes(r: CliffRasters): Uint8Array {
+  const out = new Uint8Array(r.style.length).fill(255);
+  for (let k = 0; k < out.length; k++) if (r.style[k]! || r.profile[k]!) out[k] = lookByte(r.style[k]!, r.profile[k]!);
+  return out;
+}
+
+/**
+ * The tables the terrain shader reads, as uniform arrays of four numbers each: per style (ledges, joints, stains, tone), padded with the
+ * generic look to {@link MAX_STYLES}, and per profile (ledges, overhang, 0, 0), where entry 0 is "no hint".
+ */
+export function lookTables(): { styles: number[][]; profiles: number[][] } {
+  const styles = Array.from({ length: MAX_STYLES }, (_, k) => {
+    const s = ROCK_STYLES[k];
+    return s ? [s.ledges, s.joints, s.stains, s.tone] : [1, 1, 1, 1];
+  });
+  const profiles = Array.from({ length: MAX_PROFILES }, (_, k) => {
+    const p = CLIFF_PROFILES[k - 1];
+    return p ? [p.ledges, p.overhang, 0, 0] : [1, 1, 0, 0];
+  });
+  return { styles, profiles };
+}
