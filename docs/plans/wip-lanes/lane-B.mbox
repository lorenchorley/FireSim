+++ b/src/render/cliffStyle.test.ts
@@ -0,0 +1,120 @@
+/**
+ * The looks a hand-mapped cliff can have (cliffStyle.ts, plan 15b): the style and profile tables stay in the bounds the shader and the
+ * guide rely on, the look code that travels in the rock mask's alpha round-trips, and "no map" is the byte it always was (255).
+ */
+import { describe, expect, it } from 'vitest';
+import { flatGrid } from './testing/cliffs';
+import { CLIFF_PROFILES, CLIFF_PROFILE_IDS, MAX_PROFILES, MAX_STYLES, ROCK_STYLES, ROCK_STYLE_IDS, cliffsFit, lookBytes, lookByte, lookOf, lookTables, profileCode, styleCode, type CliffRasters } from './cliffStyle';
+
+describe('the style and profile tables', () => {
+  it('name the styles and profiles the guide and the file refuse to guess at, each once', () => {
+    expect(ROCK_STYLE_IDS).toEqual(['sandstone', 'banded', 'jointed', 'stained', 'smooth', 'pale', 'dark']);
+    expect(CLIFF_PROFILE_IDS).toEqual(['vertical', 'stepped', 'undercut']);
+    expect(new Set(ROCK_STYLE_IDS).size).toBe(ROCK_STYLE_IDS.length);
+    expect(ROCK_STYLES.length).toBeLessThanOrEqual(MAX_STYLES); // three bits of the look code
+    expect(CLIFF_PROFILES.length + 1).toBeLessThanOrEqual(MAX_PROFILES); // two bits, with 0 for no hint
+    for (const s of ROCK_STYLES) expect(s.looks.length).toBeGreaterThan(10);
+    for (const p of CLIFF_PROFILES) expect(p.looks.length).toBeGreaterThan(10);
+  });
+
+  it('keep every strength where the picture stays a rock face: 0.3 to 2, brightness 0.7 to 1.25, sharpening 0.5 to 1.5', () => {
+    for (const s of ROCK_STYLES) {
+      for (const v of [s.ledges, s.joints, s.stains]) expect(v >= 0.3 && v <= 2, `${s.id} strength ${v}`).toBe(true);
+      expect(s.tone >= 0.7 && s.tone <= 1.25, `${s.id} tone`).toBe(true);
+    }
+    for (const p of CLIFF_PROFILES) {
+      expect(p.sharpen >= 0.5 && p.sharpen <= 1.5, `${p.id} sharpen`).toBe(true);
+      expect(p.ledges >= 0.5 && p.ledges <= 2, `${p.id} ledges`).toBe(true);
+      expect(p.overhang >= 1 && p.overhang <= 2, `${p.id} overhang`).toBe(true);
+    }
+  });
+
+  it('make sandstone the look the app draws everywhere: every strength 1, so naming it changes nothing', () => {
+    expect(ROCK_STYLES[0]).toMatchObject({ id: 'sandstone', ledges: 1, joints: 1, stains: 1, tone: 1 });
+    expect(styleCode('sandstone')).toBe(0);
+  });
+
+  it('give the other styles one thing that is not the generic look', () => {
+    for (const s of ROCK_STYLES.slice(1)) expect([s.ledges, s.joints, s.stains, s.tone].some((v) => v !== 1), s.id).toBe(true);
+  });
+
+  it('find a code by its id, and say when there is none', () => {
+    expect(ROCK_STYLE_IDS.map(styleCode)).toEqual([0, 1, 2, 3, 4, 5, 6]);
+    expect(styleCode('granite')).toBe(-1);
+    expect(CLIFF_PROFILE_IDS.map(profileCode)).toEqual([1, 2, 3]);
+    expect(profileCode('overhang')).toBe(0);
+  });
+});
+
+describe('the look code in the rock mask’s alpha', () => {
+  it('is 255 with no style and no profile, which is what the alpha has always been', () => {
+    expect(lookByte(0, 0)).toBe(255);
+    expect(lookOf(255)).toEqual({ style: 0, profile: 0 });
+  });
+
+  it('round-trips every style with every profile, in 32 distinct bytes from 224 to 255', () => {
+    const seen = new Set<number>();
+    for (let profile = 0; profile < MAX_PROFILES; profile++) {
+      for (let style = 0; style < MAX_STYLES; style++) {
+        const b = lookByte(style, profile);
+        expect(Number.isInteger(b) && b >= 224 && b <= 255).toBe(true);
+        expect(lookOf(b)).toEqual({ style, profile });
+        seen.add(b);
+      }
+    }
+    expect(seen.size).toBe(32);
+  });
+
+  it('is read back by the shader’s own arithmetic: the byte as a float32 fraction, floor((1 - a) x 255 + 0.5), then & 7 and >> 3', () => {
+    for (let profile = 0; profile < MAX_PROFILES; profile++) {
+      for (let style = 0; style < MAX_STYLES; style++) {
+        const a = Math.fround(lookByte(style, profile) / 255);
+        const lk = Math.floor(Math.fround(Math.fround(1 - a) * 255) + 0.5);
+        expect([lk & 7, Math.min(lk >> 3, 3)]).toEqual([style, profile]);
+      }
+    }
+  });
+});
+
+describe('the rasters', () => {
+  const g = flatGrid(6, 4);
+  const rasters = (): CliffRasters => ({ grid: g, rock: new Int16Array(24).fill(-1), style: new Uint8Array(24), profile: new Uint8Array(24) });
+
+  it('give 255 for a cell the map says nothing about, and the look byte for one it does', () => {
+    const r = rasters();
+    r.style[3] = 2;
+    r.profile[5] = 3;
+    r.style[7] = 1;
+    r.profile[7] = 1;
+    r.rock[9] = 200; // a rock share alone changes no look
+    const out = lookBytes(r);
+    expect(out[0]).toBe(255);
+    expect(out[3]).toBe(lookByte(2, 0));
+    expect(out[5]).toBe(lookByte(0, 3));
+    expect(out[7]).toBe(lookByte(1, 1));
+    expect(out[9]).toBe(255);
+    expect(out.filter((v) => v !== 255)).toHaveLength(3);
+  });
+
+  it('say whether they were made for a grid: its size, spacing and position', () => {
+    const r = rasters();
+    expect(cliffsFit(r, g)).toBe(true);
+    expect(cliffsFit(r, { ...g })).toBe(true);
+    expect(cliffsFit(r, { ...g, nx: 7 })).toBe(false);
+    expect(cliffsFit(r, { ...g, cellSize: 20 })).toBe(false);
+    expect(cliffsFit(r, { ...g, x0: 10 })).toBe(false);
+    expect(cliffsFit(r, { ...g, y0: -10 })).toBe(false);
+  });
+
+  it('become the shader’s tables: eight styles of four numbers and four profiles, entry 0 and the padding neutral', () => {
+    const t = lookTables();
+    expect(t.styles).toHaveLength(MAX_STYLES);
+    expect(t.profiles).toHaveLength(MAX_PROFILES);
+    for (const row of [...t.styles, ...t.profiles]) expect(row).toHaveLength(4);
+    expect(t.styles[0]).toEqual([1, 1, 1, 1]);
+    expect(t.styles[7]).toEqual([1, 1, 1, 1]); // padding: a look code of 7 means the generic one
+    expect(t.styles[2]).toEqual([ROCK_STYLES[2]!.ledges, ROCK_STYLES[2]!.joints, ROCK_STYLES[2]!.stains, ROCK_STYLES[2]!.tone]);
+    expect(t.profiles[0]).toEqual([1, 1, 0, 0]);
+    expect(t.profiles[3]).toEqual([CLIFF_PROFILES[2]!.ledges, CLIFF_PROFILES[2]!.overhang, 0, 0]);
+  });
+});
