new file mode 100644
index 0000000..682db72
--- /dev/null
+++ b/src/scenario/cliffsSite.ts
@@ -0,0 +1,35 @@
+/**
+ * The way to a site's hand-mapped cliffs (plan 15b; docs/cliffs-data.md) that costs nothing when there are none: the bundled-data manifest says
+ * whether a site has a cliffs.geojson, and only then is the request made and the lazy chunk (cliffs.ts: the validator and the rasteriser)
+ * loaded. No site has one today, so no request is made and no code is loaded. The build reads the card's words from it, the screen
+ * reads the rasters from it; the engine never sees either (plan section 4, rule 10).
+ */
+import type { GridSpec } from '../core/grid';
+import { bundleFile, CLIFFS_FILE, type BundleManifest, type TraceOptions } from '../data';
+import type { CliffRasters } from '../render/cliffStyle';
+import type { HandMappedCliffs } from './cliffs';
+
+/** No file for this site; a file that was refused (plain sentences, for a build warning); or the cliffs on this ground. */
+export type SiteCliffs = { kind: 'none' } | { kind: 'refused'; problems: string[] } | { kind: 'ok'; rasters: CliffRasters; info: HandMappedCliffs };
+
+/**
+ * A demo site's hand-mapped cliffs on the scenario's 10 m grid. Asks for nothing unless `bundle` lists the file. A file that cannot be
+ * read or is refused comes back as `refused`; only a cancelled request throws.
+ */
+export async function siteCliffs(siteId: string | undefined, bundle: BundleManifest | null, grid: GridSpec, signal?: AbortSignal, trace?: TraceOptions): Promise<SiteCliffs> {
+  if (!siteId || !bundleFile(bundle, siteId, CLIFFS_FILE)) return { kind: 'none' };
+  try {
+    const m = await import('./cliffs');
+    const parsed = await m.loadCliffsFile(siteId, signal, trace);
+    if (!parsed.ok) return { kind: 'refused', problems: parsed.problems };
+    const r = m.rasteriseCliffs(parsed.file, grid);
+    return { kind: 'ok', rasters: r.rasters, info: m.describeCliffs(parsed.file, r) };
+  } catch (e) {
+    if (signal?.aborted) throw e;
+    return { kind: 'refused', problems: [`The hand-mapped cliffs could not be read (${e instanceof Error ? e.message : String(e)}).`] };
+  }
+}
+
+/** The plain sentence of a build warning for a refused file: what was wrong, and that the cliffs are drawn from the terrain alone. */
+export const cliffsRefusedWarning = (problems: readonly string[]): string =>
+  `The hand-mapped cliffs of this site (${CLIFFS_FILE}) were not used: ${problems[0] ?? 'the file could not be read'}${problems.length > 1 ? ` (and ${problems.length - 1} more)` : ''}. The cliffs are drawn from the terrain alone.`;
