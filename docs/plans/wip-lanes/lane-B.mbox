+export function cliffsRefusedWarning(problems: readonly string[]): string {
+  // The checker lists eight problems and then "…and N more.": that last entry stands for N, not for one.
+  const tail = /^…and (\d+) more\.$/.exec(problems[problems.length - 1] ?? '');
