+/**
+ * The hand-mapped cliffs of a site (plan 15b, contract 0.10.0 section 4.5): an optional `demo/<site>/cliffs.geojson`, read next to
+ * `vegetation.geojson`, in which a person who has looked at photos of a cliff says how much of it is bare rock, what the rock looks
+ * like and what its profile is. The guide for that person is docs/cliffs-data.md.
+ *
+ * This file is the pure part: a validator that refuses a malformed file with plain sentences and never throws, the projection onto the
+ * 10 m terrain's grid, and the rasters ({@link CliffRasters}, cliffStyle.ts) the cliff drawing takes. Everything it makes is for the
+ * DRAWING: it goes to `SceneView.setScenario` and to the Data sets Terrain card, and never into the scenario the engine is given
+ * (plan section 4, rule 10; H-sim stays blocked). It is a lazy chunk: cliffsSite.ts loads it only for a site whose manifest lists the
+ * file, and none does today (no cliff has been mapped: there is no data in public/demo).
+ *
+ * Format (GeoJSON, WGS 84 longitude and latitude; heights are ignored: the terrain is the terrain as received):
+ *   file      `source`, `licence`, `credit` and `capturedOn` (YYYY-MM-DD), all required, and `features`.
+ *   feature   a LineString, MultiLineString, Polygon or MultiPolygon, with properties `rockShare` (0 to 1), `rockStyle` (a style id),
+ *             `profile` (vertical, stepped or undercut), at least one of them, and optionally `widthM` (lines only), `credit`,
+ *             `capturedOn`, `name` and `note`. Later features win where they overlap.
+ */
+import { LocalProjection, type LatLon } from '../core/geo';
+import type { GridSpec } from '../core/grid';
+import { CLIFFS_FILE, loadAsset, type TraceOptions } from '../data';
+import { CLIFF_PROFILE_IDS, ROCK_STYLE_IDS, profileCode, styleCode, type CliffRasters } from '../render/cliffStyle';
+
+/** The limits that keep a hand-written file from costing the build (the file's name, `CLIFFS_FILE`, is in data/bundleManifest.ts). */
+export const CLIFFS_MAX_CHARS = 1_000_000;
+export const CLIFFS_MAX_FEATURES = 500;
+export const CLIFFS_MAX_VERTICES = 50_000;
+/** Width (m) of the band drawn across a line: 20 m is two cells of the 10 m ground, the least that leaves no gaps along a diagonal line. */
+export const CLIFF_LINE_WIDTH_M = Object.freeze({ min: 20, default: 30, max: 200 });
+const TEXT_MAX = 200;
+const NOTE_MAX = 500;
+const PROBLEMS_SHOWN = 8;
+
+type Position = [number, number];
+
+/** One mapped cliff, with its geometry as longitude and latitude and its properties checked. */
+export interface CliffFeature {
+  /** Position in the file (0 first), for messages. */
+  index: number;
+  name?: string;
+  note?: string;
+  /** Polygons, each an outer ring and its holes (even-odd), as [longitude, latitude]. Empty for a line. */
+  polygons: Position[][][];
+  /** Lines as [longitude, latitude]. Empty for a polygon. */
+  lines: Position[][];
+  /** Width (m) of the band across the line; lines only. */
+  widthM?: number;
+  /** Bare-rock share, 0 to 1. */
+  rockShare?: number;
+  /** A style id (cliffStyle.ts). */
+  rockStyle?: string;
+  /** A profile id (cliffStyle.ts). */
+  profile?: string;
+  credit?: string;
+  capturedOn?: string;
+}
+
+export interface CliffFile {
+  source: string;
+  licence: string;
+  credit: string;
+  capturedOn: string;
+  features: CliffFeature[];
+}
+
+export type ParsedCliffs = { ok: true; file: CliffFile } | { ok: false; problems: string[] };
+
+class Problems {
+  readonly list: string[] = [];
+  count = 0;
+  add(text: string): void {
+    this.count++;
+    if (this.list.length < PROBLEMS_SHOWN) this.list.push(text);
+  }
+  result(): string[] {
+    return this.count > this.list.length ? [...this.list, `…and ${this.count - this.list.length} more.`] : this.list;
+  }
+}
+
+const isRecord = (v: unknown): v is Record<string, unknown> => typeof v === 'object' && v !== null && !Array.isArray(v);
+
+/** A real calendar day, written YYYY-MM-DD. */
+function isDay(v: unknown): v is string {
+  if (typeof v !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(v)) return false;
+  const d = new Date(`${v}T00:00:00Z`);
+  return !Number.isNaN(d.getTime()) && d.toISOString().slice(0, 10) === v && d.getUTCFullYear() >= 2000;
+}
+
+const KNOWN_PROPERTIES = ['rockShare', 'rockStyle', 'profile', 'widthM', 'credit', 'capturedOn', 'name', 'note', 'id', 'fid'];
+
+function text(p: Problems, where: string, name: string, v: unknown, max = TEXT_MAX): string | undefined {
+  if (typeof v !== 'string' || !v.trim()) {
+    p.add(`${where}: '${name}' must be a few words of text.`);
+    return undefined;
+  }
+  if (v.length > max) {
+    p.add(`${where}: '${name}' is ${v.length} characters; the most is ${max}.`);
+    return undefined;
+  }
+  return v.trim();
+}
+
+/** A position of a geometry: two or more finite numbers, longitude then latitude (a height, if there is one, is ignored). */
+function position(p: Problems, where: string, v: unknown): Position | null {
+  if (!Array.isArray(v) || v.length < 2 || typeof v[0] !== 'number' || typeof v[1] !== 'number' || !Number.isFinite(v[0]) || !Number.isFinite(v[1])) {
+    p.add(`${where}: a position must be [longitude, latitude] in degrees.`);
+    return null;
+  }
+  if (Math.abs(v[0]) > 180 || Math.abs(v[1]) > 90) {
+    p.add(`${where}: the position [${v[0]}, ${v[1]}] is not on the Earth. GeoJSON wants longitude first, then latitude, in degrees.`);
+    return null;
+  }
+  return [v[0], v[1]];
+}
+
+function path(p: Problems, where: string, v: unknown, min: number, budget: { left: number }): Position[] | null {
+  if (!Array.isArray(v) || v.length < min) {
+    p.add(`${where}: needs at least ${min} positions.`);
+    return null;
+  }
+  budget.left -= v.length;
+  if (budget.left < 0) {
+    p.add(`The file has more than ${CLIFFS_MAX_VERTICES} positions in all; trace the cliffs with fewer points.`);
+    return null;
+  }
+  const out: Position[] = [];
+  for (const q of v) {
+    const pos = position(p, where, q);
+    if (!pos) return null;
+    out.push(pos);
+  }
+  return out;
+}
+
+function ring(p: Problems, where: string, v: unknown, budget: { left: number }): Position[] | null {
+  const r = path(p, where, v, 4, budget);
+  if (!r) return null;
+  const a = r[0]!;
+  const b = r[r.length - 1]!;
+  if (a[0] !== b[0] || a[1] !== b[1]) {
+    p.add(`${where}: a polygon's ring must end where it starts (repeat its first position at the end).`);
+    return null;
+  }
+  // The shoelace sum about the first position (so a ring a few metres wide, 150 degrees from the origin, keeps its digits). Under 1e-14
+  // square degrees is about a square centimetre: a ring that is a line.
+  let area = 0;
+  for (let i = 1; i + 1 < r.length; i++) area += (r[i]![0] - a[0]) * (r[i + 1]![1] - a[1]) - (r[i + 1]![0] - a[0]) * (r[i]![1] - a[1]);
+  if (Math.abs(area) < 1e-14) {
+    p.add(`${where}: the ring has no area (all its positions are on one line).`);
+    return null;
+  }
+  return r;
+}
+
+function line(p: Problems, where: string, v: unknown, budget: { left: number }): Position[] | null {
+  const l = path(p, where, v, 2, budget);
+  if (!l) return null;
+  if (l.every((q) => q[0] === l[0]![0] && q[1] === l[0]![1])) {
+    p.add(`${where}: the line has no length (all its positions are the same).`);
+    return null;
+  }
+  return l;
+}
+
+function geometry(p: Problems, where: string, g: unknown, budget: { left: number }): { polygons: Position[][][]; lines: Position[][] } | null {
+  if (!isRecord(g) || typeof g['type'] !== 'string') {
+    p.add(`${where}: has no geometry.`);
+    return null;
+  }
+  const c = g['coordinates'];
+  const polygon = (v: unknown, w: string): Position[][] | null => {
+    if (!Array.isArray(v) || !v.length) {
+      p.add(`${w}: a polygon needs a ring.`);
+      return null;
+    }
+    const rings: Position[][] = [];
+    for (let i = 0; i < v.length; i++) {
+      const r = ring(p, i ? `${w} (hole ${i})` : w, v[i], budget);
+      if (!r) return null;
+      rings.push(r);
+    }
+    return rings;
+  };
+  switch (g['type']) {
+    case 'Polygon': {
+      const r = polygon(c, where);
+      return r ? { polygons: [r], lines: [] } : null;
+    }
+    case 'MultiPolygon': {
+      if (!Array.isArray(c) || !c.length) {
+        p.add(`${where}: a MultiPolygon needs at least one polygon.`);
+        return null;
+      }
+      const polygons: Position[][][] = [];
+      for (let i = 0; i < c.length; i++) {
+        const r = polygon(c[i], `${where} (polygon ${i + 1})`);
+        if (!r) return null;
+        polygons.push(r);
+      }
+      return { polygons, lines: [] };
+    }
+    case 'LineString': {
+      const l = line(p, where, c, budget);
+      return l ? { polygons: [], lines: [l] } : null;
+    }
+    case 'MultiLineString': {
+      if (!Array.isArray(c) || !c.length) {
+        p.add(`${where}: a MultiLineString needs at least one line.`);
+        return null;
+      }
+      const lines: Position[][] = [];
+      for (let i = 0; i < c.length; i++) {
+        const l = line(p, `${where} (line ${i + 1})`, c[i], budget);
+        if (!l) return null;
+        lines.push(l);
+      }
+      return { polygons: [], lines };
+    }
+    default:
+      p.add(`${where}: a ${String(g['type'])} cannot be a cliff. Draw a line along the cliff or a polygon around it.`);
+      return null;
+  }
+}
+
+/**
+ * Check a parsed GeoJSON document. Never throws: a file that is not what the guide describes comes back as `{ ok: false, problems }`, plain
+ * sentences that name the cliff (by its number in the file and its name) and say what to change, the first eight and a count of the rest.
+ */
+export function parseCliffs(doc: unknown): ParsedCliffs {
+  const p = new Problems();
+  if (!isRecord(doc) || doc['type'] !== 'FeatureCollection' || !Array.isArray(doc['features'])) {
+    return { ok: false, problems: ['The file must be a GeoJSON FeatureCollection with a list of features.'] };
+  }
+  const source = text(p, 'The file', 'source', doc['source']);
+  const licence = text(p, 'The file', 'licence', doc['licence']);
+  const credit = text(p, 'The file', 'credit', doc['credit']);
+  let capturedOn: string | undefined;
+  if (isDay(doc['capturedOn'])) capturedOn = doc['capturedOn'];
+  else p.add("The file: 'capturedOn' must be the day the cliffs were mapped, written YYYY-MM-DD.");
+  const list = doc['features'];
+  if (list.length === 0) p.add('The file has no cliffs in it.');
+  if (list.length > CLIFFS_MAX_FEATURES) p.add(`The file has ${list.length} cliffs; the most is ${CLIFFS_MAX_FEATURES}. This is for a handful of landmark cliffs.`);
+  const features: CliffFeature[] = [];
+  const budget = { left: CLIFFS_MAX_VERTICES };
+  for (let i = 0; i < Math.min(list.length, CLIFFS_MAX_FEATURES); i++) {
+    const f = list[i];
+    const props = isRecord(f) && isRecord(f['properties']) ? f['properties'] : {};
+    const nameOk = typeof props['name'] === 'string' && props['name'].trim() && props['name'].length <= TEXT_MAX;
+    const where = `Cliff ${i + 1}${nameOk ? ` (${(props['name'] as string).trim()})` : ''}`;
+    if (!isRecord(f) || f['type'] !== 'Feature') {
+      p.add(`${where}: must be a GeoJSON Feature.`);
+      continue;
+    }
+    const before = p.count;
+    const out: CliffFeature = { index: i, polygons: [], lines: [] };
+    for (const k of Object.keys(props)) {
+      if (!KNOWN_PROPERTIES.includes(k)) p.add(`${where}: '${k}' is not a property this file knows (rockShare, rockStyle, profile, widthM, credit, capturedOn, name, note). Check the spelling.`);
+    }
+    if (props['name'] !== undefined) {
+      const v = text(p, where, 'name', props['name']);
+      if (v) out.name = v;
+    }
+    if (props['note'] !== undefined) {
+      const v = text(p, where, 'note', props['note'], NOTE_MAX);
+      if (v) out.note = v;
+    }
+    if (props['rockShare'] !== undefined) {
+      const v = props['rockShare'];
+      if (typeof v === 'number' && Number.isFinite(v) && v >= 0 && v <= 1) out.rockShare = v;
+      else p.add(`${where}: 'rockShare' must be a number from 0 (no bare rock) to 1 (all bare rock).`);
+    }
+    if (props['rockStyle'] !== undefined) {
+      const v = props['rockStyle'];
+      if (typeof v === 'string' && ROCK_STYLE_IDS.includes(v)) out.rockStyle = v;
+      else p.add(`${where}: 'rockStyle' must be one of ${ROCK_STYLE_IDS.join(', ')}.`);
+    }
+    if (props['profile'] !== undefined) {
+      const v = props['profile'];
+      if (typeof v === 'string' && CLIFF_PROFILE_IDS.includes(v)) out.profile = v;
+      else p.add(`${where}: 'profile' must be one of ${CLIFF_PROFILE_IDS.join(', ')}.`);
+    }
+    if (props['credit'] !== undefined) {
+      const v = text(p, where, 'credit', props['credit']);
+      if (v) out.credit = v;
+    }
+    if (props['capturedOn'] !== undefined) {
+      if (isDay(props['capturedOn'])) out.capturedOn = props['capturedOn'];
+      else p.add(`${where}: 'capturedOn' must be a day written YYYY-MM-DD.`);
+    }
+    if (out.rockShare === undefined && out.rockStyle === undefined && out.profile === undefined && p.count === before) {
+      p.add(`${where}: says nothing to draw. Give it a rockShare, a rockStyle or a profile.`);
+    }
+    const g = geometry(p, where, f['geometry'], budget);
+    if (g) {
+      out.polygons = g.polygons;
+      out.lines = g.lines;
+      if (props['widthM'] !== undefined) {
+        const w = props['widthM'];
+        if (!out.lines.length) p.add(`${where}: 'widthM' is for lines; a polygon is as wide as it is drawn.`);
+        else if (typeof w === 'number' && Number.isFinite(w) && w >= CLIFF_LINE_WIDTH_M.min && w <= CLIFF_LINE_WIDTH_M.max) out.widthM = w;
+        else p.add(`${where}: 'widthM' must be a number of metres from ${CLIFF_LINE_WIDTH_M.min} to ${CLIFF_LINE_WIDTH_M.max}.`);
+      }
+    }
+    if (p.count === before) features.push(out);
+  }
+  if (p.count || !source || !licence || !credit || !capturedOn) return { ok: false, problems: p.result() };
+  return { ok: true, file: { source, licence, credit, capturedOn, features } };
+}
+
+/** Parse the text of a file (JSON, then {@link parseCliffs}). Never throws. */
+export function parseCliffsText(src: string): ParsedCliffs {
+  if (src.length > CLIFFS_MAX_CHARS) return { ok: false, problems: [`The file is ${src.length} characters long; the most is ${CLIFFS_MAX_CHARS}.`] };
+  let doc: unknown;
+  try {
+    doc = JSON.parse(src);
+  } catch {
+    return { ok: false, problems: ['The file is not valid JSON. A GeoJSON file is expected.'] };
+  }
+  return parseCliffs(doc);
+}
+
+// ─────────────────────────────────────────────────────────────────────────────
+// Onto the 10 m terrain's grid
+// ─────────────────────────────────────────────────────────────────────────────
+
+export interface RasteriseResult {
+  rasters: CliffRasters;
+  /** Cliffs that cover at least one cell of the grid: the "N cliffs" the Terrain card says. */
+  applied: number;
+  /** Cliffs (by position in the file, 0 first) that cover none of it: elsewhere on the site, or too narrow to reach a cell centre. */
+  outside: number[];
+}
+
+type XY = [number, number];
+
+/** Scanline fill of a polygon (outer ring and holes, even-odd) over the cells whose centres are inside it. */
+function fillPolygon(rings: XY[][], g: GridSpec, visit: (k: number) => void): void {
+  const edges: number[] = []; // ax, ay, bx, by
+  let minY = Infinity;
+  let maxY = -Infinity;
+  for (const r of rings) {
+    for (let i = 0; i + 1 < r.length; i++) {
+      const a = r[i]!;
+      const b = r[i + 1]!;
+      if (a[1] === b[1]) continue;
+      edges.push(a[0], a[1], b[0], b[1]);
+      minY = Math.min(minY, a[1], b[1]);
+      maxY = Math.max(maxY, a[1], b[1]);
+    }
+  }
+  if (!edges.length) return;
+  const j0 = Math.max(0, Math.ceil((minY - g.y0) / g.cellSize));
+  const j1 = Math.min(g.ny - 1, Math.floor((maxY - g.y0) / g.cellSize));
+  const xs: number[] = [];
+  for (let j = j0; j <= j1; j++) {
+    const y = g.y0 + j * g.cellSize;
+    xs.length = 0;
+    for (let e = 0; e < edges.length; e += 4) {
+      const ay = edges[e + 1]!;
+      const by = edges[e + 3]!;
+      // Half-open in y, so a vertex exactly on the scanline is counted once.
+      if (ay <= y !== by <= y) xs.push(edges[e]! + ((y - ay) * (edges[e + 2]! - edges[e]!)) / (by - ay));
+    }
+    xs.sort((a, b) => a - b);
+    for (let s = 0; s + 1 < xs.length; s += 2) {
+      const i0 = Math.max(0, Math.ceil((xs[s]! - g.x0) / g.cellSize));
+      const i1 = Math.min(g.nx - 1, Math.floor((xs[s + 1]! - g.x0) / g.cellSize));
+      for (let i = i0; i <= i1; i++) visit(j * g.nx + i);
+    }
+  }
+}
+
+/** The cells whose centres are within `half` metres of a line. */
+function strokeLine(pts: XY[], half: number, g: GridSpec, visit: (k: number) => void): void {
+  for (let s = 0; s + 1 < pts.length; s++) {
+    const [ax, ay] = pts[s]!;
+    const [bx, by] = pts[s + 1]!;
+    const i0 = Math.max(0, Math.floor((Math.min(ax, bx) - half - g.x0) / g.cellSize));
+    const i1 = Math.min(g.nx - 1, Math.ceil((Math.max(ax, bx) + half - g.x0) / g.cellSize));
+    const j0 = Math.max(0, Math.floor((Math.min(ay, by) - half - g.y0) / g.cellSize));
+    const j1 = Math.min(g.ny - 1, Math.ceil((Math.max(ay, by) + half - g.y0) / g.cellSize));
+    const dx = bx - ax;
+    const dy = by - ay;
+    const len2 = dx * dx + dy * dy;
+    for (let j = j0; j <= j1; j++) {
+      const y = g.y0 + j * g.cellSize;
+      for (let i = i0; i <= i1; i++) {
+        const x = g.x0 + i * g.cellSize;
+        const t = len2 > 0 ? Math.min(1, Math.max(0, ((x - ax) * dx + (y - ay) * dy) / len2)) : 0;
+        if (Math.hypot(x - (ax + t * dx), y - (ay + t * dy)) <= half) visit(j * g.nx + i);
+      }
+    }
+  }
+}
+
+/**
+ * The file's cliffs on the 10 m terrain's grid: where a cliff has a rock share, a style or a profile, the cells whose centres it covers
+ * take it, later cliffs over earlier ones. Pure; the same file and grid always give the same rasters. The grid's `origin` is the
+ * projection of the scenario (the same one the vegetation polygons are placed with).
+ */
+export function rasteriseCliffs(file: CliffFile, grid: GridSpec): RasteriseResult {
+  const n = grid.nx * grid.ny;
+  const rasters: CliffRasters = { grid, rock: new Int16Array(n).fill(-1), style: new Uint8Array(n), profile: new Uint8Array(n) };
+  const proj = new LocalProjection(grid.origin);
+  const local = (q: Position): XY => proj.toLocal({ lat: q[1], lon: q[0] } satisfies LatLon);
+  let applied = 0;
+  const outside: number[] = [];
+  for (const f of file.features) {
+    const rock = f.rockShare === undefined ? -1 : Math.round(f.rockShare * 255);
+    const style = f.rockStyle === undefined ? -1 : styleCode(f.rockStyle);
+    const profile = f.profile === undefined ? -1 : profileCode(f.profile);
+    let touched = false;
+    const visit = (k: number): void => {
+      touched = true;
+      if (rock >= 0) rasters.rock[k] = rock;
+      if (style >= 0) rasters.style[k] = style;
+      if (profile >= 0) rasters.profile[k] = profile;
+    };
+    for (const poly of f.polygons) fillPolygon(poly.map((r) => r.map(local)), grid, visit);
+    for (const l of f.lines) strokeLine(l.map(local), (f.widthM ?? CLIFF_LINE_WIDTH_M.default) / 2, grid, visit);
+    if (touched) applied++;
+    else outside.push(f.index);
+  }
+  return { rasters, applied, outside };
+}
+
+/** What the Data sets Terrain card says about the file (datasetRecords.ts): plain data, safe to put in a record. */
+export interface HandMappedCliffs {
+  /** Cliffs that cover at least one cell of this scenario's ground. */
+  count: number;
+  /** Cliffs in the file that cover none of it. */
+  outside: number;
+  source: string;
+  licence: string;
+  /** The file's credit and the distinct credits of the cliffs that were applied. */
+  credits: string[];
+  /** The day the file says it was mapped. */
+  capturedOn: string;
+}
+
+export function describeCliffs(file: CliffFile, r: RasteriseResult): HandMappedCliffs {
+  const credits = [file.credit];
+  for (const f of file.features) if (f.credit && !r.outside.includes(f.index) && !credits.includes(f.credit)) credits.push(f.credit);
+  return { count: r.applied, outside: r.outside.length, source: file.source, licence: file.licence, credits, capturedOn: file.capturedOn };
+}
+
+// ─────────────────────────────────────────────────────────────────────────────
+// Reading the bundled file
+// ─────────────────────────────────────────────────────────────────────────────
+
+const memo = new Map<string, Promise<ParsedCliffs>>();
+
+/**
+ * A site's bundled cliffs.geojson, read and checked (memoised by site, so the build and the view ask once). A file that cannot be read
+ * or is refused comes back with its problems and is not remembered. Never throws. Callers ask only for a site whose manifest lists the
+ * file (cliffsSite.ts), so no request is made for a file that does not exist.
+ */
+export function loadCliffsFile(siteId: string, signal?: AbortSignal, trace?: TraceOptions): Promise<ParsedCliffs> {
+  let m = memo.get(siteId);
+  if (!m) {
+    m = (async (): Promise<ParsedCliffs> => {
+      const bytes = await loadAsset(`demo/${siteId}/${CLIFFS_FILE}`, signal, trace).catch(() => null);
+      if (!bytes) return { ok: false, problems: [`${CLIFFS_FILE} is listed with the app's data but could not be read.`] };
+      if (bytes.byteLength > CLIFFS_MAX_CHARS) return { ok: false, problems: [`${CLIFFS_FILE} is ${bytes.byteLength} bytes; the most is ${CLIFFS_MAX_CHARS}.`] };
+      return parseCliffsText(new TextDecoder().decode(bytes));
+    })();
+    memo.set(siteId, m);
+    void m.then((r) => {
+      if (!r.ok) memo.delete(siteId);
+    });
+  }
+  return m;
+}
+
+/** Forget what was read (tests). */
+export const clearCliffsMemo = (): void => memo.clear();
