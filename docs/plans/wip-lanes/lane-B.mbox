diff --git a/src/render/cliffOverride.test.ts b/src/render/cliffOverride.test.ts
new file mode 100644
index 0000000..93995d2
--- /dev/null
+++ b/src/render/cliffOverride.test.ts
@@ -0,0 +1,235 @@
+/**
+ * A person's map of the cliffs in the cliff drawing (plan 15b, contract 0.10.0 section 4.5): a rock share replaces the mask's R (and the tree
+ * copy, scree and pavement follow it), a style and a profile ride in the alpha byte, a profile scales how far the ground is sharpened, and with
+ * no map every byte is what it was. Synthetic escarpment: a plateau, a 70 degree face of 150 m, talus (as cliffDrawing.test.ts).
+ */
+import { describe, expect, it } from 'vitest';
+import { buildCliffDrawing, type DetailTier } from './cliffDrawing';
+import { cliffSharpen } from './cliffSharpen';
+import { CLIFF_PROFILES, lookByte, type CliffRasters } from './cliffStyle';
+import { buildRockMask, sampleRock } from './rockMask';
+import { edgeSlopes, flatGrid, maxOf, terrainOf } from './testing/cliffs';
+
+const TAN = (deg: number): number => Math.tan((deg * Math.PI) / 180);
+const FACE_RUN = 150 / TAN(70);
+const g = flatGrid(180, 60);
+const height = (x: number): number => (x <= 700 ? 600 : x <= 700 + FACE_RUN ? 600 - (x - 700) * TAN(70) : 450 - (x - 700 - FACE_RUN) * TAN(30));
+const escarpment = (): Float32Array => terrainOf(g, (i) => height(i * 10));
+const noCover = { grid: g, canopyCover: new Float32Array(g.nx * g.ny) };
+const run = (z: Float32Array, cliffs?: CliffRasters | null, tier: DetailTier = 'high') =>
+  buildCliffDrawing({ hi: { grid: g, elevation: z }, fuel: noCover, meshN: 90, tier, source: 'test', ...(cliffs !== undefined ? { cliffs } : {}) });
+
+/** A map that says nothing, to fill in. Cells are (i, j) with i east and j north, 10 m apart. */
+const blank = (): CliffRasters => ({ grid: g, rock: new Int16Array(g.nx * g.ny).fill(-1), style: new Uint8Array(g.nx * g.ny), profile: new Uint8Array(g.nx * g.ny) });
+function paint(r: CliffRasters, i0: number, i1: number, j0: number, j1: number, set: { rock?: number; style?: number; profile?: number }): number {
+  let n = 0;
+  for (let j = j0; j <= j1; j++)
+    for (let i = i0; i <= i1; i++) {
+      const k = j * g.nx + i;
+      if (set.rock !== undefined) r.rock[k] = set.rock;
+      if (set.style !== undefined) r.style[k] = set.style;
+      if (set.profile !== undefined) r.profile[k] = set.profile;
+      n++;
+    }
+  return n;
+}
+const at = (i: number, j: number): number => j * g.nx + i;
+
+describe('with no map the cliff drawing is exactly what it was', () => {
+  const z = escarpment();
+  const plain = run(z);
+
+  it('an absent map and a null map give the same mask, mesh, gradient and rock copy, byte for byte', () => {
+    for (const none of [null, undefined]) {
+      const again = run(z, none);
+      expect(again.mask.rgba).toEqual(plain.mask.rgba);
+      expect(again.mesh.elevation).toEqual(plain.mesh.elevation);
+      expect(again.gradient.dzdx).toEqual(plain.gradient.dzdx);
+      expect(again.rock.r).toEqual(plain.rock.r);
+      expect(again.stats.mappedCells).toBe(0);
+    }
+  });
+
+  it('a map that says nothing is the same as no map', () => {
+    const empty = run(z, blank());
+    expect(empty.mask.rgba).toEqual(plain.mask.rgba);
+    expect(empty.mesh.elevation).toEqual(plain.mesh.elevation);
+    expect(empty.rock.r).toEqual(plain.rock.r);
+    expect(empty.stats.mappedCells).toBe(0);
+  });
+
+  it('every alpha byte is 255 and the face has rock, so the checks below have something to change', () => {
+    for (let p = 3; p < plain.mask.rgba.length; p += 4) expect(plain.mask.rgba[p]).toBe(255);
+    expect(plain.mask.stats.rockCells).toBeGreaterThan(20);
+    expect(plain.mask.stats.screeCells).toBeGreaterThan(0);
+  });
+});
+
+describe('a rock share', () => {
+  const z = escarpment();
+  const plain = run(z);
+
+  it('becomes the mask’s R on gentle ground, and the copy that keeps trees off bare faces follows it', () => {
+    const r = blank();
+    const n = paint(r, 20, 39, 20, 39, { rock: 255 });
+    const cd = run(z, r);
+    expect(plain.mask.rgba[at(30, 30) * 4]).toBe(0);
+    for (const [i, j] of [[20, 20], [30, 30], [39, 39]] as const) expect(cd.mask.rgba[at(i, j) * 4]).toBe(255);
+    expect(cd.mask.rgba[at(19, 30) * 4]).toBe(0);
+    expect(cd.mask.rgba[at(40, 30) * 4]).toBe(0);
+    expect(sampleRock(cd.rock, 300, 300)).toBe(1);
+    expect(sampleRock(plain.rock, 300, 300)).toBe(0);
+    expect(cd.stats.mappedCells).toBe(n);
+    expect(cd.mask.stats.rockCells).toBe(plain.mask.stats.rockCells + n);
+  });
+
+  it('takes the byte it is given, not a slope’s: a share of 0.4 is 102', () => {
+    const r = blank();
+    paint(r, 20, 39, 20, 39, { rock: Math.round(0.4 * 255) });
+    const cd = run(z, r);
+    expect(cd.mask.rgba[at(30, 30) * 4]).toBe(102);
+    expect(cd.mask.stats.rockCells).toBe(plain.mask.stats.rockCells); // under half is not "rock cells"
+  });
+
+  it('a share of 0 takes the rock off a steep face (the map is a person’s look at it), and the scree below it goes with it', () => {
+    const r = blank();
+    paint(r, 60, 90, 0, 59, { rock: 0 });
+    const cd = run(z, r);
+    let faceBefore = 0;
+    for (let j = 0; j < g.ny; j++) for (let i = 60; i <= 90; i++) if (plain.mask.rgba[at(i, j) * 4]! >= 128) faceBefore++;
+    expect(faceBefore).toBeGreaterThan(20);
+    for (let j = 0; j < g.ny; j++) for (let i = 60; i <= 90; i++) expect(cd.mask.rgba[at(i, j) * 4]).toBe(0);
+    expect(cd.mask.stats.rockCells).toBe(0);
+    expect(cd.mask.stats.screeCells).toBe(0); // no rock uphill, no scree
+    expect(cd.mask.stats.lipCells).toBe(0);
+    for (let k = 0; k < g.nx * g.ny; k++) expect(cd.rock.r[k]).toBe(0);
+  });
+
+  it('puts scree below and pavement on top of rock a person drew, as it does for rock the slope found', () => {
+    // the slope finds the face; remove it, and draw the same rock a little way back on the plateau instead: the scree and pavement move
+    const r = blank();
+    paint(r, 60, 90, 0, 59, { rock: 0 });
+    paint(r, 50, 55, 0, 59, { rock: 255 });
+    const cd = run(z, r);
+    expect(cd.mask.stats.rockCells).toBe(6 * 60);
+    expect(cd.mask.stats.lipCells + cd.mask.stats.screeCells).toBeGreaterThan(0);
+  });
+
+  it('only the mapped cells change: every other byte of R, G and B is the plain drawing’s', () => {
+    const r = blank();
+    paint(r, 20, 39, 20, 39, { rock: 255 });
+    const cd = run(z, r);
+    let differ = 0;
+    for (let k = 0; k < g.nx * g.ny; k++) {
+      const i = k % g.nx;
+      const j = (k - i) / g.nx;
+      const inside = i >= 20 && i <= 39 && j >= 20 && j <= 39;
+      for (let c = 0; c < 4; c++) {
+        if (cd.mask.rgba[k * 4 + c] !== plain.mask.rgba[k * 4 + c]) {
+          differ++;
+          expect(inside || c !== 0, `R changed outside the map at ${i},${j}`).toBe(true);
+        }
+      }
+    }
+    expect(differ).toBeGreaterThan(0);
+  });
+});
+
+describe('a style and a profile', () => {
+  const z = escarpment();
+
+  it('go to the alpha byte (style in the low three bits, profile above them) and leave R, G and B as they were', () => {
+    const plain = run(z);
+    const r = blank();
+    paint(r, 10, 19, 5, 14, { style: 3 });
+    paint(r, 12, 25, 8, 20, { profile: 2 });
+    paint(r, 14, 15, 9, 10, { style: 6, profile: 3 });
+    const cd = run(z, r);
+    expect(cd.mask.rgba[at(10, 5) * 4 + 3]).toBe(lookByte(3, 0));
+    expect(cd.mask.rgba[at(25, 20) * 4 + 3]).toBe(lookByte(0, 2));
+    expect(cd.mask.rgba[at(13, 8) * 4 + 3]).toBe(lookByte(3, 2));
+    expect(cd.mask.rgba[at(14, 9) * 4 + 3]).toBe(lookByte(6, 3));
+    expect(cd.mask.rgba[at(100, 40) * 4 + 3]).toBe(255);
+    for (let k = 0; k < g.nx * g.ny; k++) for (let c = 0; c < 3; c++) expect(cd.mask.rgba[k * 4 + c]).toBe(plain.mask.rgba[k * 4 + c]);
+  });
+
+  it('count in mappedCells once per cell, whichever of the three the map says', () => {
+    const r = blank();
+    let n = paint(r, 10, 19, 5, 14, { style: 3 });
+    n += paint(r, 30, 39, 5, 14, { profile: 1 });
+    n += paint(r, 50, 59, 5, 14, { rock: 10 });
+    expect(run(z, r).stats.mappedCells).toBe(n);
+  });
+
+  it('refuse a map made for another grid, and rasters or look arrays of the wrong length', () => {
+    const other = blank();
+    other.grid = { ...g, x0: 5 };
+    expect(() => run(z, other)).toThrow(RangeError);
+    expect(() =>
+      buildRockMask({ grid: g, elevation: z, slope: { grid: g, values: new Float32Array(g.nx * g.ny) }, override: { rock: new Int16Array(5), look: new Uint8Array(g.nx * g.ny) } }),
+    ).toThrow(/override.rock has 5 values/);
+    expect(() =>
+      buildRockMask({ grid: g, elevation: z, slope: { grid: g, values: new Float32Array(g.nx * g.ny) }, override: { rock: new Int16Array(g.nx * g.ny), look: new Uint8Array(3) } }),
+    ).toThrow(/override.look has 3 values/);
+  });
+});
+
+describe('a profile scales how far the ground is sharpened', () => {
+  const z = escarpment();
+  const codes = (i0: number, i1: number, j0: number, j1: number, code: number): Uint8Array => {
+    const c = new Uint8Array(g.nx * g.ny);
+    for (let j = j0; j <= j1; j++) for (let i = i0; i <= i1; i++) c[at(i, j)] = code;
+    return c;
+  };
+  const scale = [1, ...CLIFF_PROFILES.map((p) => p.sharpen)];
+
+  it('with no scaling, or scaling by 1, gives exactly the rule’s ground', () => {
+    const base = cliffSharpen(g, z).elevation;
+    expect(cliffSharpen(g, z, {}, undefined).elevation).toEqual(base);
+    expect(cliffSharpen(g, z, {}, { codes: new Uint8Array(g.nx * g.ny), scale }).elevation).toEqual(base);
+    expect(cliffSharpen(g, z, {}, { codes: codes(0, g.nx - 1, 0, g.ny - 1, 2), scale: [1, 1, 1, 1] }).elevation).toEqual(base); // "stepped" sharpens as the rule does
+  });
+
+  it('moves the ground it covers more than the rule does, and leaves every cell outside it alone', () => {
+    const base = cliffSharpen(g, z);
+    const vertical = cliffSharpen(g, z, {}, { codes: codes(0, g.nx - 1, 10, 49, 1), scale });
+    expect(vertical.stats.movedMeanM * vertical.stats.moved).toBeGreaterThan(base.stats.movedMeanM * base.stats.moved);
+    let changed = 0;
+    for (let k = 0; k < g.nx * g.ny; k++) {
+      const j = Math.floor(k / g.nx);
+      if (vertical.elevation[k] !== base.elevation[k]) {
+        changed++;
