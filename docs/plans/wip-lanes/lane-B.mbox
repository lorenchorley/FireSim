+/**
+ * The hand-mapped cliffs file (plan 15b, contract 0.10.0 section 4.5): the validator refuses a malformed file with a plain sentence and never
+ * throws, the rasteriser puts the cliffs on the 10 m grid exactly (against brute force), and the way to the file asks for nothing when the
+ * site has none. The fixtures are synthetic (tests/fixtures/cliffs): no cliff has been mapped, and nothing is in public/demo.
+ */
+import { readFileSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+import { afterEach, describe, expect, it } from 'vitest';
+import { LocalProjection } from '../core/geo';
+import { makeGridSpec, type GridSpec } from '../core/grid';
+import { bundleFile, CLIFFS_FILE, setAssetLoader, type BundleManifest } from '../data';
+import { CLIFF_LINE_WIDTH_M, CLIFFS_MAX_CHARS, CLIFFS_MAX_FEATURES, CLIFFS_MAX_VERTICES, clearCliffsMemo, describeCliffs, loadCliffsFile, parseCliffs, parseCliffsText, rasteriseCliffs } from './cliffs';
+import { cliffsRefusedWarning, siteCliffs } from './cliffsSite';
+
+const FIXTURES = fileURLToPath(new URL('../../tests/fixtures/cliffs/', import.meta.url));
+const fixtureText = (name: string): string => readFileSync(FIXTURES + name, 'utf8');
+/** The synthetic Katoomba file as a plain object a test can break. */
+const doc = (): any => JSON.parse(fixtureText('synthetic-katoomba.geojson')); // eslint-disable-line @typescript-eslint/no-explicit-any
+
+const ORIGIN = { lat: -33.715, lon: 150.285 };
+const proj = new LocalProjection(ORIGIN);
+/** A ring or line given in local metres, as GeoJSON [longitude, latitude]. */
+const ll = (pts: [number, number][]): [number, number][] => pts.map(([x, y]) => {
+  const p = proj.toLatLon(x, y);
+  return [p.lon, p.lat];
+});
+const closed = (pts: [number, number][]): [number, number][] => [...pts, pts[0]!];
+/** 200 x 200 cells of 10 m centred on the origin: cell centres at 5, 15 ... (x0 = -995). */
+const grid: GridSpec = makeGridSpec(ORIGIN, 2000, 10);
+const header = { type: 'FeatureCollection', source: 'a test', licence: 'a test licence', credit: 'a tester', capturedOn: '2026-11-08' };
+const feature = (properties: object, geometry: object) => ({ type: 'Feature', properties, geometry });
+const polygon = (pts: [number, number][]) => ({ type: 'Polygon', coordinates: [closed(ll(pts))] });
+const file = (...features: object[]) => {
+  const r = parseCliffs({ ...header, features });
+  if (!r.ok) throw new Error(r.problems.join(' | '));
+  return r.file;
+};
+const cellsOf = (a: ArrayLike<number>, v: number): number[] => {
+  const out: number[] = [];
+  for (let k = 0; k < a.length; k++) if (a[k] === v) out.push(k);
+  return out;
+};
+const centre = (k: number): [number, number] => [grid.x0 + (k % grid.nx) * grid.cellSize, grid.y0 + Math.floor(k / grid.nx) * grid.cellSize];
+
+/** Why a document is refused, in one string; fails when it is accepted. */
+function why(d: unknown): string {
+  const r = parseCliffs(d);
+  if (r.ok) throw new Error('the file was accepted');
+  expect(r.problems.length).toBeGreaterThan(0);
+  for (const p of r.problems) expect(typeof p).toBe('string');
+  return r.problems.join(' | ');
+}
+
+describe('the cliffs file: what is accepted', () => {
+  it('reads the synthetic fixture: four cliffs, their properties and the file’s own words', () => {
+    const r = parseCliffsText(fixtureText('synthetic-katoomba.geojson'));
+    expect(r.ok).toBe(true);
+    if (!r.ok) return;
+    expect(r.file.licence).toMatch(/None/);
+    expect(r.file.capturedOn).toBe('2026-11-08');
+    expect(r.file.features.map((f) => [f.name, f.rockShare, f.rockStyle, f.profile, f.widthM, f.polygons.length, f.lines.length])).toEqual([
+      ['Synthetic face A', 0.9, 'banded', 'vertical', undefined, 1, 0],
+      ['Synthetic line B', undefined, 'jointed', 'undercut', 40, 0, 1],
+      ['Synthetic patch C on gentle ground', 0, 'smooth', undefined, undefined, 1, 0],
+      ['Synthetic square D, off the site', 1, undefined, 'stepped', undefined, 1, 0],
+    ]);
+    expect(r.file.features[1]!.credit).toBe('Second synthetic credit');
+  });
+
+  it('takes a height on a position and ignores it (the terrain is the terrain as received), and MultiPolygon and MultiLineString', () => {
+    const d = doc();
+    d.features = [
+      feature({ rockShare: 0.5 }, { type: 'MultiPolygon', coordinates: [[closed(ll([[0, 0], [50, 0], [50, 50]]).map(([a, b]) => [a, b, 800] as unknown as [number, number]))], [closed(ll([[200, 0], [250, 0], [250, 50]]))]] }),
+      feature({ profile: 'stepped' }, { type: 'MultiLineString', coordinates: [ll([[0, 100], [100, 100]]), ll([[0, 200], [100, 200]])] }),
+    ];
+    const r = parseCliffs(d);
+    expect(r.ok).toBe(true);
+    if (r.ok) expect([r.file.features[0]!.polygons.length, r.file.features[1]!.lines.length]).toEqual([2, 2]);
+  });
+
