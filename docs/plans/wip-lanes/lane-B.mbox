+    profiles.forEach(([, line], i) => expect(line, CLIFF_PROFILES[i]!.id).toContain(CLIFF_PROFILES[i]!.looks));
+  });
+
+  it('states the limits the checker enforces', () => {
+    expect(GUIDE).toContain(`up to ${CLIFFS_MAX_FEATURES} cliffs, ${CLIFFS_MAX_VERTICES.toLocaleString('en-US')} positions in all and ${CLIFFS_MAX_CHARS.toLocaleString('en-US')} characters`);
+    expect(GUIDE).toContain(`${CLIFF_LINE_WIDTH_M.min} to ${CLIFF_LINE_WIDTH_M.max} m (${CLIFF_LINE_WIDTH_M.default} if you leave it out)`);
+    expect(GUIDE).toContain('up to 200 characters');
+    expect(GUIDE).toContain('up to 500 characters');
+  });
+
+  it('quotes the sentence the checker writes for a style it does not know', () => {
+    const doc = JSON.parse(/```json\n([\s\S]*?)\n```/.exec(GUIDE)![1]!);
+    doc.features[1].properties.rockStyle = 'granite';
