+    linkStats: throttle ? { upPeakQueuedKiB: Math.round(throttle.stats.up.peakQueuedBytes / 1024), downPeakQueuedKiB: Math.round(throttle.stats.down.peakQueuedBytes / 1024), downMiB: mib(throttle.stats.down.bytes) } : null,
+  }),
