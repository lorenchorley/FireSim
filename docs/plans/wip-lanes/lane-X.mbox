+/**
+ * Small helpers for the committed data of the grid-difference study: 16-bit rasters are stored as two byte planes of their
+ * differences along x (arrival times are smooth, so the differences are small and gzip packs them well), inside the same
+ * container as the rest of this folder (lib/io.ts). Written by 12_aggregate.run.ts, read by 13_score.run.ts.
+ */
+import { loadFields, saveFields, type Arr } from './io';
+
+/** u16 raster of width nx -> 2 * n bytes: the low bytes, then the high bytes, of the difference to the left neighbour (wrapping). */
+export function packU16(a: Uint16Array, nx: number): Uint8Array {
+  const n = a.length;
+  const out = new Uint8Array(2 * n);
+  for (let k = 0; k < n; k++) {
+    const d = k % nx === 0 ? a[k]! : (a[k]! - a[k - 1]!) & 0xffff;
+    out[k] = d & 0xff;
+    out[n + k] = d >> 8;
+  }
+  return out;
+}
+
+export function unpackU16(b: Uint8Array, nx: number): Uint16Array {
+  const n = b.length / 2;
+  const out = new Uint16Array(n);
+  for (let k = 0; k < n; k++) {
+    const d = b[k]! | (b[n + k]! << 8);
+    out[k] = k % nx === 0 ? d : (out[k - 1]! + d) & 0xffff;
+  }
+  return out;
+}
+
+export interface LadderSet {
+  meta: Record<string, unknown>;
+  u8: Record<string, Uint8Array>;
+  /** name -> [raster, width] */
+  u16: Record<string, [Uint16Array, number]>;
+}
+
+export function saveLadder(path: string, set: LadderSet): number {
+  const arrays: Record<string, Arr> = { ...set.u8 };
+  const widths: Record<string, number> = {};
+  for (const [name, [a, nx]] of Object.entries(set.u16)) {
+    arrays[`${name}.u16`] = packU16(a, nx);
+    widths[name] = nx;
+  }
+  return saveFields(path, { ...set.meta, u16widths: widths }, arrays);
+}
+
+export function loadLadder(path: string): { meta: Record<string, unknown>; u8: Record<string, Uint8Array>; u16: Record<string, Uint16Array> } {
+  const { meta, a } = loadFields<Record<string, unknown> & { u16widths: Record<string, number> }>(path);
+  const u8: Record<string, Uint8Array> = {};
+  const u16: Record<string, Uint16Array> = {};
+  for (const [name, arr] of Object.entries(a)) {
+    if (name.endsWith('.u16')) {
+      const base = name.slice(0, -4);
+      u16[base] = unpackU16(arr as Uint8Array, meta.u16widths[base]!);
+    } else u8[name] = arr as Uint8Array;
+  }
+  return { meta, u8, u16 };
+}
