+  results.tuned = tuned;
+  writeFileSync(`${DATA}ladder-scores.json`, `${JSON.stringify(results)}\n`);
+
+  // ── tables ──
+  const runs: string[] = ['| Site | embers | burnt ha at 8 h, 30 / 20 / 10 m | wall s, 30 / 20 / 10 m | peak RSS MB, 10 m |', '|---|---|---|---|---|'];
+  for (const s of sites) for (const flav of ['on', 'off']) {
