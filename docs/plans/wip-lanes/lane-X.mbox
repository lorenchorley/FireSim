+  const key = (s: PairSpec): string => `${s.grid}.${s.a}v${s.b}${s.flavB ? `.${s.flav}v${s.flavB}` : `.${s.flav}`}.${s.H}h.${s.metric}`;
+
+  // ── every case: D (and E) for the main pair and the others ──
+  const specs: PairSpec[] = [];
