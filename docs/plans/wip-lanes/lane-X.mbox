+/** Small statistics for the grid-difference study (13_score.run.ts). Plain functions of arrays; nothing here reads the simulation. */
+
+/** Average ranks (ties share the mean rank), 1-based. */
+export function ranks(v: ArrayLike<number>): Float64Array {
+  const n = v.length;
+  const idx = Int32Array.from({ length: n }, (_, i) => i);
+  idx.sort((a, b) => v[a]! - v[b]! || a - b);
+  const r = new Float64Array(n);
+  let i = 0;
+  while (i < n) {
+    let j = i;
+    while (j + 1 < n && v[idx[j + 1]!]! === v[idx[i]!]!) j++;
+    const rank = (i + j) / 2 + 1;
+    for (let k = i; k <= j; k++) r[idx[k]!] = rank;
+    i = j + 1;
+  }
+  return r;
+}
+
+export function pearson(a: ArrayLike<number>, b: ArrayLike<number>): number {
+  const n = a.length;
+  let ma = 0;
+  let mb = 0;
+  for (let i = 0; i < n; i++) {
+    ma += a[i]!;
+    mb += b[i]!;
+  }
+  ma /= n;
+  mb /= n;
+  let sab = 0;
+  let saa = 0;
+  let sbb = 0;
+  for (let i = 0; i < n; i++) {
+    const x = a[i]! - ma;
+    const y = b[i]! - mb;
+    sab += x * y;
+    saa += x * x;
+    sbb += y * y;
+  }
+  return saa > 0 && sbb > 0 ? sab / Math.sqrt(saa * sbb) : NaN;
+}
+
+/** Spearman rank correlation (Pearson on average ranks; NaN when one side is constant). */
+export const spearman = (a: ArrayLike<number>, b: ArrayLike<number>): number => pearson(ranks(a), ranks(b));
+
+/** Partial rank correlation of x and y given z, from the three Spearman coefficients. */
+export function partialSpearman(x: ArrayLike<number>, y: ArrayLike<number>, z: ArrayLike<number>): number {
+  const rx = ranks(x);
+  const ry = ranks(y);
+  const rz = ranks(z);
+  const xy = pearson(rx, ry);
+  const xz = pearson(rx, rz);
+  const yz = pearson(ry, rz);
+  return (xy - xz * yz) / Math.sqrt((1 - xz * xz) * (1 - yz * yz));
+}
+
+/** Seeded generator (mulberry32): every draw of the study is reproducible. */
+export function rng(seed: number): () => number {
+  let a = seed >>> 0;
+  return () => {
+    a = (a + 0x6d2b79f5) >>> 0;
+    let t = a;
+    t = Math.imul(t ^ (t >>> 15), t | 1);
+    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+export function quantile(sorted: ArrayLike<number>, p: number): number {
+  const n = sorted.length;
+  if (n === 0) return NaN;
+  const x = p * (n - 1);
+  const i = Math.floor(x);
+  const f = x - i;
+  return i + 1 < n ? sorted[i]! * (1 - f) + sorted[i + 1]! * f : sorted[i]!;
+}
+
+export const mean = (a: ArrayLike<number>): number => {
+  let s = 0;
+  for (let i = 0; i < a.length; i++) s += a[i]!;
+  return a.length ? s / a.length : NaN;
+};
+
+/** Median of a copy. */
+export const median = (a: ArrayLike<number>): number => quantile(Float64Array.from(a).sort(), 0.5);
+
+/**
+ * The share of a total that a set carries when the set is drawn at random: draws `m` of `n` items (without replacement) `draws` times
+ * and returns the sorted shares. `w[i]` is the item's part of the total (sums to 1 over all items).
+ */
+export function randomShares(w: Float64Array, m: number, draws: number, next: () => number): Float64Array {
+  const n = w.length;
+  const out = new Float64Array(draws);
+  const perm = Int32Array.from({ length: n }, (_, i) => i);
+  for (let d = 0; d < draws; d++) {
+    let s = 0;
+    for (let q = 0; q < m; q++) {
+      const j = q + Math.floor(next() * (n - q));
+      const t = perm[q]!;
+      perm[q] = perm[j]!;
+      perm[j] = t;
+      s += w[perm[q]!]!;
+    }
+    out[d] = s;
+  }
+  return out.sort();
+}
+
+/** Same, but the random set keeps the number of items the real set has in each group (`group[i]` in 0..groups-1; `want[g]` items of group g). */
+export function stratifiedShares(w: Float64Array, group: Int32Array, groups: number, want: Int32Array, draws: number, next: () => number): Float64Array {
+  const members: number[][] = Array.from({ length: groups }, () => []);
+  for (let i = 0; i < w.length; i++) members[group[i]!]!.push(i);
+  const out = new Float64Array(draws);
+  for (let d = 0; d < draws; d++) {
+    let s = 0;
+    for (let g = 0; g < groups; g++) {
+      const mem = members[g]!;
+      const m = Math.min(want[g]!, mem.length);
+      for (let q = 0; q < m; q++) {
+        const j = q + Math.floor(next() * (mem.length - q));
+        const t = mem[q]!;
+        mem[q] = mem[j]!;
+        mem[j] = t;
+        s += w[mem[q]!]!;
+      }
+    }
+    out[d] = s;
+  }
+  return out.sort();
+}
+
+/** Position (0..1) of `x` in a sorted sample: the share of draws strictly below it plus half the ties. */
+export function percentileOf(sorted: Float64Array, x: number): number {
+  let lo = 0;
+  let hi = sorted.length;
+  while (lo < hi) {
+    const mid = (lo + hi) >> 1;
+    if (sorted[mid]! < x) lo = mid + 1;
+    else hi = mid;
+  }
+  let up = lo;
+  while (up < sorted.length && sorted[up]! === x) up++;
+  return (lo + up) / 2 / sorted.length;
+}
+
+/** Index of cell (i, j) of an n x n grid after one of the 8 symmetries of the square (t = 0..7) and a wrap-around shift (di, dj). */
+export function transformIndex(i: number, j: number, n: number, t: number, di: number, dj: number): number {
+  let a = i;
+  let b = j;
+  if (t & 1) a = n - 1 - a;
+  if (t & 2) b = n - 1 - b;
+  if (t & 4) [a, b] = [b, a];
+  a = (a + di) % n;
+  b = (b + dj) % n;
+  return b * n + a;
+}

