@@ -0,0 +1,463 @@
+/**
+ * Step 5: does the complexity score of the quality map predict where the arrival time differs between fire grids?
+ * Reads ONLY the committed containers `data/ladder-<site>.gz` (12_aggregate.run.ts), so every number can be re-made without a
+ * simulation. Writes `data/ladder-scores.json` (all numbers) and `data/ladder-tables.md` (the tables of the study note).
+ *
+ *   npx vitest run --config studies/adaptive-simulation-quality/vitest.config.ts 13_score
+ *   AQ_SITES=katoomba,thredbo limits the sites (the split below is fixed in this file, before any run was scored).
+ *
+ * THE PLAN (fixed before any 10 m or 20 m row was scored; see the study note, section Plan):
+ *   - Difference D of a cell = |arrival of the finer grid - arrival of the 30 m grid| in minutes, each arrival capped at the horizon H
+ *     (a cell the front has not reached by H counts as H, so "burnt in one run, not in the other" is a difference of at least the
+ *     time left). Main case: the 30 m grid, 30 m against 10 m (a 30 m cell holds 3 x 3 cells of 10 m: the mean of their capped
+ *     arrivals), H = 8 h. Scored cells: those that can burn in the 30 m model and are reached by H in at least one of the two runs.
+ *   - Local difference E of a cell: the size of the gradient of the signed difference over the 30 m cells (central differences, minutes per
+ *     cell): where the difference is made, not where it has piled up. Scored cells: fully reached by H in both runs, as are their 4 neighbours.
+ *   - Predictors: the complexity score as defined (the mean of S, C, G, L, R, equal weights; nothing fitted) and each part alone;
+ *     baselines: the 30 m slope and the arrival time itself (differences pile up with time).
+ *   - Measures: Spearman rank correlation over the scored cells; the same with the arrival time held fixed (partial); the share of the
+ *     summed difference carried by the top-20 % set (the 20 % of the whole domain with the highest score, as 01_baseline's quality
+ *     map defines it), against random sets of the same size (and the same number of cells in each tenth of the arrival-time range), and
+ *     against the same set moved elsewhere on the map (the 8 symmetries of the square and wrap-around shifts: it keeps the set's shape).
+ *   - Development sites (the only ones used to choose anything): katoomba, thredbo, warrumbungles. Hold-out sites (scored once, after the
+ *     choice is frozen): grose, kanangra, tomah. Re-weighting the five parts is fitted on the development sites only, then scored on
+ *     the hold-out sites. The score as defined was never fitted to any run, so it is scored on every site.
+ */
+import { existsSync, writeFileSync } from 'node:fs';
+import { it } from 'vitest';
+import { count, topShare } from './lib/analysis';
+import { loadLadder } from './lib/ladderio';
+import { mean, median, partialSpearman, pearson, quantile, randomShares, ranks, rng, spearman, stratifiedShares, transformIndex } from './lib/stats';
+
+export const DEV = ['katoomba', 'thredbo', 'warrumbungles'];
+export const HOLD = ['grose', 'kanangra', 'tomah'];
+const SITES = (process.env.AQ_SITES ?? [...DEV, ...HOLD].join(',')).split(',');
+const DATA = new URL('../data/', import.meta.url).pathname;
+const PARTS = ['S', 'C', 'G', 'L', 'R'] as const;
+const PREDICTORS = ['mean', ...PARTS, 'slope30'] as const;
+type Pred = (typeof PREDICTORS)[number];
+const DRAWS = { random: 2000, timeMatched: 1000, shift: 1000, shiftRho: 400 };
+const TOP = 0.2;
+const log = (s: string): void => {
+  process.stderr.write(`[score] ${s}\n`);
+};
+const r2 = (x: number): number => (Number.isFinite(x) ? Math.round(x * 100) / 100 : x);
+const r3 = (x: number): number => (Number.isFinite(x) ? Math.round(x * 1000) / 1000 : x);
+
+interface SiteData {
+  id: string;
+  nx: number;
+  meta: Record<string, unknown>;
+  parts: Record<(typeof PARTS)[number] | 'mean' | 'slope30', Float64Array>;
+  flam30: Uint8Array;
+  u8: Record<string, Uint8Array>;
+  u16: Record<string, Uint16Array>;
+}
+
+function loadSite(id: string): SiteData | null {
+  const path = `${DATA}ladder-${id}.gz`;
+  if (!existsSync(path)) return null;
+  const { meta, u8, u16 } = loadLadder(path);
+  const nx = (meta.grid30 as { nx: number }).nx;
+  const n = nx * nx;
+  const parts = {} as SiteData['parts'];
+  for (const p of PARTS) parts[p] = Float64Array.from(u16[p]!, (v) => v / 65535);
+  parts.mean = new Float64Array(n);
+  for (let k = 0; k < n; k++) parts.mean[k] = (parts.S[k]! + parts.C[k]! + parts.G[k]! + parts.L[k]! + parts.R[k]!) / 5;
+  parts.slope30 = Float64Array.from(u16.slope30!, (v) => v / 200);
+  return { id, nx, meta, parts, flam30: u8.flam30!, u8, u16 };
+}
+
+interface PairSpec {
+  /** 'g30' (the 30 m grid) or 'g60' (60 m blocks) */
+  grid: 'g30' | 'g60';
+  a: string;
+  b: string;
+  flav: 'on' | 'off';
+  /** the flavour of the second run when it differs (the seed reference) */
+  flavB?: string;
+  H: 4 | 8;
+  /** 'D' = the difference, 'E' = the local difference */
+  metric: 'D' | 'E';
+}
+
+interface Case {
+  site: string;
+  spec: PairSpec;
+  nx: number;
+  N: number;
+  /** scored cell indices */
+  U: Int32Array;
+  /** the metric over the whole grid (0 outside U) */
+  D: Float64Array;
+  /** signed difference y - x, minutes (whole grid) */
+  signed: Float64Array;
+  /** arrival of the first run, minutes (whole grid) */
+  ax: Float64Array;
+  pred: Record<Pred, Float64Array>;
+}
+
+function blockMean(v: Float64Array, nx: number): Float64Array {
+  const nb = nx / 2;
+  const out = new Float64Array(nb * nb);
+  for (let bj = 0; bj < nb; bj++) for (let bi = 0; bi < nb; bi++) out[bj * nb + bi] = (v[2 * bj * nx + 2 * bi]! + v[2 * bj * nx + 2 * bi + 1]! + v[(2 * bj + 1) * nx + 2 * bi]! + v[(2 * bj + 1) * nx + 2 * bi + 1]!) / 4;
+  return out;
+}
+
+function makeCase(s: SiteData, spec: PairSpec): Case | null {
+  const h = `${spec.H}h`;
+  const fB = spec.flavB ?? spec.flav;
+  const kx = `${spec.grid}.${spec.a}.${spec.flav}.${h}`;
+  const ky = `${spec.grid}.${spec.b}.${fB}.${h}`;
+  const cx = `${spec.grid === 'g30' ? 'n30' : 'n60'}.${spec.a}.${spec.flav}.${h}`;
+  const cy = `${spec.grid === 'g30' ? 'n30' : 'n60'}.${spec.b}.${fB}.${h}`;
+  const x16 = s.u16[kx];
+  const y16 = s.u16[ky];
+  const nxC = s.u8[cx];
+  const nyC = s.u8[cy];
+  if (!x16 || !y16 || !nxC || !nyC) return null;
+  const nx = spec.grid === 'g30' ? s.nx : s.nx / 2;
+  const N = nx * nx;
+  const ax = Float64Array.from(x16, (v) => v / 60);
+  const signed = new Float64Array(N);
+  for (let k = 0; k < N; k++) signed[k] = (y16[k]! - x16[k]!) / 60;
+  const flam = new Uint8Array(N);
+  if (spec.grid === 'g30') flam.set(s.flam30);
+  else for (let bj = 0; bj < nx; bj++) for (let bi = 0; bi < nx; bi++) flam[bj * nx + bi] = s.flam30[2 * bj * s.nx + 2 * bi]! | s.flam30[2 * bj * s.nx + 2 * bi + 1]! | s.flam30[(2 * bj + 1) * s.nx + 2 * bi]! | s.flam30[(2 * bj + 1) * s.nx + 2 * bi + 1]!;
+  const fullY = spec.grid === 'g30' ? (spec.b === '10' ? 9 : 1) : spec.b === '10' ? 36 : spec.b === '20' ? 9 : 4;
+  const fullX = spec.grid === 'g30' ? (spec.a === '10' ? 9 : 1) : spec.a === '10' ? 36 : spec.a === '20' ? 9 : 4;
+  const D = new Float64Array(N);
+  const U: number[] = [];
+  if (spec.metric === 'D') {
+    for (let k = 0; k < N; k++) {
+      if (!flam[k] || (nxC[k]! === 0 && nyC[k]! === 0)) continue;
+      D[k] = Math.abs(signed[k]!);
+      U.push(k);
+    }
+  } else {
+    const ok = new Uint8Array(N);
+    for (let k = 0; k < N; k++) ok[k] = flam[k] && nxC[k]! === fullX && nyC[k]! === fullY ? 1 : 0;
+    for (let j = 1; j < nx - 1; j++) {
+      for (let i = 1; i < nx - 1; i++) {
+        const k = j * nx + i;
+        if (!(ok[k] && ok[k - 1] && ok[k + 1] && ok[k - nx] && ok[k + nx])) continue;
+        D[k] = Math.hypot((signed[k + 1]! - signed[k - 1]!) / 2, (signed[k + nx]! - signed[k - nx]!) / 2);
+        U.push(k);
+      }
+    }
+  }
+  const pred = {} as Case['pred'];
+  for (const p of PREDICTORS) pred[p] = spec.grid === 'g30' ? s.parts[p] : blockMean(s.parts[p], s.nx);
+  return { site: s.id, spec, nx, N, U: Int32Array.from(U), D, signed, ax, pred };
+}
+
+export interface Stat {
+  n: number;
+  rho: number;
+  rhoPartial: number;
+  setCells: number;
+  setInU: number;
+  sizeShare: number;
+  share: number;
+  lift: number;
+  oracleShare: number;
+  recall: number;
+  recallExpected: number;
+  randomMean: number;
+  randomLo: number;
+  randomHi: number;
+  pRandom?: number;
+  pTimeMatched?: number;
+  pShift?: number;
+  shiftLo?: number;
+  shiftHi?: number;
+  rhoGlobal?: number;
+  rhoShiftLo?: number;
+  rhoShiftHi?: number;
+  pRhoShift?: number;
+}
+
+/** (1 + number of draws at least as large as x) / (1 + draws). */
+const exceed = (sorted: Float64Array, x: number): number => {
+  let lo = 0;
+  let hi = sorted.length;
+  const target = x - 1e-12;
+  while (lo < hi) {
+    const mid = (lo + hi) >> 1;
+    if (sorted[mid]! < target) lo = mid + 1;
+    else hi = mid;
+  }
+  return (1 + sorted.length - lo) / (1 + sorted.length);
+};
+
+function evaluate(c: Case, score: Float64Array, mc: boolean, seed: number): Stat {
+  const { U, D, N, nx } = c;
+  const n = U.length;
+  const sU = Float64Array.from(U, (k) => score[k]!);
+  const dU = Float64Array.from(U, (k) => D[k]!);
+  const aU = Float64Array.from(U, (k) => c.ax[k]!);
+  let total = 0;
+  for (let q = 0; q < n; q++) total += dU[q]!;
+  const set = topShare(score, TOP);
+  let setIn = 0;
+  let carried = 0;
+  for (let q = 0; q < n; q++) if (set[U[q]!]) {
+    setIn++;
+    carried += dU[q]!;
+  }
+  const setCells = count(set);
+  const share = total > 0 ? carried / total : NaN;
+  const sizeShare = n > 0 ? setIn / n : NaN;
+  // the best a set of this size could do: the setCells largest differences
+  const sortedD = Float64Array.from(dU).sort();
+  let best = 0;
+  for (let q = 0; q < Math.min(setCells, n); q++) best += sortedD[n - 1 - q]!;
+  // recall of the cells with the largest differences (top 20 % of the scored cells)
+  const cut = quantile(sortedD, 1 - TOP);
+  let big = 0;
+  let bigIn = 0;
+  for (let q = 0; q < n; q++) if (dU[q]! >= cut && dU[q]! > 0) {
+    big++;
+    if (set[U[q]!]) bigIn++;
+  }
+  const w = new Float64Array(N);
+  if (total > 0) for (let q = 0; q < n; q++) w[U[q]!] = dU[q]! / total;
+  const rand = randomShares(w, setCells, DRAWS.random, rng(seed));
+  const st: Stat = {
+    n,
+    rho: spearman(sU, dU),
+    rhoPartial: partialSpearman(sU, dU, aU),
+    setCells,
+    setInU: setIn,
+    sizeShare,
+    share,
+    lift: sizeShare > 0 ? share / sizeShare : NaN,
+    oracleShare: total > 0 ? best / total : NaN,
+    recall: big ? bigIn / big : NaN,
+    recallExpected: sizeShare,
+    randomMean: mean(rand),
+    randomLo: quantile(rand, 0.025),
+    randomHi: quantile(rand, 0.975),
+  };
+  if (!mc) return st;
+  st.pRandom = exceed(rand, share);
+  // random sets with the same number of cells in each tenth of the arrival-time range of the scored cells (group 10: not scored)
+  const rk = ranks(aU);
+  const group = new Int32Array(N).fill(10);
+  for (let q = 0; q < n; q++) group[U[q]!] = Math.min(9, Math.floor(((rk[q]! - 1) / n) * 10));
+  const want = new Int32Array(11);
+  for (let k = 0; k < N; k++) if (set[k]) want[group[k]!]!++;
+  st.pTimeMatched = exceed(stratifiedShares(w, group, 11, want, DRAWS.timeMatched, rng(seed + 1)), share);
+  // the same set moved elsewhere on the map
+  const setIdx = Int32Array.from({ length: N }, (_, k) => k).filter((k) => set[k]);
+  const next = rng(seed + 2);
+  const sh = new Float64Array(DRAWS.shift);
+  for (let d = 0; d < DRAWS.shift; d++) {
+    const t = Math.floor(next() * 8);
+    const di = Math.floor(next() * nx);
+    const dj = Math.floor(next() * nx);
+    let s = 0;
+    for (let q = 0; q < setIdx.length; q++) {
+      const k = setIdx[q]!;
+      s += w[transformIndex(k % nx, (k - (k % nx)) / nx, nx, t, di, dj)]!;
+    }
+    sh[d] = s;
+  }
+  sh.sort();
+  st.pShift = exceed(sh, share);
+  st.shiftLo = quantile(sh, 0.025);
+  st.shiftHi = quantile(sh, 0.975);
+  // the rank correlation with the score map moved elsewhere (ranks taken over the whole map: the same statistic for the real map and the moved ones)
+  const rg = ranks(score);
+  const rD = ranks(dU);
+  const obs = pearson(rD, Float64Array.from(U, (k) => rg[k]!));
+  st.rhoGlobal = obs;
+  const nxt = rng(seed + 3);
+  const rs = new Float64Array(DRAWS.shiftRho);
+  const tmp = new Float64Array(n);
+  for (let d = 0; d < DRAWS.shiftRho; d++) {
+    const t = Math.floor(nxt() * 8);
+    const di = Math.floor(nxt() * nx);
+    const dj = Math.floor(nxt() * nx);
+    for (let q = 0; q < n; q++) {
+      const k = U[q]!;
+      tmp[q] = rg[transformIndex(k % nx, (k - (k % nx)) / nx, nx, t, di, dj)]!;
+    }
+    rs[d] = pearson(rD, tmp);
+  }
+  rs.sort();
+  st.rhoShiftLo = quantile(rs, 0.025);
+  st.rhoShiftHi = quantile(rs, 0.975);
+  st.pRhoShift = exceed(rs, obs);
+  return st;
+}
+
+/** Ranks by a fast route for the weight search: scores are quantised to 1e-6 and the sort is a plain numeric sort of packed keys. */
+function ranksFast(v: Float64Array): Float64Array {
+  const n = v.length;
+  const keys = new Float64Array(n);
+  for (let i = 0; i < n; i++) keys[i] = Math.round(v[i]! * 1e6) * 131072 + i;
+  keys.sort();
+  const r = new Float64Array(n);
+  let i = 0;
+  while (i < n) {
+    const q = Math.floor(keys[i]! / 131072);
+    let j = i;
+    while (j + 1 < n && Math.floor(keys[j + 1]! / 131072) === q) j++;
+    const rank = (i + j) / 2 + 1;
+    for (let k = i; k <= j; k++) r[keys[k]! - Math.floor(keys[k]! / 131072) * 131072] = rank;
+    i = j + 1;
+  }
+  return r;
+}
+
+type Weights = Record<(typeof PARTS)[number], number>;
+
+function weighted(c: Case, w: Weights): Float64Array {
+  const out = new Float64Array(c.N);
+  let tot = 0;
+  for (const p of PARTS) tot += w[p];
+  for (let k = 0; k < c.N; k++) {
+    let s = 0;
+    for (const p of PARTS) s += w[p] * c.pred[p][k]!;
+    out[k] = s / tot;
+  }
+  return out;
+}
+
+/** All weight vectors on the simplex of the five parts with step 0.1 (1001 of them). */
+function simplex(): Weights[] {
+  const out: Weights[] = [];
+  for (let a = 0; a <= 10; a++) for (let b = 0; a + b <= 10; b++) for (let c = 0; a + b + c <= 10; c++) for (let d = 0; a + b + c + d <= 10; d++) {
+    out.push({ S: a / 10, C: b / 10, G: c / 10, L: d / 10, R: (10 - a - b - c - d) / 10 });
+  }
+  return out;
+}
+
+function fitWeights(cases: Case[]): { w: Weights; devRho: number } {
+  const rD = cases.map((c) => ranksFast(Float64Array.from(c.U, (k) => c.D[k]!)));
+  let best: Weights = { S: 0.2, C: 0.2, G: 0.2, L: 0.2, R: 0.2 };
+  let bestRho = -Infinity;
+  for (const w of simplex()) {
+    let sum = 0;
+    for (let i = 0; i < cases.length; i++) {
+      const c = cases[i]!;
+      const s = weighted(c, w);
+      sum += pearson(rD[i]!, ranksFast(Float64Array.from(c.U, (k) => s[k]!)));
+    }
+    const rho = sum / cases.length;
+    if (Number.isFinite(rho) && rho > bestRho) {
+      bestRho = rho;
+      best = w;
+    }
+  }
+  return { w: best, devRho: bestRho };
+}
+
+const fmt = (x: number | undefined, d = 2): string => (x === undefined || !Number.isFinite(x) ? 'n/a' : x.toFixed(d));
+const pct = (x: number | undefined, d = 0): string => (x === undefined || !Number.isFinite(x) ? 'n/a' : `${(100 * x).toFixed(d)} %`);
+const pfmt = (p: number | undefined): string => (p === undefined ? 'n/a' : p < 0.001 ? '<0.001' : p.toFixed(3));
+
+it('score the ladder', () => {
