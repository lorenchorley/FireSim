@@ -0,0 +1,56 @@
+// Runs ONE row of the grid-difference study (10_ladder.row.ts) in its own Node process: the repository's own Vite loads the
+// TypeScript of src/ as it is (no new dependency, nothing under src/ is changed or imports from here).
+//
+//   node --expose-gc studies/adaptive-simulation-quality/scripts/10_ladder.launch.mjs <spec.json> <out.json>
+//
+// The only override lives HERE, as a text patch of src/scenario/params.ts seen by this process alone (the same one the study
+// desktop-simulation/01-cost-vs-detail uses): for a 10 m row `highDetailCellM: 20` becomes 10, because the scenario builder
+// returns the "high detail" cell for any request of 20 m or finer and 10 m is the finest the bundled 10 m terrain allows.
+// A 20 m row needs no patch (20 m is the High-detail cell as shipped, allowed up to a 6 km domain), a 30 m row neither.
+import { createServer } from 'vite';
+import { readFileSync, writeFileSync } from 'node:fs';
+import { resolve, dirname } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const here = dirname(fileURLToPath(import.meta.url));
+const root = resolve(here, '../../..');
+const [specPath, outPath] = process.argv.slice(2);
+if (!specPath || !outPath) throw new Error('usage: 10_ladder.launch.mjs <spec.json> <out.json>');
+const spec = JSON.parse(readFileSync(specPath, 'utf8'));
+
+function patchParams() {
+  return {
+    name: 'study-patch-scenario-params',
+    enforce: 'pre',
+    transform(code, id) {
+      if (!/[\\/]src[\\/]scenario[\\/]params\.ts$/.test(id.split('?')[0])) return null;
+      if (spec.cell !== 10) return null;
+      const from = 'highDetailCellM: 20,';
+      if (!code.includes(from)) throw new Error(`params.ts no longer contains "${from}": update the patch`);
+      return { code: code.replace(from, 'highDetailCellM: 10,'), map: null };
+    },
+  };
+}
+
+const server = await createServer({
+  root,
+  configFile: false,
+  logLevel: 'error',
+  appType: 'custom',
+  server: { middlewareMode: true, hmr: false, watch: null },
+  optimizeDeps: { noDiscovery: true, include: [] },
+  resolve: { alias: { '@': resolve(root, 'src') } },
+  plugins: [patchParams()],
+});
+let result;
+try {
+  const mod = await server.ssrLoadModule('/studies/adaptive-simulation-quality/scripts/10_ladder.row.ts');
+  result = await mod.default(spec);
+} catch (e) {
+  result = { spec, error: String(e && e.stack ? e.stack : e) };
+} finally {
+  await server.close();
+}
+writeFileSync(outPath, JSON.stringify(result));
+console.log(result.error ? `FAILED ${spec.id}: ${String(result.error).split('\n')[0]}` : `ok ${spec.id}`);
+process.exit(result.error ? 1 : 0);
diff --git a/studies/adaptive-simulation-quality/scripts/10_ladder.row.ts b/studies/adaptive-simulation-quality/scripts/10_ladder.row.ts
new file mode 100644
index 0000000..85e91f8
--- /dev/null
+++ b/studies/adaptive-simulation-quality/scripts/10_ladder.row.ts
@@ -0,0 +1,143 @@
+/**
+ * One row of the grid-difference study: the standard scenario of the quality map (01_baseline.run.ts: 6 km square of a bundled site,
+ * the preset "hot-nw-sw-change" from its canonical 11:00, the fast tier, one point ignition of 30 m radius at t = 0, 8 simulated hours)
+ * at ONE fire cell size (30, 20 or 10 m), with embers on or off and one seed, and the per-cell arrival time of the finished run saved.
+ * Loaded by 10_ladder.launch.mjs through the repository's own Vite (so src/ is imported as it is). Not built, not shipped.
+ *
+ * The ignition is the same point at every cell size: the flammable cell of the 30 m grid with slope30 under 10 degrees nearest to
+ * (-1500, 1500) m from the domain centre, exactly as 01_baseline.run.ts picks it. A row of another cell size therefore first builds
+ * the 30 m scenario and a Simulation (constructor only, no run) to read that point.
+ *
+ * Saved (a `saveFields` container, lib/io.ts): `arrival` (s, Infinity = not reached in the window) and `flammable` on the row's own
+ * grid, and for a 30 m row also the static terrain measures the complexity score is made from (the same arrays 01_baseline.run.ts saves).
+ * The row's result (JSON) carries the grid, the ignition, the burnt area and perimeter every 30 min, the spot-fire count, wall time and memory.
+ */
+import { createMemoryKV, DEMO_SITES, setDefaultCache } from '../../../src/data';
+import { buildScenario } from '../../../src/scenario/build';
+import { WEATHER_PRESETS } from '../../../src/scenario/presets';
+import { BurnState, type ScenarioData } from '../../../src/core/types';
+import { Simulation } from '../../../src/sim/simulation';
+import { saveFields, type Arr } from './lib/io';
+import { shape10 } from './lib/terrain10';
+
+export interface LadderSpec {
+  id: string;
+  site: string;
+  /** Fire cell (m): 30, 20 or 10. */
+  cell: 30 | 20 | 10;
+  embers: boolean;
+  seed: number;
+  hours: number;
+  /** Where the raster container is written. */
+  rasterPath: string;
+}
+
+const PRESET = 'hot-nw-sw-change' as const;
+const EXTENT = 6000;
+const IGN_TARGET: [number, number] = [-1500, 1500];
+const IGN_RADIUS_M = 30;
+const mb = (b: number): number => Math.round((b / 1048576) * 10) / 10;
+
+async function build(spec: LadderSpec, cell: number): Promise<ScenarioData> {
+  setDefaultCache(createMemoryKV());
+  const site = DEMO_SITES.find((s) => s.id === spec.site);
+  if (!site) throw new Error(`unknown site ${spec.site}`);
+  const start = WEATHER_PRESETS[PRESET].canonicalStart(site.centre.lon, 2026);
+  return buildScenario({
+    centre: site.centre,
+    extent: EXTENT,
+    demoSiteId: spec.site,
+    weather: { kind: 'preset', presetId: PRESET, start },
+    duration: spec.hours * 3600,
+    online: false,
+    options: { tier: 'fast', seed: spec.seed, embers: spec.embers, ...(cell === 30 ? {} : { fireCellSize: cell }) },
+  });
+}
+
+export default async function run(spec: LadderSpec): Promise<Record<string, unknown>> {
+  const out: Record<string, unknown> = { spec, node: process.version };
+  const t0 = performance.now();
+
+  // The 30 m scenario: the ignition point (and, for a 30 m row, the run itself and the static terrain measures).
+  const sc30 = await build(spec, 30);
+  const g30 = sc30.terrain.grid;
+  const sim30 = new Simulation(sc30, { tier: 'fast' });
+  const v30 = sim30.stateView();
+  let best = -1;
+  let bestD = Infinity;
+  for (let j = 0; j < g30.ny; j++) {
+    for (let i = 0; i < g30.nx; i++) {
+      const k = j * g30.nx + i;
+      if (v30.fire.burnState[k] === BurnState.NonFlammable || v30.features.slope30[k]! >= 10) continue;
+      const d = Math.hypot(g30.x0 + i * g30.cellSize - IGN_TARGET[0], g30.y0 + j * g30.cellSize - IGN_TARGET[1]);
+      if (d < bestD) {
+        bestD = d;
+        best = k;
+      }
+    }
+  }
+  if (best < 0) throw new Error('no ignition cell');
+  const ign = { x: g30.x0 + (best % g30.nx) * g30.cellSize, y: g30.y0 + Math.floor(best / g30.nx) * g30.cellSize };
+  out.ignition = ign;
+  out.ignitionTargetDistM = bestD;
+
+  const extra: Record<string, Arr> = {};
+  if (spec.cell === 30) {
+    if (!sc30.terrainHiRes) throw new Error('no 10 m DEM in the scenario');
+    const n30 = g30.nx * g30.ny;
+    const feats = v30.features;
+    const terr = v30.terrain;
+    const sh = shape10(g30, sc30.terrainHiRes);
+    extra.slope30 = Float32Array.from(feats.slope30);
+    extra.slopeP90 = Float32Array.from(terr.slopeP90Deg ?? new Float32Array(n30));
+    extra.cliffFrac = Float32Array.from(terr.cliffFraction ?? new Float32Array(n30));
+    extra.landform = Uint8Array.from(terr.landform);
+    extra.drainage = Uint8Array.from(feats.drainage);
+    extra.trench = Float32Array.from(feats.trench);
+    extra.rough10 = sh.rough10;
+    extra.curv10 = sh.curv10;
+  }
+
+  // The row's own scenario and simulation.
+  let scenario = sc30;
+  let sim = sim30;
+  if (spec.cell !== 30) {
+    scenario = await build(spec, spec.cell);
+    sim = new Simulation(scenario, { tier: 'fast' });
+  }
+  const g = scenario.terrain.grid;
+  const n = g.nx * g.ny;
+  if (g.cellSize !== spec.cell || g.nx * g.cellSize !== EXTENT) throw new Error(`grid is ${g.nx} x ${g.ny} of ${g.cellSize} m, not ${spec.cell} m over ${EXTENT} m`);
+  out.grid = { nx: g.nx, ny: g.ny, cellSize: g.cellSize, x0: g.x0, y0: g.y0 };
+  out.buildS = (performance.now() - t0) / 1000;
+  const flammable = new Uint8Array(n);
+  const vS = sim.stateView();
+  for (let k = 0; k < n; k++) flammable[k] = vS.fire.burnState[k] === BurnState.NonFlammable ? 0 : 1;
+
+  sim.ignite({ id: 'ladder', kind: 'point', points: [[ign.x, ign.y]], time: 0, radius: IGN_RADIUS_M, origin: 'observed' });
+  const series: { t: number; burntHa: number; perimeterKm: number; headRos: number; spots: number; wallS: number }[] = [];
+  let peakRss = process.memoryUsage().rss;
+  const tRun = performance.now();
+  const chunk = 300;
+  for (let t = chunk; t <= spec.hours * 3600 + 1e-6; t += chunk) {
+    sim.advance(t);
+    peakRss = Math.max(peakRss, process.memoryUsage().rss);
+    if (t % 1800 === 0) {
+      const st = sim.stats();
+      series.push({ t, burntHa: st.burntAreaHa, perimeterKm: st.perimeterKm, headRos: st.headRos, spots: st.spotFires, wallS: (performance.now() - tRun) / 1000 });
+    }
+  }
+  out.runS = (performance.now() - tRun) / 1000;
+  out.peakRssMB = mb(Math.max(peakRss, process.resourceUsage().maxRSS * 1024));
+  out.series = series;
+  out.options = { embers: sim.options.embers, seed: spec.seed, maxEmbers: sim.options.maxEmbers, mountainPhenomena: sim.options.mountainPhenomena };
+  const arrival = Float32Array.from(sim.stateView().fire.arrivalTime);
+  let reached = 0;
+  for (let k = 0; k < n; k++) if (Number.isFinite(arrival[k]!)) reached++;
+  out.reachedCells = reached;
+  out.flammableCells = flammable.reduce((s, v) => s + v, 0);
+  out.cells = n;
+  const bytes = saveFields(spec.rasterPath, { id: spec.id, site: spec.site, grid: out.grid, ignition: ign }, { arrival, flammable, ...extra });
+  out.rasterBytes = bytes;
+  return out;
+}
diff --git a/studies/adaptive-simulation-quality/scripts/11_ladder.batch.mjs b/studies/adaptive-simulation-quality/scripts/11_ladder.batch.mjs
new file mode 100644
index 0000000..b16543a
--- /dev/null
+++ b/studies/adaptive-simulation-quality/scripts/11_ladder.batch.mjs
@@ -0,0 +1,52 @@
+// Runs the rows of the grid-difference study one after the other, each in its own Node process and each under the machine's shared
+// heavy-job lock (so another job can take its turn between two rows; a 10 m row of 8 simulated hours takes minutes and about 1.2 GB).
+//
+//   setsid nohup node studies/adaptive-simulation-quality/scripts/11_ladder.batch.mjs <outdir> <log> [sites] [cells] [flavours] &
+//     sites     comma list (default: the six sites of the study, in run order)
+//     cells     comma list of fire cells (default 30,20,10)
+//     flavours  comma list of: off (embers off), on (embers on, seed 1), on2 (embers on, seed 2; 30 m only) (default off,on,on2)
+//   The last line of <log> is "DONE" when the batch has finished. A row whose raster file exists is skipped, so an interrupted
+//   batch can be started again. Row ids are <site>.<cell>m.<flavour>.
+import { spawnSync } from 'node:child_process';
+import { existsSync, mkdirSync, writeFileSync, appendFileSync } from 'node:fs';
+import { resolve, dirname } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const here = dirname(fileURLToPath(import.meta.url));
+const root = resolve(here, '../../..');
+const [outDir, logPath, sitesArg, cellsArg, flavArg] = process.argv.slice(2);
+if (!outDir || !logPath) throw new Error('usage: 11_ladder.batch.mjs <outdir> <log> [sites] [cells] [flavours]');
+mkdirSync(outDir, { recursive: true });
+const SITES = (sitesArg ?? 'katoomba,thredbo,warrumbungles,grose,kanangra,tomah').split(',');
+const CELLS = (cellsArg ?? '30,20,10').split(',').map(Number);
+const FLAV = (flavArg ?? 'off,on,on2').split(',');
+const HOURS = 8;
+const log = (s) => appendFileSync(logPath, `${new Date().toISOString().slice(11, 19)} ${s}\n`);
+
+const rows = [];
+for (const site of SITES) {
+  // cheap rows first, the 10 m rows last: a stopped batch still leaves the 30 m and 20 m data of every site finished so far
+  for (const cell of [30, 20, 10]) {
+    if (!CELLS.includes(cell)) continue;
+    for (const f of FLAV) {
+      if (f === 'on2' && cell !== 30) continue;
+      rows.push({ id: `${site}.${cell}m.${f}`, site, cell, embers: f !== 'off', seed: f === 'on2' ? 2 : 1, hours: HOURS });
+    }
+  }
+}
+log(`batch of ${rows.length} rows`);
+for (const spec of rows) {
+  const raster = resolve(outDir, `${spec.id}.fields.gz`);
+  const out = resolve(outDir, `${spec.id}.json`);
+  if (existsSync(raster) && existsSync(out)) {
+    log(`skip ${spec.id} (done)`);
+    continue;
+  }
+  const specFile = resolve(outDir, `${spec.id}.spec.json`);
+  writeFileSync(specFile, JSON.stringify({ ...spec, rasterPath: raster }));
+  log(`start ${spec.id} (waits for the lock)`);
+  const t = Date.now();
+  const r = spawnSync('flock', ['/tmp/firesim-heavy.lock', 'node', '--expose-gc', '--max-old-space-size=4096', resolve(here, '10_ladder.launch.mjs'), specFile, out], { cwd: root, encoding: 'utf8', maxBuffer: 1 << 26 });
+  log(`end ${spec.id} after ${Math.round((Date.now() - t) / 1000)} s incl. lock wait, status ${r.status}: ${(r.stdout || '').trim().split('\n').pop()} ${(r.stderr || '').trim().split('\n').slice(-3).join(' | ')}`);
+}
+appendFileSync(logPath, 'DONE\n');
diff --git a/studies/adaptive-simulation-quality/scripts/12_aggregate.run.ts b/studies/adaptive-simulation-quality/scripts/12_aggregate.run.ts
new file mode 100644
index 0000000..1971b16
--- /dev/null
+++ b/studies/adaptive-simulation-quality/scripts/12_aggregate.run.ts
@@ -0,0 +1,151 @@
+/**
+ * Step 4 (after 10_ladder / 11_ladder.batch): from the full-resolution rows in `work/` build ONE small container per site,
+ * `data/ladder-<site>.gz`, that holds everything 13_score.run.ts needs and nothing else:
+ *   - the five complexity groups of the quality map (lib/analysis.ts, `complexity()`), at the 30 m grid, as 16-bit rasters
+ *     (resolution 1/65535; the score itself is the mean of the five and is made by the scorer), the 30 m slope, the flammable masks;
+ *   - per embers setting (`on` = embers on, seed 1; `off` = embers off) and per horizon H (4 h, 8 h): the arrival time of every row
+ *     capped at H (a cell not reached by H counts as H) on two common grids: the 30 m grid (the 30 m row as it is; the 10 m row as
+ *     the mean of the 3 x 3 cells inside each 30 m cell) and 60 m blocks (every row as the mean of the cells inside the block), with
+ *     the number of cells reached by H;
+ *   - the run records (burnt area every 30 min, wall time, memory, spot fires).
+ * 20 m cells do not tile the 30 m grid (1.5 cells), so the 20 m row is compared on the 60 m blocks only.
+ *
+ *   AQ_WORK=<dir with the rows> AQ_SITES=katoomba,... npx vitest run --config studies/adaptive-simulation-quality/vitest.config.ts 12_aggregate
+ */
+import { existsSync, mkdirSync, readFileSync } from 'node:fs';
+import { it } from 'vitest';
+import { complexity, type Fields } from './lib/analysis';
+import { loadFields } from './lib/io';
+import { saveLadder, type LadderSet } from './lib/ladderio';
+
+const SITES = (process.env.AQ_SITES ?? 'katoomba,thredbo,warrumbungles,grose,kanangra,tomah').split(',');
+const WORK = process.env.AQ_WORK ?? new URL('../work/ladder/', import.meta.url).pathname;
+const DATA = new URL('../data/', import.meta.url).pathname;
+const HORIZONS_S = [4 * 3600, 8 * 3600] as const;
+const log = (s: string): void => {
+  process.stderr.write(`[aggregate] ${s}\n`);
+};
+
+interface Row {
+  arrival: Float32Array;
+  flammable: Uint8Array;
+  meta: { grid: { nx: number; ny: number; cellSize: number; x0: number; y0: number }; ignition: { x: number; y: number } };
+  a: Record<string, unknown>;
+  out: Record<string, unknown>;
+}
+
+function loadRow(id: string): Row | null {
+  const raster = `${WORK}${id}.fields.gz`;
+  const json = `${WORK}${id}.json`;
+  if (!existsSync(raster) || !existsSync(json)) return null;
+  const { meta, a } = loadFields<Row['meta']>(raster);
+  return { arrival: a.arrival as Float32Array, flammable: a.flammable as Uint8Array, meta, a, out: JSON.parse(readFileSync(json, 'utf8')) as Record<string, unknown> };
+}
+
+/** Blocks of f x f cells: the mean of min(arrival, H) (s, rounded) and the number of cells with arrival < H. */
+function blocks(arrival: Float32Array, nx: number, f: number, H: number): { mean: Uint16Array; count: Uint8Array; nb: number } {
+  const nb = nx / f;
+  if (!Number.isInteger(nb)) throw new Error(`${nx} cells do not divide into blocks of ${f}`);
+  const mean = new Uint16Array(nb * nb);
+  const count = new Uint8Array(nb * nb);
+  for (let bj = 0; bj < nb; bj++) {
+    for (let bi = 0; bi < nb; bi++) {
+      let s = 0;
+      let c = 0;
+      for (let dj = 0; dj < f; dj++) {
+        for (let di = 0; di < f; di++) {
+          const t = arrival[(bj * f + dj) * nx + bi * f + di]!;
+          if (t < H) {
+            s += t;
+            c++;
+          } else s += H;
+        }
+      }
+      mean[bj * nb + bi] = Math.round(s / (f * f));
+      count[bj * nb + bi] = c;
+    }
+  }
+  return { mean, count, nb };
+}
+
+const q16 = (a: Float32Array): Uint16Array => Uint16Array.from(a, (v) => Math.round(Math.min(1, Math.max(0, v)) * 65535));
+
+it('aggregate the ladder rows into one container per site', () => {
+  mkdirSync(DATA, { recursive: true });
+  for (const site of SITES) {
+    const base = loadRow(`${site}.30m.on`) ?? loadRow(`${site}.30m.off`);
+    if (!base || !base.a.slope30) {
+      log(`${site}: no 30 m row with the terrain measures, skipped`);
+      continue;
+    }
+    const g = base.meta.grid;
+    const n = g.nx * g.ny;
+    const comp = complexity({ ...(base.a as unknown as Fields) });
+    const set: LadderSet = { meta: { site, grid30: g, windowS: 8 * 3600, horizonsS: HORIZONS_S, ignition: base.meta.ignition, runs: {} as Record<string, unknown>, complexityNote: 'S, C, G, L, R of lib/analysis.ts complexity(), 16-bit (1/65535); score = their mean' }, u8: {}, u16: {} };
+    const runs = set.meta.runs as Record<string, unknown>;
+    set.u16.S = [q16(comp.S), g.nx];
+    set.u16.C = [q16(comp.C), g.nx];
+    set.u16.G = [q16(comp.G), g.nx];
+    set.u16.L = [q16(comp.L), g.nx];
+    set.u16.R = [q16(comp.R), g.nx];
+    set.u16.slope30 = [Uint16Array.from(base.a.slope30 as Float32Array, (v) => Math.round(Math.min(300, v) * 200)), g.nx];
+    set.u8.flam30 = base.flammable;
+    let flam10: Uint8Array | null = null;
+    for (const flav of ['on', 'off', 'on2']) {
+      const r30 = loadRow(`${site}.30m.${flav}`);
+      if (!r30) continue;
+      runs[`30m.${flav}`] = { ...slim(r30.out) };
+      // The 30 m row as it is, on the 30 m grid (only the on / off rows are compared across grids; on2 is the seed reference at 30 m).
+      for (const H of HORIZONS_S) {
+        const b30 = blocks(r30.arrival, g.nx, 1, H);
+        set.u16[`g30.30.${flav}.${H / 3600}h`] = [b30.mean, g.nx];
+        set.u8[`n30.30.${flav}.${H / 3600}h`] = b30.count;
+        if (flav === 'on2') continue;
+        const b60 = blocks(r30.arrival, g.nx, 2, H);
+        set.u16[`g60.30.${flav}.${H / 3600}h`] = [b60.mean, b60.nb];
+        set.u8[`n60.30.${flav}.${H / 3600}h`] = b60.count;
+      }
+      if (flav === 'on2') continue;
+      const r20 = loadRow(`${site}.20m.${flav}`);
+      const r10 = loadRow(`${site}.10m.${flav}`);
+      if (r20) {
+        runs[`20m.${flav}`] = slim(r20.out);
+        for (const H of HORIZONS_S) {
+          const b60 = blocks(r20.arrival, r20.meta.grid.nx, 3, H);
+          set.u16[`g60.20.${flav}.${H / 3600}h`] = [b60.mean, b60.nb];
+          set.u8[`n60.20.${flav}.${H / 3600}h`] = b60.count;
+        }
+      }
+      if (r10) {
+        runs[`10m.${flav}`] = slim(r10.out);
+        const nx10 = r10.meta.grid.nx;
+        if (nx10 !== 3 * g.nx) throw new Error(`${site} 10 m grid ${nx10} is not 3 x ${g.nx}`);
+        if (!flam10) {
+          flam10 = new Uint8Array(n);
+          for (let bj = 0; bj < g.ny; bj++) for (let bi = 0; bi < g.nx; bi++) {
+            let c = 0;
+            for (let dj = 0; dj < 3; dj++) for (let di = 0; di < 3; di++) c += r10.flammable[(bj * 3 + dj) * nx10 + bi * 3 + di]!;
+            flam10[bj * g.nx + bi] = c;
+          }
+          set.u8.flam10in30 = flam10;
+        }
+        for (const H of HORIZONS_S) {
+          const b30 = blocks(r10.arrival, nx10, 3, H);
+          set.u16[`g30.10.${flav}.${H / 3600}h`] = [b30.mean, g.nx];
+          set.u8[`n30.10.${flav}.${H / 3600}h`] = b30.count;
+          const b60 = blocks(r10.arrival, nx10, 6, H);
+          set.u16[`g60.10.${flav}.${H / 3600}h`] = [b60.mean, b60.nb];
+          set.u8[`n60.10.${flav}.${H / 3600}h`] = b60.count;
+        }
+      }
+    }
+    const bytes = saveLadder(`${DATA}ladder-${site}.gz`, set);
+    log(`${site}: ${Object.keys(set.u16).length} 16-bit and ${Object.keys(set.u8).length} byte rasters, ${(bytes / 1024).toFixed(0)} kB, runs ${Object.keys(runs).join(' ')}`);
+  }
+}, 600_000);
+
+/** The part of a row's record that is kept: burnt area every 30 min, wall time, memory, ignition, cells reached. */
+function slim(o: Record<string, unknown>): Record<string, unknown> {
+  const keep = ['series', 'runS', 'buildS', 'peakRssMB', 'reachedCells', 'flammableCells', 'cells', 'options', 'ignition', 'ignitionTargetDistM', 'grid', 'rasterBytes'];
+  return Object.fromEntries(keep.filter((k) => k in o).map((k) => [k, k === 'series' ? (o.series as { t: number; burntHa: number; perimeterKm: number; headRos: number; spots: number; wallS: number }[]).map((s) => ({ t: s.t, burntHa: Math.round(s.burntHa), perimeterKm: Math.round(s.perimeterKm * 10) / 10, headRos: Math.round(s.headRos * 100) / 100, spots: s.spots, wallS: Math.round(s.wallS * 10) / 10 })) : o[k]]));
+}
