diff --git a/studies/adaptive-simulation-quality/scripts/14_figures.run.ts b/studies/adaptive-simulation-quality/scripts/14_figures.run.ts
new file mode 100644
index 0000000..3cb40cd
--- /dev/null
+++ b/studies/adaptive-simulation-quality/scripts/14_figures.run.ts
@@ -0,0 +1,250 @@
+/**
+ * Step 6: the figures of the grid-difference study, from `data/ladder-scores.json` and the containers `data/ladder-<site>.gz`
+ * (13_score.run.ts has to have run). Writes into `figures/`: three SVG charts (plain SVG made here, no dependency; light and dark by the viewer's
+ * setting) and a four-panel map per site in AQ_FIGS (PNG, north up, same drawing code as the quality map).
+ *
+ *   npx vitest run --config studies/adaptive-simulation-quality/vitest.config.ts 14_figures
+ *
+ * Colours: the validated reference palette of the dataviz skill (blue and orange as the two series, a neutral mid for the zero of the
+ * correlation map); the tables of the study note carry every number the charts show.
+ */
+import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
+import { it } from 'vitest';
+import { topShare } from './lib/analysis';
+import { loadLadder } from './lib/ladderio';
+import { writePanels, type Panel } from './lib/png';
+import { quantile } from './lib/stats';
+
+const DATA = process.env.AQ_DATA ?? new URL('../data/', import.meta.url).pathname;
+const FIG = process.env.AQ_FIG ?? new URL('../figures/', import.meta.url).pathname;
+const DEV = ['katoomba', 'thredbo', 'warrumbungles'];
+const HOLD = ['grose', 'kanangra', 'tomah'];
+const NAMES: Record<string, string> = { katoomba: 'Katoomba', thredbo: 'Thredbo', warrumbungles: 'Warrumbungles', grose: 'Blackheath', kanangra: 'Kanangra', tomah: 'Mount Tomah' };
+const FIGS = (process.env.AQ_FIGS ?? 'katoomba,grose').split(',');
+const log = (s: string): void => {
+  process.stderr.write(`[figures] ${s}\n`);
+};
+
+interface StatLite {
+  rho: number;
+  rhoPartial: number;
+  lift: number;
+  share: number;
+  sizeShare: number;
+  shiftLiftLo?: number;
+  shiftLiftHi?: number;
+  pShiftLift?: number;
+}
+interface Scores {
+  cases: Record<string, Record<string, StatLite>>;
+  deciles: Record<string, { mean: { meanD: number[] } }>;
+}
+
+const STYLE = `
+:root{--bg:#fcfcfb;--ink:#0b0b0b;--ink2:#52514e;--grid:#dddcd7;--mid:#e9e8e4;--s1:#2a78d6;--s2:#eb6834;--s3:#1baf7a;--s4:#eda100;--s5:#e87ba4;--s6:#008300;--band:#d9d8d3}
+@media (prefers-color-scheme: dark){:root{--bg:#1a1a19;--ink:#f0efec;--ink2:#c3c2b7;--grid:#383836;--mid:#34332f;--s1:#3987e5;--s2:#d95926;--s3:#199e70;--s4:#c98500;--s5:#d55181;--s6:#008300;--band:#3b3b38}}
+text{font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;fill:var(--ink)}
+.t2{fill:var(--ink2)}.small{font-size:12px}.lab{font-size:13px}.ttl{font-size:15px;font-weight:600}
+`;
+
+const esc = (s: string): string => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
+
+function svgDoc(w: number, h: number, title: string, desc: string, body: string): string {
+  return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${w} ${h}" width="${w}" height="${h}" role="img" aria-labelledby="t d"><title id="t">${esc(title)}</title><desc id="d">${esc(desc)}</desc><style>${STYLE}</style><rect width="${w}" height="${h}" fill="var(--bg)"/>${body}</svg>\n`;
+}
+
+const f1 = (x: number): string => x.toFixed(1);
+
+/** Figure A: the lift per scored cell of the top-20 % set, by site, with the band the same set moved elsewhere on the map gives. */
+function figLift(sc: Scores, sites: string[]): string {
+  const W = 720;
+  const rowH = 26;
+  const left = 120;
+  const right = 40;
+  const plotW = W - left - right;
+  let maxX = 2;
+  const flavs = ['off', 'on'] as const;
+  for (const f of flavs) for (const s of sites) {
+    const c = sc.cases[`${s}|g30.30v10.${f}.8h.D`];
+    if (!c) continue;
+    maxX = Math.max(maxX, c.mean!.lift, c.slope30!.lift, c.mean!.shiftLiftHi ?? 0);
+  }
+  maxX = Math.ceil(maxX * 2) / 2;
+  const X = (v: number): number => left + (v / maxX) * plotW;
+  let y = 52;
+  let body = `<text x="16" y="24" class="ttl">Does the complexity score point at where the grids differ?</text><text x="16" y="42" class="small t2">Lift per scored cell of the top-20 % set, 30 m against 10 m, 8 h (1 = no better than chance)</text>`;
+  for (const f of flavs) {
+    const rows = sites.filter((s) => sc.cases[`${s}|g30.30v10.${f}.8h.D`]);
+    y += 22;
+    body += `<text x="16" y="${y}" class="lab" font-weight="600">Embers ${f === 'off' ? 'off (the grid alone)' : 'on (as in the standard scenario)'}</text>`;
+    const top = y + 8;
+    const bottom = top + rows.length * rowH + 8;
+    for (let v = 0; v <= maxX + 1e-9; v += 0.5) body += `<line x1="${f1(X(v))}" x2="${f1(X(v))}" y1="${top}" y2="${bottom}" stroke="var(--grid)" stroke-width="1"/><text x="${f1(X(v))}" y="${bottom + 14}" class="small t2" text-anchor="middle">${v}</text>`;
+    body += `<line x1="${f1(X(1))}" x2="${f1(X(1))}" y1="${top}" y2="${bottom}" stroke="var(--ink2)" stroke-width="1.5" stroke-dasharray="4 3"/>`;
+    rows.forEach((s, i) => {
+      const c = sc.cases[`${s}|g30.30v10.${f}.8h.D`]!;
+      const cy = top + 16 + i * rowH;
+      const isHold = HOLD.includes(s);
+      body += `<text x="${left - 10}" y="${cy + 4}" class="lab" text-anchor="end">${esc(NAMES[s] ?? s)}${isHold ? ' *' : ''}</text>`;
+      if (c.mean!.shiftLiftLo !== undefined && c.mean!.shiftLiftHi !== undefined) body += `<rect x="${f1(X(c.mean!.shiftLiftLo))}" y="${cy - 7}" width="${f1(Math.max(1, X(c.mean!.shiftLiftHi) - X(c.mean!.shiftLiftLo)))}" height="14" rx="3" fill="var(--band)"/>`;
+      body += `<path d="M${f1(X(c.slope30!.lift))} ${cy - 6} l6 6 l-6 6 l-6 -6 z" fill="var(--s2)" stroke="var(--bg)" stroke-width="2"/>`;
+      body += `<circle cx="${f1(X(c.mean!.lift))}" cy="${cy}" r="6" fill="var(--s1)" stroke="var(--bg)" stroke-width="2"/>`;
+      body += `<text x="${f1(Math.max(X(c.mean!.lift), X(c.slope30!.lift)) + 12)}" y="${cy + 4}" class="small t2">${c.mean!.lift.toFixed(2)}</text>`;
+    });
+    y = bottom + 20;
+  }
+  y += 14;
+  body += `<circle cx="${left}" cy="${y}" r="6" fill="var(--s1)"/><text x="${left + 12}" y="${y + 4}" class="small">the score as defined</text>`;
+  body += `<path d="M${left + 150} ${y - 6} l6 6 l-6 6 l-6 -6 z" fill="var(--s2)"/><text x="${left + 164}" y="${y + 4}" class="small">the 30 m slope alone</text>`;
+  body += `<rect x="${left + 310}" y="${y - 7}" width="26" height="14" rx="3" fill="var(--band)"/><text x="${left + 344}" y="${y + 4}" class="small">the same set moved elsewhere (95 % of draws)</text>`;
+  body += `<text x="16" y="${y + 24}" class="small t2">* hold-out site: scored once, after the plan was fixed. One realisation per site.</text>`;
+  const H = y + 40;
+  return svgDoc(W, H, 'Lift of the top-20 % complexity set', 'For each site, with embers off and on, the lift per scored cell of the top-20 percent complexity set and of the top-20 percent slope set, against the band that the same set moved elsewhere on the map gives. A lift of 1 is chance.', body);
+}
+
+/** Figure B: the rank correlations of every group, the score and two baselines with D. */
+function figRho(sc: Scores, sites: string[]): string {
+  const cols: [string, string][] = [['S', 'steepness'], ['C', 'cliff'], ['G', 'gully'], ['L', 'landform'], ['R', '10 m relief'], ['mean', 'score'], ['slope30', '30 m slope'], ['arrival', 'arrival time']];
+  const W = 720;
+  const left = 150;
+  const cw = (W - left - 16) / cols.length;
+  const rh = 24;
+  const rows: { id: string; f: 'off' | 'on' }[] = [];
+  for (const f of ['off', 'on'] as const) for (const s of sites) if (sc.cases[`${s}|g30.30v10.${f}.8h.D`]) rows.push({ id: s, f });
+  let body = `<text x="16" y="24" class="ttl">Rank correlation of each group with the difference D</text><text x="16" y="42" class="small t2">Spearman, 30 m against 10 m, 8 h; blue = larger D where the score is larger, orange = the opposite</text>`;
+  cols.forEach(([, name], j) => {
+    body += `<text x="${f1(left + j * cw + cw / 2)}" y="68" class="small" text-anchor="middle">${esc(name)}</text>`;
+  });
+  rows.forEach((r, i) => {
+    const y = 78 + i * rh + (r.f === 'on' ? 10 : 0);
+    const c = sc.cases[`${r.id}|g30.30v10.${r.f}.8h.D`]!;
+    body += `<text x="${left - 8}" y="${y + 16}" class="lab" text-anchor="end">${esc(NAMES[r.id] ?? r.id)}${HOLD.includes(r.id) ? ' *' : ''} · ${r.f}</text>`;
+    cols.forEach(([p], j) => {
+      const v = c[p]!.rho;
+      const m = Math.min(70, Math.round((Math.abs(v) / 0.6) * 70));
+      const fill = Number.isFinite(v) ? `color-mix(in srgb, var(${v >= 0 ? '--s1' : '--s2'}) ${m}%, var(--mid))` : 'var(--mid)';
+      body += `<rect x="${f1(left + j * cw + 1)}" y="${y}" width="${f1(cw - 2)}" height="${rh - 2}" rx="3" fill="${fill}"/><text x="${f1(left + j * cw + cw / 2)}" y="${y + 16}" class="small" text-anchor="middle">${Number.isFinite(v) ? v.toFixed(2) : 'n/a'}</text>`;
+    });
+  });
+  const H = 78 + rows.length * rh + 40;
+  body += `<text x="16" y="${H - 16}" class="small t2">off = embers off, on = embers on. * hold-out site. The arrival time is a baseline that knows nothing of the terrain.</text>`;
+  return svgDoc(W, H, 'Rank correlation of each complexity group with the difference', 'A table of Spearman correlations between the difference in arrival time and each complexity group, the score, the 30 m slope and the arrival time, for each site with embers off and on.', body);
+}
+
+/** Figure C: mean D in ten equal-count groups of the score, as an index of the site's own mean (1 = the site's average). */
+function figDeciles(sc: Scores, sites: string[]): string {
+  const W = 720;
+  const left = 56;
+  const pw = (W - left - 120) / 2 - 24;
+  const ph = 190;
+  const colors = ['--s1', '--s2', '--s3', '--s4', '--s5', '--s6'];
+  let maxY = 1.5;
+  const series: { s: string; f: 'off' | 'on'; v: number[] }[] = [];
+  for (const f of ['off', 'on'] as const) for (const s of sites) {
+    const d = sc.deciles[`${s}|g30.30v10.${f}.8h.D`];
+    if (!d) continue;
+    const m = d.mean.meanD;
+    const avg = m.reduce((a, b) => a + b, 0) / m.length;
+    const v = m.map((x) => x / avg);
+    maxY = Math.max(maxY, ...v);
+    series.push({ s, f, v });
+  }
+  maxY = Math.ceil(maxY * 2) / 2;
+  let body = `<text x="16" y="24" class="ttl">Does D rise with the score?</text><text x="16" y="42" class="small t2">Mean difference D in ten equal groups of the score (1 = lowest tenth), as a multiple of the site's own mean; 30 m against 10 m, 8 h</text>`;
+  (['off', 'on'] as const).forEach((f, pi) => {
+    const x0 = left + pi * (pw + 110);
+    const y0 = 76;
+    const X = (i: number): number => x0 + (i / 9) * pw;
+    const Y = (v: number): number => y0 + ph - (v / maxY) * ph;
+    body += `<text x="${x0}" y="${y0 - 10}" class="lab" font-weight="600">Embers ${f}</text>`;
+    for (let v = 0; v <= maxY + 1e-9; v += 0.5) body += `<line x1="${x0}" x2="${x0 + pw}" y1="${f1(Y(v))}" y2="${f1(Y(v))}" stroke="var(--grid)"/><text x="${x0 - 6}" y="${f1(Y(v) + 4)}" class="small t2" text-anchor="end">${v}</text>`;
+    body += `<line x1="${x0}" x2="${x0 + pw}" y1="${f1(Y(1))}" y2="${f1(Y(1))}" stroke="var(--ink2)" stroke-dasharray="4 3"/>`;
+    for (let i = 0; i < 10; i += 3) body += `<text x="${f1(X(i))}" y="${y0 + ph + 16}" class="small t2" text-anchor="middle">${i + 1}</text>`;
+    body += `<text x="${f1(x0 + pw / 2)}" y="${y0 + ph + 34}" class="small t2" text-anchor="middle">tenth of the scored cells, by the score</text>`;
+    series.filter((q) => q.f === f).forEach((q) => {
+      const ci = sites.indexOf(q.s);
+      const col = colors[ci % colors.length]!;
+      const pts = q.v.map((v, i) => `${f1(X(i))},${f1(Y(v))}`).join(' ');
+      body += `<polyline points="${pts}" fill="none" stroke="var(--${col.slice(2)})" stroke-width="2" ${HOLD.includes(q.s) ? 'stroke-dasharray="6 3"' : ''} stroke-linejoin="round"/>`;
+    });
+  });
+  // direct labels (right of the second panel) and a legend for the line style
+  const lastPanelX = left + (pw + 110) + pw;
+  const labelled = series.filter((q) => q.f === 'on');
+  labelled.sort((a, b) => b.v[9]! - a.v[9]!);
+  let prevY = -1e9;
+  const y0 = 76;
+  const ph2 = ph;
+  for (const q of labelled) {
+    let yy = y0 + ph2 - (q.v[9]! / maxY) * ph2;
+    if (yy - prevY < 13) yy = prevY + 13;
+    prevY = yy;
+    const col = colors[sites.indexOf(q.s) % colors.length]!;
+    body += `<rect x="${f1(lastPanelX + 8)}" y="${f1(yy - 5)}" width="10" height="3" fill="var(--${col.slice(2)})"/><text x="${f1(lastPanelX + 22)}" y="${f1(yy + 1)}" class="small">${esc(NAMES[q.s] ?? q.s)}${HOLD.includes(q.s) ? ' *' : ''}</text>`;
+  }
+  const H = 76 + ph + 76;
+  body += `<text x="16" y="${H - 14}" class="small t2">Solid: development site. Dashed and *: hold-out site. The dashed grey line is the site's average.</text>`;
+  return svgDoc(W, H, 'The difference by tenth of the complexity score', 'Lines, one per site, of the mean arrival-time difference in ten equal-count groups of the complexity score, as a multiple of the site mean, with embers off and on.', body);
+}
+
+const CATS: [number, number, number][] = [
+  [58, 58, 56],
+  [57, 135, 229],
+  [235, 104, 52],
+  [253, 231, 37],
+];
+
+it('draw the figures', () => {
+  const scoresPath = `${DATA}ladder-scores.json`;
+  if (!existsSync(scoresPath)) throw new Error('no ladder-scores.json: run 13_score first');
+  const sc = JSON.parse(readFileSync(scoresPath, 'utf8')) as Scores;
+  mkdirSync(FIG, { recursive: true });
+  const sites = [...DEV, ...HOLD].filter((s) => existsSync(`${DATA}ladder-${s}.gz`));
+  writeFileSync(`${FIG}ladder-lift.svg`, figLift(sc, sites));
+  writeFileSync(`${FIG}ladder-rho.svg`, figRho(sc, sites));
+  writeFileSync(`${FIG}ladder-deciles.svg`, figDeciles(sc, sites));
+  log(`charts for ${sites.join(', ')}`);
+
+  for (const site of FIGS) {
+    const path = `${DATA}ladder-${site}.gz`;
+    if (!existsSync(path)) continue;
+    const { meta, u8, u16 } = loadLadder(path);
+    const g = meta.grid30 as { nx: number; ny: number; cellSize: number; x0: number; y0: number };
+    const n = g.nx * g.ny;
+    const score = new Float64Array(n);
+    for (let k = 0; k < n; k++) score[k] = (u16.S![k]! + u16.C![k]! + u16.G![k]! + u16.L![k]! + u16.R![k]!) / 5 / 1023;
+    const top = topShare(score, 0.2);
+    const dMap = (flav: string): { v: Float32Array; inU: Uint8Array; d: Float64Array } => {
+      const x = u16[`g30.30.${flav}.8h`]!;
+      const y = u16[`g30.10.${flav}.8h`]!;
+      const cx = u8[`n30.30.${flav}.8h`]!;
+      const cy = u8[`n30.10.${flav}.8h`]!;
+      const v = new Float32Array(n).fill(NaN);
+      const inU = new Uint8Array(n);
+      const d = new Float64Array(n);
+      for (let k = 0; k < n; k++) {
+        if (!u8.flam30![k] || (cx[k] === 0 && cy[k] === 0)) continue;
+        inU[k] = 1;
+        d[k] = Math.abs(y[k]! - x[k]!) / 6;
+        v[k] = Math.min(1, Math.log1p(d[k]!) / Math.log1p(480));
+      }
+      return { v, inU, d };
+    };
+    const off = dMap('off');
+    const on = dMap('on');
+    const vals = Float64Array.from(off.d.filter((_, k) => off.inU[k])).sort();
+    const cut = quantile(vals, 0.8);
+    const cat = new Float32Array(n);
+    for (let k = 0; k < n; k++) cat[k] = (top[k] ? 1 : 0) + (off.inU[k] && off.d[k]! >= cut ? 2 : 0);
+    const dim = Uint8Array.from(u8.flam30!, (v) => (v ? 0 : 1));
+    const ign = meta.ignition as { x: number; y: number };
+    const panels: Panel[] = [
+      { values: score, dim, mark: ign },
+      { values: off.v, dim, mark: ign },
+      { values: on.v, dim, mark: ign },
+      { values: cat, categories: CATS, dim },
+    ];
+    const bytes = writePanels(`${FIG}ladder-map-${site}.png`, g, panels, 2);
+    log(`${site}: map ${(bytes / 1024).toFixed(0)} kB`);
+  }
+}, 300_000);
