+  /** Build the picture synchronously from the same input as the glyph builder. */
+  build(input: GlyphInput, ground10: { grid: { nx: number; ny: number; cellSize: number; x0: number; y0: number }; elevation: Float32Array }): void {
+    const t0 = performance.now();
+    const speedTable = buildSpeedTable();
