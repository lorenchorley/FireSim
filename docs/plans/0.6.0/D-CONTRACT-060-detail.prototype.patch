@@ -0,0 +1,122 @@
+/** THROWAWAY scout spec (not for merging): layout shots at three sizes, the 0.5.0 L4 look, and (second run) the prototype. */
+import { mkdirSync, writeFileSync } from 'node:fs';
+import { join } from 'node:path';
+import type { Page } from '@playwright/test';
+import { expect, test } from './fixtures';
+import { acceptNotice } from './helpers';
+
+test.use({ deviceScaleFactor: 1, actionTimeout: 45_000 });
+
+const OUT = process.env.SCOUT_SHOTS ?? '/tmp/scout-shots';
+mkdirSync(OUT, { recursive: true });
+
+type Pt = [number, number];
+type View = {
+  cameraState(): { target: Pt; distance: number; mode: string };
+  lookAt(x: number, y: number, d: number, az: number, tilt: number, animate?: boolean): void;
+  setLayers(l: Record<string, unknown>): void;
+  setViewMode(m: 'orbit' | 'top' | 'ground'): void;
+  renderNow(): void;
+  windGlyphStats?(): { level: number; cellPx: number; cellM: number; count: number; segments: number } | null;
+  stats(): { drawCalls: number; triangles: number };
+  rig: { update(now: number): boolean };
+  renderer: { domElement: HTMLCanvasElement; info: { render: { calls: number; triangles: number } } };
+};
+type Handle = { __firesim: { view: View; session: { state: { get(): { snapshot: { atmosphere?: { kind?: string } } | null } } } } };
+const airKind = (page: Page): Promise<string | null> => page.evaluate(() => (window as unknown as Handle).__firesim.session.state.get().snapshot?.atmosphere?.kind ?? null);
+const setLayers = (page: Page, l: Record<string, unknown>): Promise<void> => page.evaluate((v) => (window as unknown as Handle).__firesim.view.setLayers(v), l);
+const lookAt = (page: Page, d: number, x = 0, y = 0, az = 200, tilt = 55): Promise<void> =>
+  page.evaluate(([px, py, pd, a, t]) => (window as unknown as Handle).__firesim.view.lookAt(px!, py!, pd!, a!, t!, false), [x, y, d, az, tilt]);
+const settle = async (page: Page): Promise<void> => {
+  await page.evaluate(() => {
+    const rig = (window as unknown as Handle).__firesim.view.rig;
+    const t0 = performance.now() + 4000;
+    for (let i = 0; i < 100; i++) rig.update(t0 + i * 16);
+  });
+};
+const canvasShot = async (page: Page, name: string): Promise<void> => {
+  const url = await page.evaluate(() => {
+    const v = (window as unknown as Handle).__firesim.view;
+    v.renderNow();
+    return v.renderer.domElement.toDataURL('image/png');
+  });
+  writeFileSync(join(OUT, name), Buffer.from(url.split(',')[1]!, 'base64'));
+};
+const pageShot = async (page: Page, name: string): Promise<void> => {
+  await page.evaluate(() => (window as unknown as Handle).__firesim.view.renderNow());
+  await page.screenshot({ path: join(OUT, name) });
+};
+
+async function build(page: Page): Promise<void> {
+  await page.goto('/?debug=1');
+  await acceptNotice(page);
+  await page.getByTestId('open-settings').click();
+  await page.getByTestId('picture-quality').getByRole('radio', { name: 'High' }).check();
+  await page.getByTestId('close-settings').click();
+  await page.getByTestId('site-katoomba').click();
+  await page.getByTestId('extent').getByRole('radio', { name: '6 km' }).check({ force: true });
+  await page.getByTestId('detail').getByRole('radio', { name: /^Fast/ }).check({ force: true });
+  await page.getByTestId('weather-source').getByRole('radio', { name: 'Preset' }).check();
+  await page.getByTestId('preset-hot-nw-sw-change').click();
+  const online = page.getByTestId('online').getByRole('switch');
+  if (await online.isChecked()) await page.getByTestId('online').click();
+  await page.getByTestId('build').click();
+  await expect(page.getByTestId('sim')).toBeVisible({ timeout: 180_000 });
+  await expect.poll(() => airKind(page), { timeout: 60_000 }).not.toBeNull();
+}
+
+test('scout: layout at three sizes and the look of L4', async ({ page }) => {
+  test.setTimeout(900_000);
+  await build(page);
+  const cellM = (await page.evaluate(() => (window as unknown as Handle).__firesim.view.windGlyphStats?.()?.cellM)) ?? 133;
+  const sizes: [number, number][] = [
+    [412, 915],
+    [360, 640],
+    [844, 390],
+  ];
+  for (const [w, h] of sizes) {
+    await page.setViewportSize({ width: w, height: h });
+    await page.waitForTimeout(1200);
+    await lookAt(page, 1500);
+    await settle(page);
+    // The default layers: the wind streaks on (their legend card shows), glyphs off.
+    await pageShot(page, `layout-${w}x${h}-streaks.png`);
+    // Rects of what floats, for the placement of an icon.
+    const rects = await page.evaluate(() => {
+      const q = (sel: string): { sel: string; l: number; t: number; r: number; b: number }[] =>
+        [...document.querySelectorAll(sel)]
+          .filter((e) => {
+            const cs = getComputedStyle(e);
+            const b = e.getBoundingClientRect();
+            return cs.display !== 'none' && cs.visibility !== 'hidden' && !(e as HTMLElement).hidden && b.width > 0 && b.height > 0;
+          })
+          .map((e) => {
+            const b = e.getBoundingClientRect();
+            return { sel, l: Math.round(b.left), t: Math.round(b.top), r: Math.round(b.right), b: Math.round(b.bottom) };
+          });
+      return [...q('.sim-topbar .tb-pill'), ...q('.sim-topbar .tb-wx > *'), ...q('.map-fabs .fab'), ...q('.menu-fab'), ...q('.map-legend'), ...q('.map-credit'), ...q('[data-testid=dock]'), ...q('.scrubber'), ...q('.crosshair')];
+    });
+    writeFileSync(join(OUT, `rects-${w}x${h}.json`), JSON.stringify(rects, null, 1));
+  }
+  await page.setViewportSize({ width: 412, height: 915 });
+  await page.waitForTimeout(800);
+  // The 0.5.0 L4 look: glyphs only, three zooms, in plan-ish tilt 55 and in a top view.
+  await setLayers(page, { vegetation: false, understorey: false, wind: 'off', flames: false, smoke: false, embers: false, roads: false, fireTrails: false, placeNames: false, imagery: false, insightMarkers: false, windSway: false, windGlyphs: true, windHeight: 'fire' });
+  const H = await page.evaluate(() => document.querySelector('canvas')!.clientHeight);
+  const at = (px: number): number => (cellM * H) / (2 * Math.tan((25 * Math.PI) / 180) * px);
+  const log: string[] = [];
+  for (const px of [120, 300, 900, 2000]) {
+    await lookAt(page, at(px), 400, -300, 200, 55);
+    await settle(page);
+    await page.evaluate(() => (window as unknown as Handle).__firesim.view.renderNow());
+    const s = await page.evaluate(() => (window as unknown as Handle).__firesim.view.windGlyphStats?.());
+    log.push(`px/cell ${px}: distance ${at(px).toFixed(0)} m, level ${s?.level}, cellPx ${s?.cellPx.toFixed(0)}, count ${s?.count}, segments ${s?.segments}`);
+    await canvasShot(page, `base-L4-${px}px.png`);
+  }
+  // With the trees, the way a user sees it.
+  await setLayers(page, { vegetation: true, understorey: true, imagery: false });
+  await lookAt(page, at(300), 400, -300, 200, 55);
+  await settle(page);
+  await canvasShot(page, 'base-L4-300px-trees.png');
+  writeFileSync(join(OUT, 'log.txt'), `${log.join('\n')}\ncellM ${cellM} canvasH ${H}\n`);
+});
