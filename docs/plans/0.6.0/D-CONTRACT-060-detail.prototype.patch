+
+async function build(page: Page): Promise<void> {
+  await page.goto('/?debug=1');
+  await acceptNotice(page);
+  await page.getByTestId('open-settings').click();
+  await page.getByTestId('picture-quality').getByRole('radio', { name: 'High' }).check();
+  await page.getByTestId('close-settings').click();
+  await page.getByTestId('site-katoomba').click();
+  await page.getByTestId('extent').getByRole('radio', { name: '6 km' }).check({ force: true });
+  await page.getByTestId('detail').getByRole('radio', { name: /^Fast/ }).check({ force: true });
+  await page.getByTestId('weather-source').getByRole('radio', { name: 'Preset' }).check();
+  await page.getByTestId('preset-hot-nw-sw-change').click();
+  const online = page.getByTestId('online').getByRole('switch');
+  if (await online.isChecked()) await page.getByTestId('online').click();
+  await page.getByTestId('build').click();
+  await expect(page.getByTestId('sim')).toBeVisible({ timeout: 180_000 });
+  await expect.poll(() => airKind(page), { timeout: 60_000 }).not.toBeNull();
+}
+
+
+type Proto = { proto: { lines: number; segments: number; lastMs: number } };
+const protoInfo = (page: Page): Promise<{ lines: number; segments: number; lastMs: number; level: number }> =>
+  page.evaluate(() => {
+    const v = (window as unknown as { __firesim: { view: { glyphs: Proto; windGlyphStats(): { level: number } } } }).__firesim.view;
+    return { lines: v.glyphs.proto.lines, segments: v.glyphs.proto.segments, lastMs: v.glyphs.proto.lastMs, level: v.windGlyphStats().level };
+  });
+const setT = (page: Page, t: number, still = false, eddy = 1): Promise<void> =>
+  page.evaluate(([a, b, c]) => {
+    const w = window as unknown as { __protoTime?: number; __protoStill?: boolean; __protoEddy?: number };
+    w.__protoTime = a as number;
+    w.__protoStill = b as boolean;
+    w.__protoEddy = c as number;
+  }, [t, still, eddy] as const);
+
+test('scout: the prototype detailed streaks and the chip placement', async ({ page }) => {
+  test.setTimeout(900_000);
+  await build(page);
+  const log: string[] = [];
+  await setLayers(page, { vegetation: false, understorey: false, wind: 'off', flames: false, smoke: false, embers: false, roads: false, fireTrails: false, placeNames: false, imagery: false, insightMarkers: false, windSway: false, windGlyphs: true, windHeight: 'fire' });
+  const shotAt = async (name: string, d: number, x: number, y: number, tilt: number, t: number, still = false, eddy = 1): Promise<void> => {
+    await lookAt(page, d, x, y, 200, tilt);
+    await settle(page);
+    await setT(page, t, still, eddy);
+    await page.evaluate(() => (window as unknown as Handle).__firesim.view.renderNow());
+    const info = await protoInfo(page);
+    log.push(`${name}: d ${d} m tilt ${tilt}, level ${info.level}, lines ${info.lines}, segments ${info.segments}, build ${info.lastMs.toFixed(1)} ms`);
+    await canvasShot(page, `proto-${name}.png`);
+  };
+  await shotAt('d1200-t1', 1200, 400, -300, 55, 1.0);
+  await shotAt('d700-t1', 700, 400, -300, 55, 1.0);
+  await shotAt('d700-t2', 700, 400, -300, 55, 1.8);
+  await shotAt('d250-t1', 250, 400, -300, 55, 1.0);
+  await shotAt('d250-t2', 250, 400, -300, 55, 1.8);
+  await shotAt('d250-t3', 250, 400, -300, 55, 2.4);
+  await shotAt('d250-t4', 250, 400, -300, 55, 3.0);
+  await shotAt('d250-still', 250, 400, -300, 55, 0, true);
+  await shotAt('d250-noeddy', 250, 400, -300, 55, 1.0, false, 0);
+  await shotAt('d70-t1', 70, 400, -300, 55, 1.0);
+  await shotAt('d120-top-t1', 120, 400, -300, 5, 1.0);
+  await shotAt('d250-cliff-t1', 250, -300, 600, 60, 1.0);
+  // With the trees and the aerial photo, the way a user sees it.
+  await setLayers(page, { vegetation: true, understorey: true, imagery: true });
+  await shotAt('d250-trees-t1', 250, 400, -300, 55, 1.0);
+  await shotAt('d700-trees-t1', 700, 0, 0, 55, 1.0);
+  await setLayers(page, { vegetation: true, understorey: true, imagery: false });
+  await shotAt('d250-trees-plain-t1', 250, 400, -300, 55, 1.0);
+  writeFileSync(join(OUT, 'proto-log.txt'), log.join('\n'));
+
+  // The chip: a stand-in for the real thing, placed above the legend (or the credit line) at three sizes, with its open card, and measured against every floating control.
+  await setLayers(page, { windGlyphs: false, wind: 'surface' });
+  for (const [w, h] of [[412, 915], [360, 640], [844, 390]] as [number, number][]) {
+    await page.setViewportSize({ width: w, height: h });
+    await page.waitForTimeout(1200);
+    await lookAt(page, 300, 400, -300, 200, 55);
+    await settle(page);
+    const res = await page.evaluate(() => {
+      const vis = (sel: string): DOMRect[] =>
+        [...document.querySelectorAll(sel)]
+          .filter((e) => {
+            const cs = getComputedStyle(e);
+            const b = e.getBoundingClientRect();
+            return cs.display !== 'none' && cs.visibility !== 'hidden' && !(e as HTMLElement).hidden && b.width > 0 && b.height > 0;
+          })
+          .map((e) => e.getBoundingClientRect());
+      const legend = vis('.map-legend')[0];
+      const credit = vis('.map-credit')[0];
+      const anchor = legend ?? credit;
+      const left = (legend ?? credit)?.left ?? 12;
+      const bottomOf = anchor ? innerHeight - anchor.top + 8 : 80;
+      const chip = document.createElement('div');
+      chip.id = 'mock-chip';
+      chip.style.cssText = `position:fixed;z-index:60;left:${left}px;bottom:${bottomOf}px;height:44px;padding:0 14px;display:flex;align-items:center;gap:8px;border-radius:22px;background:#fff;color:#1b1b1f;font:600 14px system-ui;box-shadow:0 1px 4px rgba(0,0,0,.4)`;
+      chip.innerHTML = '<span>Wind detail</span><span style="letter-spacing:3px">&#9679;&#9679;&#9679;&#9675;</span>';
+      document.body.append(chip);
+      const cb = chip.getBoundingClientRect();
+      const card = document.createElement('div');
+      card.id = 'mock-card';
+      card.style.cssText = `position:fixed;z-index:61;left:${left}px;bottom:${innerHeight - cb.top + 8}px;width:${Math.min(300, innerWidth - 80)}px;padding:12px;border-radius:12px;background:#fff;color:#1b1b1f;font:14px/1.35 system-ui;box-shadow:0 2px 8px rgba(0,0,0,.45)`;
+      card.innerHTML = '<b style="font-size:16px">Wind detail: level 4 of 4</b><p>Moving streaks with small eddies, about 10 m above open ground.</p><p>This is the most detailed level.</p><p>The air model works on cells about 133 m wide. The small eddies are added for looks, from the shape of the ground. The direction and speed along the flow are the model\'s.</p><p>The fast tier\'s wind is estimated from the forecast and the shape of the ground. It is not simulated.</p><button style="height:44px;min-width:88px">Close</button>';
+      document.body.append(card);
+      const kb = card.getBoundingClientRect();
+      const others = [...vis('.sim-topbar .tb-pill'), ...vis('.sim-topbar .tb-wx > *'), ...vis('.map-fabs .fab'), ...vis('.menu-fab'), ...vis('.map-credit'), ...vis('[data-testid=dock]'), ...vis('.scrubber')];
+      const hit = (a: DOMRect, b: DOMRect): boolean => a.left < b.right && a.right > b.left && a.top < b.bottom && a.bottom > b.top;
+      const chipHits = others.filter((o) => hit(cb, o)).length;
+      const cardHits = others.filter((o) => hit(kb, o)).length;
+      return { chip: [cb.left, cb.top, cb.right, cb.bottom].map(Math.round), card: [kb.left, kb.top, kb.right, kb.bottom].map(Math.round), legend: legend ? [legend.left, legend.top, legend.right, legend.bottom].map(Math.round) : null, chipHits, cardHits };
