+/** THROWAWAY prototype of the detailed streaks (scout D-CONTRACT-060). Not for merging: unoptimised, allocates, no slicing. */
+import * as THREE from 'three';
+import { hash01 as hash3 } from '../fields';
+import { buildSpeedTable, GLYPH_CALM_MS, SPEED_TABLE_BINS, SPEED_TABLE_MAX_MS, HALO_INK } from './flowGlyphs';
+import type { GlyphInput } from './glyphTypes';
+
+const VERT = /* glsl */ `
+uniform vec2 uViewport;
+uniform float uWidthPx;
+uniform float uDepthBias;
+uniform float uTime;
+uniform float uMoving;
+uniform float uFade;
+uniform float uPxPerM1;
+uniform float uEddy;
+attribute vec3 aA;
+attribute vec3 aB;
+attribute vec4 aC;
+attribute vec4 aD; // s0, s1, L, seed
+attribute vec4 aE; // speed, turb, lift, tail
+varying vec4 vC;
+varying vec2 vUv;
+varying float vHalf;
+varying float vAlpha;
+
+float h21(vec2 p) {
+  vec3 p3 = fract(vec3(p.xyx) * 0.1031);
+  p3 += dot(p3, p3.yzx + 33.33);
+  return fract((p3.x + p3.y) * p3.z);
+}
+float vn(vec2 p) {
+  vec2 i = floor(p);
+  vec2 f = fract(p);
+  f = f * f * (3.0 - 2.0 * f);
+  return mix(mix(h21(i), h21(i + vec2(1.0, 0.0)), f.x), mix(h21(i + vec2(0.0, 1.0)), h21(i + vec2(1.0, 1.0)), f.x), f.y);
+}
+vec2 vn2(vec2 p) { return vec2(vn(p), vn(p + vec2(31.7, 17.3))) - 0.5; }
+
+float pulse(float s, float head, float tail) {
+  return s <= head ? clamp(1.0 - (head - s) / tail, 0.0, 1.0) : 0.0;
+}
+
+void main() {
+  float t = uMoving > 0.5 ? uTime : 3.7;
+  float seed = aD.w;
+  float L = aD.z;
+  float tail = aE.w;
+  float speed = aE.x;
+  float vpx = clamp(14.0 * speed, 40.0, 260.0);
+  float life = L + tail;
+  float T = life / vpx * (0.7 + 0.6 * h21(vec2(seed * 91.7, 3.1)));
+  float gap = 0.6 * h21(vec2(seed * 53.3, 7.7));
+  float ph = fract(t / T + h21(vec2(seed * 17.9, 1.3)));
+  float head = ph * (1.0 + gap) * life;
+  float ia = pulse(aD.x, head, tail);
+  float ib = pulse(aD.y, head, tail);
+  vec4 ca0 = projectionMatrix * viewMatrix * vec4(aA, 1.0);
+  vec4 cb0 = projectionMatrix * viewMatrix * vec4(aB, 1.0);
+  if (ca0.w <= 0.01 || cb0.w <= 0.01 || (ia <= 0.0 && ib <= 0.0)) {
+    gl_Position = vec4(0.0, 0.0, -2.0, 1.0);
+    return;
+  }
+  vec2 dir = normalize((aB - aA).xz + vec2(1e-6));
+  // Eddy meander: three octaves, the finer ones only when their amplitude is over about a pixel.
+  vec3 pa = aA;
+  vec3 pb = aB;
+  float turbF = 0.25 + 0.75 * aE.y;
+  float adv = vpx * t / max(uPxPerM1 / ca0.w, 1e-4);
+  float wA = 0.0;
+  vec2 offA = vec2(0.0);
+  vec2 offB = vec2(0.0);
+  for (int k = 0; k < 3; k++) {
+    float lam = k == 0 ? 60.0 : (k == 1 ? 15.0 : 4.0);
+    float amp = k == 0 ? 20.0 : (k == 1 ? 5.0 : 1.2);
+    float wk = smoothstep(0.75, 3.0, amp * uPxPerM1 / ca0.w) * turbF * uEddy;
+    vec2 qa = (aA.xz - dir * adv) / lam + vec2(t * 0.05, t * 0.07) * (float(k) + 1.0);
