+    await page.screenshot({ path: join(OUT, `chip-${w}x${h}-closed.png`) });
+    await page.evaluate(() => document.getElementById('mock-chip')?.remove());
+  }
+  writeFileSync(join(OUT, 'proto-log.txt'), log.join('\n'));
+});
