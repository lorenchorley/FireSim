+    this.a = new Float32Array(cap * 3);
+    this.b = new Float32Array(cap * 3);
+    this.c = new Float32Array(cap * 4);
+    this.d = new Float32Array(cap * 4);
+    this.e = new Float32Array(cap * 4);
