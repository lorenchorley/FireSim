+          this.c[4 * o + 1] = speedTable[3 * bin + 1]!;
+          this.c[4 * o + 2] = speedTable[3 * bin + 2]!;
+          this.c[4 * o + 3] = 1;
+          this.d[4 * o] = s0;
+          this.d[4 * o + 1] = s0 + lenPx / n;
+          this.d[4 * o + 2] = lenPx;
+          this.d[4 * o + 3] = seedHash;
+          this.e[4 * o] = sp;
+          this.e[4 * o + 1] = turb;
+          this.e[4 * o + 2] = lift;
+          this.e[4 * o + 3] = tail;
+          made.push(o);
+          s0 += lenPx / n;
+          ox = qx;
+          oyw = qyw;
+          ozw = qzw;
+          x = qx;
+          y = qy;
+        }
+        if (made.length >= 3) {
+          seg += made.length;
+          lines++;
+        }
+        void u;
+        void v;
+      }
+    }
+    this.lines = lines;
+    this.commit(seg);
+    this.lastMs = performance.now() - t0;
+  }
+}
