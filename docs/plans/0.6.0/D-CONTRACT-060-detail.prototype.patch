+export class DetailProto {
+  readonly mesh: THREE.Mesh;
+  readonly cap: number;
+  readonly a: Float32Array;
+  readonly b: Float32Array;
+  readonly c: Float32Array;
+  readonly d: Float32Array;
+  readonly e: Float32Array;
