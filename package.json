{
  "name": "firesim",
  "version": "0.1.1",
  "private": true,
  "description": "FireSim - on-site 3D coupled atmosphere, bushfire and ember simulation for training firefighters in the mountains of NSW",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "cap:sync": "npm run build:cap && cap sync",
    "cap:android": "npm run build:cap && cap sync android && cap open android",
    "cap:ios": "npm run build:cap && cap sync ios && cap open ios",
    "build:cap": "tsc --noEmit && vite build --mode capacitor",
    "test:fast": "FIRESIM_SKIP_SLOW=1 vitest run",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/preferences": "^8.0.1",
    "fast-png": "^8.0.0",
    "geotiff": "^3.0.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
