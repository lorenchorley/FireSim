+        double inv = 1 / h;
+        double half = 0.5 * inv;
+        double inv2 = inv * inv;
+        double nu = P.Nu;
+        double nuH = nu * h;
+        double nu4 = 4 * nu;
+        double eps = P.NormalEps;
+        double rMax = P.RosMaxMs;
