@@ -0,0 +1,89 @@
+using System.Diagnostics;
+using System.Runtime.InteropServices;
+
+namespace Fs.Tests;
+
+/// <summary>
+/// Card T1.4b, the T1.2 and T1.4a arrangement again (vectorization skill, plan section 9): every SIMD situation in its own process. Each test starts this test assembly
+/// (<c>dotnet Fs.Tests.dll --filter ...FastPathChecks</c>) with one runtime setting and tells the child what to expect, so a setting that did nothing fails the child. By hand:
+/// <c>DOTNET_EnableHWIntrinsic=0 FS_FAST_EXPECT=software dotnet test --project prototypes/dotnet-b/Fs.Tests -- --filter "FullyQualifiedName~FastPathChecks"</c>.
+/// Not testable here: arm64 (<c>Vector128</c> maps to NEON) and WebAssembly (T1.4b runs the same case runner in the Mono WebAssembly build under Node).
+/// </summary>
+[TestClass]
+public sealed class FastSeparateProcessTests
+{
+    [TestMethod]
+    public void DefaultHardware() => RunChild("hardware");
+
+    [TestMethod]
+    public void Avx2Disabled() => RunChild("no-avx2", ("DOTNET_EnableAVX2", "0"));
+
+    [TestMethod]
+    public void Avx512AndAvx2Disabled() => RunChild("no-avx2", ("DOTNET_EnableAVX2", "0"), ("DOTNET_EnableAVX512F", "0"));
+
+    [TestMethod]
+    public void HardwareIntrinsicsDisabledSoftwareFallback() => RunChild("software", ("DOTNET_EnableHWIntrinsic", "0"));
+
+    [TestMethod]
+    public void TieredCompilationOffFullOptimisationFromTheFirstCall() => RunChild("hardware", ("DOTNET_TieredCompilation", "0"));
+
+    [TestMethod]
+    public void TieredPgoOffAndOnStackReplacementOff() => RunChild("hardware", ("DOTNET_TieredPGO", "0"), ("DOTNET_TC_OnStackReplacement", "0"));
+
+    static string DotnetHost()
+    {
+        string? host = Environment.GetEnvironmentVariable("DOTNET_HOST_PATH");
+        if (!string.IsNullOrEmpty(host) && File.Exists(host)) return host;
+        string? self = Environment.ProcessPath;
+        if (self is not null && Path.GetFileNameWithoutExtension(self) == "dotnet") return self;
+        string root = Path.GetFullPath(Path.Combine(RuntimeEnvironment.GetRuntimeDirectory(), "..", "..", ".."));
+        string candidate = Path.Combine(root, OperatingSystem.IsWindows() ? "dotnet.exe" : "dotnet");
+        if (File.Exists(candidate)) return candidate;
+        Assert.Inconclusive("cannot find the dotnet host to start the child process");
+        return "";
+    }
+
+    static void RunChild(string expect, params (string Name, string Value)[] env)
+    {
+        if (Environment.GetEnvironmentVariable("FS_FAST_CHILD") == "1") return; // a child never starts children
+        if (!File.Exists(Path.Combine(FastTestData.FixturesRoot(), "fx-k6f-900", "header.json")))
+        {
+            Assert.Inconclusive("the fixture is missing (see LevelSetKernelTests)");
+            return;
+        }
+        string dll = typeof(FastSeparateProcessTests).Assembly.Location;
+        string results = Path.Combine(Path.GetTempPath(), "fs-fast-child-" + Guid.NewGuid().ToString("N"));
+        var psi = new ProcessStartInfo(DotnetHost())
+        {
+            RedirectStandardOutput = true,
+            RedirectStandardError = true,
+            UseShellExecute = false,
+            WorkingDirectory = Path.GetDirectoryName(dll)!,
+        };
+        foreach (string a in new[] { dll, "--filter", "FullyQualifiedName~FastPathChecks", "--minimum-expected-tests", FastPathChecks.TestCount.ToString(), "--progress", "off", "--no-ansi", "--results-directory", results })
+            psi.ArgumentList.Add(a);
+        psi.Environment["FS_FAST_CHILD"] = "1";
+        psi.Environment[FastPathChecks.ExpectVariable] = expect;
+        foreach (string k in new[] { "DOTNET_EnableAVX2", "DOTNET_EnableAVX512F", "DOTNET_EnableHWIntrinsic", "DOTNET_TieredCompilation", "DOTNET_TieredPGO", "DOTNET_TC_OnStackReplacement" })
+            psi.Environment.Remove(k);
+        foreach ((string name, string value) in env) psi.Environment[name] = value;
+        try
+        {
+            using Process p = Process.Start(psi)!;
+            Task<string> stdout = p.StandardOutput.ReadToEndAsync();
+            Task<string> stderr = p.StandardError.ReadToEndAsync();
+            if (!p.WaitForExit(TimeSpan.FromMinutes(10)))
+            {
+                p.Kill(entireProcessTree: true);
+                Assert.Fail("the child test process did not finish in 10 minutes");
+            }
+            string output = stdout.GetAwaiter().GetResult() + stderr.GetAwaiter().GetResult();
+            Assert.AreEqual(0, p.ExitCode, $"child with {string.Join(" ", env.Select(e => $"{e.Name}={e.Value}"))} (expect {expect}) failed:\n{output}");
+            StringAssert.Contains(output, $"succeeded: {FastPathChecks.TestCount}", "the child must have run all the path checks");
+        }
+        finally
+        {
+            try { Directory.Delete(results, recursive: true); } catch (IOException) { } catch (UnauthorizedAccessException) { }
+        }
+    }
+}
diff --git a/prototypes/dotnet-b/Fs.Tests/FastTestData.cs b/prototypes/dotnet-b/Fs.Tests/FastTestData.cs
new file mode 100644
index 0000000..b992f75
--- /dev/null
+++ b/prototypes/dotnet-b/Fs.Tests/FastTestData.cs
@@ -0,0 +1,186 @@
+using System.Text.Json;
+using Fs.Kernel;
+using Fs.Kernel.LevelSet;
+
+namespace Fs.Tests;
+
+/// <summary>
+/// Card T1.4b test data. Two sources: (1) the fixtures made by Fs.Bench/ts/fast/capture.ts from the real TypeScript fast tier (a folder with header.json + data.bin, found through
+/// <c>FS_FAST_FIXTURES</c>, default <c>$FIRESIM_SCRATCH/T1.4b</c>, regenerated by Fs.Bench/ts/fast/regen.sh) whose output hashes the real, unmodified TypeScript kernels produced,
+/// committed as the small golden files Fs.Tests/golden/fast-*.json; (2) synthetic grids from a fixed generator, for the checks of one form against another (every tail length, every
+/// tile edge, the edge cells of the grid, NaN and -0). Without the fixtures the fixture tests are inconclusive, never green.
+/// </summary>
+static class FastTestData
+{
+    public static string FixturesRoot()
+    {
+        string? e = Environment.GetEnvironmentVariable("FS_FAST_FIXTURES");
+        if (!string.IsNullOrEmpty(e)) return e;
+        string? s = Environment.GetEnvironmentVariable("FIRESIM_SCRATCH");
+        return s is null ? "" : Path.Combine(s, "T1.4b");
+    }
+
+    public sealed class Files : IFastData
+    {
+        readonly byte[] _data;
+        readonly Dictionary<string, (string Type, int Length, long Offset)> _arrays = [];
+        public readonly JsonElement Header;
+
+        Files(byte[] data, JsonElement header)
+        {
+            _data = data; Header = header;
+            foreach (JsonElement a in header.GetProperty("arrays").EnumerateArray())
+                _arrays[a.GetProperty("name").GetString()!] = (a.GetProperty("type").GetString()!, a.GetProperty("length").GetInt32(), a.GetProperty("byteOffset").GetInt64());
+        }
+
+        public static Files? TryLoad(string name)
+        {
+            string dir = Path.Combine(FixturesRoot(), "fx-" + name);
+            if (!File.Exists(Path.Combine(dir, "header.json")) || !File.Exists(Path.Combine(dir, "data.bin"))) return null;
+            using JsonDocument doc = JsonDocument.Parse(File.ReadAllBytes(Path.Combine(dir, "header.json")));
+            return new Files(File.ReadAllBytes(Path.Combine(dir, "data.bin")), doc.RootElement.Clone());
+        }
+
+        T[] Get<T>(string n, string type) where T : unmanaged
+        {
+            var (t, len, off) = _arrays[n];
+            if (t != type) throw new InvalidOperationException($"{n} is {t}");
+            var r = new T[len];
+            Buffer.BlockCopy(_data, (int)off, r, 0, len * System.Runtime.CompilerServices.Unsafe.SizeOf<T>());
+            return r;
+        }
+
+        public double[] F64(string n) => Get<double>(n, "float64");
+        public float[] F32(string n) => Get<float>(n, "float32");
+        public int[] I32(string n) => Get<int>(n, "int32");
+        public byte[] U8(string n) => Get<byte>(n, "uint8");
+    }
+
+    /// <summary>Appends a line to the file named by FS_FAST_NOTES (when set): numbers a test measured that the report quotes. The test runner does not show a passing test's output.</summary>
+    public static void Note(string line)
+    {
+        string? f = Environment.GetEnvironmentVariable("FS_FAST_NOTES");
+        if (!string.IsNullOrEmpty(f)) File.AppendAllText(f, line + Environment.NewLine);
+    }
+
+    public static JsonElement Golden(string name)
+    {
+        string path = Path.Combine(AppContext.BaseDirectory, "golden", $"fast-{name}.json");
+        using JsonDocument doc = JsonDocument.Parse(File.ReadAllBytes(path));
+        return doc.RootElement.Clone();
+    }
+
+    // ───────────────────────────── the forms ─────────────────────────────
+
+    /// <summary>Every form the card asks for: scalar, element-wise Vector128, Parallel.For on 1 (inline), 2, 4 and 8 threads, and the vector body in parallel.</summary>
+    public static readonly KernelExec[] AllForms =
+    [
+        KernelExec.Scalar, KernelExec.Vec, KernelExec.Par(1), KernelExec.Par(2), KernelExec.Par(4), KernelExec.Par(8), KernelExec.ParVec(2), KernelExec.ParVec(4), KernelExec.ParVec(8),
+    ];
+
+    public static string Name(KernelExec e) => e.Threads < 2 ? (e.Vector ? "vector" : e.Threads == 1 ? "parallel x1 (inline)" : "scalar") : $"parallel x{e.Threads}{(e.Vector ? " + vector" : "")}";
+
+    // ───────────────────────────── synthetic data ─────────────────────────────
+
+    /// <summary>A fixed generator: xorshift64*, values in [0, 1).</summary>
+    public sealed class Rng(ulong seed)
+    {
+        ulong _s = seed * 0x9E3779B97F4A7C15UL + 0x1234567UL;
+        public double Next()
+        {
+            _s ^= _s >> 12; _s ^= _s << 25; _s ^= _s >> 27;
+            return (_s * 0x2545F4914F6CDD1DUL >> 11) * (1.0 / 9007199254740992.0);
+        }
+        public double Range(double lo, double hi) => lo + (hi - lo) * Next();
+        public int Int(int n) => (int)(Next() * n);
+    }
+
+    /// <summary>
+    /// A level set on an nx x ny grid shaped like a fire: phi = signed distance to a union of discs plus noise, clamped to +-9 dx; the band holds the cells with |phi| <= 8 dx in row order
+    /// (at most <paramref name="cap"/> of them, the first ones, so that tests can hit chunk boundaries), burnt cells (phi &lt;= 0) get arrival speeds on half of them, and the speed
+    /// coefficients are random with some all-zero cells, some lateral-spread cells and some prepared ones. Border cells are included when the discs reach them.
+    /// </summary>
+    public static LevelSetCore MakeLs(int nx, int ny, ulong seed, int cap = int.MaxValue, bool borderFire = false, LevelSetParams? p = null)
+    {
+        var r = new Rng(seed);
+        var ls = new LevelSetCore(nx, ny, 30, p);
+        int discs = 1 + r.Int(3);
+        var cx = new double[discs]; var cy = new double[discs]; var rad = new double[discs];
+        for (int d = 0; d < discs; d++)
+        {
+            cx[d] = borderFire && d == 0 ? 0 : r.Range(0.2, 0.8) * nx;
+            cy[d] = borderFire && d == 0 ? ny / 2.0 : r.Range(0.2, 0.8) * ny;
+            rad[d] = r.Range(2, Math.Max(3, Math.Min(nx, ny) * 0.3));
+        }
+        double far = ls.Far;
+        for (int j = 0; j < ny; j++)
+            for (int i = 0; i < nx; i++)
+            {
+                double best = double.MaxValue;
+                for (int d = 0; d < discs; d++) best = Math.Min(best, Math.Sqrt((i - cx[d]) * (i - cx[d]) + (j - cy[d]) * (j - cy[d])) - rad[d]);
+                double v = best * 30 + r.Range(-0.3, 0.3) * 30 * 0.2;
+                v = Math.Max(-far, Math.Min(far, v));
+                ls.Phi[j * nx + i] = v;
+                ls.PhiS[j * nx + i] = v;
+            }
+        int count = 0;
+        for (int k = 0; k < nx * ny && count < cap; k++) if (Math.Abs(ls.Phi[k]) <= 8 * 30) ls.Band[count++] = k;
+        ls.BandCount = count;
+        for (int k = 0; k < nx * ny; k++)
+        {
+            double kind = r.Next();
+            bool zero = kind < 0.08;
+            ls.SA2[k] = zero ? 0 : (float)r.Range(0.01, 0.4);
+            ls.SB2[k] = zero ? 0 : (float)r.Range(0.001, 0.05);
+            ls.SC[k] = (float)r.Range(-0.2, 0.3);
+            double ang = r.Range(0, 2 * Math.PI);
+            ls.SEx[k] = (float)Math.Cos(ang); ls.SEy[k] = (float)Math.Sin(ang);
+            ls.SVls[k] = zero ? 0 : (kind > 0.8 ? (float)r.Range(0.05, 0.5) : 0f);
+            ls.SJun[k] = r.Next() < 0.2 ? (float)r.Range(0.8, 1.4) : 1f;
+            ls.SBurnt[k] = ls.Phi[k] <= 0 && r.Next() < 0.5 ? (float)r.Range(0.1, 3) : 0f;
+            double tang = r.Range(0, 2 * Math.PI);
+            ls.STx[k] = (float)Math.Cos(tang); ls.STy[k] = (float)Math.Sin(tang);
+            ls.PrepStamp[k] = r.Next() < 0.7 ? ls.Stamp : r.Next() < 0.5 ? 0 : ls.Stamp - 1;
+        }
+        return ls;
+    }
+
+    /// <summary>The same arrays copied into a new core (so that two forms start from identical state).</summary>
+    public static LevelSetCore Clone(LevelSetCore a)
+    {
+        var b = new LevelSetCore(a.Nx, a.Ny, a.H, a.P);
+        Array.Copy(a.Phi, b.Phi, a.N); Array.Copy(a.PhiS, b.PhiS, a.N);
+        Array.Copy(a.SA2, b.SA2, a.N); Array.Copy(a.SB2, b.SB2, a.N); Array.Copy(a.SC, b.SC, a.N); Array.Copy(a.SEx, b.SEx, a.N); Array.Copy(a.SEy, b.SEy, a.N);
+        Array.Copy(a.SVls, b.SVls, a.N); Array.Copy(a.SJun, b.SJun, a.N); Array.Copy(a.SBurnt, b.SBurnt, a.N); Array.Copy(a.STx, b.STx, a.N); Array.Copy(a.STy, b.STy, a.N);
+        Array.Copy(a.PrepStamp, b.PrepStamp, a.N);
+        Array.Copy(a.Band, b.Band, a.BandCount); b.BandCount = a.BandCount;
+        Array.Copy(a.InBand, b.InBand, a.N); Array.Copy(a.Touched, b.Touched, a.N);
+        b.Stamp = a.Stamp; b.Lazy = a.Lazy; b.SubCount = a.SubCount;
+        return b;
+    }
+
+    /// <summary>A hook that draws random numbers (as the fire model's breachDraw does) and writes cell k's coefficients from them: a result that depends on the order of the calls.</summary>
+    public sealed class DrawingHooks(LevelSetCore ls, ulong seed) : ILevelSetHooks
+    {
+        readonly Rng _r = new(seed);
+        public readonly List<int> Seq = [];
+        public readonly List<double> Arrivals = [];
+
+        public void EnsureSpeed(int k)
+        {
+            Seq.Add(k);
+            double a = _r.Next(), b = _r.Next(), c = _r.Next();
+            ls.SA2[k] = a < 0.1 ? 0f : (float)(0.01 + 0.4 * a);
+            ls.SB2[k] = a < 0.1 ? 0f : (float)(0.001 + 0.05 * b);
+            ls.SC[k] = (float)(c - 0.3);
+            ls.SVls[k] = c > 0.85 ? (float)(0.05 + 0.4 * b) : 0f;
+            ls.PrepStamp[k] = ls.Stamp;
+        }
+
+        public void OnArrival(int k, double tA, double r, double nx, double ny)
+        {
+            Arrivals.Add(k); Arrivals.Add(tA); Arrivals.Add(r); Arrivals.Add(nx); Arrivals.Add(ny);
+            _ = _r.Next();
+        }
+    }
+}
diff --git a/prototypes/dotnet-b/Fs.Tests/LevelSetKernelTests.cs b/prototypes/dotnet-b/Fs.Tests/LevelSetKernelTests.cs
new file mode 100644
index 0000000..664ad78
--- /dev/null
+++ b/prototypes/dotnet-b/Fs.Tests/LevelSetKernelTests.cs
@@ -0,0 +1,436 @@
+using System.Runtime.CompilerServices;
+using System.Text.Json;
+using Fs.Kernel;
+using Fs.Kernel.LevelSet;
+
+namespace Fs.Tests;
+
+/// <summary>
+/// Card T1.4b, the level set (<c>LevelSetCore.evaluate</c> and <c>reinit</c>, and the sub-step that calls them). Reference data: the real, unmodified TypeScript kernels run on real frames
+/// of <c>katoomba6-fast-4h</c> (a 900 s and a late window; Fs.Bench/ts/fast/capture.ts, committed as Fs.Tests/golden/fast-*.json, the large fixture regenerated by regen.sh).
+/// The kernels use only + - * / and sqrt, so the bits are the TypeScript's own (no FsMath shim). Then: every form against every other on synthetic grids, the lazy-speed hook order
+/// (the fire model's hook draws random numbers), threads 1 to 16, NaN and -0, and an operand-order mutation test.
+/// </summary>
+[TestClass]
+public sealed class LevelSetKernelTests
+{
+    // ───────────────────────────── the real fixtures ─────────────────────────────
+
+    static readonly Func<string, bool> LevelSetKinds = k => k != "pyro";
+
+    internal static void CheckFixture(string name, IEnumerable<KernelExec> forms, bool forceChunks = true)
+    {
+        var data = FastTestData.Files.TryLoad(name);
+        if (data is null)
+        {
+            Assert.Inconclusive($"the fixture fx-{name} is missing in {FastTestData.FixturesRoot()} (run Fs.Bench/ts/fast/regen.sh)");
+            return;
+        }
+        JsonElement golden = FastTestData.Golden(name);
+        CollectionAssert.AreEqual(
+            golden.GetProperty("cases").EnumerateArray().Select(c => c.GetProperty("id").GetString()).ToList(),
+            data.Header.GetProperty("cases").EnumerateArray().Select(c => c.GetProperty("id").GetString()).ToList(), "the fixture and the golden file hold different cases (stale fixture?)");
+        var expected = FastCaseRunner.Expected(golden, LevelSetKinds);
+        Assert.IsTrue(expected.Count > 200, "expected values: " + expected.Count);
+        var bad = new List<string>();
+        int checks = 0;
+        foreach (KernelExec exec in forms)
+        {
+            var got = FastCaseRunner.RunAll(data, data.Header, exec, LevelSetKinds, forceChunks);
+            foreach (var kv in expected)
+            {
+                checks++;
+                if (!got.TryGetValue(kv.Key, out string? g)) bad.Add($"[{FastTestData.Name(exec)}] {kv.Key}: not produced");
+                else if (g != kv.Value) bad.Add($"[{FastTestData.Name(exec)}] {kv.Key}: {g} != {kv.Value}");
+            }
+            Assert.AreEqual(expected.Count, got.Count, "the form produced other keys than the golden file has");
+        }
+        Assert.AreEqual(0, bad.Count, $"{bad.Count} of {checks} hashes differ from the TypeScript's, first: {string.Join("; ", bad.Take(6))}");
+    }
+
+    [TestMethod]
+    public void The900sWindowEqualsTheTypeScriptOnEveryForm() => CheckFixture("k6f-900", FastTestData.AllForms);
+
+    [TestMethod]
+    public void TheLateWindowEqualsTheTypeScriptOnEveryForm() => CheckFixture("k6f-late", FastTestData.AllForms);
+
+    [TestMethod]
+    public void TheFixturesWithTheDefaultThresholdsAlsoEqualTheTypeScript()
+    {
+        // MinParallelBand 1024 and MinParallelBox 16384: the 900 s box (9.4k cells) runs the row phases in parallel but the sweeps serially, the late box (30k cells) runs the wavefront
+        CheckFixture("k6f-900", [KernelExec.Par(4), KernelExec.ParVec(4)], forceChunks: false);
+        CheckFixture("k6f-late", [KernelExec.Par(4), KernelExec.ParVec(4)], forceChunks: false);
+    }
+
+    [TestMethod]
+    public void TheGoldenFilesAreSmall()
+    {
+        long total = 0;
+        foreach (string n in new[] { "k6f-900", "k6f-late" }) total += new FileInfo(Path.Combine(AppContext.BaseDirectory, "golden", $"fast-{n}.json")).Length;
+        Assert.IsTrue(total < 300_000, $"{total} bytes");
+    }
+
+    // ───────────────────────────── synthetic: one form against another ─────────────────────────────
+
+    static string[] EvalHashes(LevelSetCore ls, DrawingHooksOrNone hooks, KernelExec exec, bool stage1, bool withOut, bool useBand2, out double maxC)
+    {
+        int count = ls.BandCount;
+        var o = new double[count];
+        double[] src = useBand2 ? ls.PhiS : ls.Phi;
+        maxC = ls.Evaluate(src, withOut ? o : null, stage1, exec);
+        var r = new List<string> { FastCaseRunner.Bits(maxC), FastCaseRunner.Hash(o) };
+        if (stage1 && withOut)
+        {
+            r.Add(FastCaseRunner.Hash(ls.R1.AsSpan(0, count)));
+            r.Add(FastCaseRunner.Hash(ls.N1x.AsSpan(0, count)));
+            r.Add(FastCaseRunner.Hash(ls.N1y.AsSpan(0, count)));
+            r.Add(FastCaseRunner.Hash(ls.PrepStamp));
+            r.Add(FastCaseRunner.Hash(ls.SA2)); r.Add(FastCaseRunner.Hash(ls.SB2)); r.Add(FastCaseRunner.Hash(ls.SC)); r.Add(FastCaseRunner.Hash(ls.SVls));
+            r.Add(FastCaseRunner.Hash(hooks.Seq.ToArray()));
+        }
+        return [.. r];
+    }
+
+    sealed class DrawingHooksOrNone(FastTestData.DrawingHooks h) { public List<int> Seq => h.Seq; }
+
+    static void Poison(LevelSetCore ls, int mode)
+    {
+        // NaN and -0 in the field and in the coefficients, at band positions
+        for (int a = 0; a < ls.BandCount; a++)
+        {
+            int k = ls.Band[a];
+            if (mode >= 1)
+            {
+                if (a % 11 == 3) { ls.Phi[k] = double.NaN; ls.PhiS[k] = double.NaN; }
+                if (a % 13 == 5) { ls.Phi[k] = -0.0; ls.PhiS[k] = -0.0; }
+            }
+            if (mode >= 2)
+            {
+                if (a % 17 == 4) ls.SA2[k] = float.NaN;
+                if (a % 19 == 6) ls.SEx[k] = -0.0f;
+                if (a % 23 == 7) ls.SVls[k] = float.NaN;
+                if (a % 29 == 9) ls.SBurnt[k] = float.NaN;
+                if (a % 31 == 2) ls.STx[k] = float.NaN;
+            }
+        }
+    }
+
+    [TestMethod]
+    public void EvaluateFormsAgreeBitForBitOnEveryBandLengthAroundTheChunkEdges()
+    {
+        int[] counts = [1, 2, 3, 5, 254, 255, 256, 257, 258, 511, 512, 513, 700, int.MaxValue];
+        int shapes = 0, checks = 0;
+        var bad = new List<string>();
+        foreach (int nx in new[] { 17, 40, 64 })
+            foreach (int count in counts)
+                foreach (int poison in new[] { 0, 1, 2 })
+                    foreach (bool stage1 in new[] { true, false })
+                    {
+                        var proto = FastTestData.MakeLs(nx, nx - 3, (ulong)(nx * 1000 + (count & 0xffff) + poison), count, borderFire: (nx & 1) == 0);
+                        Poison(proto, poison);
+                        shapes++;
+                        string[]? reference = null;
+                        foreach (KernelExec exec in FastTestData.AllForms)
+                        {
+                            LevelSetCore ls = FastTestData.Clone(proto);
+                            ls.MinParallelBand = 0;
+                            var hooks = new FastTestData.DrawingHooks(ls, 77);
+                            ls.Hooks = hooks;
+                            string[] h = EvalHashes(ls, new DrawingHooksOrNone(hooks), exec, stage1, true, !stage1, out _);
+                            if (reference is null) reference = h;
+                            else
+                            {
+                                checks++;
+                                if (!h.SequenceEqual(reference)) bad.Add($"nx {nx} count {ls.BandCount} poison {poison} stage1 {stage1} [{FastTestData.Name(exec)}]");
+                            }
+                        }
+                    }
+        Assert.AreEqual(0, bad.Count, $"{bad.Count} of {checks} differ: {string.Join("; ", bad.Take(6))}");
+        Assert.IsTrue(shapes > 200 && checks > 1500);
+    }
+
+    [TestMethod]
+    public void TheBoundOnlyCallAgreesAndAsksForNoSpeeds()
+    {
+        var proto = FastTestData.MakeLs(40, 33, 5, 600);
+        var bound = new List<string>();
+        foreach (KernelExec exec in FastTestData.AllForms)
+        {
+            LevelSetCore ls = FastTestData.Clone(proto);
+            ls.MinParallelBand = 0;
+            var hooks = new FastTestData.DrawingHooks(ls, 1);
+            ls.Hooks = hooks;
+            double c = ls.Evaluate(ls.Phi, null, true, exec);
+            Assert.AreEqual(0, hooks.Seq.Count, "evaluate with no output must not ask for speeds");
+            bound.Add(FastCaseRunner.Bits(c));
+        }
+        Assert.AreEqual(1, bound.Distinct().Count(), string.Join(",", bound));
+    }
+
+    [TestMethod]
+    public void TheLazySpeedHooksAreCalledInBandOrderWhateverTheFormAndTheDrawsAreTheTypeScripts()
+    {
+        // The hook draws random numbers and writes the coefficients of the cell it is asked about: if two forms asked in another order, the coefficients (hashed) would differ.
+        var proto = FastTestData.MakeLs(64, 61, 21, 1500);
+        int asked = -1;
+        string? reference = null;
+        foreach (KernelExec exec in FastTestData.AllForms)
+        {
+            LevelSetCore ls = FastTestData.Clone(proto);
+            ls.MinParallelBand = 0;
+            var hooks = new FastTestData.DrawingHooks(ls, 5);
+            ls.Hooks = hooks;
+            ls.Evaluate(ls.Phi, new double[ls.BandCount], true, exec);
+            CollectionAssert.AreEqual(hooks.Seq.OrderBy(x => x).ToList(), hooks.Seq, $"[{FastTestData.Name(exec)}] hooks out of band order");
+            string h = FastCaseRunner.Hash(ls.SA2) + FastCaseRunner.Hash(ls.SC) + FastCaseRunner.Hash(ls.R1.AsSpan(0, ls.BandCount));
+            if (reference is null) { reference = h; asked = hooks.Seq.Count; }
+            else Assert.AreEqual(reference, h, $"[{FastTestData.Name(exec)}]");
+        }
+        Assert.IsTrue(asked > 50, $"only {asked} speed requests: the test would prove little");
+    }
+
+    static string[] ReinitHashes(LevelSetCore ls, bool wide)
+    {
+        var d = FastCaseRunner.ReinitHashes(ls, wide);
+        return [.. d.Values];
+    }
+
+    [TestMethod]
+    public void ReinitFormsAgreeBitForBitOnEveryShapeAndEveryTileEdge()
+    {
+        int shapes = 0, checks = 0;
+        var bad = new List<string>();
+        foreach (var (nx, ny) in new[] { (12, 12), (23, 17), (45, 40), (64, 70), (101, 83), (140, 120) })
+            foreach (int poison in new[] { 0, 1, 2 })
+                foreach (bool wide in new[] { false, true })
+                {
+                    var proto = FastTestData.MakeLs(nx, ny, (ulong)(nx * 31 + ny + poison), int.MaxValue, borderFire: (nx & 1) == 1);
+                    Poison(proto, poison);
+                    if (proto.BandCount == 0) continue;
+                    shapes++;
+                    string[]? reference = null;
+                    foreach (KernelExec exec in FastTestData.AllForms)
+                    {
+                        LevelSetCore ls = FastTestData.Clone(proto);
+                        ls.MinParallelBox = 0;
+                        if (wide) ls.ReinitWide(exec); else ls.Reinit(exec);
+                        string[] h = ReinitHashes(ls, wide);
+                        if (reference is null) reference = h;
+                        else
+                        {
+                            checks++;
+                            if (!h.SequenceEqual(reference)) bad.Add($"{nx}x{ny} poison {poison} wide {wide} [{FastTestData.Name(exec)}]");
+                        }
+                    }
+                }
+        Assert.AreEqual(0, bad.Count, $"{bad.Count} of {checks} differ: {string.Join("; ", bad.Take(6))}");
+        Assert.IsTrue(shapes >= 30 && checks >= 200);
+    }
+
+    [TestMethod]
+    public void ResultsDoNotDependOnTheNumberOfThreads()
+    {
+        var proto = FastTestData.MakeLs(140, 120, 99, int.MaxValue);
+        string? refEval = null, refReinit = null;
+        foreach (int t in new[] { 2, 3, 4, 5, 6, 8, 16 })
+        {
+            foreach (bool vec in new[] { false, true })
+            {
+                LevelSetCore ls = FastTestData.Clone(proto);
+                ls.MinParallelBand = 0; ls.MinParallelBox = 0;
+                var exec = new KernelExec(vec, t);
+                var hooks = new FastTestData.DrawingHooks(ls, 3);
+                ls.Hooks = hooks;
+                string e = string.Concat(EvalHashes(ls, new DrawingHooksOrNone(hooks), exec, true, true, false, out _));
+                ls.Reinit(exec);
+                string r = string.Concat(ReinitHashes(ls, false));
+                if (refEval is null) { refEval = e; refReinit = r; }
+                else { Assert.AreEqual(refEval, e, $"evaluate on {t} threads, vector {vec}"); Assert.AreEqual(refReinit, r, $"reinit on {t} threads, vector {vec}"); }
+            }
+        }
+        // and the same again, from the same instance, to catch state left behind by a first call
+        LevelSetCore twice = FastTestData.Clone(proto);
+        twice.MinParallelBox = 0; twice.MinParallelBand = 0;
+        twice.Reinit(KernelExec.ParVec(8));
+        LevelSetCore once = FastTestData.Clone(proto);
+        once.Reinit(KernelExec.Scalar);
+        Assert.AreEqual(string.Concat(ReinitHashes(once, false)), string.Concat(ReinitHashes(twice, false)));
+    }
+
+    [TestMethod]
+    public void ASequenceOfSubStepsWithReinitsEqualsTheScalarFormOnEveryForm()
+    {
+        var proto = FastTestData.MakeLs(70, 64, 123, int.MaxValue);
+        proto.SubCount = 7; // reinit after the 3rd, 13th and 23rd step
+        string? reference = null;
+        foreach (KernelExec exec in FastTestData.AllForms)
+        {
+            LevelSetCore ls = FastTestData.Clone(proto);
+            ls.MinParallelBand = 0; ls.MinParallelBox = 0;
+            var hooks = new FastTestData.DrawingHooks(ls, 9);
+            ls.Hooks = hooks;
+            double t = 0;
+            var log = new List<string>();
+            for (int s = 0; s < 25; s++)
+            {
+                double dt = ls.Advance(t, 4, exec);
+                t += dt;
+                log.Add(FastCaseRunner.Bits(dt) + FastCaseRunner.Hash(ls.Phi) + ls.BandCount);
+            }
+            log.Add(FastCaseRunner.Hash(hooks.Arrivals.ToArray()));
+            log.Add(FastCaseRunner.Hash(hooks.Seq.ToArray()));
+            log.Add(FastCaseRunner.Hash(ls.SBurnt));
+            string h = string.Concat(log);
+            if (reference is null) reference = h;
+            else Assert.AreEqual(reference, h, $"[{FastTestData.Name(exec)}]");
+        }
+    }
+
+    [TestMethod]
+    public void StepFixedRejectsADtOverTheBoundAndBoundIsFinite()
+    {
+        LevelSetCore ls = FastTestData.MakeLs(40, 33, 5, 600);
+        double b = ls.Bound(KernelExec.Scalar);
+        Assert.IsTrue(b > 0 && double.IsFinite(b), b.ToString());
+        Assert.ThrowsExactly<ArgumentOutOfRangeException>(() => ls.StepFixed(0, b * 2, KernelExec.Scalar));
+        ls.StepFixed(0, b * 0.5, KernelExec.Scalar);
+        Assert.AreEqual(1, ls.SubCount);
+    }
+
+    [TestMethod]
+    public void AnEmptyBandDoesNothing()
+    {
+        var ls = new LevelSetCore(20, 20, 30);
+        double[] o = new double[1];
+        foreach (KernelExec exec in FastTestData.AllForms)
+        {
+            Assert.AreEqual(0.0, ls.Evaluate(ls.Phi, o, true, exec));
+            ls.Reinit(exec);
+            Assert.AreEqual(0, ls.BandCount);
+        }
+    }
+
+    // ───────────────────────────── NaN and -0 expectations that do not depend on the TypeScript ─────────────────────────────
+
+    [TestMethod]
+    public void ANaNCoefficientGivesANaNTendencyAndTheCFLMaximumIgnoresItWhileANaNNeighbourIsIgnored()
+    {
+        var ls = new LevelSetCore(9, 9, 30);
+        int k = 4 * 9 + 4;
+        ls.Band[0] = k; ls.BandCount = 1;
+        ls.Phi[k] = 10;
+        ls.SA2[k] = float.NaN; ls.SB2[k] = 0.01f;
+        var o = new double[1];
+        foreach (KernelExec exec in FastTestData.AllForms)
+        {
+            double c = ls.Evaluate(ls.Phi, o, true, exec);
+            Assert.IsTrue(double.IsNaN(o[0]), $"[{FastTestData.Name(exec)}] {o[0]}");
+            Assert.AreEqual(0.0, c, "a NaN speed is not greater than the maximum so far");
+        }
+        // a NaN in a neighbour's phi: every comparison with it is false, the one-sided differences drop out and the tendency stays finite (the JavaScript semantics, kept)
+        ls.SA2[k] = 0.1f;
+        ls.Phi[k - 1] = double.NaN;
+        foreach (KernelExec exec in FastTestData.AllForms)
+        {
+            ls.Evaluate(ls.Phi, o, false, exec);
+            Assert.IsTrue(double.IsFinite(o[0]), $"[{FastTestData.Name(exec)}] {o[0]}");
+        }
+    }
+
+    [TestMethod]
+    public void AZeroCoefficientCellHasZeroTendencyAndAnArrivalCellKeepsItsStoredSpeed()
+    {
+        var ls = new LevelSetCore(9, 9, 30);
+        int k0 = 4 * 9 + 3, k1 = 4 * 9 + 4;
+        ls.Band[0] = k0; ls.Band[1] = k1; ls.BandCount = 2;
+        ls.Phi[k0] = 10; ls.Phi[k1] = -10;              // an unburnt cell with no coefficients; a burnt cell with an arrival speed
+        ls.SBurnt[k1] = 1.25f;
+        var o = new double[2];
+        foreach (KernelExec exec in FastTestData.AllForms)
+        {
+            ls.Evaluate(ls.Phi, o, true, exec);
+            Assert.AreEqual(0.0, o[0]);
+            Assert.AreEqual(BitConverter.DoubleToInt64Bits(0.0), BitConverter.DoubleToInt64Bits(o[0]), "+0 for an all-zero cell");
+            Assert.AreEqual(-1.25, o[1]);
+        }
+    }
+
+    // ───────────────────────────── the discriminating power of the tests ─────────────────────────────
+
+    /// <summary>The TypeScript's update with its sum associated the other way: 0.5 (aa + (bb + sqrt)) instead of 0.5 (aa + bb + sqrt).</summary>
+    readonly struct ReassociatedUpdate : IDistUpdate
+    {
+        [MethodImpl(MethodImplOptions.AggressiveInlining)]
+        public static double Update(double aa, double bb, double h, double h2)
+        {
+            double diff = aa - bb;
+            if (diff >= h || diff <= -h) return (aa < bb ? aa : bb) + h;
+            return 0.5 * (aa + (bb + Math.Sqrt(h2 - diff * diff)));
+        }
+    }
+
+    [TestMethod]
+    public void AnOperandOrderSlipInTheSweepIsCaughtByTheDoubleDistanceAndMayNotBeByTheFloat32One()
+    {
+        // The lesson of T1.4a: a float32 store can hide a double-rounding difference. Reinit's distance array is float32 in the TypeScript, so the golden file also holds the run with
+        // a Float64 distance array. Here a re-associated sum in the sweep is run on real frames; the double distances and the phi derived from them must differ from the TypeScript's,
+        // while the float32 ones usually do not: the second half documents why the wide variant exists.
+        string[] windows = ["k6f-900", "k6f-late"];
+        int ran = 0, wideCaught = 0, floatCaught = 0;
+        foreach (string name in windows)
+        {
+            var data = FastTestData.Files.TryLoad(name);
+            if (data is null) { Assert.Inconclusive("fixture missing"); return; }
+            JsonElement golden = FastTestData.Golden(name);
+            var meta = FastCaseRunner.ReadMeta(golden.GetProperty("meta"));
+            foreach (JsonElement c in golden.GetProperty("cases").EnumerateArray())
+            {
+                if (c.GetProperty("kind").GetString() != "reinit") continue;
+                JsonElement plain = c.GetProperty("variants")[0].GetProperty("result");
+                // control: the unmutated update reproduces the golden dist (so a difference below is the mutation's)
+                var (ls0, _) = FastCaseRunner.BuildLs(data, meta, c, "plain");
+                ls0.ReinitWith<LiteralUpdate>(wide: true);
+                Assert.AreEqual(plain.GetProperty("wide").GetProperty("dist").GetString(), FastCaseRunner.ReinitHashes(ls0, true)["dist"], "control, wide");
+                var (lsW, _) = FastCaseRunner.BuildLs(data, meta, c, "plain");
+                lsW.ReinitWith<ReassociatedUpdate>(wide: true);
+                var (lsF, _) = FastCaseRunner.BuildLs(data, meta, c, "plain");
+                lsF.ReinitWith<ReassociatedUpdate>(wide: false);
+                ran++;
+                if (FastCaseRunner.ReinitHashes(lsW, true)["dist"] != plain.GetProperty("wide").GetProperty("dist").GetString()) wideCaught++;
+                if (FastCaseRunner.ReinitHashes(lsF, false)["dist"] != plain.GetProperty("float").GetProperty("dist").GetString()) floatCaught++;
+            }
+        }
+        FastTestData.Note($"re-associated sweep sum on {ran} real reinit frames: caught by the double distance in {wideCaught}, by the float32 distance in {floatCaught}");
+        Assert.IsTrue(ran >= 4);
+        Assert.AreEqual(ran, wideCaught, "the Float64 distance must expose the slip on every frame");
+        Assert.IsTrue(floatCaught <= wideCaught);
+    }
+
+    // ───────────────────────────── allocation ─────────────────────────────
+
+    [TestMethod]
+    public void ScalarAndVectorFormsAllocateNothingPerCall()
+    {
+        LevelSetCore ls = FastTestData.MakeLs(100, 100, 7, int.MaxValue);
+        var hooks = new FastTestData.DrawingHooks(ls, 1);
+        ls.Hooks = new NoopHooks();
+        _ = hooks;
+        foreach (KernelExec exec in new[] { KernelExec.Scalar, KernelExec.Vec })
+        {
+            var o = new double[ls.BandCount];
+            var proto = FastTestData.Clone(ls);
+            for (int w = 0; w < 5; w++) { ls.Evaluate(ls.Phi, o, true, exec); ls.Evaluate(ls.PhiS, o, false, exec); ls.Evaluate(ls.Phi, null, true, exec); ls.Reinit(exec); }
+            long before = GC.GetAllocatedBytesForCurrentThread();
+            for (int i = 0; i < 10; i++) { ls.Evaluate(ls.Phi, o, true, exec); ls.Evaluate(ls.PhiS, o, false, exec); ls.Evaluate(ls.Phi, null, true, exec); ls.Reinit(exec); }
+            long after = GC.GetAllocatedBytesForCurrentThread();
+            Assert.AreEqual(0, after - before, $"[{FastTestData.Name(exec)}] allocated {after - before} bytes in 10 rounds of evaluate x3 + reinit");
+            _ = proto;
+        }
+    }
+
+    sealed class NoopHooks : ILevelSetHooks
+    {
+        public void EnsureSpeed(int k) { }
+        public void OnArrival(int k, double tA, double r, double nx, double ny) { }
+    }
+}
diff --git a/prototypes/dotnet-b/Fs.Tests/PyrogenicKernelTests.cs b/prototypes/dotnet-b/Fs.Tests/PyrogenicKernelTests.cs
