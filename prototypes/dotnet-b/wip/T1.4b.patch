+        return !(W(SA2, k) == 0 && W(SB2, k) == 0 && W(SVls, k) == 0);
+    }
+
+    void Pair(int a, int k0, int k1, double[] src, double[]? @out, bool stage1, bool ext, int nx, ref double maxC,
