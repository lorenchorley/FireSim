+            double ey = W(SEy, k);
+            double nxv, nyv;
+            if (cn > eps)
+            {
+                nxv = cx / cn;
+                nyv = cy / cn;
+            }
+            else
+            {
+                nxv = ex;
+                nyv = ey;
+            }
+            double cosp = nxv * ex + nyv * ey;
+            double c2 = cosp * cosp;
+            double s2 = 1 - c2;
