+                proj.Add(new JsonObject { ["fixture"] = fx, ["form"] = form, ["kernelSpeedups"] = new JsonObject { ["evaluate"] = ev, ["reinitNet"] = re, ["pyrogenic"] = py }, ["newShareOfOldStepPercent"] = newShare, ["projectedStepSpeedup"] = total });
