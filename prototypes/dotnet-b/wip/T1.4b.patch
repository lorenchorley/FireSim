diff --git a/prototypes/dotnet-b/Fs.Bench/ts/fast/bench.ts b/prototypes/dotnet-b/Fs.Bench/ts/fast/bench.ts
index ff7bd09..0b2f3df 100644
--- a/prototypes/dotnet-b/Fs.Bench/ts/fast/bench.ts
+++ b/prototypes/dotnet-b/Fs.Bench/ts/fast/bench.ts
@@ -1 +1,114 @@
-// placeholder
+/**
+ * T1.4b TypeScript timing: the ORIGINAL kernels (LevelSetCore.evaluate stage 1 and 2, LevelSetCore.reinit, PyrogenicPotential.solve; unmodified, run by Node/V8, one thread) on the
+ * real frames of the fast tier that capture.ts recorded. One operation each, the same as Fs.Bench/FastBench.cs:
+ *   evalStage1   LevelSetCore.evaluate(phi, out, true): lazy speed requests answered by the replay hook (the coefficients the real hook wrote, from the frame); the prepStamp of the
+ *                cells the hook was asked about is put back before each call (a loop over those cells), in both languages
+ *   evalStage2   LevelSetCore.evaluate(phiS, out, false)
+ *   reinit       LevelSetCore.reinit(): phi (the whole array), band and bandCount are restored before each call (a copy), in both languages
+ *   restore      the restore of reinit alone (to subtract: both languages)
+ *   pyro         PyrogenicPotential.solve(q) on a persistent instance
+ * Each sample is ONE operation timed on its own; a warm-up of at least WARM_MS and 30 operations comes first.
+ *   node bench.mjs FIXTURE_DIR OUT.json [SAMPLES=1000] [WARM_MS=1500]
+ * Build: node ../build.mjs BUILD_DIR fast/capture.ts fast/bench.ts  (into a folder under the repository: node_modules must resolve)
+ */
+import { writeFileSync } from 'node:fs';
+import os from 'node:os';
+import { buildLS, loadFixture, makePyro, type Case, type LS, type Meta } from './lib';
+
+const [fixDir, outFile, sArg, wArg] = process.argv.slice(2);
+if (!fixDir || !outFile) throw new Error('usage: bench.mjs FIXTURE_DIR OUT.json [SAMPLES] [WARM_MS]');
+const samples = Number(sArg ?? 1000);
+const warmMs = Number(wArg ?? 1500);
+const fx = loadFixture(fixDir);
+const h = fx.header as unknown as { meta: Meta; cases: Case[]; scenario: string; window: string };
+const meta = h.meta;
+const find = (pred: (c: Case) => boolean): Case => {
+  const c = h.cases.find(pred);
+  if (!c) throw new Error('case not found');
+  return c;
+};
+const e1 = find((c) => c.kind === 'evaluate' && c.mode === 'e1');
+const e2 = find((c) => c.kind === 'evaluate' && c.mode === 'e2');
+const ri = find((c) => c.kind === 'reinit');
+const py = find((c) => c.kind === 'pyro');
+
+// stage 1: a lean replay hook (typed index, no log) on the real LevelSetCore
+const f1 = buildLS(fx, meta, e1, 'plain');
+const ls1: LS = f1.ls;
+const hk = e1.hook as { k: string; vals: string };
+const hookK = fx.get(hk.k) as unknown as Int32Array;
+const hookV = fx.get(hk.vals) as Float32Array;
+const hookIndex = new Int32Array(ls1.n).fill(-1);
+hookK.forEach((k, i) => (hookIndex[k] = i));
+const prepBefore = Int32Array.from(hookK, (k) => ls1.prepStamp[k]!);
+ls1.hooks = {
+  ensureSpeed: (k: number): void => {
+    const i = hookIndex[k]!;
+    if (i >= 0) {
+      ls1.sA2[k] = hookV[6 * i]!; ls1.sB2[k] = hookV[6 * i + 1]!; ls1.sC[k] = hookV[6 * i + 2]!;
+      ls1.sEx[k] = hookV[6 * i + 3]!; ls1.sEy[k] = hookV[6 * i + 4]!; ls1.sVls[k] = hookV[6 * i + 5]!;
+    }
+    ls1.prepStamp[k] = ls1.stamp;
+  },
+  onArrival: () => undefined,
+};
+const out1 = new Float64Array(ls1.bandCount);
+const ls2: LS = buildLS(fx, meta, e2, 'plain').ls;
+const out2 = new Float64Array(ls2.bandCount);
+const ls3: LS = buildLS(fx, meta, ri, 'plain').ls;
+const phi0 = Float64Array.from(ls3.phi);
+const band0 = Int32Array.from(ls3.band.subarray(0, ls3.bandCount));
+const count3 = ls3.bandCount;
+const pyro = makePyro(meta, py.fireNx as number, py.fireNy as number, py.cellSize as number);
+const q = fx.get(py.q as string) as Float32Array;
+
+let sink = 0;
+const restore = (): void => {
+  ls3.phi.set(phi0);
+  ls3.band.set(band0);
+  ls3.bandCount = count3;
+};
+const ops: Record<string, () => void> = {
+  evalStage1: () => {
+    for (let i = 0; i < hookK.length; i++) ls1.prepStamp[hookK[i]!] = prepBefore[i]!;
+    sink += ls1.evaluate(ls1.phi, out1, true);
+  },
+  evalStage2: () => {
+    sink += ls2.evaluate(ls2.phiS, out2, false);
+  },
+  reinit: () => {
+    restore();
+    ls3.reinit();
+    sink += ls3.bandCount;
+  },
+  restore: () => {
+    restore();
+    sink += ls3.bandCount;
+  },
+  pyro: () => {
+    pyro.solve(q);
+    sink += pyro.up[1]!;
+  },
+};
+
+const pct = (s: number[], p: number): number => s[Math.min(s.length - 1, Math.max(0, Math.ceil(p * s.length) - 1))]!;
+const cases: Record<string, unknown>[] = [];
+for (const [name, op] of Object.entries(ops)) {
+  let warm = 0;
+  for (const w0 = performance.now(); warm < 30 || performance.now() - w0 < warmMs; warm++) op();
+  const ms: number[] = [];
+  for (let i = 0; i < samples; i++) {
+    const t0 = performance.now();
+    op();
+    ms.push(performance.now() - t0);
+  }
+  const s = [...ms].sort((a, b) => a - b);
+  const mean = ms.reduce((a, b) => a + b, 0) / ms.length;
+  const sd = Math.sqrt(ms.reduce((a, b) => a + (b - mean) * (b - mean), 0) / (ms.length - 1));
+  const med = pct(s, 0.5);
+  console.log(`${h.scenario} ${h.window} ${name}: median ${med.toFixed(4)} ms, min ${s[0]!.toFixed(4)}, p95 ${pct(s, 0.95).toFixed(4)}, max ${s[s.length - 1]!.toFixed(4)}, sd ${sd.toFixed(4)}`);
+  cases.push({ kernel: name, n: samples, warmup: warm, medianMs: med, meanMs: mean, stdDevMs: sd, p95Ms: pct(s, 0.95), minMs: s[0], maxMs: s[s.length - 1] });
+}
+if (!Number.isFinite(sink)) console.log('(sink not finite)');
+writeFileSync(outFile, JSON.stringify({ impl: 'ts', fixture: fixDir.split('/').pop(), node: process.version, v8: process.versions.v8, cpu: os.cpus()[0]?.model, cores: os.cpus().length, loadavg: os.loadavg(), bandCount: ls1.bandCount, hookCells: hookK.length, cases }));
+process.exit(0);
diff --git a/prototypes/dotnet-b/Fs.Bench/ts/fast/measure.sh b/prototypes/dotnet-b/Fs.Bench/ts/fast/measure.sh
new file mode 100644
index 0000000..0714ccc
--- /dev/null
+++ b/prototypes/dotnet-b/Fs.Bench/ts/fast/measure.sh
@@ -0,0 +1,47 @@
+#!/usr/bin/env bash
+# T1.4b: the timed runs, every one under the heavy-work lock, with the load average (uptime) written before and after each. Run from anywhere after
+#   source prototypes/dotnet-b/env.sh ; bash prototypes/dotnet-b/Fs.Bench/ts/fast/regen.sh      (fixtures, once)
+#   dotnet build prototypes/dotnet-b/Fs.Bench -c Release                                         (under the lock)
+#   bash prototypes/dotnet-b/Fs.Bench/ts/fast/measure.sh [OUT_DIR]                              default $FIRESIM_SCRATCH/T1.4b/measure
+# To hold the lock once for the whole session: flock /tmp/firesim-heavy.lock env FS_HAVE_LOCK=1 bash .../measure.sh
+# Order: TypeScript run 1, the BenchmarkDotNet session (default job, out of process, all 34 cases), TypeScript runs 2 and 3, the thread curve (DOTNET_TieredCompilation=0, one process),
+# then the merge into reports/1-fast-kernels.json (conditions.json holds every uptime line). Each TypeScript run is its own process.
+set -uo pipefail
+here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+root="$(cd "$here/../../../../.." && pwd)"
+pd="$root/prototypes/dotnet-b"
+fix="${FIRESIM_SCRATCH:?source prototypes/dotnet-b/env.sh first}/T1.4b"
+out="${1:-$fix/measure}"
+mkdir -p "$out"
+build="$pd/fixtures/.build-fast"
+bench="$pd/Fs.Bench/bin/Release/net11.0/Fs.Bench.dll"
+export FS_FAST_FIXTURES="$fix"
+cond="$out/conditions.log"
+: > "$cond"
+timed() { # name, command...
+  local name="$1"; shift
+  echo "$name before: $(date -u +%H:%M:%S) $(cut -d' ' -f1-3 /proc/loadavg)" >> "$cond"
+  if [ "${FS_HAVE_LOCK:-0}" = 1 ]; then "$@"; else flock /tmp/firesim-heavy.lock "$@"; fi   # FS_HAVE_LOCK=1: the caller already holds the lock for the whole session
+  local rc=$?
+  echo "$name after: $(date -u +%H:%M:%S) $(cut -d' ' -f1-3 /proc/loadavg)" >> "$cond"
+  return $rc
+}
+tsrun() { # n
+  for w in k6f-900 k6f-late; do
+    timed "ts-$w-run$1" node "$build/bench.mjs" "$fix/fx-$w" "$out/ts-$w-$1.json" 1000 1500 | tee "$out/ts-$w-$1.txt"
+  done
+}
+tsrun 1
+timed bdn dotnet "$bench" --filter "*FastBench*" --artifacts "$out/bdn"
+tsrun 2
+tsrun 3
+timed threads env DOTNET_TieredCompilation=0 dotnet "$bench" fast-threads "$out/threads.json" > "$out/threads.md"
+python3 - "$cond" "$out/conditions.json" <<'EOF'
+import json, sys
+lines = [l.strip() for l in open(sys.argv[1]) if l.strip()]
+json.dump({"loadAverageLog": lines, "columns": "name before|after: UTC time, load average over 1, 5 and 15 minutes (/proc/loadavg)"}, open(sys.argv[2], "w"), indent=1)
+EOF
+bdnjson="$(ls "$out"/bdn/results/*FastBench*-report-full.json | head -1)"
+dotnet "$bench" fast-merge "$bdnjson" "$out/ts-k6f-900-1.json,$out/ts-k6f-900-2.json,$out/ts-k6f-900-3.json" "$out/ts-k6f-late-1.json,$out/ts-k6f-late-2.json,$out/ts-k6f-late-3.json" \
+  "$pd/reports/1-fast-kernels.json" "$out/conditions.json" "$out/threads.json" > "$out/merge.md"
+echo "done; tables in $out/merge.md and $out/threads.md; $pd/reports/1-fast-kernels.json written"
diff --git a/prototypes/dotnet-b/Fs.Bench/ts/fast/wasm-run.mjs b/prototypes/dotnet-b/Fs.Bench/ts/fast/wasm-run.mjs
new file mode 100644
index 0000000..7f3ad01
--- /dev/null
+++ b/prototypes/dotnet-b/Fs.Bench/ts/fast/wasm-run.mjs
@@ -0,0 +1,47 @@
+// T1.4b: runs the fast tier's kernels of the published Fs.Wasm (Mono WebAssembly) under Node on a captured fixture. For each of the four forms the build runs every recorded case
+// and variant (Fs.Tests/FastCaseRunner.cs, compiled into Fs.Wasm) and compares every hash with the one the real TypeScript kernels gave (the golden file Fs.Tests/golden/fast-*.json);
+// the x64 C# tests check the same hashes on 9 forms, so equal here means equal to the x64 build too. The aggregate hash of all the computed hashes is printed so that two runs
+// (or this and the x64 one, Fs.Bench `fast-aggregate`) can be compared with one value.
+//   node wasm-run.mjs FRAMEWORK_DIR FIXTURE_DIR GOLDEN.json OUT.json
+// FRAMEWORK_DIR is Fs.Wasm/bin/Release/net11.0/publish/wwwroot/_framework. Forms: 0 scalar, 1 Vector128, 2 Parallel.For x4 (one thread here), 3 the same with the vector body.
+import fs from 'node:fs';
+import path from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+const [fwDir, fixDir, goldenFile, outFile] = process.argv.slice(2);
+if (!fwDir || !fixDir || !goldenFile || !outFile) throw new Error('usage: wasm-run.mjs FRAMEWORK_DIR FIXTURE_DIR GOLDEN.json OUT.json');
+
+const { dotnet } = await import(pathToFileURL(path.join(path.resolve(fwDir), 'dotnet.js')).href);
+const t0 = performance.now();
+const { getAssemblyExports } = await dotnet.withDiagnosticTracing(false).create();
+const E = (await getAssemblyExports('Fs.Wasm')).Fs.Wasm.FastTierExports;
+const startMs = performance.now() - t0;
+const info = E.Info();
+
+const headerText = fs.readFileSync(`${fixDir}/header.json`, 'utf8');
+const header = JSON.parse(headerText);
+const data = fs.readFileSync(`${fixDir}/data.bin`);
+E.SetHeader(headerText);
+for (const a of header.arrays) {
+  const size = a.type === 'float64' ? 8 : a.type === 'uint8' ? 1 : 4;
+  E.SetArray(a.name, new Uint8Array(data.buffer, data.byteOffset + a.byteOffset, a.length * size));
+}
+const goldenText = fs.readFileSync(goldenFile, 'utf8');
+
+const FORMS = ['scalar', 'vector128', 'parallel x4 (one thread in WebAssembly)', 'parallel x4 + vector128'];
+const results = [];
+let failures = 0;
+for (let form = 0; form < FORMS.length; form++) {
+  const t = performance.now();
+  const r = JSON.parse(E.Check(goldenText, form));
+  const ms = performance.now() - t;
+  results.push({ form: FORMS[form], ...r, totalMs: ms });
+  failures += r.failures;
+  console.log(`${path.basename(fixDir)} [${FORMS[form]}]: ${r.checks} hashes compared with the TypeScript's, ${r.failures} differ; aggregate ${r.aggregateHash}; ${ms.toFixed(0)} ms`);
+  for (const f of r.failureList.slice(0, 5)) console.log('  ' + f);
+}
+const agg = new Set(results.map((r) => r.aggregateHash));
+const result = { engine: 'node', node: process.version, v8: process.versions.v8, runtime: info, startUpMs: startMs, fixture: path.basename(fixDir), window: header.window, forms: results, failures, allFormsSameAggregate: agg.size === 1, aggregateHash: results[0].aggregateHash };
+fs.writeFileSync(outFile, JSON.stringify(result, null, 1));
+console.log(`aggregate over every computed hash, all four forms equal: ${agg.size === 1} (${results[0].aggregateHash}); ${info}`);
+process.exit(failures || agg.size !== 1 ? 1 : 0);
