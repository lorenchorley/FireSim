<Project Sdk="Microsoft.NET.Sdk">

	<!-- T0.4 hello build 3: the `dotnet new maui` template, Android only (this container is Linux: no iOS, Mac Catalyst or Windows), Release APK, CoreCLR.
	       source prototypes/dotnet-b/env.sh
	       flock /tmp/firesim-heavy.lock dotnet build prototypes/dotnet-b/hello/maui-android -c Release -p:AndroidPackageFormats=apk -p:EmbedAssembliesIntoApk=true
	     The APK is signed with the debug key (/root/.android/debug.keystore, created by the Android tooling if absent); never commit that key.
	     UseMonoRuntime=true is refused by the 11.0.100 SDK for net11.0-android (NETSDK1242): see TOOLCHAIN.md. -->
	<PropertyGroup>
		<TargetFramework>net11.0-android</TargetFramework>
		<!-- the phone is arm64; one ABI keeps the APK and the build small. Override with -p:RuntimeIdentifier=android-x64 for an x86_64 emulator. -->
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">android-arm64</RuntimeIdentifier>

		<OutputType>Exe</OutputType>
		<RootNamespace>HelloMaui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>HelloMaui</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>au.firesim.hello</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" BaseSize="222,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0" />
	</ItemGroup>

</Project>
