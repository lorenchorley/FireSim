<Project Sdk="Microsoft.NET.Sdk">

  <!-- T0.6a: the tests of Fs.Results. MSTest on Microsoft.Testing.Platform, like Fs.Tests (the runner is chosen in global.json):
         dotnet test (flag: project) Fs.Results.Tests -c Release
       Not in FsProto.slnx (net10.0 and Azure packages). RollForward=Major: the container has only the .NET 11 runtime, so the net10.0 test host runs on it;
       on a machine that has .NET 10 it simply runs on 10. Not a solver project. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableMSTestRunner>true</EnableMSTestRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fs.Results\Fs.Results.csproj" />
  </ItemGroup>

  <!-- Compatibility with the real phone client: its sender (what the APK POSTs, its headers and what it does with the answer) and the document builder of the
       T0.5 tests are linked, so the tests drive the endpoint with the same bytes the app produces. -->
  <ItemGroup>
    <Compile Include="..\Fs.TestApp.Core\Sending\Senders.cs" Link="Linked\Senders.cs" />
    <Compile Include="..\Fs.TestApp.Core\Sending\GitHubIssueUrl.cs" Link="Linked\GitHubIssueUrl.cs" />
    <Compile Include="..\Fs.Tests\TestApp\TestDocs.cs" Link="Linked\TestDocs.cs" />
  </ItemGroup>

</Project>
